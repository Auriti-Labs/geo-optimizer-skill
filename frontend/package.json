{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/verify-scheduled-articles.mjs",
    "build": "astro build && node scripts/generate-og-images.mjs",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "astro": "astro",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "generate:feed": "node scripts/generate-feed.mjs",
    "sanity:check-schedule": "node scripts/verify-scheduled-articles.mjs",
    "sanity:publish-due:dry-run": "node scripts/publish-scheduled-articles.mjs --dry-run",
    "sanity:publish-due": "node scripts/publish-scheduled-articles.mjs",
    "site:check-drift": "node scripts/check-live-drift.mjs",
    "indexnow:dry-run": "node scripts/indexnow-submit.mjs",
    "indexnow:submit": "node scripts/indexnow-submit.mjs --submit"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/starlight": "^0.42.2",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/geist": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/newsreader": "^5.2.10",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.2.10",
    "@portabletext/to-html": "^5.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^7.27.0",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.3.3",
    "astro-portabletext": "^0.13.0",
    "dotenv": "^18.0.2",
    "groq": "^6.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "@vercel/frameworks": {
      "js-yaml": "3.15.2",
      "smol-toml": "^1.9.1"
    },
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
