---
import '../styles/global.css';
// Interpolated into the inline Consent Mode script below: when the consent
// version changes, that script must stop trusting choices recorded against the
// previous one. Importing the constant keeps the two copies from drifting apart
// in silence.
import { CONSENT_VERSION } from '../lib/cookieRegistry';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  twitterImage?: string;
  robots?: string;
}

const {
  title,
  description = "Audit your website's visibility to ChatGPT, Perplexity, Claude & Gemini",
  canonical = "https://geoready.dev/",
  ogImage = "https://geoready.dev/assets/og-image.png",
  twitterImage = "https://geoready.dev/assets/twitter-image.png",
  robots = "index, follow"
} = Astro.props;

---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Preload dei font critici above-the-fold (self-hosted in /public/fonts).
       Con font-display: optional in global.css, il preload dà al font la possibilità
       di essere pronto entro il block period → niente swap tardivo, CLS azzerato. -->
  <link rel="preload" href="/fonts/space-grotesk-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/geist-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content={robots}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:secure_url" content={ogImage}>
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={description}>
  <meta property="og:site_name" content="GeoReady">
  <meta property="og:locale" content="en_US">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={twitterImage}>
  <meta name="twitter:image:alt" content={description}>
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
  <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0D9488">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/atom+xml" title="GeoReady Guides" href="https://geoready.dev/feed.xml">
  <link rel="alternate" type="application/atom+xml" title="GEO Optimizer Releases" href="https://github.com/Auriti-Labs/geo-optimizer-skill/releases.atom">
  <link rel="alternate" hreflang="en" href={canonical}>
  <link rel="alternate" hreflang="x-default" href={canonical}>
  <!--
    Google Consent Mode v2 — has to sit here, inline in the head, ahead of any
    Google tag. `consent default` commands are order-dependent: arriving after
    gtag.js initialises they are ignored, and the tag behaves as though consent
    had never been declared. So this cannot wait for CookieConsentManager to
    hydrate (client:only="react").

    No network request: it only populates dataLayer. gtag.js itself is loaded by
    loadAnalyticsScript(), and only once analytics consent is explicit.
  -->
  <script is:inline define:vars={{ consentVersion: CONSENT_VERSION }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('consent', 'default', {
      ad_storage: 'denied',
      analytics_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500
    });
    // Replay a choice already on file straight away, without waiting for React:
    // without this a visitor who had accepted would be measured in cookieless
    // mode for the first few hundred milliseconds of every page.
    try {
      var stored = JSON.parse(localStorage.getItem('geo_cookie_consent') || 'null');
      if (stored && stored.version === consentVersion) {
        gtag('consent', 'update', {
          analytics_storage: stored.analytics ? 'granted' : 'denied',
          ad_storage: stored.marketing ? 'granted' : 'denied',
          ad_user_data: stored.marketing ? 'granted' : 'denied',
          ad_personalization: stored.marketing ? 'granted' : 'denied'
        });
      }
    } catch (e) { /* localStorage unreachable: the denied defaults stand */ }
    window.__geoConsentModeReady = true;
  </script>
  <!-- Google Analytics: loaded by CookieConsentManager only after explicit consent -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://geoready.dev/#organization",
        "name": "Auriti Labs",
        "url": "https://geoready.dev",
        "description": "Auriti Labs builds open-source tools for AI search visibility and Generative Engine Optimization.",
        "foundingDate": "2024",
        "foundingLocation": {
          "@type": "Country",
          "name": "Italy"
        },
        "areaServed": "Worldwide",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "technical support",
          "url": "https://github.com/Auriti-Labs/geo-optimizer-skill/issues"
        },
        "sameAs": [
          "https://github.com/Auriti-Labs",
          "https://github.com/Auriti-Labs/geo-optimizer-skill",
          "https://pypi.org/project/geo-optimizer-skill/",
          "https://auriti-labs.github.io/geo-optimizer-skill/"
        ],
        "founder": { "@id": "https://geoready.dev/#founder" }
      },
      {
        "@type": "Person",
        "@id": "https://geoready.dev/#founder",
        "name": "Juan Camilo Auriti",
        "url": "https://x.com/JuanAuriti",
        "sameAs": [
          "https://x.com/JuanAuriti",
          "https://www.linkedin.com/in/juancamiloauriti/"
        ],
        "worksFor": { "@id": "https://geoready.dev/#organization" }
      },
      {
        "@type": "WebSite",
        "@id": "https://geoready.dev/#website",
        "name": "GeoReady",
        "url": "https://geoready.dev",
        "description": "GeoReady is a Generative Engine Optimization (GEO) platform that audits your website's AI search visibility and citability, scoring it across 8 categories with actionable recommendations — free, no account required.",
        "dateModified": "2026-06-16",
        "publisher": { "@id": "https://geoready.dev/#organization" }
      },
      {
        "@type": ["WebApplication", "SoftwareApplication"],
        "@id": "https://geoready.dev/#webapp",
        "name": "GeoReady",
        "url": "https://geoready.dev",
        "description": "GeoReady is a Generative Engine Optimization (GEO) platform that audits your website's AI search visibility and citability, scoring it across 8 categories with actionable recommendations — free, no account required.",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web",
        "dateModified": "2026-06-16",
        "author": {
          "@id": "https://geoready.dev/#organization"
        },
        "brand": {
          "@id": "https://geoready.dev/#organization"
        },
        "featureList": [
          "GEO score 0-100 across 8 categories",
          "Free one-shot web audit, no account required",
          "Free weekly monitoring for one domain with drift email",
          "AI citation tracking via Perplexity Sonar",
          "Full 8-category report and fix recommendations"
        ],
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "EUR",
          "lowPrice": "0",
          "highPrice": "89",
          "offerCount": "4",
          "offers": [
            { "@type": "Offer", "name": "Free", "price": "0", "priceCurrency": "EUR" },
            { "@type": "Offer", "name": "Pro", "price": "19", "priceCurrency": "EUR" },
            { "@type": "Offer", "name": "Studio", "price": "49", "priceCurrency": "EUR" },
            { "@type": "Offer", "name": "Agency", "price": "89", "priceCurrency": "EUR" }
          ]
        }
      }
    ]
  })} />
</head>
<body class="bg-bg-base text-text-primary">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-accent-teal focus:text-white focus:rounded-lg focus:text-sm focus:font-medium">Skip to main content</a>
  <slot />
</body>
</html>
