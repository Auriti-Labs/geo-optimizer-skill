<body class="bg-paper text-ink">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-pass-deep focus:text-on-accent focus:rounded-[10px] focus:text-sm focus:font-medium">Skip to main content</a>
