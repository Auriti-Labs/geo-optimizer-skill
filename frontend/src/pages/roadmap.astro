---
import Shell from '../components/Shell.astro';
import RoadmapPhase from '../components/content/RoadmapPhase.astro';
import { roadmapPhases, releaseCadence } from '../lib/roadmapContent';
---

<Shell title="GeoReady Roadmap — AI SEO & AI Visibility" description="See the GeoReady roadmap for AI SEO audits, GEO monitoring, AI visibility tracking, crawler analysis, API access and platform features." canonical="https://geoready.dev/roadmap/">
  <div class="bg-paper font-text text-ink">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-16">
      {/* Hero */}
      <header class="mb-14 md:mb-20">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h1 class="max-w-3xl font-head text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] md:text-5xl">
            GeoReady Roadmap — AI Visibility &amp; GEO Monitoring
          </h1>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">GeoReady · Roadmap</p>
        </div>

        <p class="mt-4 max-w-2xl text-lg font-medium text-ink-soft">
          Focused waves, not noisy patches.
        </p>

        <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft">
          GEO Optimizer evolves through deliberate releases focused on signal quality, auditability, retrieval visibility, and developer workflows.
        </p>
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">Last updated: October 2026 · v{__ENGINE_VERSION__}</p>
      </header>

      {/* Legend */}
      <div class="mb-10 flex flex-wrap items-center gap-2" aria-label="Status legend">
        <span class="rounded-[2px] bg-pass-wash px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-pass-deep">
          Available
        </span>
        <span class="rounded-[2px] border border-rail px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-mute">
          In progress
        </span>
        <span class="rounded-[2px] border border-rail px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-mute">
          Planned
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-[2px] border border-rail px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-queued">
          <svg class="h-2 w-2" viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="4" cy="4" r="3" /></svg>
          Exploring
        </span>
      </div>

      {/* Phases */}
      <div class="space-y-14 md:space-y-20">
        {roadmapPhases.map((phase, i) => (
          <RoadmapPhase phase={phase} index={i} />
        ))}
      </div>

      {/* Release cadence */}
      <section class="mt-16 border-t border-rail pt-10 md:mt-24">
        <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] md:text-3xl">
          Release direction
        </h2>
        <p class="mb-6 mt-2 max-w-xl text-sm text-ink-soft">
          These are planned directions, not rigid promises. Names reflect the thematic focus of each release.
        </p>

        <div class="flex flex-wrap gap-2">
          {releaseCadence.map((rel) => {
            const isAvailable = rel.status === 'available';
            const isExploring = rel.status === 'exploring';
            return (
              <div
                class={`inline-flex items-center gap-2 rounded-[2px] px-2.5 py-1.5 font-mono text-[11px] ${
                  isAvailable
                    ? 'bg-pass-wash text-pass-deep'
                    : isExploring
                      ? 'border border-rail text-queued'
                      : 'border border-rail text-ink-mute'
                }`}
              >
                {isExploring && (
                  <svg class="h-2 w-2" viewBox="0 0 8 8" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="4" cy="4" r="3" /></svg>
                )}
                <span class="sr-only">{isAvailable ? 'Available' : isExploring ? 'Exploring' : 'Planned'}: </span>
                <span class="font-semibold tabular-nums">{rel.version}</span>
                <span>{rel.name}</span>
              </div>
            );
          })}
        </div>
      </section>

      {/* CTA */}
      <section class="mt-14 rounded-[4px] border border-rail bg-white p-6 md:mt-20 md:p-8">
        <h2 class="font-head text-xl font-extrabold tracking-[-0.02em] md:text-2xl">
          Want to influence the roadmap?
        </h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink-soft">
          GEO Optimizer is open source. The best way to shape its direction is to open an issue, start a discussion, or star the project on GitHub.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="https://github.com/Auriti-Labs/geo-optimizer-skill/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-[4px] bg-pass-deep px-5 py-2.5 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-pass"
          >
            Open an issue
            <span class="sr-only">(opens in a new tab)</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
          <a
            href="https://github.com/Auriti-Labs/geo-optimizer-skill/discussions"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-[4px] border border-rail bg-white px-5 py-2.5 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-ink transition-colors hover:bg-pass-wash"
          >
            Start a discussion
            <span class="sr-only">(opens in a new tab)</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
          <a
            href="https://github.com/Auriti-Labs/geo-optimizer-skill"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-[4px] border border-rail bg-white px-5 py-2.5 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-ink transition-colors hover:bg-pass-wash"
          >
            Star on GitHub
            <span class="sr-only">(opens in a new tab)</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>
      </section>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "GeoReady Roadmap — AI SEO, GEO Monitoring & AI Visibility",
    "url": "https://geoready.dev/roadmap/",
    "description": "See the GeoReady roadmap for AI SEO audits, GEO monitoring, AI visibility tracking, crawler analysis, API access and platform features.",
    "author": { "@id": "https://geoready.dev/#founder" },
    "publisher": { "@id": "https://geoready.dev/#organization" },
    "datePublished": "2026-05-12",
    "dateModified": "2026-10-12",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": roadmapPhases.map((phase, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": phase.label,
        "description": phase.subtitle
      }))
    }
  })} />
</Shell>
