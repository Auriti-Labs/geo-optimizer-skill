---
import Shell from '../components/Shell.astro';
import ArticleVisual from '../components/ArticleVisual.astro';

// Le 8 categorie di scoring con i pesi esatti (totale 100).
// Allineati a SCORING in src/geo_optimizer/models/config.py.
// La quarta colonna è la chiave di categoria dello score_breakdown JSON —
// lo stesso ID che la homepage mostra sul rail dei gate: deve restare quella vera.
const SCORING_CATEGORIES = [
  ['robots.txt', 18, 'Whether AI crawlers can reach the site and whether the file welcomes citation-oriented bots instead of blocking them by default. It gates everything downstream — an unreachable page never gets scored on anything else.', 'robots'],
  ['llms.txt', 18, 'Presence and quality of a root-level llms.txt: a clear H1, a summary, sectioned links, and link depth that point AI systems at the pages worth citing.', 'llms'],
  ['Schema JSON-LD', 16, 'Valid structured data — Organization, WebSite, Article, FAQ — that lets engines disambiguate the entity and pull facts with confidence rather than inference.', 'schema'],
  ['Meta tags', 14, 'Title, description, canonical, and Open Graph tags that keep the page identifiable and free of duplication when an engine indexes it.', 'meta'],
  ['Content', 12, 'Heading hierarchy, front-loaded answers, lists, tables, and the numbers and links that make individual passages quotable.', 'content'],
  ['Brand & entity', 10, 'Naming coherence, knowledge-graph readiness, and about/contact clarity that tie a set of pages to a single recognizable entity.', 'brand_entity'],
  ['Signals', 6, 'Declared language, RSS, and freshness indicators that help an engine judge how current and maintained the source is.', 'signals'],
  ['AI discovery', 6, 'Machine-readable endpoints such as /.well-known/ai.txt and JSON summaries that expose the site to AI tooling directly.', 'ai_discovery'],
] as const;

// Bande di punteggio, identiche a SCORE_BANDS in config.py.
const SCORE_BANDS = [
  ['86–100', 'Excellent', 'Most signals are in place; the site is structurally ready to be cited.'],
  ['68–85', 'Good', 'A solid foundation with a few high-value gaps left to close.'],
  ['36–67', 'Foundation', 'Core pieces exist, but several categories still need work.'],
  ['0–35', 'Critical', 'Crawlability or structure blocks visibility before content quality matters.'],
] as const;

// Segnali di citability con il lift verificato dalla ricerca.
// Fonti: Princeton KDD 2024 (arXiv:2311.09735), AutoGEO ICLR 2026 (arXiv:2510.11438),
// GEO survey 2026 (arXiv:2607.14035), C-SEO Bench (arXiv:2506.11097).
const CITABILITY_SIGNALS = [
  ['Quotations', '+41%', 'Direct quotes from named sources give an engine a self-contained, attributable passage it can lift verbatim.'],
  ['Statistics', '+33%', 'Concrete numbers anchor a claim and are easier for a model to surface than a general assertion.'],
] as const;

// FAQ visibili — riusate sia nel markup crawlable che nello schema FAQPage.
// Tenere allineate: ogni modifica al testo va replicata in entrambi i punti.
const faqs = [
  {
    question: 'What is an AI visibility score?',
    answer:
      'An AI visibility score is a number — in GEO Optimizer, a score out of 100 — that measures how well a site is structured for AI answer engines to crawl, understand, and evaluate. It differs from a traditional SEO score: rather than evaluating keyword density or backlinks, it checks signals like AI crawler access, llms.txt, schema JSON-LD, content quotability, and entity clarity. The score answers the readiness question — can an AI engine use this site? — not the outcome question of whether you are currently cited.',
  },
  {
    question: 'Why are the scoring weights public?',
    answer:
      'GEO Optimizer is open source under the MIT license, and the weights live in the repository as plain constants. Publishing them means anyone can read exactly how a score is produced, reproduce it locally, and disagree with a specific number on the record rather than against a black box. A visibility score you cannot inspect is a score you cannot trust.',
  },
  {
    question: 'How are the 100 points distributed?',
    answer:
      'Across eight categories: robots.txt 18, llms.txt 18, schema 16, meta tags 14, content 12, brand and entity signals 10, freshness signals 6, and AI discovery 6. Crawlability and orientation files carry the most weight because they gate everything else — if a bot cannot fetch the page or find your key URLs, content quality never gets a chance to count.',
  },
  {
    question: 'Does a higher GEO score guarantee more AI citations?',
    answer:
      'No. The score measures structural readiness — whether crawlers can reach the site, whether content is quotable, and whether the entity is clear. Citation behavior in AI engines is probabilistic and shifts as models are retrained. A stronger score removes friction; it does not force a citation.',
  },
  {
    question: 'Where does the citability layer come from?',
    answer:
      'It is a set of 47 content checks derived from published research. The headline signals — direct quotations and concrete statistics — carry measured citation lift in the Princeton KDD 2024 study (arXiv:2311.09735), and AutoGEO (ICLR 2026, arXiv:2510.11438) reports a +50.99% improvement over that baseline. The checks turn those findings into auditable rules.',
  },
  {
    question: 'Can I change the weights for my own use?',
    answer:
      'Yes. The scoring weights are constants in the open-source repository, so you can fork it and re-weight the categories for your context. The defaults reflect how much each category influences whether an AI answer engine can reach, understand, and quote a page, but they are a starting point, not a fixed law.',
  },
];
---

<Shell
  title="GEO Scoring Methodology — Open Scoring Weights"
  description="GEO Optimizer's open scoring: the 8 categories, exact point weights, score bands, and the citability layer — all MIT-licensed. Reproduce any score free."
  canonical="https://geoready.dev/methodology/"
>
  {/* Hero — paper band, annotation on the heading's baseline row */}
  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20">
      <header>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h1 class="max-w-3xl font-head text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] text-ink md:text-5xl">
            How GEO Optimizer scores a site — and why the weights are public.
          </h1>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">GEO Optimizer · Methodology</p>
        </div>

        <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
          GEO Optimizer scores a site out of 100 across eight signal categories, then adds a
          research-backed citability layer on top. The weights are not a secret: they are plain
          constants in an open-source, MIT-licensed repository, so any score can be read,
          reproduced, and challenged on the record.
        </p>
        <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">Last updated: June 2026</p>

        <div class="mt-8 grid gap-px overflow-hidden rounded-[4px] border border-rail bg-rail sm:grid-cols-3">
          {[
            ['100 points', 'Distributed across 8 signal categories.'],
            ['Open weights', 'Constants in the MIT-licensed repo.'],
            ['Research-backed', 'Citability grounded in published papers.'],
          ].map(([label, text]) => (
            <div class="bg-white p-5">
              <p class="text-sm font-semibold text-ink">{label}</p>
              <p class="mt-1 text-sm leading-relaxed text-ink-soft">{text}</p>
            </div>
          ))}
        </div>

        <p class="mt-8 max-w-3xl text-sm text-ink-soft">
          For the science behind the signals, see the
          <a href="/research/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">research foundation</a>.
          To turn the score into action, start with the
          <a href="/guides/ai-visibility-checklist/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">AI visibility checklist</a>.
        </p>
      </header>

      <ArticleVisual
        src="/images/article-visuals/N1HeroScoringWeights.png"
        alt="Diagram of the eight published signal weights that make up the GeoReady score."
        caption="GeoReady's score is the sum of eight published signal weights, not a black-box number."
        height={452}
      />
    </div>
  </section>

  {/* How scoring works */}
  <section class="border-t border-rail bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">How the score is built</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        A GEO audit produces a single number out of 100. That number is the sum of eight
        category scores, each with a fixed weight. The weights reflect how much a category
        influences whether an AI answer engine can reach a page, understand what it is about,
        and quote it confidently. They are deliberately uneven: the categories that gate access
        and orientation carry more weight than the ones that polish an already-reachable page.
      </p>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        On top of the structural score sits a citability layer — a set of content checks drawn
        from published research on what makes a passage quotable. The structural score answers
        “can an engine use this site at all?”; the citability layer answers “once it can, is the
        content worth lifting?”. Both are visible in the audit output, and both are computed by
        rules you can read in the source.
      </p>
    </div>
  </section>

  {/* The 8 categories and weights */}
  <section class="border-t border-rail bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">The 8 categories and their exact weights</h2>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">models/config.py · SCORING · Σ = 100 pts</p>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Every site is scored on the same eight categories, weighted to a total of 100 points.
        robots.txt and llms.txt carry the most weight because they gate everything downstream:
        if a crawler is blocked or cannot find your key URLs, the quality of the content never
        gets a chance to matter. Schema and meta tags come next, because they decide whether an
        engine can resolve the entity and pull facts without guessing.
      </p>
      <div class="mt-6 overflow-x-auto rounded-[4px] border border-rail bg-white">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="bg-paper">
            <tr class="border-b border-rail">
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Category</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Weight</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">What it measures</th>
            </tr>
          </thead>
          <tbody>
            {SCORING_CATEGORIES.map(([name, weight, detail, key]) => (
              <tr class="border-b border-rail/60 align-top last:border-0">
                <th scope="row" class="whitespace-nowrap px-4 py-3 font-semibold text-ink">
                  {name}
                  <span class="block font-mono text-[11px] font-normal text-ink-mute">{key}</span>
                </th>
                <td class="px-4 py-3 font-mono tabular-nums text-pass-deep">{weight}</td>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{detail}</td>
              </tr>
            ))}
            <tr class="border-t-2 border-rail">
              <th scope="row" class="whitespace-nowrap px-4 py-3 font-semibold text-ink">Total</th>
              <td class="px-4 py-3 font-mono font-semibold tabular-nums text-ink">100</td>
              <td class="px-4 py-3 leading-relaxed text-ink-mute">The sum of all eight category weights.</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        The same weights apply to every site, so two audits are always directly comparable. A
        site can score well on content yet lose most of its points to a single blocked crawler —
        which is exactly the kind of imbalance the category breakdown is meant to expose.
      </p>
    </div>
  </section>

  {/* Score bands */}
  <section class="border-t border-rail bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">How to read the score bands</h2>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">models/config.py · SCORE_BANDS</p>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        The total score falls into one of four bands. The band is a summary, not a verdict: it
        tells you roughly how much structural work remains, but the category breakdown is where
        the actual to-do list lives.
      </p>
      <div class="mt-6 overflow-x-auto rounded-[4px] border border-rail bg-white">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-paper">
            <tr class="border-b border-rail">
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Range</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Band</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">What it means</th>
            </tr>
          </thead>
          <tbody>
            {SCORE_BANDS.map(([range, label, meaning]) => (
              <tr class="border-b border-rail/60 align-top last:border-0">
                <th scope="row" class="whitespace-nowrap px-4 py-3 font-mono tabular-nums text-ink">{range}</th>
                <td class="whitespace-nowrap px-4 py-3 font-semibold text-ink">{label}</td>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Prioritize by where the gap is largest and the effort is lowest. A site in the foundation
        band almost always has more to gain from fixing crawlability and structure than from
        rewriting copy — the points are concentrated in the categories that gate everything else.
      </p>

      <ArticleVisual
        src="/images/article-visuals/D1HeroChecklist.png"
        alt="Checklist diagram showing how access, structure, content, entity signals, and monitoring become a practical fix order."
        caption="The scoring method turns category gaps into a practical fix order."
        height={411}
      />
    </div>
  </section>

  {/* Citability layer */}
  <section class="border-t border-rail bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">The citability layer: 47 research-backed checks</h2>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">arXiv:2311.09735 · KDD 2024</p>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Beyond the structural score, GEO Optimizer runs 47 content checks that estimate how
        quotable a page is. These checks are not opinions; they map directly to findings in
        published research on generative engine optimization. The two strongest signals are
        direct quotations and concrete statistics — both measured to raise citation rates in the
        Princeton study.
      </p>
      <div class="mt-6 overflow-x-auto rounded-[4px] border border-rail bg-white">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-paper">
            <tr class="border-b border-rail">
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Signal</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Citation lift</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Why it works</th>
            </tr>
          </thead>
          <tbody>
            {CITABILITY_SIGNALS.map(([name, lift, detail]) => (
              <tr class="border-b border-rail/60 align-top last:border-0">
                <th scope="row" class="whitespace-nowrap px-4 py-3 font-semibold text-ink">{name}</th>
                <td class="px-4 py-3 font-mono tabular-nums text-pass-deep">{lift}</td>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        The lift figures come from
        {' '}
        <a href="https://arxiv.org/abs/2311.09735" rel="noopener" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">Princeton’s KDD 2024 paper</a>
        {' '}(arXiv:2311.09735), the first systematic study of which on-page changes move AI
        citations. <a href="https://arxiv.org/abs/2510.11438" rel="noopener" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">AutoGEO</a>
        {' '}(ICLR 2026, arXiv:2510.11438) builds on it and reports a +50.99% improvement over the
        Princeton baseline by optimizing content automatically. The full list of sources behind
        every signal is on the <a href="/research/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">research page</a>.
      </p>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        A 2026 <a href="https://arxiv.org/abs/2607.14035" rel="noopener" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">critical survey of GEO</a>
        {' '}(arXiv:2607.14035) reviewed 45 studies and reached a conclusion that shapes how we
        weight these checks: topical relevance and passage structure are the levers with
        reproducible effects, while any single copy tactic loses value as more sites adopt it
        (<a href="https://arxiv.org/abs/2506.11097" rel="noopener" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">C-SEO Bench</a>,
        arXiv:2506.11097). That is why the citability layer scores structure a model can lift and
        attribute — not a formula for a guaranteed ranking gain.
      </p>

      <ArticleVisual
        src="/images/article-visuals/O1HeroCitabilityEvidence.png"
        alt="Diagram showing quotations, concrete statistics, and source-backed claims feeding stronger citability."
        caption="Quotations and statistics make passages easier for AI systems to lift and attribute."
        height={452}
      />
    </div>
  </section>

  {/* Why we publish the weights */}
  <section class="border-t border-rail bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <h2 id="why-we-publish-the-weights" class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">Why we publish the weights</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        A visibility score is only useful if you can interrogate it. Publishing the weights as
        open-source constants does three things. It makes the score reproducible — you can run
        the same audit locally and get the same number. It makes the score auditable — you can
        read the exact rule behind any category and disagree with it specifically. And it makes
        the score honest — there is no hidden lever to inflate a result or favor a particular
        kind of site.
      </p>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        The weights and every check live in the
        {' '}
        <a href="https://github.com/Auriti-Labs/geo-optimizer-skill" rel="noopener" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">open-source repository</a>
        {' '}under the MIT license. If you think a category is weighted wrong for your context,
        you can read the code, open an issue, or fork it and re-weight it yourself. That is the
        point of publishing them: a methodology you can change on the record is more trustworthy
        than one you have to take on faith.
      </p>
    </div>
  </section>

  {/* Score stability, measured — first-party measured data, framed as the page's
      one log well (One Dark Material Rule). */}
  <section class="border-t border-rail bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">Score stability, measured</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        "Reproducible" is a claim you can check, not a description we'll ask you to trust. We
        measured it against real usage of the hosted audit rather than a synthetic test: every
        pair of audits of the same domain, run back to back (48 hours apart or less, so it
        isolates measurement noise from the site actually changing), across every domain audited
        on GeoReady.
      </p>
      <div class="mt-6 max-w-3xl overflow-hidden rounded-[4px] bg-well text-well-ink">
        <div class="flex items-center justify-between gap-3 border-b border-well-ink/15 px-6 py-3">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-well-mute">Audit pairs ≤48h apart · measured 2026-08-30</p>
          <span class="font-mono text-[11px] tracking-[0.08em] text-pass">exit 0</span>
        </div>
        <div class="overflow-x-auto px-2 py-2">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-well-ink/15">
                <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-well-mute">Metric</th>
                <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-well-mute">Value</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-well-ink/15">
                <th scope="row" class="px-4 py-3 font-normal text-well-ink">Audit pairs measured</th>
                <td class="px-4 py-3 font-mono tabular-nums text-white">2,513 (216 distinct domains)</td>
              </tr>
              <tr class="border-b border-well-ink/15">
                <th scope="row" class="px-4 py-3 font-normal text-well-ink">Pairs with zero score movement</th>
                <td class="px-4 py-3 font-mono tabular-nums text-white">98.6%</td>
              </tr>
              <tr class="border-b border-well-ink/15">
                <th scope="row" class="px-4 py-3 font-normal text-well-ink">Average score movement</th>
                <td class="px-4 py-3 font-mono tabular-nums text-white">0.09 points</td>
              </tr>
              <tr>
                <th scope="row" class="px-4 py-3 font-normal text-well-ink">Pairs within 3 points of each other</th>
                <td class="px-4 py-3 font-mono tabular-nums text-white">99.4%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Measured 2026-08-30. When two consecutive audits of the same site do disagree by more
        than a few points, it is almost always because something on the site changed between
        them, not because the scoring is noisy — this is what the
        {' '}
        <a href="/methodology/#why-we-publish-the-weights" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">published, fixed weights</a>
        {' '}buy you: a number that moves for a reason you can find, not one that drifts on its
        own. We'll re-run this measurement periodically rather than let a good number go stale on
        the page.
      </p>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        The GEO score is deterministic on purpose. What an AI engine actually cites is not:
        research on AI-search visibility finds the same query returns different sources run to
        run (<a href="https://arxiv.org/abs/2604.07585" rel="noopener" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">Schulte et al. 2026</a>,
        arXiv:2604.07585). So a live citation check is a sample, not a verdict — the
        {' '}<code class="font-mono text-sm">geo citations --runs</code> flag asks each query
        several times and reports a confidence interval instead of one coin flip.
      </p>

      {/* Rimando alla pagina sulla trasparenza: stesso cluster, intento diverso —
           qui c'è la derivazione dei pesi, là cosa si può verificare da fuori. */}
      <p class="mt-8 max-w-3xl text-sm leading-relaxed text-ink-soft">
        Want to check these numbers rather than read about them?
        <a href="/transparent-geo-tool/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">See what you can verify yourself</a>
        — the constants, the test suite, and the one command that reproduces any score.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink-soft">
        The same engine scores our <a href="/state-of-geo/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">monthly benchmark</a>.
        When a release changes detection mid-month, the edition says which versions scored which
        domains — see the <a href="/state-of-geo/september-2026/#engine-versions" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">September 2026 engine-version note</a>.
      </p>
    </div>
  </section>

