---
import { PortableText } from 'astro-portabletext';
import Shell from '../../components/Shell.astro';
import NewsletterSignup from '../../components/NewsletterSignup';
import Callout from '../../components/Callout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Image from '../../components/Image.astro';
import PortableTextLink from '../../components/PortableTextLink.astro';
import { getAllArticleSlugs, getArticleBySlug, urlForImage } from '../../utils/sanity';

// ── Static paths ──────────────────────────────────────────────────────────────
export async function getStaticPaths() {
  const slugs = await getAllArticleSlugs();
  return slugs
    .filter((s: { slug: string; category: string }) => s.category === 'resources')
    .map((s: { slug: string; category: string }) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const article = await getArticleBySlug(slug as string);

if (!article) return Astro.redirect('/404', 301);

const canonical = `https://geoready.dev/resources/${slug}/`;
const title = article.metaTitle || article.title;
const schemaType = article.schemaOrgType || 'Article';
const author = article.author || 'Juan Camilo Auriti';
const ogImageUrl = article.ogImage?.asset
  ? urlForImage(article.ogImage).width(1200).height(630).fit('crop').auto('format').url()
  : undefined;

// ── Portable Text components ──────────────────────────────────────────────────
// astro-portabletext requires .astro component files for custom renderers.
// Block/list/marks use the library defaults (semantic HTML) styled via CSS below.
const ptComponents = {
  type: {
    callout: Callout,
    codeBlock: CodeBlock,
    image: Image,
  },
  mark: {
    link: PortableTextLink,
  },
};

// ── JSON-LD ───────────────────────────────────────────────────────────────────
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': schemaType,
      '@id': `${canonical}#article`,
      url: canonical,
      headline: article.title,
      description: article.description,
      ...(ogImageUrl
        ? { image: { '@type': 'ImageObject', url: ogImageUrl, width: 1200, height: 630 } }
        : {}),
      datePublished: article.datePublished,
      dateModified: article.dateModified,
      // Founder and Organization are defined once in the global graph (Layout.astro)
      author: author === 'Juan Camilo Auriti'
        ? { '@id': 'https://geoready.dev/#founder' }
        : { '@type': 'Person', name: author, url: 'https://geoready.dev/about/' },
      publisher: { '@id': 'https://geoready.dev/#organization' },
      mainEntityOfPage: canonical,
      isPartOf: { '@id': 'https://geoready.dev/#website' },
    },
    ...(article.faqs?.length
      ? [{
          '@type': 'FAQPage',
          mainEntity: article.faqs.map((faq: any) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: { '@type': 'Answer', text: faq.answer },
          })),
        }]
      : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'GeoReady', item: 'https://geoready.dev/' },
        { '@type': 'ListItem', position: 2, name: article.title, item: canonical },
      ],
    },
  ],
};
---

<Shell
  title={title}
  description={article.description}
  canonical={canonical}
  robots={article.noindex ? 'noindex, follow' : 'index, follow'}
  ogImage={ogImageUrl}
  twitterImage={ogImageUrl}
>
  <article class="bg-paper font-text text-ink" itemscope itemtype="https://schema.org/Article">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-16">
      {/* ── Header ──────────────────────────────────────────────────────────── */}
      <header class="mb-12 max-w-3xl md:mb-16">
        <h1 itemprop="headline" class="text-[2.1rem] font-semibold leading-[1.08] tracking-[-0.035em] text-ink sm:text-[2.6rem]">
          {article.title}
        </h1>

        <div class="eyebrow mt-3">
          Resources{article.focusKeyword && ` · ${article.focusKeyword}`}
        </div>

        <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
          {article.description}
        </p>

        <div class="eyebrow mt-5 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span itemprop="author">{author}</span>
          <span>·</span>
          <time itemprop="datePublished" datetime={article.datePublished}>
            {new Date(article.datePublished).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {article.dateModified !== article.datePublished && (
            <>
              <span>· Updated</span>
              <time itemprop="dateModified" datetime={article.dateModified}>
                {new Date(article.dateModified).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </>
          )}
        </div>
      </header>

      {/* ── Body ─────────────────────────────────────────────────────────────── */}
      <div class="pt-prose max-w-3xl">
        <PortableText value={article.body} components={ptComponents} />
      </div>

      {/* ── FAQs ─────────────────────────────────────────────────────────────── */}
      {article.faqs && article.faqs.length > 0 && (
        <section class="mt-16 max-w-3xl" data-reveal>
          <h2 class="mb-6 font-head text-2xl font-semibold leading-tight tracking-[-0.02em]">
            Frequently asked questions
          </h2>
          <div class="panel divide-y divide-rail overflow-hidden">
            {article.faqs.map((faq: any) => (
              <div class="p-6">
                <h3 class="text-base font-semibold text-ink">{faq.question}</h3>
                <p class="mt-2 leading-relaxed text-ink-soft">{faq.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      {/* ── Newsletter ───────────────────────────────────────────────────────── */}
      <div class="mt-16 max-w-3xl">
        <NewsletterSignup
          client:visible
          source={`newsletter-resource-${slug}`}
          title="Get the monthly State of GEO report"
          detail="AI search readiness benchmarks, adoption stats, and the actions that move the needle — delivered monthly. No spam."
        />
      </div>
    </div>
  </article>

  {/* ── Structured data ──────────────────────────────────────────────────────── */}
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Shell>

<style is:global>
  /* Read-mode prose nella grammatica console: Geist 600 per i titoli,
     ink/ink-soft per il testo, hairline rail per i bordi, niente superfici scure. */
  .pt-prose h2 { font-family: var(--font-head, inherit); font-size: 1.5rem; font-weight: 800; color: var(--color-ink, inherit); line-height: 1.25; letter-spacing: -0.02em; margin-top: 3rem; margin-bottom: 1rem; }
  .pt-prose h3 { font-family: var(--font-head, inherit); font-size: 1.125rem; font-weight: 800; color: var(--color-ink, inherit); letter-spacing: -0.01em; margin-top: 2rem; margin-bottom: 0.75rem; }
  .pt-prose h4 { font-weight: 600; color: var(--color-ink, inherit); margin-top: 1.5rem; margin-bottom: 0.5rem; }
  .pt-prose p { color: var(--color-ink-soft, inherit); line-height: 1.75; margin-top: 1rem; }
  .pt-prose ul { list-style-type: disc; padding-left: 1.25rem; margin-top: 1rem; }
  .pt-prose ol { list-style-type: decimal; padding-left: 1.25rem; margin-top: 1rem; }
  .pt-prose li { color: var(--color-ink-soft, inherit); line-height: 1.75; margin-top: 0.375rem; }
  .pt-prose strong { font-weight: 600; color: var(--color-ink, inherit); }
  .pt-prose em { font-style: italic; }
  .pt-prose code { font-size: 0.875rem; font-family: var(--font-mono, ui-monospace, monospace); color: var(--color-ink, inherit); background: #fff; border: 1px solid var(--color-rail, #DFE5E5); border-radius: 2px; padding: 0.125rem 0.25rem; }
  .pt-prose pre { background: #fff; border: 1px solid var(--color-rail, #DFE5E5); border-radius: 4px; padding: 1rem; margin: 1.5rem 0; overflow-x: auto; font-size: 0.875rem; font-family: var(--font-mono, ui-monospace, monospace); }
  .pt-prose pre code { background: none; border: none; padding: 0; }
  .pt-prose a { color: var(--color-pass-deep, #0F766E); text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--color-rail, #DFE5E5); }
  .pt-prose a:hover { text-decoration-color: var(--color-pass-deep, #0F766E); }
  .pt-prose blockquote { border-left: 2px solid var(--color-pass-deep, #0F766E); padding-left: 1rem; font-style: italic; color: var(--color-ink-soft, inherit); margin: 1.5rem 0; }
</style>
