---
import Shell from '../components/Shell.astro';

const title = 'Citation Gap Analysis: See Who AI Cites Instead of You';
const description = 'Find the prompts where AI engines like Perplexity cite a competitor instead of you, learn why, and close the gap with a 4-step workflow.';
const canonical = 'https://geoready.dev/citation-gap-analysis/';
const datePublished = '2026-09-16';
const dateModified = '2026-09-16';

// Tabella piani/workflow — 4 step, quale piano copre ciascuno. Nessuna feature
// "citation gap" unica: sono capacità reali usate in sequenza (verdetto Hybrid A/B).
const PLAN_ROWS = [
  ["Who's cited instead of me?", 'Free', 'The AI Citation Checker, unlimited manual sampling, 5 checks/day'],
  ['Structural diagnosis: why is the gap there?', 'Free', 'GEO-score comparison via /compare/ and /analyze-competitors/'],
  ['Recurring automated Perplexity tracking', 'Studio ($49/mo)', '5 automated citation checks/day, competitor comparison, GEO-score history'],
  ['Trend across a named competitor, tracked prompt set', 'Studio ($49/mo)', 'Share-of-voice over saved AI answer snapshots'],
  ['Structured ChatGPT (and Google) snapshot history', 'Agency ($89/mo)', 'Manual-paste answer snapshots with citation-quality scoring'],
] as const;

const faqs = [
  {
    q: 'What is a citation gap analysis?',
    a: "Finding the queries where an AI engine cites another source instead of you, seeing who got cited, and deciding whether to fix your readiness, watch the gap, or both. It's a workflow across four real tools, not one report.",
  },
  {
    q: 'Does GeoReady have a single "citation gap" feature?',
    a: "No. There's no one product or endpoint that runs this whole workflow automatically. What exists are the four capabilities described above, used together.",
  },
  {
    q: "Is Studio's competitor comparison the same as a citation comparison?",
    a: "No. Studio's competitor comparison measures GEO score — structural readiness across 8 categories — not who was actually cited for a given prompt. Use the free citation checker (Step 1) or manual sampling (Step 2) to answer the citation question.",
  },
  {
    q: 'How do I know if a domain cited instead of me is a real competitor?',
    a: "The AI Citation Checker's results distinguish true competitor domains from reference platforms like Wikipedia, YouTube, or G2 that get cited across an entire category, not just against you specifically.",
  },
  {
    q: 'Can I track my citation gap automatically over time?',
    a: "Automated, scheduled tracking exists for Perplexity on Studio (5 checks/day) and for a tracked set of prompts via Studio's share-of-voice view. There's no automated tracking for ChatGPT specifically — see the ChatGPT citation tracking page for the manual-paste alternative.",
  },
  {
    q: 'Is any part of this free?',
    a: 'Yes — Steps 1 through 3 (the citation check, the manual sampling, and the GEO-score comparison) are all free, with no account required. Only recurring automated tracking (Step 4) is a paid feature.',
  },
  {
    q: "Why does a competitor get cited and I don't, if my product is just as good?",
    a: 'Usually because of structural readiness, not product quality — a schema gap, blocked AI-crawler access, thin factual content, or an unclear brand entity on your side, and stronger versions of those same signals on theirs. See "Why citation gaps happen" above, and run a GEO-score comparison (Step 3) to see which category is actually behind it.',
  },
  {
    q: 'Should I run this before or after fixing my GEO score?',
    a: 'Either order works, but running the citation check first (Step 1) tells you whether there\'s a gap worth fixing at all, before you spend time on Step 3\'s diagnosis. If you already know your score is low, you can start with the free GEO audit and come back to Steps 1 and 2 once the structural basics are in place.',
  },
] as const;
---

<Shell title={title} description={description} canonical={canonical}>
  <article class="mx-auto max-w-3xl bg-paper px-4 py-10 font-text text-ink sm:px-6 md:py-16 [&_h2]:font-head [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:leading-tight [&_h2]:tracking-[-0.02em] [&_h2]:text-ink [&_h3]:font-head [&_h3]:text-lg [&_h3]:font-extrabold [&_h3]:tracking-[-0.01em] [&_h3]:text-ink [&_p]:text-ink-soft [&_p]:leading-relaxed [&_li]:text-ink-soft [&_li]:leading-relaxed [&_a]:text-pass-deep [&_a]:underline [&_a]:decoration-rail [&_a]:underline-offset-4 [&_a:hover]:decoration-pass-deep">

    <header class="mb-12 md:mb-16">
      <h1 class="font-head text-3xl font-extrabold leading-tight tracking-[-0.03em] text-ink md:text-4xl">
        How to Find Your AI Citation Gaps
      </h1>

      <p class="mt-4 text-base leading-relaxed text-ink-soft md:text-lg">
        <strong>A citation gap is a query where an AI engine cites someone else instead of you.</strong> Finding yours is
        not a single push-button report — it's a short workflow: check who's cited instead of you, sample the pattern
        manually across engines, diagnose why with a GEO-score comparison, and decide whether the gap is worth tracking
        over time. This page walks through all four steps with the free and paid tools that actually do each one — and is
        equally clear about the one thing none of them do: there is no single "citation gap analysis" feature that runs
        this whole workflow for you automatically.
      </p>

      <p class="mt-4 font-mono text-xs text-ink-mute">
        Juan Camilo Auriti · September 16, 2026
      </p>
    </header>

    <section class="mb-12 md:mb-16">
      <h2>What "citation gap" actually means</h2>
      <p class="mt-4">
        When an AI engine answers a question in your category, it cites a handful of sources — sometimes you, often not.
        A citation gap analysis is the practice of finding those queries, seeing who got cited instead, and deciding what
        to do about it.
      </p>
      <p class="mt-4">
        Not every domain cited instead of you is a competitor worth chasing. AI answers frequently cite Wikipedia,
        YouTube, G2, or industry directories alongside — or instead of — company sites. The free
        <a href="/tools/ai-citation-checker/">AI Citation Checker</a> already separates true competitor domains from
        these reference platforms in its results, so the first step below tells you who's actually in your commercial gap
        and who's just a reference source every brand in the category gets cited alongside.
      </p>
    </section>

    <section class="mb-12 md:mb-16">
      <h2>Why citation gaps happen</h2>
      <p class="mt-4">
        A citation gap usually isn't about your product being worse than the source that got cited instead. It's more
        often structural: AI engines cite sources they can retrieve, parse, and quote cleanly — valid schema, AI-crawler
        access in <code>robots.txt</code>, dense factual content, and a clear brand entity. A page that reads fine to a
        human but is thin on structured data or blocked to AI bots in one overlooked directory will lose citations to a
        page that's weaker on substance but stronger on those specific signals. This is exactly why Step 3 below compares
        GEO-score readiness rather than guessing: a low score in one category — schema depth, factual density, AI-crawler
        permissions — is frequently the actual reason a named competitor gets cited and you don't. See
        <a href="/methodology/">the 8 scoring categories</a> for the full breakdown of what's actually being measured.
      </p>
    </section>

    <section class="mb-12 md:mb-16">
      <h2>The workflow: 4 steps you can run today</h2>

      <h3 class="mt-6">Step 1 — Run a free citation check</h3>
      <p class="mt-3">
        Start with the free <a href="/tools/ai-citation-checker/">AI Citation Checker</a>:
        <a href="/tools/ai-citation-checker/">run a citation check</a> against the questions your buyers actually ask,
        and read the "cited instead of you" list in the results. This is real, live, and free today — no account needed.
        The check queries Perplexity Sonar specifically, because Sonar returns the exact source URLs behind its answer,
        which is what makes a citation gap verifiable in the first place. It does not query ChatGPT directly; ChatGPT and
        other parametric models don't expose sources the same way, which is exactly why this checker uses the one engine
        that does.
      </p>
      <p class="mt-3 italic">
        Illustrative example — not a customer case, no measured figures. Say the results show a competitor's comparison
        page cited for three of the five prompts you sampled, and a G2 listing cited for the other two. The G2 citation
        isn't a gap worth chasing — it's a reference platform every brand in the category gets cited alongside,
        competitor included. The competitor's comparison page is the real gap: one source, worth investigating in Step 3.
      </p>

      <h3 class="mt-6">Step 2 — Sample the same prompts manually, across engines</h3>
      <p class="mt-3">
        A single automated check is a snapshot from one engine. Before you act on it, sample the same handful of prompts
        by hand in ChatGPT, Perplexity, and whatever else your buyers use — a fresh session each time, no personalization.
        This is the manual method described in
        <a href="/guides/ai-citations-check/">how to tell if ChatGPT and Perplexity are citing your brand</a>: open a
        clean session and ask the questions a buyer would ask. It's slower than the automated check, but it's the only
        way to see, first-hand, whether a gap on Perplexity is also a gap on ChatGPT — since nothing automated can confirm
        that for you yet (more on why in
        <a href="/chatgpt-citation-tracker/">ChatGPT citation tracking: what actually works</a>).
      </p>

      <h3 class="mt-6">Step 3 — Compare GEO-score readiness, not citations</h3>
      <p class="mt-3">
        Once you know <em>who's</em> cited instead of you, the next question is <em>why</em>. That's a structural
        question, not a citation question, and GeoReady answers it with a GEO score, not a citation count.
      </p>
      <blockquote class="mt-4 max-w-2xl border-l-2 border-pass-deep pl-4">
        <p class="text-sm italic leading-relaxed text-ink-soft">
          <strong>The GEO score measures readiness — not citations.</strong>
          <a href="/compare/">Compare two sites' scores</a> or
          <a href="/analyze-competitors/">benchmark several domains at once</a> and you'll see an 8-category readiness
          comparison: crawlability, schema, factual density, entity clarity, and the rest. A higher score means fewer
          blockers and stronger citable signals, which correlates with being cited — it is not a report of who was
          actually cited for a given prompt. To confirm that, go back to Step 1 or Step 2. Studio's "competitor
          comparison" line item runs this same GEO-score comparison, not a citation-based one — don't expect it to name
          which prompts a competitor is winning; that's a different tool.
        </p>
      </blockquote>

      <h3 class="mt-6">Step 4 — Decide whether the gap is worth tracking</h3>
      <p class="mt-3">
        A one-time gap is a data point. A recurring one is a trend worth watching — but only Studio and up have anything
        that watches automatically, and it's worth being precise about what that is:
      </p>
      <ul class="mt-3 space-y-3">
        <li><strong>Automated, scheduled tracking exists for Perplexity only</strong> — Studio's AI citation tracking runs
          5 automated checks per day against Perplexity. It is not a general "AI citation tracker" across every engine.</li>
        <li><strong>Share-of-voice over a tracked prompt set</strong> — Studio and up can also show, across a set of
          saved AI answer snapshots, whether a named competitor is mentioned more often than you. This is a trend across
          the prompts you've chosen to track, not a continuous scan of "every prompt where you lose to competitor X" — no
          such all-prompts dashboard exists.</li>
      </ul>
      <p class="mt-3">
        If ChatGPT specifically is the gap you care about, automated tracking isn't available for it on any plan — see
        <a href="/chatgpt-citation-tracker/">ChatGPT citation tracking: what actually works</a> for what Agency's
        manual-paste snapshot tracking does instead. See <a href="/pricing/">pricing</a> for exact plan details.
      </p>
    </section>

    <section class="mb-12 md:mb-16">
      <h2>What this workflow is not</h2>
      <ul class="mt-4 space-y-3">
        <li><strong>Not one feature.</strong> GeoReady doesn't have a single "citation gap analysis" product or report
          that runs Steps 1–4 for you automatically. It's four real capabilities, used in sequence.</li>
        <li><strong>Not a citation-based competitor dashboard.</strong> Studio's competitor comparison is GEO-score
          based. If a page tells you it shows "who's cited vs. your competitor" as a live dashboard, that page is
          describing something GeoReady doesn't build.</li>
        <li><strong>Not an all-prompts scan.</strong> Tracking (Step 4) works over prompts you've explicitly added to a
          tracked set — it does not continuously discover every query where a named competitor beats you.</li>
      </ul>
    </section>

    <section class="mb-12 md:mb-16">
      <h2>Which plan fits this workflow</h2>
      <div class="mt-6 overflow-x-auto rounded-[4px] border border-rail bg-white">
        <table class="w-full text-left text-sm">
          <thead class="bg-paper">
            <tr class="border-b border-rail">
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Job</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Plan</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">What it gives you here</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-rail">
            {PLAN_ROWS.map(([job, plan, gives]) => (
              <tr class="align-top">
                <th scope="row" class="px-4 py-3 text-left font-text font-semibold text-ink">{job}</th>
                <td class="whitespace-nowrap px-4 py-3 leading-relaxed text-ink-soft">{plan}</td>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{gives}</td>
              </tr>
            ))}
            <tr class="align-top">
              <th scope="row" class="px-4 py-3 text-left font-text font-semibold text-ink">Structured ChatGPT (and Google) snapshot history</th>
              <td class="whitespace-nowrap px-4 py-3 leading-relaxed text-ink-soft">Agency ($89/mo)</td>
              <td class="px-4 py-3 leading-relaxed text-ink-soft">
                Manual-paste answer snapshots with citation-quality scoring — see the
                <a href="/chatgpt-citation-tracker/">ChatGPT citation tracking page</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4">
        See <a href="/pricing/">pricing</a> for the full plan breakdown and current founding-price terms.
      </p>
    </section>

    <section class="mb-12 md:mb-16">
      <h2>A word on rank vs. citations</h2>
      <p class="mt-4">
        A citation gap is not the same measurement as a ranking gap. Your page can rank well on Google and still never
        get cited in an AI answer, because the two questions are different: does Google rank this page, versus does an AI
        assistant retrieve and cite it. That's also why this workflow doesn't route through traditional rank-tracking
        tools at any step — none of the four steps above measure position in a list of ten blue links, and none of them
        should. If a "citation gap" report you're evaluating elsewhere is really just a rank-tracking export with AI
        branding, it's answering a different question than the one this page walks through.
      </p>
    </section>

    <section class="mb-12 md:mb-16">
      <h2>FAQ</h2>
      <div class="mt-6 space-y-6">
        {faqs.map((faq) => (
          <div>
            <h3>{faq.q}</h3>
            <p class="mt-2">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="rounded-[4px] border border-rail bg-white p-6">
      <h2 class="font-head text-lg font-extrabold tracking-[-0.02em] text-ink">Start finding your gaps</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-soft">
        Run the free citation check first — no account, no card. If the structural diagnosis matters more right now, run
        the free GEO audit instead. Either way, nothing past this point requires a credit card or a sales conversation —
        the paid tiers only come into play once you've decided a gap is worth tracking (Step 4).
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/tools/ai-citation-checker/"
          class="inline-flex items-center gap-2 rounded-[4px] bg-pass-deep px-6 py-2.5 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-white no-underline transition-colors hover:bg-pass"
        >
          Run a citation check
        </a>
        <a
          href="/ai-seo-audit/"
          class="inline-flex items-center gap-2 rounded-[4px] border border-rail bg-white px-6 py-2.5 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-ink no-underline transition-colors hover:bg-paper"
        >
          Run the free GEO audit
        </a>
      </div>
    </section>
  </article>

  {/* Page-specific schema — WebPage referencing the sitewide Organization/WebSite entities (no standalone Offer/Product) */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": title,
    "description": description,
    "url": canonical,
    "author": { "@id": "https://geoready.dev/#organization" },
    "publisher": { "@id": "https://geoready.dev/#organization" },
    "datePublished": datePublished,
    "dateModified": dateModified,
    "isPartOf": { "@id": "https://geoready.dev/#website" }
  })} />
</Shell>
