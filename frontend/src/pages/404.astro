---
import Shell from '../components/Shell.astro';
---

<Shell
  title="404 — Page not found · GeoReady"
  description="The page you're looking for doesn't exist. Head back to geoready.dev to audit your site's AI visibility."
  canonical="https://geoready.dev/404/"
  robots="noindex, nofollow"
>
  <div class="bg-paper font-text text-ink">
    <div class="mx-auto flex min-h-[60vh] max-w-2xl flex-col justify-center px-4 py-20 sm:px-6">

      <p class="w-fit rounded-[6px] bg-fail-wash px-2 py-0.5 font-text text-[12.5px] font-semibold text-fail">
        404 · not found
      </p>

      <h1 class="mt-5 font-head text-3xl font-semibold leading-[1.05] tracking-[-0.03em] md:text-4xl">
        This page doesn't exist
      </h1>

      <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft">
        The URL might be wrong, the page may have moved, or it was never here.
        AI engines won't find it either — just like a site with no GEO signals.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-[10px] bg-pass-deep px-6 py-3 font-text text-[13px] font-semibold text-white transition-colors hover:bg-pass"
        >
          Back to home
        </a>
        <a
          href="/?audit=1#audit"
          class="inline-flex items-center justify-center rounded-[10px] border border-rail bg-white px-6 py-3 font-text text-[13px] font-semibold text-ink transition-colors hover:bg-pass-wash"
        >
          Audit your site
        </a>
      </div>

      <div class="mt-14 border-t border-rail pt-8">
        <p class="mb-5 font-text font-medium text-[12.5px] text-ink-mute">Useful links</p>
        <nav aria-label="404 helpful links" class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href="/pricing/" class="text-sm font-medium text-ink underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Pricing</a>
          <a href="/research/" class="text-sm font-medium text-ink underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Research</a>
          <a href="/roadmap/" class="text-sm font-medium text-ink underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Roadmap</a>
          <a href="/compare/" class="text-sm font-medium text-ink underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Compare</a>
          <a href="/manifesto/" class="text-sm font-medium text-ink underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Manifesto</a>
          <a href="https://github.com/Auriti-Labs/geo-optimizer-skill" target="_blank" rel="noopener" class="text-sm font-medium text-ink underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">GitHub</a>
        </nav>
      </div>

    </div>
  </div>
</Shell>
