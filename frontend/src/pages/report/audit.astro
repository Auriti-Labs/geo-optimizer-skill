---
import Shell from '../../components/Shell.astro';
import AuditReportContainer from '../../components/report/AuditReportContainer';

const url = Astro.url.searchParams.get('url') || '';
const title = url ? `GeoReady Audit Report — ${url}` : 'GeoReady Audit Report';
const description = 'View your GeoReady audit report with GEO scores, citability ratings, technical signals, and actionable AI search visibility recommendations.';
const canonical = 'https://geoready.dev/report/audit/';
const robots = 'noindex, nofollow';
---

<Shell title={title} description={description} canonical={canonical} robots={robots}>
  <header class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16 pb-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <h1 class="font-head text-4xl md:text-5xl font-extrabold leading-[1.02] tracking-[-0.03em] text-ink">
        GEO Audit Report
      </h1>
      <p class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">
        <span>GeoReady</span>
        <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true"></span>
        <span>Audit Report</span>
      </p>
    </div>

    <p class="mt-4 text-base text-ink-soft leading-relaxed max-w-2xl">
      Live audit results for the submitted URL. This report is generated on demand and is not indexed by search engines.
    </p>

    <p class="mt-2 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">Generated on demand · not indexed</p>
  </header>

  {/* min-h-svh reserves a viewport of space for the client-only island: the
      sections below start under the fold at first paint, so the report
      mounting (0px → full height) cannot shift any viewport-visible content. */}
  <div class="min-h-svh">
    <AuditReportContainer client:only="react" reportId={url} />
  </div>

  {/* Static next-step CTA — server-rendered, visible after the report */}
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-16 md:pb-24">
    <div class="overflow-hidden rounded-[4px] border border-rail bg-white">
      <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 border-b border-rail px-6 py-2.5 md:px-10">
        <p class="flex items-center gap-2 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">
          <span>GeoReady</span>
          <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true"></span>
          <span>Next step</span>
        </p>
        <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">schedule: weekly</span>
      </div>

      <div class="px-6 py-6 md:p-10">
        <h2 class="font-head text-2xl md:text-3xl font-extrabold tracking-[-0.02em] leading-tight text-ink">
          This is a snapshot. AI visibility changes as engines re-crawl.
        </h2>

        <p class="mt-4 max-w-2xl text-base text-ink-soft leading-relaxed">
          A one-off audit shows where the site stands today. GeoReady Pro re-runs the same
          checks on a weekly schedule, keeps a score history per category, and alerts you when
          a signal regresses — so a robots.txt change or a dropped llms.txt does not go unnoticed.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/pricing/"
            data-cta="report_to_pricing"
            class="inline-block rounded-[4px] bg-pass-deep px-6 py-2.5 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-pass"
          >
            See monitoring plans
          </a>
        </div>
      </div>
    </div>
  </section>
</Shell>
