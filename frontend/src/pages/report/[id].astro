---
import Shell from '../../components/Shell.astro';
import AuditReportContainer from '../../components/report/AuditReportContainer';

export function getStaticPaths() {
  return [
    { params: { id: 'demo' } },
    { params: { id: '100680ad546ce6a577f42f52df33b4cf' } },
  ];
}

const { id } = Astro.params;
const decodedId = id ? decodeURIComponent(id) : 'demo';

const isDemo = decodedId === 'demo';
const title = isDemo
  ? 'GeoReady Audit Report Demo'
  : 'GeoReady Audit Report';
const description = isDemo
  ? 'Preview a sample GeoReady audit report with GEO scores, citability ratings, technical signals, and actionable AI search visibility recommendations.'
  : 'View your GeoReady audit report with GEO scores, citability ratings, technical signals, and actionable AI search visibility recommendations.';
// Public demo report is a marketing page (static mock data, no user data) and
// should be indexable. Live token reports stay out of the index.
const canonical = isDemo
  ? 'https://geoready.dev/report/demo/'
  : `https://geoready.dev/report/${decodedId}`;
const robots = isDemo ? 'index, follow' : 'noindex, nofollow';
---

<Shell title={title} description={description} canonical={canonical} robots={robots}>
  <header class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 md:pt-16 pb-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <h1 class="font-head text-4xl md:text-5xl font-semibold leading-[1.02] tracking-[-0.03em] text-ink">
        {isDemo ? 'GEO Audit Report Demo' : 'GEO Audit Report'}
      </h1>
      <p class="flex items-center gap-2 font-text font-medium text-[12.5px] text-ink-mute">
        <span>GeoReady</span>
        <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true"></span>
        <span>{isDemo ? 'Demo Report' : 'Audit Report'}</span>
      </p>
    </div>

    <p class="mt-4 text-base text-ink-soft leading-relaxed max-w-2xl">
      {isDemo
        ? 'This is a preview of a GeoReady audit report. The demo shows how a complete report looks when you run an audit on a live website.'
        : 'Live audit results for the submitted URL. This report is generated on demand and is not indexed by search engines.'}
    </p>

    {isDemo && (
      <p class="mt-2 font-text font-medium text-[12.5px] text-ink-mute">Demo snapshot: May 2026</p>
    )}
  </header>

  {isDemo && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-6 max-w-2xl">
      <h2 class="font-text text-[12.5px] font-semibold text-ink-mute mb-3">
        What this demo report shows
      </h2>
      <ul class="space-y-2">
        <li class="text-sm text-ink-soft flex items-start gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-mute mt-1.5 shrink-0" aria-hidden="true" />
          GEO Score by signal category (this May 2026 demo snapshot uses the earlier eight-category v1 rubric; current audits use nine categories)
        </li>
        <li class="text-sm text-ink-soft flex items-start gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-mute mt-1.5 shrink-0" aria-hidden="true" />
          Citability Score (47-method suite)
        </li>
        <li class="text-sm text-ink-soft flex items-start gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-mute mt-1.5 shrink-0" aria-hidden="true" />
          Category breakdown with actionable recommendations
        </li>
        <li class="text-sm text-ink-soft flex items-start gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-mute mt-1.5 shrink-0" aria-hidden="true" />
          Technical signal readiness (pass / warn / fail)
        </li>
        <li class="text-sm text-ink-soft flex items-start gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-ink-mute mt-1.5 shrink-0" aria-hidden="true" />
          Prioritized recommendations and export actions
        </li>
      </ul>
    </section>
  )}

  {/* min-h-svh reserves a viewport of space for the report island: the
      sections below start under the fold at first paint, so the async
      report growth (loading strip → full height) cannot shift any
      viewport-visible content. */}
  <div class="min-h-svh">
    <AuditReportContainer client:load reportId={decodedId} />
  </div>
</Shell>
