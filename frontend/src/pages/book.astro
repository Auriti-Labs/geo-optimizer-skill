---
import Shell from '../components/Shell.astro';
import { BOOK, amazonUrl } from '../lib/bookData';

const kindleUrl = amazonUrl('kindle', 'book-page');
const paperbackUrl = amazonUrl('paperback', 'book-page');

/** The measurable pipeline the book is organised around. */
const pipeline = [
  { step: 'Discovery', desc: 'How answer engines find a URL exists at all.' },
  { step: 'Crawling', desc: 'Crawler access, robots controls, and what actually gets fetched.' },
  { step: 'Machine understanding', desc: 'Rendering, structured data, semantic HTML, entity signals.' },
  { step: 'Retrieval', desc: 'Which passages get selected as candidate sources.' },
  { step: 'Answer generation', desc: 'How content is used once it reaches the model.' },
  { step: 'Citation', desc: 'Whether the source is named, and how to measure it over time.' },
  { step: 'Interaction', desc: 'Machine-readable interfaces and agent-driven navigation.' },
  { step: 'Action', desc: 'Preparing sites for agents that do things, not just read.' },
];

/** Verbatim scope from the book's own description — no invented claims. */
const covers = [
  'How modern AI answer engines discover and use web content',
  'Telling documented behaviour apart from research findings, observation, inference, and product-specific scoring',
  'Auditing crawler access, robots controls, rendering, structured data, semantic HTML, and entity signals',
  'Engineering content for extraction and citation without relying on arbitrary "AI-friendly" formulas',
  'Designing prompt research frameworks for measuring real AI visibility',
  'Tracking citations, source usage, answer presence, and visibility over time',
  'Building operational GEO workflows for teams, agencies, and technical SEO programmes',
  'Evaluating llms.txt, schema markup, and crawler directives without overstating what they can do',
  'Preparing websites for AI agents, machine interaction, and action-oriented interfaces',
  'Managing prompt injection, content integrity, and agent-related security risks',
];

const audience = [
  'Developers',
  'Technical SEOs',
  'Consultants',
  'Agencies',
  'Product teams',
  'Site owners',
];
---

<Shell
  title="AI Search Engineering — GEO Book by GEO Optimizer's Author"
  description="Buy AI Search Engineering — the 992-page GEO book by GEO Optimizer's author. Technical guide to AI citations and agent-ready sites. Paperback & Kindle on Amazon."
  canonical="https://geoready.dev/book/"
>
  <div class="bg-paper font-text text-ink">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-16">

      <header class="mb-14 md:mb-20">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <p class="font-text font-medium text-[12.5px] text-ink-mute">GeoReady · Book</p>
          <p class="font-mono text-[11px] text-ink-mute">ISBN {BOOK.isbnFormatted}</p>
        </div>

        <h1 class="mt-3 font-head text-4xl font-semibold leading-[1.05] tracking-[-0.03em] md:text-5xl">
          {BOOK.title}
        </h1>
        <p class="mt-4 max-w-3xl font-head text-lg font-semibold leading-snug text-ink-soft md:text-xl">
          {BOOK.subtitle}
        </p>

        <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
          A technical, evidence-first guide to Generative Engine Optimization. Instead of treating
          GEO as a collection of tricks, the book presents it as an engineering discipline built
          around a measurable pipeline — the same methodology the open-source
          <a href="https://github.com/Auriti-Labs/geo-optimizer-skill" target="_blank" rel="noopener"
             class="font-medium text-pass-deep underline decoration-pass/40 underline-offset-4 hover:decoration-pass-deep">GEO Optimizer</a>
          audit engine implements.
        </p>

        <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-3 border-t border-rail pt-5 font-text font-medium text-[12.5px] text-ink-mute">
          <div><dt class="inline">Author </dt><dd class="inline text-ink">{BOOK.author}</dd></div>
          <div><dt class="inline">Pages </dt><dd class="inline text-ink">{BOOK.numberOfPages}</dd></div>
          <div><dt class="inline">Language </dt><dd class="inline text-ink">English</dd></div>
          <div><dt class="inline">Published </dt><dd class="inline text-ink">10 September 2026</dd></div>
        </dl>

        <div class="mt-8 flex flex-wrap gap-3" data-book-links>
          <a
            href={paperbackUrl}
            target="_blank"
            rel="noopener"
            data-book-format="paperback"
            class="inline-flex items-center gap-2 rounded-[6px] bg-pass-deep px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-ink"
          >
            Paperback on Amazon
          </a>
          <a
            href={kindleUrl}
            target="_blank"
            rel="noopener"
            data-book-format="kindle"
            class="inline-flex items-center gap-2 rounded-[6px] border border-rail bg-white px-5 py-3 text-sm font-semibold text-ink transition-colors hover:border-ink"
          >
            Kindle edition
          </a>
        </div>
        <p class="mt-3 text-sm">
          <a href="/geo-readiness-manual/" data-cta="book_hero_free_manual" class="font-medium text-pass-deep underline decoration-pass/40 underline-offset-4 hover:decoration-pass-deep">
            Not ready to buy? Start free with the 160-page GEO Readiness Manual.
          </a>
        </p>
      </header>

      <div class="space-y-14">

        {/* The pipeline */}
        <section>
          <h2 class="mb-2 font-head text-2xl font-semibold tracking-[-0.02em] md:text-3xl">
            The pipeline the book is built around
          </h2>
          <p class="mb-6 max-w-2xl text-sm leading-relaxed text-ink-soft">
            Every chapter attaches to one stage of the path a page travels before it can be cited.
            Naming the stages is what makes GEO measurable instead of anecdotal.
          </p>
          <ol class="grid grid-cols-1 gap-px overflow-hidden rounded-[10px] border border-rail bg-rail md:grid-cols-2">
            {pipeline.map((p, i) => (
              <li class="bg-white p-5">
                <div class="flex items-baseline gap-3">
                  <span class="font-mono text-[11px] text-ink-mute">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="text-[15px] font-semibold text-ink">{p.step}</h3>
                </div>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{p.desc}</p>
              </li>
            ))}
          </ol>
        </section>

        {/* What it covers */}
        <section>
          <h2 class="mb-6 font-head text-2xl font-semibold tracking-[-0.02em] md:text-3xl">What it covers</h2>
          <ul class="grid gap-x-10 gap-y-0 md:grid-cols-2">
            {covers.map((c) => (
              <li class="border-t border-rail py-4 text-sm leading-relaxed text-ink-soft">{c}</li>
            ))}
          </ul>
          <p class="mt-6 max-w-2xl text-sm leading-relaxed text-ink-soft">
            The appendices cover GEO audits, AI crawlers, JSON-LD templates, prompt research,
            citation tracking, evidence classification, CI/CD checks, client reporting, terminology,
            and technical references.
          </p>
        </section>

        {/* Who it is for */}
        <section>
          <h2 class="mb-6 font-head text-2xl font-semibold tracking-[-0.02em] md:text-3xl">Who it is for</h2>
          <ul class="flex flex-wrap gap-2">
            {audience.map((a) => (
              <li class="rounded-[6px] border border-rail bg-white px-3 py-1.5 font-text font-medium text-[12.5px] text-ink-soft">
                {a}
              </li>
            ))}
          </ul>
          <p class="mt-6 max-w-2xl text-sm leading-relaxed text-ink-soft">
            Written for people who want to understand what can actually be measured, implemented,
            and defended in AI search. No guarantees, no invented ranking factors, no hype presented
            as fact — the same standard the audit engine holds itself to.
          </p>
        </section>

        {/* Relation to the tool */}
        <section class="rounded-[10px] border border-rail bg-white p-6 md:p-8">
          <h2 class="font-head text-xl font-semibold tracking-[-0.02em]">Book and tool, same methodology</h2>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft">
            The book explains the reasoning; GEO Optimizer runs it. The scoring weights, the eight
            signal categories, and the evidence classification described in print are the ones
            implemented in the MIT-licensed engine — you can read the rules and disagree with them.
          </p>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
            <a href="/methodology/" class="text-sm font-medium text-pass-deep underline decoration-pass/40 underline-offset-4 hover:decoration-pass-deep">
              How the scoring works
            </a>
            <a href="/research/" class="text-sm font-medium text-pass-deep underline decoration-pass/40 underline-offset-4 hover:decoration-pass-deep">
              The research behind it
            </a>
            <a href="/" class="text-sm font-medium text-pass-deep underline decoration-pass/40 underline-offset-4 hover:decoration-pass-deep">
              Run a free audit
            </a>
          </div>
        </section>

      </div>
    </div>
  </div>

  {/* Outbound click tracking. Counts people leaving for the store, not sales:
      sales attribution needs an Amazon Associates / Attribution id (bookData.ts). */}
  <script>
    import { trackBookLinkClicked } from '../lib/geo_track.ts';

    document.querySelectorAll('[data-book-links] a[data-book-format]').forEach((el) => {
      el.addEventListener('click', () => {
        const format = el.getAttribute('data-book-format');
        if (format === 'kindle' || format === 'paperback') {
          trackBookLinkClicked({ surface: 'book-page', format });
        }
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Book",
        "@id": "https://geoready.dev/book/#book",
        "name": BOOK.title,
        "alternateName": `${BOOK.title}: ${BOOK.subtitle}`,
        "description": "A technical, evidence-first guide to Generative Engine Optimization (GEO), AI citations, machine-readable websites, and the agent-ready web. Presents GEO as an engineering discipline built around a measurable pipeline: discovery, crawling, machine understanding, retrieval, answer generation, citation, interaction, and action.",
        "url": "https://geoready.dev/book/",
        "isbn": BOOK.isbn,
        "numberOfPages": BOOK.numberOfPages,
        "inLanguage": BOOK.inLanguage,
        "datePublished": BOOK.datePublished,
        "bookFormat": "https://schema.org/Paperback",
        "author": { "@id": "https://geoready.dev/#founder" },
        "about": [
          "Generative Engine Optimization",
          "Answer Engine Optimization",
          "AI search visibility",
          "Structured data",
          "Technical SEO"
        ],
        "workExample": [
          {
            "@type": "Book",
            "bookFormat": "https://schema.org/Paperback",
            "isbn": BOOK.isbn,
            "numberOfPages": BOOK.numberOfPages,
            "inLanguage": BOOK.inLanguage,
            "url": `https://${BOOK.amazonHost}/dp/${BOOK.asinPaperback}`
          },
          {
            "@type": "Book",
            "bookFormat": "https://schema.org/EBook",
            "inLanguage": BOOK.inLanguage,
            "url": `https://${BOOK.amazonHost}/dp/${BOOK.asinKindle}`
          }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://geoready.dev/" },
          { "@type": "ListItem", "position": 2, "name": BOOK.title, "item": "https://geoready.dev/book/" }
        ]
      }
    ]
  })} />
</Shell>
