---
import Shell from '../components/Shell.astro';
import { BOOK, BOOK_PAGE } from '../lib/bookData';

// Link e riferimenti usati in più punti della pagina: definiti una volta sola.
const REPO = 'https://github.com/Auriti-Labs/geo-optimizer-skill';
const ISSUES = `${REPO}/issues`;
const WEIGHTS = `${REPO}/blob/main/src/geo_optimizer/models/config.py`;
const EMAIL = 'info@geoready.dev';

// Data di pubblicazione leggibile, calcolata da bookData (fonte unica).
const bookDate = new Date(`${BOOK.datePublished}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

// Classe link inline condivisa: teal + sottolineatura hairline.
const link = 'text-pass-deep underline decoration-current/50 underline-offset-4 transition-colors hover:decoration-pass-deep';

// Carta d'identità dell'hero: righe label/valore stile dashboard.
const identity = [
  { label: 'Maintainer', value: 'Juan Camilo Auriti', href: 'https://x.com/JuanAuriti' },
  { label: 'Based in', value: 'Italy' },
  { label: 'Engine', value: 'GEO Optimizer, MIT', href: REPO },
  { label: 'Book', value: `${BOOK.title}, ${BOOK.numberOfPages} pp`, href: BOOK_PAGE },
  { label: 'Contact', value: EMAIL, href: `mailto:${EMAIL}` },
];

// Base di ricerca: solo identificativi arXiv verificati.
const research = [
  {
    id: '2311.09735',
    title: 'GEO: Generative Engine Optimization',
    venue: 'Princeton, KDD 2024',
  },
  {
    id: '2510.11438',
    title: 'AutoGEO, which builds on the Princeton study',
    venue: 'arXiv preprint',
  },
];
---

<Shell
  title="GeoReady | About the maintainer, the engine and the book"
  description="GeoReady is built by Juan Camilo Auriti, maintainer of the MIT-licensed GEO Optimizer engine and author of AI Search Engineering. How to reach him."
  canonical="https://geoready.dev/about/"
>
  <div class="bg-paper font-text text-ink">

    {/* Hero asimmetrico: claim a sinistra, carta d'identità a destra */}
    <section class="mx-auto max-w-7xl px-5 pt-12 pb-14 sm:px-6 md:pt-20 md:pb-20">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_400px] lg:items-end lg:gap-16">
        <div>
          <p class="eyebrow">About · GeoReady</p>
          <h1 class="mt-4 max-w-2xl font-head text-[2.4rem] font-semibold leading-[1.04] tracking-[-0.035em] md:text-6xl">
            One maintainer, a public <em>engine</em>, and a book.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">
            GeoReady is built independently in Italy by Juan Camilo Auriti. The audit engine it runs is
            open source, and the method behind it is written down in full.
          </p>
        </div>

        <aside class="panel overflow-hidden" aria-labelledby="identity-heading">
          <div class="flex items-center justify-between border-b border-rail px-5 py-3">
            <h2 id="identity-heading" class="eyebrow">Who builds it</h2>
            <span class="font-mono text-[11px] text-ink-mute">#founder</span>
          </div>
          <dl class="divide-y divide-rail">
            {identity.map((row) => (
              <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-3 px-5 py-3 text-[13px]">
                <dt class="font-mono text-ink-mute">{row.label}</dt>
                <dd class="min-w-0 break-words font-mono text-ink">
                  {row.href ? (
                    <a
                      href={row.href}
                      class="underline decoration-current/40 underline-offset-4 hover:text-pass-deep"
                      {...(row.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                    >{row.value}</a>
                  ) : row.value}
                </dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    {/* Cosa ho costruito: due pannelli, motore e app */}
    <section class="border-t border-rail bg-white">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-20">
        <p class="eyebrow">What I built</p>
        <h2 class="mt-3 max-w-2xl font-head text-3xl font-semibold tracking-[-0.03em] md:text-4xl">
          An engine you can run yourself, and an app that runs it for you.
        </h2>

        <div class="mt-10 grid gap-5 md:grid-cols-2" data-reveal="stagger">
          <article class="panel flex min-w-0 flex-col p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-[17px] font-semibold">GEO Optimizer</h3>
              <span class="font-mono text-[12px] text-ink-mute">MIT · Python · PyPI</span>
            </div>
            <p class="mt-3 leading-relaxed text-ink-soft">
              The open-source audit engine. It measures how ready a site is for AI search across
              <span class="font-mono tabular-nums">9</span> scoring categories, with
              <span class="font-mono tabular-nums">16</span> CLI commands to audit, fix and monitor. The weights are
              published in <a href={WEIGHTS} class={link} target="_blank" rel="noopener">models/config.py</a>.
            </p>
            <pre class="mt-5 overflow-x-auto rounded-[9px] bg-well px-4 py-3 font-mono text-[13px] leading-relaxed text-well-ink"><code><span class="select-none text-well-mute">$ </span>pip install geo-optimizer-skill
<span class="select-none text-well-mute">$ </span>geo audit --url https://example.com</code></pre>
            <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5 text-[13px] font-medium">
              <a href={REPO} class={link} target="_blank" rel="noopener">Source on GitHub</a>
              <a href="https://pypi.org/project/geo-optimizer-skill/" class={link} target="_blank" rel="noopener">PyPI</a>
              <a href="/docs/" class={link}>Docs</a>
            </div>
          </article>

          <article class="panel flex min-w-0 flex-col p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="text-[17px] font-semibold">GeoReady</h3>
              <span class="font-mono text-[12px] text-ink-mute">app.geoready.dev</span>
            </div>
            <p class="mt-3 leading-relaxed text-ink-soft">
              The hosted app built on the same engine. It runs the audit on a schedule, keeps the score
              history, and alerts you when a change drops a site's score. It is built for agencies, SEO
              freelancers and developers who look after more than one site.
            </p>
            <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-5 text-[13px] font-medium">
              <a href="https://app.geoready.dev" class={link} target="_blank" rel="noopener">Open the app</a>
              <a href="/pricing/" class={link}>Plans</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    {/* Perché open: testo in prima persona */}
    <section class="border-t border-rail">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 sm:px-6 md:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16" data-reveal>
        <div>
          <p class="eyebrow">Why open</p>
          <h2 class="mt-3 font-head text-3xl font-semibold tracking-[-0.03em] md:text-4xl">A score you can check.</h2>
        </div>
        <div class="max-w-2xl space-y-4 text-[17px] leading-relaxed text-ink-soft">
          <p>
            The problem I set out to fix is the black-box score: a number between 0 and 100 with no way to
            see how it was reached, so no way to tell whether a fix moved it for a real reason. A tool that
            criticises that cannot work the same way.
          </p>
          <p>
            So the scoring is public. Every check, every weight and every band is in the repository, and
            you can run the same audit on your own machine and get the same number. If you think a weight
            is wrong, open an issue and argue it in the open.
          </p>
          <blockquote class="border-l-2 border-pass-deep py-1 pl-5">
            <p class="font-serif text-2xl italic leading-snug text-ink md:text-[1.7rem]">
              AI visibility infrastructure should be auditable by anyone, not locked behind proprietary black boxes.
            </p>
            <footer class="mt-2 text-sm text-ink-mute">— <cite class="not-italic">Juan Camilo Auriti, maintainer</cite></footer>
          </blockquote>
          <p class="flex flex-wrap gap-x-5 gap-y-2 pt-1 text-[15px] font-medium">
            <a href="/methodology/" class={link}>Read the methodology</a>
            <a href="/transparent-geo-tool/" class={link}>What "transparent" means here</a>
          </p>
        </div>
      </div>
    </section>

    {/* Base di ricerca: due righe con ID arXiv */}
    <section class="border-t border-rail bg-white">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-20">
        <p class="eyebrow">Research basis</p>
        <h2 class="mt-3 max-w-2xl font-head text-3xl font-semibold tracking-[-0.03em] md:text-4xl">
          The papers the rubric starts from.
        </h2>

        <div class="panel mt-10 overflow-hidden" data-reveal>
          <ul class="divide-y divide-rail">
            {research.map((paper) => (
              <li class="grid gap-1 px-5 py-4 sm:grid-cols-[160px_minmax(0,1fr)_auto] sm:items-baseline sm:gap-6">
                <a
                  href={`https://arxiv.org/abs/${paper.id}`}
                  class="font-mono text-[13px] tabular-nums text-pass-deep hover:underline"
                  target="_blank"
                  rel="noopener"
                >arXiv:{paper.id}</a>
                <span class="font-medium text-ink">{paper.title}</span>
                <span class="font-mono text-[12px] text-ink-mute">{paper.venue}</span>
              </li>
            ))}
          </ul>
        </div>
        <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-ink-soft">
          Where a check goes beyond these papers, the reasoning is documented on the
          <a href="/research/" class={link}>research page</a>.
        </p>
      </div>
    </section>

    {/* Il libro: banda scura */}
    <section class="band-dark">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-6 md:py-20 lg:grid-cols-[minmax(0,1fr)_400px] lg:items-center lg:gap-16" data-reveal>
        <div>
          <p class="eyebrow">The book</p>
          <h2 class="mt-3 max-w-xl font-head text-3xl font-semibold tracking-[-0.03em] md:text-4xl">
            The method, written down.
          </h2>
          <p class="mt-5 max-w-xl text-[17px] leading-relaxed text-ink-soft">
            <a href={BOOK_PAGE} class={link}>{BOOK.title}</a> is the long version of what the engine
            checks: a technical guide to Generative Engine Optimization, AI citations and agent-ready
            websites. The book explains the
            reasoning; the engine runs it.
          </p>
          <a
            href={BOOK_PAGE}
            class="mt-7 inline-flex items-center gap-2 rounded-[9px] bg-pass-light px-4 py-2.5 text-sm font-semibold text-[#090C0C] transition-opacity hover:opacity-90"
          >
            About the book
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        </div>

        <dl class="panel divide-y divide-rail font-mono text-[13px]">
          <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-3 px-5 py-3">
            <dt class="text-ink-mute">Author</dt>
            <dd class="text-ink">{BOOK.author}</dd>
          </div>
          <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-3 px-5 py-3">
            <dt class="text-ink-mute">Pages</dt>
            <dd class="tabular-nums text-ink">{BOOK.numberOfPages}</dd>
          </div>
          <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-3 px-5 py-3">
            <dt class="text-ink-mute">Published</dt>
            <dd class="tabular-nums text-ink"><time datetime={BOOK.datePublished}>{bookDate}</time></dd>
          </div>
          <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-3 px-5 py-3">
            <dt class="text-ink-mute">ISBN</dt>
            <dd class="tabular-nums text-ink">{BOOK.isbnFormatted}</dd>
          </div>
          <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-3 px-5 py-3">
            <dt class="text-ink-mute">Formats</dt>
            <dd class="text-ink">Paperback, Kindle</dd>
          </div>
        </dl>
      </div>
    </section>

    {/* Contatti */}
    <section>
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 md:py-20" data-reveal>
        <p class="eyebrow">Contact</p>
        <h2 class="mt-3 max-w-2xl font-head text-3xl font-semibold tracking-[-0.03em] md:text-4xl">
          Write to the person who builds it.
        </h2>
        <div class="panel mt-10 grid divide-y divide-rail md:grid-cols-2 md:divide-x md:divide-y-0">
          <div class="p-6">
            <p class="eyebrow">Email</p>
            <a href={`mailto:${EMAIL}`} class={`mt-2 inline-block font-mono text-[15px] ${link}`}>{EMAIL}</a>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">Questions about the app, plans, agencies, or the book.</p>
          </div>
          <div class="p-6">
            <p class="eyebrow">Bugs and feature requests</p>
            <a href={ISSUES} class={`mt-2 inline-block font-mono text-[15px] ${link}`} target="_blank" rel="noopener">GitHub Issues</a>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">Anything about the engine, a check or a weight.</p>
          </div>
        </div>
        <p class="mt-5 text-[15px] text-ink-soft">
          You'll get a reply from the person who builds it. Also on
          <a href="https://x.com/JuanAuriti" class={link} target="_blank" rel="noopener">X</a> and
          <a href="https://github.com/Auriti-Labs" class={link} target="_blank" rel="noopener">GitHub</a>.
        </p>
      </div>
    </section>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About GeoReady",
    "url": "https://geoready.dev/about/",
    "description": "GeoReady is built by Juan Camilo Auriti, maintainer of the MIT-licensed GEO Optimizer engine and author of AI Search Engineering. How to reach him.",
    // Same @id as the full Book node on /book/, so consumers merge the two
    // instead of seeing two books. ISBN and page count are declared once, there.
    "mentions": {
      "@type": "Book",
      "@id": "https://geoready.dev/book/#book",
      "name": BOOK.title,
      "url": "https://geoready.dev/book/",
      "author": { "@id": "https://geoready.dev/#founder" }
    },
    "author": { "@id": "https://geoready.dev/#founder" },
    "publisher": { "@id": "https://geoready.dev/#organization" },
    "mainEntity": {
      "@type": "Organization",
      "name": "GeoReady",
      "url": "https://geoready.dev/",
      "description": "GeoReady and GEO Optimizer are built by Juan Camilo Auriti: open-source tools for AI search visibility and Generative Engine Optimization.",
      "foundingDate": "2024",
      "foundingLocation": {
        "@type": "Country",
        "name": "Italy"
      },
      "areaServed": "Worldwide",
      "sameAs": [
        "https://github.com/Auriti-Labs",
        "https://pypi.org/project/geo-optimizer-skill/"
      ],
      // Stesso jobTitle del nodo Person in Layout.astro: le due dichiarazioni
      // dello stesso @id non devono divergere.
      "founder": {
        "@type": "Person",
        "@id": "https://geoready.dev/#founder",
        "name": "Juan Camilo Auriti",
        "jobTitle": "Founder",
        "description": "Builds open-source tools for AI search visibility. Maintains GEO Optimizer, the MIT-licensed audit engine behind GeoReady.",
        "url": "https://x.com/JuanAuriti",
        "sameAs": [
          "https://github.com/Auriti-Labs",
          "https://x.com/JuanAuriti",
          "https://www.linkedin.com/in/juancamiloauriti/",
          "https://youtube.com/@georeadydev"
        ]
      }
    }
  })} />
</Shell>
