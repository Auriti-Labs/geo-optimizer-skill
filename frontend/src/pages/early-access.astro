---
import Shell from '../components/Shell.astro';
import WaitlistForm from '../components/WaitlistForm';
import SurveyForm from '../components/SurveyForm';
---

<Shell
  title="Founding Access — GeoReady"
  description="GeoReady founding access is now open. Run a free audit, create an account, or start with Pro for full nine-category reports, monitoring, and alerts."
  canonical="https://geoready.dev/early-access/"
>
  <div class="bg-paper font-text text-ink">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-16">
      <header class="mb-10">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h1 class="font-head text-4xl font-semibold leading-[1.05] tracking-[-0.03em] md:text-5xl">
            Founding access is open
          </h1>
          <p class="font-text font-medium text-[12.5px] text-ink-mute">GeoReady · Founding Access</p>
        </div>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-soft">
          Run a free audit now, or create an account to track your domain over time. Pro plan starts at $19/month.
        </p>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://geoready.dev"
            data-cta="early_access_free_audit"
            class="inline-flex items-center justify-center rounded-[10px] bg-pass-deep px-5 py-2.5 font-text text-[13px] font-semibold text-white transition-colors hover:bg-pass"
          >
            Run a free audit
          </a>
          <a
            href="https://app.geoready.dev/signup"
            data-cta="early_access_signup"
            class="inline-flex items-center justify-center rounded-[10px] border border-rail bg-white px-5 py-2.5 font-text text-[13px] font-semibold text-ink transition-colors hover:bg-pass-wash"
          >
            Create free account
          </a>
          <p class="mt-2 text-center text-xs text-ink-mute">
            app.geoready.dev — the GeoReady monitoring platform built on GEO Optimizer
          </p>
          <a
            href="https://app.geoready.dev/pricing"
            data-cta="early_access_see_pricing"
            class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 text-sm font-medium text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep"
          >
            See pricing
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
          </a>
        </div>
      </header>

      {/* Real dashboard screenshot — the platform being sold, not a mockup */}
      <figure class="mb-12 overflow-hidden rounded-[10px] border border-rail bg-white">
        <img
          src="/assets/screenshots/app-dashboard.webp"
          alt="GeoReady dashboard: GEO score 88, score trend across saved audits, signals passing 16 of 18"
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
          class="h-auto w-full"
        />
        <figcaption class="border-t border-rail px-5 py-3 text-xs text-ink-mute">
          The live GeoReady dashboard — real screenshot, no mockup.
        </figcaption>
      </figure>

      <div class="grid gap-10 md:grid-cols-2 md:gap-16">
        <div>
          <h2 class="mb-5 font-head text-xl font-semibold tracking-[-0.02em] md:text-2xl">What Pro includes</h2>
          <ul class="space-y-4 text-sm text-ink-soft">
            <li class="flex items-start gap-3">
              <span class="mt-0.5 h-4 w-4 shrink-0 text-pass-deep">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span><strong class="font-semibold text-ink">Unlimited audits</strong> — the full nine-category report stays free; Pro removes the daily limit</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 h-4 w-4 shrink-0 text-pass-deep">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>
                <strong class="font-semibold text-ink">Weekly AI search monitoring</strong>
                <span class="ml-2 rounded-[6px] bg-pass-wash px-1.5 py-0.5 font-text text-[12px] font-semibold text-pass-deep">Founding access</span>
                — track score changes over time per domain
              </span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 h-4 w-4 shrink-0 text-pass-deep">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span><strong class="font-semibold text-ink">Score history and audit log</strong> — see how your GEO score evolves after changes</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 h-4 w-4 shrink-0 text-pass-deep">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span><strong class="font-semibold text-ink">Regression alerts</strong> — email notifications when your score drops</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 h-4 w-4 shrink-0 text-pass-deep">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span><strong class="font-semibold text-ink">PDF report export</strong> — for client deliverables and documentation</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-0.5 h-4 w-4 shrink-0 text-pass-deep">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>
                <strong class="font-semibold text-ink">API access</strong>
                <span class="ml-2 rounded-[6px] border border-rail px-1.5 py-0.5 font-text text-[12px] font-semibold text-ink-mute">Beta</span>
                — integrate GEO audits in your own tools and workflows
              </span>
            </li>
          </ul>

          <div class="mt-8 rounded-[10px] border border-rail bg-white p-4">
            <p class="text-sm leading-relaxed text-ink-soft">
              The CLI and the free web audit remain MIT-licensed and free. Pro adds continuity and
              professional tools — it does not replace the open-source toolkit.
            </p>
          </div>
        </div>

        <div>
          <h2 class="mb-5 font-head text-xl font-semibold tracking-[-0.02em] md:text-2xl">Get product updates</h2>
          <WaitlistForm client:load />
          <p class="mt-3 text-xs leading-relaxed text-ink-mute">
            Get notified about new features and GEO research. No spam.
          </p>
          <p class="mt-3 text-xs leading-relaxed text-ink-mute">
            Payments are processed by Stripe, Inc. Your account session is stored in browser local storage. We don't use tracking cookies.
          </p>
        </div>
      </div>

      <div class="mt-16 max-w-xl border-t border-rail pt-12">
        <div class="mb-6">
          <h2 class="mb-2 font-head text-xl font-semibold tracking-[-0.02em] md:text-2xl">
            Quick survey — 4 questions
          </h2>
          <p class="text-sm leading-relaxed text-ink-soft">
            No email required. Anonymous answers help us build the right features first.
          </p>
        </div>
        <SurveyForm client:load />
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Founding Access — GeoReady",
    "description": "GeoReady founding access is now open. Full GEO reports, AI search monitoring, score history, and alerts.",
    "url": "https://geoready.dev/early-access/",
    "isPartOf": {
      "@type": "WebSite",
      "name": "GeoReady",
      "url": "https://geoready.dev"
    }
  })} />
</Shell>
