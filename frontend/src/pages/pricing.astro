    if (reportClaim) {
      document.querySelectorAll<HTMLAnchorElement>('a[href^="https://app.geoready.dev/signup"]').forEach((link) => {
        const url = new URL(link.href);
        url.searchParams.set('claim', reportClaim);
        url.searchParams.set('claim_source', claimSource);
        url.searchParams.set('onboarding', 'claim_report');
        link.href = url.toString();
      });
