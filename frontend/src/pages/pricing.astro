---
import Shell from '../components/Shell.astro';
import PricingObjectionSurvey from '../components/PricingObjectionSurvey';
import FoundingSeatsStatus from '../components/FoundingSeatsStatus';

const selfServePlans = [
  {
    id: 'free',
    name: 'Free',
    price: '$0',
    period: 'forever',
    status: 'Available now',
    statusStyle: 'bg-pass-wash text-pass-deep',
    description: 'Single-URL audit with a full GEO score and the complete 9-category breakdown. No account required.',
    cta: 'Start free audit',
    ctaHref: '/',
    ctaStyle: 'border border-rail bg-white text-ink hover:bg-pass-wash',
    recommended: false,
    cadence: 'run: on demand · 5/day',
    features: [
      '5 audits per day',
      '1 AI answer check per week with a free account (Perplexity)',
      'GEO score 0-100',
      'Full 9-category GEO report',
      'Actionable recommendations',
      'CLI (MIT, unlimited)',
    ],
  },
  {
    id: 'pro',
    name: 'Pro',
    price: '$19',
    period: '/month',
    status: 'Founding price, then $29/month',
    statusStyle: 'bg-pass-wash text-pass-deep',
    description: 'Weekly monitoring for up to 10 domains, score history, regression alerts, PDF export, and API access. For developers and consultants managing a few sites.',
    cta: 'Start with Pro',
    ctaHref: 'https://app.geoready.dev/signup?plan=pro&intent=monitoring&onboarding=first_domain&utm_source=pricing&utm_medium=plan_card&utm_campaign=pricing_to_paid&utm_content=pro_card',
    ctaStyle: 'bg-pass-deep text-white hover:bg-pass',
    recommended: true,
    cadence: 'schedule: weekly · 10 domains',
    features: [
      'Unlimited audits',
      '10 domains, weekly monitoring',
      '30-audit score history',
      'Regression alerts by email (when your score drops by 5 points or more)',
      'PDF export',
      'API access (Bearer token)',
    ],
  },
];

const scalePlans = [
  {
    id: 'agency',
    name: 'Agency',
    price: '$89',
    period: '/month',
    status: 'Founding price, then $199/month',
    statusStyle: 'bg-pass-wash text-pass-deep',
    description: 'Team workspace, 50-domain daily portfolio monitoring, AI answer snapshots, and unlimited batch audits.',
    cta: 'Start with Agency',
    ctaHref: 'https://app.geoready.dev/signup?plan=agency&intent=portfolio&onboarding=first_domain&utm_source=pricing&utm_medium=plan_card&utm_campaign=pricing_to_paid&utm_content=agency_card',
    cadence: 'schedule: daily · 50 domains',
    features: [
      'Everything in Pro',
      '50 domains, daily monitoring',
      'Unbranded PDF export (removes GeoReady footer and badge)',
      'Competitor comparison',
      '24-month score history',
      'Team workspace (owner / editor / viewer)',
      'Unlimited batch audits',
      'AI answer snapshots (Perplexity automated; ChatGPT and Google via manual paste)',
      'Citation quality scoring',
    ],
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    price: 'Custom',
    period: '',
    status: 'Talk to us',
    statusStyle: 'border border-rail text-ink-mute',
    description: 'SLA, dedicated account manager, on-premise deployment, hourly monitoring, and custom integrations.',
    // No sales team today — honest label + direct email to the maintainer
    // (address already public on the privacy policy page).
    cta: 'Contact us',
    ctaHref: 'mailto:juancamilo.auriti@gmail.com?subject=GeoReady%20Enterprise',
    cadence: 'schedule: hourly · unlimited',
    features: [
      'Everything in Agency',
      'Unlimited domains',
      'Hourly monitoring',
      'SLA',
      'On-premise deployment',
      'Webhooks / Slack / CMS integrations',
      'Dedicated account manager',
      'Custom onboarding',
    ],
  },
];

const planChoiceRows = [
  {
    intent: 'I need one current GEO score before I change anything.',
    plan: 'Free audit',
    reason: 'Use the free audit when you need a one-time diagnosis for one URL, with the full 9-category report and no account.',
    href: '/#audit-form',
    cta: 'Run free audit',
    tracking: 'pricing_choice_free_audit',
    planId: '',
    planName: '',
    price: '',
    period: '',
  },
  {
    intent: 'I need to know when my site gets worse or better.',
    plan: 'Pro',
    reason: 'Choose Pro when your domains need weekly monitoring, score history, regression alerts, PDF export, and API access.',
    href: 'https://app.geoready.dev/signup?plan=pro&intent=monitoring&onboarding=first_domain&utm_source=pricing&utm_medium=plan_choice&utm_campaign=pricing_to_paid&utm_content=pro_choice',
    cta: 'Start Pro',
    tracking: 'pricing_choice_pro_monitoring',
    planId: 'pro',
    planName: 'Pro',
    price: '$19',
    period: 'monthly',
  },
  {
    intent: 'I manage a portfolio and need team or bulk workflows.',
    plan: 'Agency',
    reason: 'Choose Agency when 50 monitored domains, team access, unlimited batch audits, and AI answer snapshots are part of the workflow.',
    href: 'https://app.geoready.dev/signup?plan=agency&intent=portfolio&onboarding=first_domain&utm_source=pricing&utm_medium=plan_choice&utm_campaign=pricing_to_paid&utm_content=agency_choice',
    cta: 'Start Agency',
    tracking: 'pricing_choice_agency_portfolio',
    planId: 'agency',
    planName: 'Agency',
    price: '$89',
    period: 'monthly',
  },
] as const;

const afterCheckoutSteps = [
  {
    step: '01',
    title: 'Stripe checkout',
    desc: 'Payment is handled by Stripe. GeoReady does not store card details on its own servers.',
  },
  {
    step: '02',
    title: 'Plan activates immediately',
    desc: 'After payment, the selected plan is available in the app without a sales call or manual approval.',
  },
  {
    step: '03',
    title: 'Claim or add your domain',
    desc: 'If you start from a free report, the claim link carries that report into your account. Pricing links open the app with the first-domain onboarding context.',
  },
  {
    step: '04',
    title: 'Monitoring starts from there',
    desc: 'Pro runs weekly for up to 10 domains. Agency moves to daily multi-site monitoring with longer history and client workflows.',
  },
] as const;

const trustAssurances = [
  ['Free stays useful', 'The free audit remains a complete 9-category report with no account and no card.'],
  ['Cancel anytime', 'There is no annual lock-in or sales contract for self-serve plans.'],
  ['Open methodology', 'The core audit engine, scoring logic, and CLI are MIT-licensed and auditable.'],
  ['Founding price lock', 'The founding price stays locked while the subscription remains active.'],
] as const;

// '✓' renders as a drawn SVG check; '—' stays typographic.
const comparisonRows: [string, string, string, string][] = [
  ['GEO score (0-100)', '✓', '✓', '✓'],
  ['Full 9-category report', '✓', '✓', '✓'],
  ['Audits per day', '5', '∞', '∞'],
  ['Domain monitoring', '—', '15 / day', '50 / day'],
  ['Score history', '—', '12 months', '24 months'],
  ['Regression alerts', '—', '✓', '✓'],
  ['PDF export', '—', '✓', '✓'],
  ['Unbranded PDF export', '—', '✓', '✓'],
  ['Custom-logo white-label', '—', 'roadmap', 'roadmap'],
  ['Competitor comparison', '—', '✓', '✓'],
  ['Bulk audit', '—', '50 URLs', '∞'],
  ['Team workspace', '—', '—', '✓'],
  ['AI search snapshots', '—', '5 runs/day', '✓'],
  ['API access', '—', '✓', '✓'],
  ['CLI (MIT)', '✓', '✓', '✓'],
];

// CLI vs Pro. Every row below was checked against the CLI source and docs:
// src/geo_optimizer/cli/{track,monitor,history,audit}_cmd.py, core/history.py,
// core/monitor.py, models/config.py. The Pro column only restates what the plan
// cards and the feature comparison above already claim.
const cliVsProRows = [
  [
    'Where the audit runs',
    'On the machine or CI runner where you start it.',
    'On GeoReady servers.',
  ],
  [
    'Schedule',
    'None built in. geo track and geo monitor run once, when you call them. Recurring runs need your own cron or scheduled CI job.',
    'Weekly for up to 10 domains, without a scheduler on your side.',
  ],
  [
    'Where history lives',
    'A local SQLite file, ~/.geo-optimizer/tracking.db, on the machine that ran the audit. By default the trend shows the last 12 snapshots and keeps 90 days; both are adjustable. A CI runner that starts clean needs that file cached or persisted.',
    'Kept in your account: 30-audit score history.',
  ],
  [
    'When the score drops',
    'geo audit --regression exits with code 1 and prints a message when the score is lower than the previous saved snapshot. Anything beyond that, such as who gets told, is up to your CI.',
    'An email alert when your score drops by 5 points or more.',
  ],
] as const;

const cliVsProAnswer =
  'If you already run the CLI in CI, you may not need Pro. geo track and geo monitor use the same open-source audit engine, store snapshots in a local SQLite file (~/.geo-optimizer/tracking.db), and run only when you start them, so the schedule, the storage and reading the output are yours to set up. Pro is for people who would rather not operate that: the audit runs weekly for up to 10 domains, history is kept in your account, and a score drop of 5 points or more triggers an email alert.';

const faqs = [
  {
    q: 'Is the free audit really free?',
    a: 'Yes. The web audit requires no account, no credit card, and no signup. You get a full GEO score and the complete 9-category breakdown immediately. The CLI is MIT-licensed and free to use without limits.',
  },
  {
    q: 'Do I need to register to use the free audit?',
    a: 'No. Just enter a URL and run the audit. No email is required to see your results.',
  },
  {
    q: 'What does Pro add that Free does not?',
    a: 'Pro adds continuity rather than a bigger report. The free audit is a one-shot snapshot with all 9 categories. Pro monitors your domain weekly, tracks score history over time, and sends alerts when your GEO score drops. It also includes PDF export and API access.',
  },
  {
    q: 'The CLI already has geo track and geo monitor. Why pay for Pro?',
    a: cliVsProAnswer,
  },
  {
    q: 'Are paid plans available right now?',
    a: 'Yes. Pick a plan, create an account, and pay. Your subscription is active immediately. No sales call, no waitlist. Payments are processed securely by Stripe.',
  },
  {
    q: 'What happens after I choose a paid plan?',
    a: 'You complete Stripe checkout, return to the GeoReady app, and the selected plan activates immediately. If you came from a free report, the claim link can attach that report to your account; otherwise you add a domain from the dashboard and monitoring starts from that point.',
  },
  {
    q: 'What is the founding price?',
    a: 'The current prices are a founding rate for early members. They are locked for the life of the subscription as long as it stays active. Pro is $19/month founding, then $29/month; Agency is $89/month founding, then $199/month.',
  },
  {
    q: 'Will the CLI remain open source?',
    a: 'Yes. The CLI (geo-optimizer-skill on PyPI) is MIT-licensed and will remain free forever. SaaS plans add what the CLI leaves for you to run: the schedule, the stored history and the alerts.',
  },
  {
    q: 'Is there a free trial for paid plans?',
    a: 'There is no self-serve trial. The Free plan is the permanent baseline and returns real audit results without commitment. A 14-day Agency trial is available on request: contact us at juan@geoready.dev.',
  },
  {
    q: 'Can I cancel at any time?',
    a: 'Yes. You can cancel from your account settings at any time, with no lock-in or penalties.',
  },
];

const heroCadenceRows = [
  { plan: 'Free', value: 'run: on demand', detail: '5 audits/day' },
  { plan: 'Pro', value: 'schedule: weekly', detail: '10 domains' },
  { plan: 'Agency', value: 'schedule: daily', detail: '50 domains' },
] as const;
---

<Shell
  title="GeoReady Pricing | Free AI Audit & Monitoring"
  description="The full 9-category GEO audit is free, no account. Pro adds weekly monitoring, score history, and alerts. Agency adds multi-site daily monitoring."
  canonical="https://geoready.dev/pricing/"
>
  {/* Hero */}
  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20">
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(340px,0.52fr)] lg:gap-14">
        <div>
          <h1 class="max-w-3xl font-head text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] text-ink md:text-5xl">
            Free GEO audit, forever. Pay only when you need monitoring.
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft">
            Run a full GEO score on any URL with no account and no card, as often as you want.
            Paid plans add what a one-shot audit can't: weekly monitoring, score history, regression
            alerts, exports, and team workflows.
          </p>

          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="/"
              data-cta="pricing_hero_free_audit"
              class="inline-flex items-center justify-center gap-2 rounded-[4px] bg-pass-deep px-6 py-3 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-pass"
            >
              Start free audit
              <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <path d="M3 1.5 9.5 6 3 10.5V1.5Z" />
              </svg>
            </a>
            <span class="text-sm text-ink-mute">
              No self-serve trial. No card required for Free. Cancel anytime.
            </span>
          </div>

          <div class="mt-8 grid gap-3 sm:grid-cols-2">
            <div class="border-l border-rail pl-4">
              <p class="text-sm font-semibold text-ink">Free</p>
              <p class="mt-1 text-sm text-ink-soft">Single-URL audit, no account.</p>
            </div>
            <div class="border-l border-rail pl-4">
              <p class="text-sm font-semibold text-ink">Pro</p>
              <p class="mt-1 text-sm text-ink-soft">$19/month founding price, then $29/month.</p>
            </div>
          </div>

          <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ink-mute">
            The web audit and CLI are MIT-licensed and remain free forever. The CLI runs locally with
            no usage limits.
          </p>
        </div>

        {/* Monitoring cadence — the plan facts as a ledger, not a mockup */}
        <aside class="rounded-[4px] border border-rail bg-white" aria-label="Monitoring cadence by plan">
          <div class="flex items-center justify-between border-b border-rail px-5 py-2.5">
            <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">monitoring cadence</span>
            <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-pass-deep">per plan</span>
          </div>
          <ul class="divide-y divide-rail">
            {heroCadenceRows.map((row) => (
              <li class="flex items-baseline justify-between gap-4 px-5 py-3.5">
                <span class="text-sm font-semibold text-ink">{row.plan}</span>
                <span class="text-right font-mono text-[12px] text-ink-soft">
                  {row.value} <span class="text-ink-mute">· {row.detail}</span>
                </span>
              </li>
            ))}
          </ul>
          <div class="border-t border-rail px-5 py-2.5">
            <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">billing: Stripe · cancel anytime</span>
          </div>
        </aside>
      </div>

      <div class="mt-12 grid gap-px overflow-hidden rounded-[4px] border border-rail bg-rail md:grid-cols-3">
        {[
          ['Free', 'Audit once, learn what to fix.'],
          ['Pro', 'Track up to 10 domains weekly.'],
          ['Agency', 'Add team and bulk workflows.'],
        ].map(([label, text]) => (
          <div class="bg-white p-5">
            <p class="text-sm font-semibold text-ink">{label}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Credibility row — verifiable signals only (open-source, research-backed, coverage) */}
  <section aria-label="What the audit is built on" class="border-t border-rail bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <ul class="grid gap-px overflow-hidden rounded-[4px] border border-rail bg-rail sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Open source, MIT', 'Scoring weights are public and auditable on GitHub.', 'github.com/Auriti-Labs'],
          ['Research-grounded', 'Weights follow Princeton KDD 2024 and AutoGEO (arXiv:2510.11438, preprint).', 'KDD 2024 · arXiv 2025'],
          ['27 AI bots checked', 'robots.txt access verified across 27 AI crawlers.', 'models/config.py · AI_BOTS'],
          ['47 citability methods', 'Each audit runs 47 citation-signal checks.', 'core/citability.py'],
        ].map(([label, text, source]) => (
          <li class="bg-paper p-5">
            <p class="text-sm font-semibold text-ink">{label}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{text}</p>
            <p class="mt-3 font-mono text-[10px] uppercase tracking-[0.1em] text-ink-mute">{source}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Plan cards */}
  <section aria-labelledby="plans-heading" class="border-t border-rail bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <h2 id="plans-heading" class="sr-only">Plans</h2>

      <p class="mb-6 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">
        Founding price for early members, locked for life while your subscription stays active.
      </p>

      {/* Self-serve row */}
      <div class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-3">
        {selfServePlans.map((plan) => (
          <div class={`flex flex-col rounded-[4px] border ${plan.recommended ? 'border-pass/50 bg-pass-wash/60' : 'border-rail bg-white'}`}>
            <div class={`flex items-center justify-between border-b px-5 py-2.5 ${plan.recommended ? 'border-pass/30' : 'border-rail'}`}>
              <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">{plan.cadence}</span>
              {plan.recommended && (
                <span class="rounded-[2px] bg-pass-deep px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-white">
                  Recommended
                </span>
              )}
            </div>

            <div class="flex flex-1 flex-col p-5">
              <div class="mb-3 flex items-center justify-between">
                <span class="text-sm font-semibold text-ink">{plan.name}</span>
                <span class={`rounded-[2px] px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.1em] ${plan.statusStyle}`}>
                  {plan.status}
                </span>
              </div>
              <div class="flex items-baseline gap-1">
                <span class="font-head text-3xl font-extrabold tracking-[-0.02em] text-ink">{plan.price}</span>
                {plan.period && <span class="font-mono text-xs text-ink-mute">{plan.period}</span>}
              </div>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{plan.description}</p>

              <ul class="mb-6 mt-4 flex-1 space-y-2">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm text-ink-soft">
                    <svg aria-hidden="true" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-pass-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>

              <a
                href={plan.ctaHref}
                data-plan-id={plan.id}
                data-plan-name={plan.name}
                data-plan-price={plan.price}
                data-plan-period={plan.period}
                data-plan-currency="USD"
                data-cta-location="pricing_page"
                class={`block rounded-[4px] px-4 py-2.5 text-center font-mono text-[12px] font-semibold uppercase tracking-[0.12em] transition-colors ${plan.ctaStyle}`}
              >
                {plan.cta}
              </a>
            </div>
          </div>
        ))}
      </div>

      {/* Scale row */}
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        {scalePlans.map((plan) => (
          <div class="flex flex-col rounded-[4px] border border-rail bg-white">
            <div class="flex items-center justify-between border-b border-rail px-5 py-2.5">
              <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">{plan.cadence}</span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <div class="mb-3 flex items-center justify-between">
                <span class="text-sm font-semibold text-ink">{plan.name}</span>
                <span class={`rounded-[2px] px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.1em] ${plan.statusStyle}`}>
                  {plan.status}
                </span>
              </div>
              <div class="flex items-baseline gap-1">
                <span class="font-head text-3xl font-extrabold tracking-[-0.02em] text-ink">{plan.price}</span>
                {plan.period && <span class="font-mono text-xs text-ink-mute">{plan.period}</span>}
              </div>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{plan.description}</p>

              <ul class="mb-6 mt-4 flex-1 space-y-2">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm text-ink-soft">
                    <svg aria-hidden="true" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-pass-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>

              {/* Enterprise è lead-gen ("Contact us" via mailto), non selezione piano self-serve:
                  usa data-cta → geo_cta_clicked, non data-plan-id → geo_plan_selected.
                  Il nome evento resta "pricing_enterprise_contact_sales" per continuità storica GA4. */}
              {plan.id === 'enterprise' ? (
                <a
                  href={plan.ctaHref}
                  data-cta="pricing_enterprise_contact_sales"
                  class="block rounded-[4px] border border-rail bg-white px-4 py-2.5 text-center font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-ink transition-colors hover:bg-pass-wash"
                >
                  {plan.cta}
                </a>
              ) : (
                <a
                  href={plan.ctaHref}
                  data-plan-id={plan.id}
                  data-plan-name={plan.name}
                  data-plan-price={plan.price}
                  data-plan-period={plan.period}
                  data-plan-currency="USD"
                  data-cta-location="pricing_page"
                  class="block rounded-[4px] border border-rail bg-white px-4 py-2.5 text-center font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-ink transition-colors hover:bg-pass-wash"
                >
                  {plan.cta}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* After checkout */}
  <section class="border-t border-rail bg-white" aria-labelledby="after-checkout-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.5fr)]">
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h2 id="after-checkout-heading" class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">
              What happens after you pick a paid plan
            </h2>
            <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">checkout: Stripe</p>
          </div>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-ink-soft">
            Self-serve plans activate through Stripe. The app then guides you to claim the report
            or add the first monitored domain, with no sales contact step.
          </p>

          <ol class="mt-6 grid gap-px overflow-hidden rounded-[4px] border border-rail bg-rail sm:grid-cols-2">
            {afterCheckoutSteps.map((item) => (
              <li class="bg-paper p-5">
