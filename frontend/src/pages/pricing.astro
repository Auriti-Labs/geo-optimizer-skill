---
import Shell from '../components/Shell.astro';
import PricingObjectionSurvey from '../components/PricingObjectionSurvey';
import FoundingSeatsStatus from '../components/FoundingSeatsStatus';

// Piani self-serve. Le liste feature rispecchiano le entitlement del backend: non aggiungere
// voci che il codice non implementa. `price`/`period` alimentano anche i data-plan-* (GA4).
const plans = [
  {
    id: 'free',
    name: 'Free',
    price: '$0',
    period: 'forever',
    terms: 'no card · no account',
    description: 'Single-URL audit with a full GEO score and the complete 9-category breakdown. No account required.',
    cta: 'Start free audit',
    ctaHref: '/',
    ctaStyle: 'border border-rail bg-white text-ink hover:bg-pass-wash',
    highlight: false,
    cadence: 'run: on demand · 5/day',
    features: [
      '5 audits per day',
      '1 AI answer check per week with a free account (Perplexity)',
      'GEO score 0-100',
      'Full 9-category GEO report',
      'Actionable recommendations',
      'CLI (MIT, unlimited)',
    ],
  },
  {
    id: 'pro',
    name: 'Pro',
    price: '$19',
    period: '/month',
    terms: 'founding price · then $29/month',
    description: 'Weekly monitoring for up to 10 domains, score history, regression alerts, PDF export, and API access. For developers and consultants managing a few sites.',
    cta: 'Start with Pro',
    ctaHref: 'https://app.geoready.dev/signup?plan=pro&intent=monitoring&onboarding=first_domain&utm_source=pricing&utm_medium=plan_card&utm_campaign=pricing_to_paid&utm_content=pro_card',
    ctaStyle: 'bg-ink text-white hover:bg-ink-soft',
    highlight: false,
    cadence: 'schedule: weekly · 10 domains',
    features: [
      'Unlimited audits',
      '10 domains, weekly monitoring',
      '30-audit score history',
      'Regression alerts by email (when your score drops by 5 points or more)',
      'PDF export',
      'API access (Bearer token)',
    ],
  },
  {
    id: 'agency',
    name: 'Agency',
    price: '$89',
    period: '/month',
    terms: 'founding price · then $199/month',
    description: 'Team workspace, 50-domain daily portfolio monitoring, AI answer snapshots, and unlimited batch audits.',
    cta: 'Start with Agency',
    ctaHref: 'https://app.geoready.dev/signup?plan=agency&intent=portfolio&onboarding=first_domain&utm_source=pricing&utm_medium=plan_card&utm_campaign=pricing_to_paid&utm_content=agency_card',
    ctaStyle: 'bg-pass-deep text-white hover:bg-pass',
    highlight: true,
    cadence: 'schedule: daily · 50 domains',
    features: [
      'Everything in Pro',
      '50 domains, daily monitoring',
      'Unbranded PDF export (removes GeoReady footer and badge)',
      'Competitor comparison',
      '24-month score history',
      'Team workspace (owner / editor / viewer)',
      'Unlimited batch audits',
      'AI answer snapshots (Perplexity automated; ChatGPT and Google via manual paste)',
      'Citation quality scoring',
    ],
  },
] as const;

const heroCadenceRows = [
  { plan: 'Free', value: 'on demand', detail: '5/day' },
  { plan: 'Pro', value: 'weekly', detail: '10 domains' },
  { plan: 'Agency', value: 'daily', detail: '50 domains' },
] as const;

// Cosa gira da solo e cosa no: stessa verità della sezione "automated" e della FAQ "Is any part manual?".
const automationRows = [
  { item: 'Site audits', mode: 'automated', how: 'On our servers: weekly on Pro, daily on Agency' },
  { item: 'Score monitoring', mode: 'automated', how: 'Same schedule, with regression alerts' },
  { item: 'Perplexity answers', mode: 'automated', how: 'Queried through the Perplexity API' },
  { item: 'ChatGPT answers', mode: 'manual paste', how: 'Scored the same way: brand mention, cited domains' },
  { item: 'Google AI answers', mode: 'manual paste', how: 'Scored the same way: brand mention, cited domains' },
] as const;

const credibility = [
  { value: '27', label: 'AI bots checked', text: 'robots.txt access verified across 27 AI crawlers.', source: 'models/config.py · AI_BOTS' },
  { value: '47', label: 'citability checks', text: 'A content analysis reported next to the 0-100 score. The score itself comes from 9 categories.', source: 'core/citability.py' },
  { value: '9', label: 'checks from KDD 2024', text: '9 of the 47 content checks come from the methods tested in Princeton KDD 2024. The weights are a published starting point.', source: 'KDD 2024 · arXiv:2311.09735' },
  { value: 'MIT', label: 'open source', text: 'Scoring weights are public and auditable on GitHub.', source: 'github.com/Auriti-Labs' },
] as const;

const planChoiceRows = [
  {
    intent: 'I need one current GEO score before I change anything.',
    plan: 'Free audit',
    reason: 'Use the free audit when you need a one-time diagnosis for one URL, with the full 9-category report and no account.',
    href: '/#audit-form',
    cta: 'Run free audit',
    tracking: 'pricing_choice_free_audit',
    planId: '',
    planName: '',
    price: '',
    period: '',
  },
  {
    intent: 'I need to know when my site gets worse or better.',
    plan: 'Pro',
    reason: 'Choose Pro when your domains need weekly monitoring, score history, regression alerts, PDF export, and API access.',
    href: 'https://app.geoready.dev/signup?plan=pro&intent=monitoring&onboarding=first_domain&utm_source=pricing&utm_medium=plan_choice&utm_campaign=pricing_to_paid&utm_content=pro_choice',
    cta: 'Start Pro',
    tracking: 'pricing_choice_pro_monitoring',
    planId: 'pro',
    planName: 'Pro',
    price: '$19',
    period: 'monthly',
  },
  {
    intent: 'I manage a portfolio and need team or bulk workflows.',
    plan: 'Agency',
    reason: 'Choose Agency when 50 monitored domains, team access, unlimited batch audits, and AI answer snapshots are part of the workflow.',
    href: 'https://app.geoready.dev/signup?plan=agency&intent=portfolio&onboarding=first_domain&utm_source=pricing&utm_medium=plan_choice&utm_campaign=pricing_to_paid&utm_content=agency_choice',
    cta: 'Start Agency',
    tracking: 'pricing_choice_agency_portfolio',
    planId: 'agency',
    planName: 'Agency',
    price: '$89',
    period: 'monthly',
  },
] as const;

const afterCheckoutSteps = [
  {
    step: '01',
    title: 'Stripe checkout',
    desc: 'Payment is handled by Stripe. GeoReady does not store card details on its own servers.',
  },
  {
    step: '02',
    title: 'Plan activates immediately',
    desc: 'After payment, the selected plan is available in the app without a sales call or manual approval.',
  },
  {
    step: '03',
    title: 'Claim or add your domain',
    desc: 'If you start from a free report, the claim link carries that report into your account. Pricing links open the app with the first-domain onboarding context.',
  },
  {
    step: '04',
    title: 'Monitoring starts from there',
    desc: 'Pro runs weekly for up to 10 domains. Agency moves to daily multi-site monitoring with longer history and client workflows.',
  },
] as const;

const trustAssurances = [
  ['Free stays useful', 'The free audit remains a complete 9-category report with no account and no card.'],
  ['Cancel anytime', 'There is no annual lock-in or sales contract for self-serve plans.'],
  ['Open methodology', 'The core audit engine, scoring logic, and CLI are MIT-licensed and auditable.'],
  ['Founding price lock', 'The founding price stays locked while the subscription remains active.'],
] as const;

// '✓' diventa un check SVG disegnato; '—' resta tipografico.
const comparisonRows: [string, string, string, string][] = [
  ['GEO score (0-100)', '✓', '✓', '✓'],
  ['Full 9-category report', '✓', '✓', '✓'],
  ['Audits per day', '5', '∞', '∞'],
  ['Domain monitoring', '—', '10, weekly', '50, daily'],
  ['Score history', '—', '30 audits', '24 months'],
  ['Regression alerts', '—', '✓', '✓'],
  ['PDF export', '—', '✓', '✓'],
  ['Unbranded PDF export', '—', '—', '✓'],
  ['Custom-logo white-label', '—', '—', 'roadmap'],
  ['Competitor comparison', '—', '—', '✓'],
  ['Bulk audit', '—', '—', '∞'],
  ['Team workspace', '—', '—', '✓'],
  ['Automated AI answer checks (Perplexity)', '1 / week, with an account', '3 / day', '✓'],
  ['API access', '—', '✓', '✓'],
  ['CLI (MIT)', '✓', '✓', '✓'],
];

// CLI vs Pro. Ogni riga è verificata sul sorgente e sui docs della CLI:
// src/geo_optimizer/cli/{track,monitor,history,audit}_cmd.py, core/history.py,
// core/monitor.py, models/config.py. La colonna Pro ripete solo ciò che già
// dichiarano le card piano e la tabella di confronto.
const cliVsProRows = [
  [
    'Where the audit runs',
    'On the machine or CI runner where you start it.',
    'On GeoReady servers.',
  ],
  [
    'Schedule',
    'None built in. geo track and geo monitor run once, when you call them. Recurring runs need your own cron or scheduled CI job.',
    'Weekly for up to 10 domains, without a scheduler on your side.',
  ],
  [
    'Where history lives',
    'A local SQLite file, ~/.geo-optimizer/tracking.db, on the machine that ran the audit. By default the trend shows the last 12 snapshots and keeps 90 days; both are adjustable. A CI runner that starts clean needs that file cached or persisted.',
    'Kept in your account: 30-audit score history.',
  ],
  [
    'When the score drops',
    'geo audit --regression exits with code 1 and prints a message when the score is lower than the previous saved snapshot. Anything beyond that, such as who gets told, is up to your CI.',
    'An email alert when your score drops by 5 points or more.',
  ],
] as const;

// Unica fonte per la FAQ visibile e per il FAQPage JSON-LD: domande e risposte devono coincidere.
const faqs = [
  {
    q: 'Is the free audit really free?',
    a: 'Yes. The web audit requires no account, no credit card, and no signup. You get a full GEO score and the complete 9-category breakdown immediately. The CLI is MIT-licensed and free to use without limits.',
  },
  {
    q: 'Do I need to register to use the free audit?',
    a: 'No. Just enter a URL and run the audit. No email is required to see your results.',
  },
  {
    q: 'What does Pro add that Free does not?',
    a: 'Pro adds continuity rather than a bigger report. The free audit is a one-shot snapshot with all 9 categories. Pro monitors your domain weekly, tracks score history over time, and sends alerts when your GEO score drops. It also includes PDF export and API access.',
  },
  {
    q: 'The CLI already has geo track and geo monitor. Why pay for Pro?',
    a: 'If you already run the CLI in CI, you may not need Pro. geo track and geo monitor use the same open-source audit engine, store snapshots in a local SQLite file (~/.geo-optimizer/tracking.db), and run only when you start them, so the schedule, the storage and reading the output are yours to set up. Pro is for people who would rather not operate that: the audit runs weekly for up to 10 domains, history is kept in your account, and a score drop of 5 points or more triggers an email alert.',
  },
  {
    q: 'Does a high score guarantee AI citations?',
    a: 'No. The score measures whether AI engines can reach, read and attribute your pages. Whether a page is cited also depends on the query and on the engine, and no tool controls that.',
  },
  {
    q: 'Is any part manual?',
    a: "Yes, one part. Site audits and score monitoring run automatically on our servers (weekly on Pro, daily on Agency), and AI answer checks query Perplexity through its API. For ChatGPT and Google AI answers, you paste the answer you see and GeoReady scores it the same way (brand mention, cited domains). We don't scrape those interfaces.",
  },
  {
    q: 'Are paid plans available right now?',
    a: 'Yes. Pick a plan, create an account, and pay. Your subscription is active immediately. No sales call, no waitlist. Payments are processed securely by Stripe.',
  },
  {
    q: 'What happens after I choose a paid plan?',
    a: 'You complete Stripe checkout, return to the GeoReady app, and the selected plan activates immediately. If you came from a free report, the claim link can attach that report to your account; otherwise you add a domain from the dashboard and monitoring starts from that point.',
  },
  {
    q: 'What is the founding price?',
    a: 'The current prices are a founding rate for early members. They are locked for the life of the subscription as long as it stays active. Pro is $19/month founding, then $29/month; Agency is $89/month founding, then $199/month.',
  },
  {
    q: 'Will the CLI remain open source?',
    a: 'Yes. The CLI (geo-optimizer-skill on PyPI) is MIT-licensed and will remain free forever. SaaS plans add what the CLI leaves for you to run: the schedule, the stored history and the alerts.',
  },
  {
    q: 'Is there a free trial for paid plans?',
    a: 'There is no self-serve trial. The Free plan is the permanent baseline and returns real audit results without commitment. A 14-day Agency trial is available on request: contact us at info@geoready.dev.',
  },
  {
    q: 'Can I cancel at any time?',
    a: 'Yes. You can cancel from your account settings at any time, with no lock-in or penalties.',
  },
];

const linkClass = 'text-pass-deep underline decoration-current/50 underline-offset-4 hover:decoration-pass-deep';
// Prezzo dal dato dei piani, così il testo non diverge dalle card
const planPrice = (id: string) => plans.find((p) => p.id === id)?.price;
const sectionHeading = 'font-head text-2xl font-semibold tracking-[-0.03em] text-ink md:text-3xl';
const thClass = 'border-b border-rail px-4 py-3 text-left font-mono text-[12px] font-medium text-ink-mute';
---

<Shell
  title="GeoReady Pricing | Free AI Audit & Monitoring"
  description="The full 9-category GEO audit is free, no account. Pro adds weekly monitoring, score history, and alerts. Agency adds multi-site daily monitoring."
  canonical="https://geoready.dev/pricing/"
>
  {/* Hero: claim a sinistra, ledger delle cadenze a destra (pannello impostazioni della dashboard) */}
  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-4 pb-12 pt-14 sm:px-6 md:pb-16 md:pt-20">
      <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-16">
        <div>
          <p class="eyebrow">pricing · USD · billed monthly via Stripe</p>
          <h1 class="mt-4 max-w-3xl font-head text-[2.5rem] font-semibold leading-[1.04] tracking-[-0.035em] text-ink md:text-[3.5rem]">
            Pay for <em>monitoring</em>, not for the audit.
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
            The full 9-category audit stays free, with no account and no card. The audit engine and the
            CLI are MIT-licensed. Paid plans add what a one-shot audit can't: the schedule, the stored
            history and the alerts.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              href="#plans"
              data-cta="pricing_hero_compare_plans"
              class="inline-flex items-center justify-center rounded-[9px] bg-pass-deep px-6 py-3 text-[14px] font-semibold text-white transition-colors hover:bg-pass"
            >
              Compare plans
            </a>
            <a
              href="/"
              data-cta="pricing_hero_free_audit"
              class="inline-flex items-center justify-center gap-2 rounded-[9px] border border-rail bg-white px-6 py-3 text-[14px] font-semibold text-ink transition-colors hover:bg-pass-wash"
            >
              Start free audit
              <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <path d="M3 1.5 9.5 6 3 10.5V1.5Z" />
              </svg>
            </a>
          </div>
          <p class="mt-4 font-mono text-[12px] text-ink-mute">
            no card for Free · 14-day Agency trial on request · cancel anytime
          </p>
        </div>

        <aside class="panel overflow-hidden" aria-label="Monitoring cadence by plan">
          <div class="flex items-center justify-between border-b border-rail px-5 py-3">
            <span class="eyebrow">cadence ledger</span>
            <span class="font-mono text-[12px] text-pass-deep">per plan</span>
          </div>
          <dl class="divide-y divide-rail">
            {heroCadenceRows.map((row) => (
              <div class="grid grid-cols-[72px_minmax(0,1fr)_auto] items-baseline gap-3 px-5 py-3.5">
                <dt class="text-sm font-semibold text-ink">{row.plan}</dt>
                <dd class="font-mono text-[13px] text-ink-soft">{row.value}</dd>
                <dd class="text-right font-mono text-[12px] tabular-nums text-ink-mute">{row.detail}</dd>
              </div>
            ))}
          </dl>
          <div class="border-t border-rail bg-[#EEF2F2] px-5 py-3">
            <span class="font-mono text-[12px] text-ink-mute">billing: Stripe · cancel anytime</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* Piani: tre pannelli, Agency evidenziato (conversione primaria: agenzie e consulenti) */}
  <section id="plans" aria-labelledby="plans-heading" class="scroll-mt-20 border-t border-rail bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <p class="eyebrow">founding price, locked while your subscription stays active</p>
      <h2 id="plans-heading" class={`${sectionHeading} mt-2`}>Plans</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">
        The audit is free and needs no account. Pro is {planPrice('pro')}/month and Agency is {planPrice('agency')}/month at the founding price.
      </p>

      <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-3">
        {plans.map((plan) => (
          <div
            class="panel flex flex-col overflow-hidden"
            style={plan.highlight ? 'box-shadow: 0 0 0 1.5px #0F766E' : undefined}
          >
            <div class={`flex items-center border-b px-5 py-3 ${plan.highlight ? 'border-pass-deep/30 bg-pass-wash' : 'border-rail'}`}>
              <span class="eyebrow whitespace-nowrap">{plan.cadence}</span>
            </div>

            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-base font-semibold text-ink">{plan.name}</h3>
                {plan.highlight && (
                  <span class="whitespace-nowrap rounded-[6px] bg-pass-deep px-2 py-0.5 font-mono text-[11.5px] font-medium text-white">
                    For client portfolios
                  </span>
                )}
              </div>
              <div class="mt-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="font-mono text-[44px] font-medium leading-none tracking-[-0.04em] tabular-nums text-ink md:text-[48px]">{plan.price}</span>
                <span class="font-mono text-[13px] text-ink-mute">{plan.period}</span>
                {plan.id !== 'free' && (
                  <span class="ml-auto rounded-[6px] border border-rail px-2 py-0.5 font-mono text-[11.5px] text-ink-soft">cancel anytime</span>
                )}
              </div>
              <p class="mt-2 font-mono text-[12px] text-ink-mute">{plan.terms}</p>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft">{plan.description}</p>

              <ul class="mb-6 mt-5 flex-1 space-y-2.5 border-t border-rail pt-5">
                {plan.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                    <svg aria-hidden="true" class="mt-0.5 h-3.5 w-3.5 shrink-0 text-pass-deep" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>

              <a
                href={plan.ctaHref}
                data-plan-id={plan.id}
                data-plan-name={plan.name}
                data-plan-price={plan.price}
                data-plan-period={plan.period}
                data-plan-currency="USD"
                data-cta-location="pricing_page"
                class={`block rounded-[9px] px-4 py-3 text-center text-[14px] font-semibold transition-colors ${plan.ctaStyle}`}
              >
                {plan.cta}
              </a>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-5 text-sm text-ink-mute">
        Want to try Agency first? A 14-day trial is available on request at <a href="mailto:info@geoready.dev?subject=GeoReady%20Agency%20trial" class={linkClass}>info@geoready.dev</a>.
      </p>

      {/* Custom: una riga, non una quarta card. Niente promesse che il codice non mantiene. */}
      <div class="panel mt-8 flex flex-col gap-5 p-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-3xl">
          <p class="eyebrow">custom</p>
          <p class="mt-2 text-base leading-relaxed text-ink">
            More than 50 domains, invoicing, or a security questionnaire? Email info@geoready.dev. You get a reply from the person who builds GeoReady.
          </p>
        </div>
        {/* Lead-gen via mailto, non selezione piano: data-cta → geo_cta_clicked.
            Il nome evento resta "pricing_enterprise_contact_sales" per continuità storica GA4. */}
        <a
          href="mailto:info@geoready.dev?subject=GeoReady%20Enterprise"
          data-cta="pricing_enterprise_contact_sales"
          class="inline-flex shrink-0 items-center justify-center rounded-[9px] border border-rail bg-white px-5 py-3 text-[14px] font-semibold text-ink transition-colors hover:bg-pass-wash"
        >
          Email info@geoready.dev
        </a>
      </div>
    </div>
  </section>

  {/* Cosa è automatico e cosa no: unica banda scura della pagina, per ritmo */}
  <section class="band-dark" aria-labelledby="automation-heading">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16" data-reveal>
        <div>
          <p class="eyebrow">what runs on its own</p>
          <h2 id="automation-heading" class={`mt-3 ${sectionHeading}`}>
            What's automated, what isn't
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft md:text-base">
            Site audits and score monitoring are automatic: they run on our servers, weekly on Pro and
            daily on Agency. AI answer checks query Perplexity through its API. For ChatGPT and Google AI
            answers, you paste the answer you see and GeoReady scores it the same way (brand mention,
            cited domains). We don't scrape those interfaces.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-ink">
            The score measures technical readiness; it does not guarantee citations.
          </p>
        </div>

        <div class="panel overflow-hidden">
          <div class="flex items-center justify-between border-b border-rail px-5 py-3">
            <span class="eyebrow">job</span>
            <span class="eyebrow">mode</span>
          </div>
          <ul class="divide-y divide-rail">
            {automationRows.map((row) => (
              <li class="flex items-start justify-between gap-4 px-5 py-4">
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-ink">{row.item}</p>
                  <p class="mt-1 text-[13px] leading-relaxed text-ink-soft">{row.how}</p>
                </div>
                <span class={`shrink-0 rounded-[6px] px-2 py-0.5 font-mono text-[11.5px] ${row.mode === 'automated' ? 'bg-[#0F2A27] text-pass-deep' : 'border border-rail text-ink-soft'}`}>
                  {row.mode}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Credibilità: solo segnali verificabili nel codice (open source, ricerca, copertura) */}
  <section aria-label="What the audit is built on" class="border-b border-rail bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <ul class="grid gap-px overflow-hidden rounded-[14px] border border-rail bg-rail sm:grid-cols-2 lg:grid-cols-4" data-reveal="stagger">
        {credibility.map((c) => (
          <li class="bg-white p-5">
            <p class="flex items-baseline gap-2">
              <span class="font-mono text-[28px] font-medium leading-none tracking-[-0.03em] tabular-nums text-ink">{c.value}</span>
              <span class="text-sm font-semibold text-ink">{c.label}</span>
            </p>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{c.text}</p>
            <p class="eyebrow mt-3">{c.source}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

