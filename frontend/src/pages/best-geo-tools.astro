---
import Shell from '../components/Shell.astro';
import ArticleVisual from '../components/ArticleVisual.astro';
import { BENCHMARK } from '../lib/benchmarkSnapshot';

const title = 'Best GEO Tools 2026: Compare AI Visibility Software';
const description =
  'Compare GEO and AI visibility tools by audit depth, monitoring, llms.txt support, schema, workflows, and pricing fit. Includes GEO Optimizer.';
const canonical = 'https://geoready.dev/best-geo-tools/';
const datePublished = '2026-06-16';
const dateModified = '2026-10-23';
const dateModifiedLabel = 'October 23, 2026';


// Criteri di valutazione di un GEO tool — riusati nella tabella visibile.
// Ogni criterio è una domanda concreta che un reviewer tecnico può verificare.
const EVALUATION_CRITERIA = [
  [
    'Methodology transparency',
    'Are the scoring weights and methods published, or is the score a black box? A transparent tool lets you read exactly why a page scored the way it did.',
  ],
  [
    'Open-source vs closed',
    'Can you read, fork, and self-host the code, or are you locked into a hosted product? Open-source tools can be audited and run in your own environment.',
  ],
  [
    'Audit vs monitoring',
    'Does it score a site once, track changes over time, or both? One-off audits answer "where do I stand"; monitoring answers "did my changes hold".',
  ],
  [
    'CI/CD integration',
    'Can it run in a pipeline and fail a build on regression, or only in a browser? Pipeline support turns AI-readiness into an enforceable check.',
  ],
  [
    'Answer-engine querying',
    'Does it only score on-page signals, or can it ask real answer engines whether your brand is mentioned and your domain cited? These are different questions.',
  ],
  [
    'Research backing',
    'Are the methods grounded in published research, or asserted without sources? Cited methods are testable; unsourced claims are not.',
  ],
  [
    'Pricing model',
    'Free and open, freemium, or paid-only? The model determines how much you can verify before committing budget.',
  ],
] as const;

// Strumenti nominati — solo fatti già registrati, con fonte e data, nelle pagine
// "alternative" collegate (controllate il 16-21 settembre 2026). Nessuna classifica,
// nessun punteggio: se una cella non è nella pagina collegata, rimanda alla pagina.
const NAMED_TOOLS_CHECKED = '16 September to 23 October 2026 (vendor pricing pages re-read on 23 October; Semrush dollar prices are from 1 September because Semrush shows euros from Europe)';
const NAMED_TOOLS = [
  {
    name: 'Profound',
    href: '/profound-alternative/',
    free: 'A 7-day free trial; no ongoing free tier',
    entry: 'No public self-serve price: trial, then a custom Enterprise plan',
    weights: 'Not published on the pages checked',
  },
  {
    name: 'RankScale',
    href: '/rankscale-alternative/',
    free: 'No ongoing free plan; a 7-day free trial of Pro',
    entry: 'Essentials, yearly only ($204/year in the page\'s structured data); Pro $99/mo: 1,200 credits',
    weights: '7 core metrics described; exact weighted formula not published',
  },
  {
    name: 'Goodie',
    href: '/goodie-alternative/',
    free: 'A 7-day free trial of Core; no ongoing free plan',
    entry: 'Core $295/mo billed annually',
    weights: 'Metric types described; see the comparison page',
  },
  {
    name: 'Veesie',
    href: '/veesie-alternative/',
    free: '7-day trial, 15 prompts, no card',
    entry: 'Starter €24/mo billed annually: 1 site, 20 prompts, 3 engines',
    weights: '"GEO Score" weights published: mention rate 50, sentiment 25, source coverage 15, position 10',
  },
  {
    name: 'AEO Vision',
    href: '/aeovision-alternative/',
    free: 'No free paid plan; free tools such as an llms.txt generator',
    entry: 'Lite $9/mo: 30 prompts on ChatGPT, 1 brand',
    weights: 'Factors described, exact weights not published',
  },
  {
    name: 'Otterly',
    href: '/otterly-alternative/',
    free: 'A free trial (length not stated on the pricing page)',
    entry: 'See the comparison page',
    weights: 'See the comparison page',
  },
  {
    name: 'Semrush AI Visibility Toolkit',
    href: '/semrush-ai-visibility-toolkit-alternative/',
    free: 'Free plan includes some AI Visibility features; scope not disclosed',
    entry: 'See the comparison page',
    weights: 'See the comparison page',
  },
  {
    name: 'GeoReady (this site)',
    href: '/methodology/',
    free: '$0, 5 audits/day, full nine-category report, no account, no card',
    entry: 'Pro $19/mo founding price, then $29/mo: 10 domains, weekly monitoring',
    weights: 'Nine categories and weights published, MIT-licensed',
  },
] as const;

// Categorie di tool sul mercato — descritte senza inventare nomi o feature di vendor.
const TOOL_CATEGORIES = [
  [
    'AI-readiness audit tools',
    'Score a page or site against the technical and content signals AI engines rely on — crawler access, structured data, llms.txt, quotable content. Best for a baseline and a prioritized fix list.',
  ],
  [
    'Citation monitoring',
    'Track whether AI answer engines mention your brand and cite your domain over time, and which competitors are cited instead. Best for measuring outcomes rather than readiness.',
  ],
  [
    'llms.txt tooling',
    'Generate or validate the root-level llms.txt orientation file. Narrow in scope, useful as one part of a wider workflow rather than a standalone strategy.',
  ],
  [
    'SEO suites adding GEO',
    'Established SEO platforms layering AI-visibility features onto existing crawls and dashboards. Convenient if you already run the suite; verify how the GEO score is computed before relying on it.',
  ],
] as const;

// Matrice comparativa categoria × criterio — volutamente category-level.
// Nessun nome o feature di vendor specifici: ogni cella descrive cosa fa
// tipicamente quel TIPO di tool, con hedging onesto ("usually/often/varies").
const CATEGORY_MATRIX = [
  {
    category: 'AI-readiness audit tools',
    bestAt: 'A baseline score and a prioritized fix list.',
    audit: 'Audit-first; some add tracking over time.',
    query: 'Usually no; they score on-page signals, not live answers.',
    cicd: 'Some can run in a pipeline.',
    pricing: 'Free to freemium.',
  },
  {
    category: 'Citation monitoring',
    bestAt: 'Tracking brand mentions and citations over time.',
    audit: 'Monitoring-first.',
    query: 'Yes; querying answer engines is the core function.',
    cicd: 'Rarely.',
    pricing: 'Mostly paid.',
  },
  {
    category: 'llms.txt tooling',
    bestAt: 'Generating or validating a root-level llms.txt.',
    audit: 'Neither; a narrow point utility.',
    query: 'No.',
    cicd: 'Occasionally, as a validation step.',
    pricing: 'Often free.',
  },
  {
    category: 'SEO suites adding GEO',
    bestAt: 'GEO features inside an existing SEO workflow.',
    audit: 'Both, layered onto existing crawls.',
    query: 'Varies; often on-page only.',
    cicd: 'Rarely.',
    pricing: 'Paid subscription.',
  },
] as const;

// Feature verificabili di GEO Optimizer — ogni voce è confermata nel repository.
const GEO_OPTIMIZER_FEATURES = [
  ['License', 'MIT, open-source. Scoring weights are public and readable in the repository.'],
  ['Distribution', 'Python package on PyPI, plus a command-line tool, a Python library, and an MCP server.'],
  ['Audit', 'Scores a site 0–100 across nine categories using 47 citability checks, 9 of them taken from the KDD 2024 GEO paper.'],
  ['CI/CD', 'Ships a GitHub Action that runs a full audit in a pipeline and can fail a build below a minimum score.'],
  ['Answer-engine querying', 'The geo citations command asks real answer engines whether your brand is mentioned and your domain is cited (bring your own API key).'],
  ['Hosted citation monitoring', 'The GeoReady hosted layer tracks AI answers over time: a free account gets 1 automated Perplexity answer check a week, and Agency adds AI answer snapshots (Perplexity automated, ChatGPT/Google by manual paste). One-off checks are free; saving history and monitoring are paid.'],
  ['Research basis', '9 of the 47 content checks come from the methods tested in the KDD 2024 GEO paper (arXiv:2311.09735). The scoring weights are a considered starting point, published so you can disagree with a specific number.'],
] as const;

// FAQ condivise tra markup visibile e JSON-LD (single source of truth).
const faqs = [
  {
    q: 'What makes a GEO tool worth using?',
    a: 'A GEO tool is worth using when you can verify how it works. The most useful signals are a transparent, published scoring methodology, support for both one-off audits and tracking over time, the ability to run in a pipeline rather than only in a browser, and methods grounded in citable research. A tool that hides its scoring logic gives you a number you cannot act on or contest.',
  },
  {
    q: 'Are there open-source GEO tools?',
    a: 'Yes. GEO Optimizer is an open-source, MIT-licensed toolkit whose scoring weights are published in the repository. Open-source tools let you read the methodology, fork it, and run it in your own environment, which matters when you want to understand exactly why a page scored the way it did.',
  },
  {
    q: 'What is the difference between an audit tool and citation monitoring?',
    a: 'An audit tool scores the on-page and technical signals that determine whether an AI engine can reach, understand, and quote your site — crawler access, structured data, quotable content. Citation monitoring asks a different question: does an answer engine actually mention your brand and cite your domain, and which competitors are cited instead. Readiness and outcome are related but distinct; the strongest workflows use both.',
  },
  {
    q: 'Can any GEO tool guarantee that ChatGPT or Perplexity will cite my site?',
    a: 'No. Citation behavior is probabilistic and changes every time a model is retrained or its retrieval index updates. No tool can guarantee a specific engine will cite you. What a good tool does is remove the technical and content barriers that prevent a model from finding, understanding, and quoting your pages, and measure whether you are cited today.',
  },
  {
    q: 'Should I use a dedicated GEO tool or the GEO features in my existing SEO suite?',
    a: 'It depends on how much you need to verify. SEO suites adding GEO features are convenient if you already run the platform, but the way the AI-visibility score is computed is often not published. A dedicated tool with a transparent methodology lets you audit the logic and reproduce the result. If accountability matters, prefer the tool whose scoring you can read.',
  },
  {
    q: 'What is the difference between GEO tools and AI visibility tools?',
    a: 'The terms are often used interchangeably, and in practice they describe overlapping categories. GEO tools — short for Generative Engine Optimization tools — help you structure a site so AI answer engines like ChatGPT and Perplexity can more easily find, understand, and evaluate its content. AI visibility tools is the broader label some vendors use for the same category, sometimes extending to citation monitoring and brand-mention tracking. When comparing products, check what the tool actually measures: a one-off readiness audit, ongoing citation monitoring, or both.',
  },
];

// Classe condivisa dei link nel corpo del testo (ricetta console).
const PROSE_LINK = 'text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep';
---

<Shell title={title} description={description} canonical={canonical}>
  <article class="mx-auto max-w-7xl px-4 py-10 sm:px-6 md:py-16">

    {/* Header — answer-first, visible to crawlers */}
    <header class="mb-12 md:mb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h1 class="max-w-3xl font-head text-3xl font-extrabold leading-[1.05] tracking-[-0.03em] text-ink md:text-4xl">
          Best GEO Tools for AI Search Visibility
        </h1>
        <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">GEO Optimizer · Tools</p>
      </div>

      <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft md:text-lg">
        The honest answer to "what is the best GEO tool" is that it depends on
        what you are trying to measure. The category is new, vendors define
        "AI visibility" differently, and a score is only useful if you can see how
        it was computed. Rather than rank products on claims we cannot verify,
        this guide evaluates the main categories of AI visibility and generative
        engine optimization tools against fixed criteria, gives you the questions
        to ask before you buy, and details one open-source option, GEO Optimizer,
        using only facts published in its repository.
      </p>

      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-ink-soft">
        GEO here means Generative Engine Optimization, not geographic or local SEO.
      </p>

      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-mute">
        This comparison is criteria-based and evolving. The GEO tooling landscape
        changes quickly; treat the criteria below as the durable part and any specific
        product as a snapshot to re-verify before you buy.
      </p>

      <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">
        Published June 16, 2026 · Last updated {dateModifiedLabel} · 8 min read
      </p>
    </header>

    <ArticleVisual
      src="/images/article-visuals/K1HeroGEOToolSelection.png"
      alt="Diagram showing how a GEO tool should expose methodology, monitoring, workflow fit, and evidence before a team trusts the score."
      caption="A useful GEO tool makes the evaluation method visible before asking you to trust the score."
      height={452}
    />

    {/* What "best" means in a new category */}
    <section class="mb-12 md:mb-16">
      <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">What "best" means in a category this young</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Generative Engine Optimization is the practice of structuring a site so AI
        answer engines like ChatGPT, Perplexity, Claude, and Gemini can crawl it,
        understand it, and cite it. The discipline is only a couple of years old, the
        underlying models change on their own schedule, and no tool controls whether a
        given engine cites you. That makes any ranked "top 10" list fragile: the
        rankings rest on methodologies that are rarely published and on outcomes no
        vendor can guarantee.
      </p>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        A more durable approach is to evaluate tools against fixed criteria and pick the
        one that fits your workflow. The sections below give you those criteria, then
        describe the categories of tool you will encounter so you know what each is
        good for before you compare specific products.
      </p>
    </section>

    {/* Evaluation criteria table */}
    <section class="mb-12 md:mb-16">
      <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">How to evaluate a GEO tool</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Score any candidate against these seven criteria. Each is a question you can
        answer by reading documentation or running a trial — not a claim you have to
        take on faith.
      </p>
      <div class="mt-6 overflow-x-auto rounded-[4px] border border-rail bg-white">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-paper">
            <tr class="border-b border-rail">
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Criterion</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Question to ask</th>
            </tr>
          </thead>
          <tbody>
            {EVALUATION_CRITERIA.map(([name, detail]) => (
              <tr class="border-b border-rail/60 align-top last:border-0">
                <th scope="row" class="whitespace-nowrap px-4 py-3 font-semibold text-ink">{name}</th>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Methodology transparency sits at the top for a reason: if you cannot see how a
        score is calculated, you cannot reproduce it, contest it, or learn from it. A
        published scoring model turns a number into a checklist you can act on.
      </p>
    </section>

    {/* First-party benchmark — what the audited cohort actually scores.
        Own measurements, not vendor claims: this is the part of the comparison no
        competitor can restate, and it gives an answer engine something quotable.
        Reso come "log well": l'unico materiale scuro della pagina. */}
    <section class="mb-12 md:mb-16">
      <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">What sites actually score, measured</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Criteria tell you how to judge a tool. They do not tell you how much room a
        typical site has to gain. We measured that: our data shows what sites score when
        the same open-source 100-point rubric is applied to every site audited through
        GeoReady. The baseline below is measurement, not estimation.
      </p>
      <div class="mt-6 overflow-hidden rounded-[4px] bg-well text-well-ink">
        <div class="flex items-center justify-between gap-3 border-b border-well-ink/15 px-6 py-3">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-well-mute">GeoReady benchmark · GET /api/public/benchmark</p>
          <span class="font-mono text-[11px] tracking-[0.08em] text-pass-light">exit 0</span>
        </div>
        <figure class="px-6 py-6 md:px-8">
          <blockquote>
            <p class="max-w-3xl text-lg leading-relaxed">
              The average audited site scores <strong class="font-semibold text-white">{BENCHMARK.average} out of 100</strong>,
              with a median of {BENCHMARK.median}. Only {BENCHMARK.llmsTxtAdoption} publish
              an llms.txt file and {BENCHMARK.schemaAdoption} ship JSON-LD schema, which
              makes {BENCHMARK.biggestGap} the single largest readiness gap in the sample.
            </p>
          </blockquote>
          <figcaption class="mt-4 font-mono text-[12px] leading-relaxed text-well-mute">
            GeoReady benchmark, {BENCHMARK.sampleLabel}, measured {BENCHMARK.measuredOn}.
            Latest audit per domain, aggregates only.
            <a href="/state-of-geo/" class="underline underline-offset-2 hover:text-well-ink">See the live benchmark</a>
            and the <a href="/methodology/" class="underline underline-offset-2 hover:text-well-ink">scoring methodology</a>.
          </figcaption>
        </figure>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Two things follow. First, a score in the fifties is ordinary rather than alarming
        — most sites are in the same position. Second, the gaps concentrate in signals a
        tool can find mechanically: a missing orientation file or absent structured data
        is a specific, fixable defect, not a matter of judgment. That is what an audit
        should hand you.
      </p>
      <h3 class="mt-8 font-head text-lg font-extrabold tracking-[-0.01em] text-ink">Methodology</h3>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft">
        Every figure above comes from one audit per domain — the most recent, with
        scheduled re-audits excluded so an actively monitored site cannot weight the
        average. Each site is scored by the same open-source engine on a published 100-point
        rubric. Audits run before engine 4.19.0 used the eight-category v1 rubric; the
        nine-category v2 rubric, which adds Google AI readiness, is the default since then.
        See the <a href="/methodology/" class="underline underline-offset-2 hover:text-ink">methodology</a>
        for the version in use. Only aggregates are published: no domain, URL, or identifier leaves
        the sample.
      </p>
      <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft">
        The limits are worth stating plainly. This is a benchmark of sites audited by
        GeoReady, not a survey of the whole web, and the sample skews toward teams already
        curious about AI visibility — a site whose owner ran an audit is not a random site.
        Read it as a directional baseline among sites that chose to measure, not a
        universal figure.
      </p>
    </section>


    {/* Tool categories */}
    <section class="mb-12 md:mb-16">
      <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">The main categories of GEO and AI visibility tools</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Tools in this space fall into a few broad categories. Most teams end up using
        more than one, because readiness and outcome are different things and few
        products do both well.
      </p>
      <div class="mt-6 grid gap-px overflow-hidden rounded-[4px] border border-rail bg-rail sm:grid-cols-2">
        {TOOL_CATEGORIES.map(([name, detail]) => (
          <div class="bg-white p-5">
            <h3 class="font-head text-lg font-extrabold tracking-[-0.01em] text-ink">{name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{detail}</p>
          </div>
        ))}
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        When you compare specific products, place each one in a category first. A
        citation monitor and an audit tool are not really competitors: they answer
        different questions, and judging one by the other's strengths is how
        misleading "best of" lists get written.
      </p>
    </section>

    {/* Category comparison matrix — category level; named tools follow in the next section */}
    <section class="mb-12 md:mb-16">
      <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">GEO tools compared, by category</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        This matrix compares the categories, not individual products, so it stays
        true as vendors come and go; named tools follow below. Use it to decide which kind of tool fits your
        question, then verify any specific product against the criteria above before
        you buy. "Varies" means the answer depends on the vendor and is worth
        checking yourself.
      </p>
      <div class="mt-6 overflow-x-auto rounded-[4px] border border-rail bg-white">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="bg-paper">
            <tr class="border-b border-rail">
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Tool category</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Best at</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Audit vs monitoring</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Answer-engine querying</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">CI/CD</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Pricing</th>
            </tr>
          </thead>
          <tbody>
            {CATEGORY_MATRIX.map((row) => (
              <tr class="border-b border-rail/60 align-top last:border-0">
                <th scope="row" class="px-4 py-3 font-semibold text-ink">{row.category}</th>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{row.bestAt}</td>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{row.audit}</td>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{row.query}</td>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{row.cicd}</td>
                <td class="px-4 py-3 leading-relaxed text-ink-soft">{row.pricing}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Most teams end up using more than one category, because readiness and outcome
        are different questions. The pattern that holds across all of them: the tool
        whose methodology you can read is the one you can trust the result from.
      </p>
    </section>

    {/* Named tools — facts as recorded on each comparison page, dated, not ranked */}
    <section class="mb-12 md:mb-16">
      <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">Named tools, as recorded on our comparison pages</h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
        Each row repeats facts from the linked comparison page, which cites the vendor's
        own pages and was checked between {NAMED_TOOLS_CHECKED}. The table is not a
        ranking and prices change, so confirm on the vendor's site before you buy. We
        build GeoReady, so read its row with that in mind.
      </p>
      <div class="mt-6 overflow-x-auto rounded-[4px] border border-rail bg-white">
        <table class="w-full min-w-[760px] text-left text-sm">
          <thead class="bg-paper">
            <tr class="border-b border-rail">
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Tool</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Free option</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Entry paid tier</th>
              <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Scoring weights</th>
            </tr>
          </thead>
          <tbody>
            {NAMED_TOOLS.map((row) => (
              <tr class="border-b border-rail/60 align-top last:border-0">
                <th scope="row" class="px-4 py-3 font-semibold text-ink"><a href={row.href} class="underline decoration-rail underline-offset-4 hover:decoration-ink">{row.name}</a></th>
