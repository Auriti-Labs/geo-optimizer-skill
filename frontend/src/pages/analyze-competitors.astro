---
import Shell from '../components/Shell.astro';
import AnalyzeCompetitorsContainer from '../components/compare/AnalyzeCompetitorsContainer';
import CompareSurface from '../components/product/CompareSurface.astro';

// FAQ visibili — riusate sia nel markup crawlable che nello schema FAQPage.
const faqs = [
  {
    question: 'What is competitor AI visibility analysis?',
    answer:
      'It runs the same GEO audit on your site and several competitor domains at once, then puts the scores next to each other. Instead of an isolated number, you see how ready each domain is to be cited by AI answer engines across the same nine signal categories: Google AI readiness, robots.txt, schema, content, brand and entity, meta, llms.txt, signals, and AI discovery.',
  },
  {
    question: 'How many competitors should I analyze at once?',
    answer:
      'Three to five direct rivals keeps the report readable and is enough to tell a category-wide blocker from a single weak site. That is a working rule, not a measured threshold. Pick the domains that already appear when you ask an AI engine "what is the best tool for X".',
  },
  {
    question: 'Does a higher GEO Score mean a competitor is cited more often?',
    answer:
      'The GEO Score measures readiness — the technical and content signals AI retrieval rewards — not live citation counts. A higher score means a domain has fewer blockers and stronger citable signals. This tool does not show that a higher score leads to more citations. To see who is actually cited for a given question, pair the analysis with a citation check.',
  },
  {
    question: 'When should I use head-to-head compare instead of multi-competitor analysis?',
    answer:
      'Use a single audit when you only need your own baseline. Use head-to-head compare when one rival matters most and you want a focused, two-column diff. Use multi-competitor analysis when you need to see a whole category at once and decide where you sit in the field.',
  },
  {
    question: 'Is the competitor analysis free?',
    answer:
      'Yes. The batch audit scores each domain on the open-source GEO scoring weights at no cost, with a fair-use limit per visitor. The audit reads only publicly available pages, the same content any AI crawler can fetch.',
  },
  {
    question: 'What do I do once I find a gap?',
    answer:
      'Sort the blockers by scoring weight and fix the highest-impact ones first. Google AI readiness is worth 20 points, and robots.txt, schema, and content are worth 14 each, so an access or indexing gap usually outranks a small meta or llms.txt tweak (6 points). Re-run the analysis after the fixes to confirm the gap closed relative to the same competitors.',
  },
];

// Passi della procedura mostrati nella sezione "How it works" della pagina.
const howToSteps = [
  {
    name: 'Enter your URL and competitor URLs',
    text: 'Add your own domain and the competitor domains you want to benchmark — the rivals that already surface in AI answers for your category.',
  },
  {
    name: 'Run the batch audit',
    text: 'Each domain is scored across the same nine GEO signal categories on a 100-point scale, so the results are directly comparable.',
  },
  {
    name: 'Read which domain AI engines are most ready to cite',
    text: 'Compare the scores and category breakdowns to see which site has the fewest blockers and the strongest citable signals for AI answer engines.',
  },
  {
    name: 'Prioritise fixes by scoring weight',
    text: 'Close the gaps that carry the most points first — Google AI readiness is worth 20 points, and robots.txt, schema, and content are worth 14 each — then re-run the analysis to confirm the gap narrowed.',
  },
];
---

<Shell
  title="Competitor AI Visibility Analysis: Benchmark 3-5 Sites"
  description="Run one GEO audit on your site and 3-5 competitors. See scores across nine categories and which gaps to fix first. Free, with a fair-use limit."
  canonical="https://geoready.dev/analyze-competitors/"
>
  <div class="mx-auto max-w-7xl bg-paper px-4 py-10 text-ink sm:px-6 md:py-16">
    {/* Static hero — visible to crawlers */}
    <header class="mb-8 md:mb-10">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.86fr)_minmax(420px,0.82fr)] lg:items-center">
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h1 class="max-w-3xl text-[2.3rem] font-semibold leading-[1.05] tracking-[-0.035em] text-ink sm:text-[3rem]">
              Competitor AI visibility analysis: benchmark your site against 3-5 rivals in one run.
            </h1>
            <div class="eyebrow">GeoReady · Competitors</div>
          </div>

          <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
            Enter multiple competitor URLs and run a batch GEO audit. See how each site scores for AI search visibility, citability, and technical readiness.
          </p>

          <div class="mt-8 grid gap-3 sm:grid-cols-3">
            {[
              ['Portfolio', 'Multiple domains in one run.'],
              ['Pattern', 'Shared blockers and winning signals.'],
              ['Priority', 'Where to focus before the next audit.'],
            ].map(([label, text]) => (
              <div class="border-l border-rail pl-4">
                <p class="text-sm font-semibold text-ink">{label}</p>
                <p class="mt-1 text-sm leading-relaxed text-ink-soft">{text}</p>
              </div>
            ))}
          </div>

          <div class="eyebrow mt-8">Last updated: October 2026</div>
        </div>

        <div class="flex items-center">
          <CompareSurface mode="leaderboard" variant="dark" class="w-full" />
        </div>
      </div>
    </header>

    {/* Static info section — visible to crawlers */}
    <section class="mb-10 grid gap-4 panel p-5 md:grid-cols-[minmax(0,0.46fr)_repeat(3,minmax(0,1fr))] md:p-6">
      <div>
        <h2 class="font-head text-lg font-semibold tracking-[-0.01em] text-ink">
          What competitor analysis checks
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          Every competitor is scored across the same categories so relative strengths are visible.
        </p>
      </div>
      {[
        ['Score', 'GEO Score across nine signal categories.'],
        ['Citability', 'Citation-oriented content and source signals.'],
        ['Readiness', 'Technical access, structure, and AI discovery.'],
      ].map(([label, text]) => (
        <div class="border-l border-rail pl-4">
          <p class="text-base font-semibold text-ink">{label}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{text}</p>
        </div>
      ))}
      <p class="text-sm text-ink-soft md:col-span-3 md:col-start-2">
        Need a focused two-site benchmark? <a href="/compare/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">Use side-by-side comparison</a>.
      </p>
    </section>

    {/* Interactive tool — hydrated by React */}
    <AnalyzeCompetitorsContainer client:only="react" />

    {/* Static, crawler-visible content — answer-first */}
    <div class="mx-auto mt-14 max-w-7xl space-y-12 md:mt-16 md:space-y-16 [&_h2]:font-head [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-ink [&_h2]:leading-tight [&_h2]:tracking-[-0.02em] [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-ink [&_p]:text-ink-soft [&_p]:leading-relaxed [&_li]:text-ink-soft [&_li]:leading-relaxed">

      <section data-reveal>
        <h2>When to map competitor AI visibility</h2>
        <p class="mt-4">
          Map competitor AI visibility when a single audit isn't enough to make
          a decision. A standalone score tells you where <em>you</em> stand; it
          doesn't tell you whether a 72 is leading your category or trailing it.
          Run a multi-competitor analysis when you're entering a crowded space,
          planning a content investment, or trying to explain to a stakeholder
          why a rival keeps showing up in ChatGPT and Perplexity answers and you
          don't.
        </p>
        <p class="mt-4">
          The analysis is most useful in three moments: before you commit
          budget to GEO work and want a baseline against the field; after a
          competitor's traffic or share of AI mentions shifts and you need to
          know what changed technically; and during a quarterly review, where a
          repeated run shows whether your relative position improved or the
          category as a whole moved.
        </p>
      </section>

      <section data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h2>What a competitor GEO gap reveals</h2>
          <div class="eyebrow">models/config.py · CATEGORY_MAX_V2 · Σ = 100 pts</div>
        </div>
        <p class="mt-4">
          A gap is the difference between your category breakdown and a rival's,
          read against the scoring weights. Because every domain is graded on
          the same 100-point scale across nine categories, a gap points to a
          specific, fixable cause rather than a vague "they rank better"
          feeling. The categories carry uneven weight, so where the gap sits
          matters more than how big it looks:
        </p>
        <ul class="mt-5 space-y-2 list-disc pl-5">
          <li><strong>Google AI readiness (20)</strong> — the technical conditions Google documents for its search and AI features: an indexable page, snippet controls, one canonical, consistent dates, a byline, crawlable links, a viewport tag, and a declared sitemap. A gap here is the most expensive single item.</li>
          <li><strong>robots.txt (14), schema (14), and content (14)</strong> — if a competitor lets AI crawlers in and you don't, no amount of content closes the distance. Valid structured data and quotable, well-structured content make a page easier for an engine to parse and attribute.</li>
          <li><strong>Brand &amp; entity (12) and meta (11)</strong> — consistent entity signals and clean title, description, and Open Graph tags are where a thin site falls behind a deep one.</li>
          <li><strong>llms.txt (6), signals (6), and AI discovery (3)</strong> — the orientation file, language declaration, freshness, and the AI discovery files are smaller but cheap to fix once spotted.</li>
        </ul>
        <p class="mt-4">
          A gap concentrated in the high-weight categories is a priority; a gap
          spread across the smallest categories (6 points or fewer) is housekeeping. Reading the gap
          by weight is what turns a comparison into a plan — the
          {' '}<a href="/citation-gap-analysis/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">citation gap analysis workflow</a>{' '}
          walks through that process end to end.
        </p>
      </section>

      <section data-reveal>
        <h2>A worked example (hypothetical): one SaaS against three rivals</h2>
        <p class="mt-4 text-sm text-ink-mute">
          An illustrative scenario, not data from real sites.
        </p>
        <p class="mt-4">
          A project-management SaaS keeps seeing one of its competitors cited
          when prospects ask an AI engine "what's the best tool for remote
          teams". It runs a multi-competitor analysis on its own domain plus
          three rivals. The breakdown is more informative than any single
          number:
        </p>
        <ul class="mt-5 space-y-2 list-disc pl-5">
          <li>All four sites have a strong meta and content profile — that's table stakes in the category, not a differentiator.</li>
          <li>The two most-cited rivals both publish an llms.txt and valid FAQ and Organization schema. The SaaS publishes neither.</li>
          <li>One rival blocks AI crawlers in robots.txt and scores lowest overall, confirming the cost of an access gap even with good content.</li>
        </ul>
        <p class="mt-4">
          The conclusion writes itself: the SaaS isn't losing on content, it's
          losing on technical signals that the cited rivals already have:
          structured data above all, then the llms.txt orientation file.
          Schema carries 14 points; llms.txt carries 6, so schema goes first. That's a two-week fix, not a
          quarter-long content project — and the analysis is what made the
          priority obvious. To confirm the change later, the team re-runs the
          analysis against the same three domains and watches the gap close.
        </p>
      </section>

      <section data-reveal>
        <h2>Single audit vs head-to-head vs multi-competitor</h2>
        <p class="mt-4">
          The three views answer different questions. Pick the smallest one that
          answers yours:
        </p>
        <ul class="mt-5 space-y-3" role="list">
          <li class="panel p-4">
            <strong>Single audit</strong> — your own baseline, one domain, full
            category breakdown. Start here to know where you stand before you
            look at anyone else. <a href="/ai-seo-audit/" data-cta="competitor_analysis_single_audit_link" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">Run a free GEO audit</a>.
          </li>
          <li class="panel p-4">
            <strong>Head-to-head compare</strong> — two domains, side by side,
            for when one rival matters most and you want a focused diff.
            {' '}<a href="/compare/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">Compare two sites</a>.
          </li>
          <li class="panel p-4">
            <strong>Multi-competitor analysis</strong> — your domain plus several
            rivals in one run, for reading a whole category and finding where you
            sit in the field. That's this page.
          </li>
        </ul>
      </section>

      <section data-reveal>
        <h2>How to run a competitor analysis</h2>
        <ol class="mt-5 space-y-3 list-decimal pl-5">
          {howToSteps.map((step) => (
            <li><strong>{step.name}.</strong> {step.text}</li>
          ))}
        </ol>
        <p class="mt-4">
          Earning citations is a function of the signals AI retrieval rewards —
          open access for AI crawlers, structured data, an llms.txt, quotable
          statistics, and multi-page topical coverage. The
          {' '}<a href="/guides/appear-in-chatgpt-perplexity/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">guide to appearing in ChatGPT and Perplexity</a>{' '}
          and the
          {' '}<a href="/guides/entity-authority/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">entity authority guide</a>{' '}
          cover the playbook behind the categories you're benchmarking.
        </p>
      </section>

      {/* FAQ visibili (stesse del FAQPage schema) */}
      <section data-reveal>
        <h2>Frequently asked questions</h2>
        <div class="panel mt-6 divide-y divide-rail overflow-hidden">
          {faqs.map((faq) => (
            <div class="p-6">
              <h3>{faq.question}</h3>
              <p class="mt-2">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  {/* Page-specific schema — WebPage + FAQPage in un unico @graph */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "name": "Competitor AI Visibility Analysis: Benchmark 3-5 Sites",
        "description": "Analyze competitor AI visibility with GeoReady. Compare multiple websites across GEO scores, citability, technical readiness, and AI search signals.",
        "url": "https://geoready.dev/analyze-competitors/",
        "author": { "@id": "https://geoready.dev/#organization" },
        "publisher": { "@id": "https://geoready.dev/#organization" },
        "datePublished": "2026-05-12",
        "dateModified": "2026-10-18",
        "mainEntity": {
          "@type": "WebApplication",
          "@id": "https://geoready.dev/analyze-competitors/#tool",
          "name": "GeoReady Competitor Analysis Tool",
          "applicationCategory": "DeveloperApplication",
          "operatingSystem": "Web",
          "isPartOf": { "@id": "https://geoready.dev/#webapp" },
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "featureList": [
            "Batch competitor GEO audit",
            "Citability benchmarking",
            "Technical signal comparison",
            "AI visibility scoring"
          ]
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      }
    ]
  })} />

</Shell>
