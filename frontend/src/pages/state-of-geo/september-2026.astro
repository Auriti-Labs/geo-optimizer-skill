---
import Shell from '../../components/Shell.astro';
import NewsletterSignup from '../../components/NewsletterSignup';
import ArticleVisual from '../../components/ArticleVisual.astro';

const title = 'State of GEO September 2026: 704-Site AI Search Benchmark';
const description =
  'State of GEO September 2026: 704 domains audited, avg GEO score 56.2/100, flat vs August. llms.txt adoption 57.4%; AI-crawler blocking fell to 8.8%.';
const canonical = 'https://geoready.dev/state-of-geo/september-2026/';
const datePublished = '2026-10-01';
const dateModified = '2026-10-01';

// Every figure below comes from the closed 1–30 Sep 2026 benchmark_audit_events
// export (source = 'web', latest audit per domain, UTC window). Prior-month
// figures are the ones already printed in the June/July/August editions.
const stats = {
  domains: 704,
  avgScore: 56.2,
  median: 58,
  p25: 46,
  p75: 69,
  minScore: 4,
  maxScore: 100,
  pctExcellent: 1.8,
  pctGood: 27.0,
  pctFoundation: 58.4,
  pctCritical: 12.8,
  nExcellent: 13,
  nGood: 190,
  nFoundation: 411,
  nCritical: 90,
  pctBelowGood: 71.2,
  pctGoodOrAbove: 28.8,
  pctLlmsTxt: 57.4,
  pctLlmsFull: 26.0,
  pctSchema: 77.4,
  pctOrgSchema: 61.5,
  pctWebSchema: 61.8,
  pctFaqSchema: 21.3,
  pctArticleSchema: 5.4,
  pctCanonical: 84.8,
  pctH1: 84.9,
  pctLang: 95.6,
  pctAnswerFirst: 81.1,
  pctContentFaq: 21.3,
  pctAiDiscovery: 15.2,
  pctBlockAnyBot: 8.8,
  pctBlockThreeBots: 5.1,
  avgBotsAllowed: 23.8,
  avgWordCount: 1331,
  llmsAdopters: 404,
  llmsFullFile: 183,
  llmsStub: 221,
  llmsStubShareOfAdopters: 54.7,
  corrLlmsWith: 65.3,
  corrLlmsWithout: 43.9,
  corrSchemaWith: 62.6,
  corrSchemaWithout: 34.1,
  corrFaqWith: 71.5,
  corrFaqWithout: 52.1,
  corrAnswerWith: 59.4,
  corrAnswerWithout: 42.5,
  // Skills-transfer cross-tab (share of cohort)
  xtabBoth: 48.9,
  xtabSchemaOnly: 28.6,
  xtabLlmsOnly: 8.5,
  xtabNeither: 14.1,
  // Returning domains audited in both August and September
  returning: 43,
  returningAvgAug: 55.7,
  returningAvgSep: 57.6,
  returningImproved: 15,
  returningDeclined: 11,
  returningFlat: 17,
  // Engine version that scored each cohort row (geo_optimizer_version)
  engineVersions: [
    { version: '4.17.1', released: '31 Aug 2026', rows: 289, change: 'Baseline for the month. Predates the 4.18.x detection changes below.' },
    { version: '4.18.1', released: '17 Sep 2026', rows: 55, change: 'LocalBusiness and ~25 Organization subtypes count as Organization schema; Brand & entity checks handle en-dash title separators and #about anchors. Includes 4.18.0 (12 Sep): CJK word counts no longer under-counted ~10×; the negative-signal check reads cleaned page text.' },
    { version: '4.18.2', released: '19 Sep 2026', rows: 259, change: 'Security patch (sitemap redirect validation). No scoring change described in the changelog.' },
    { version: '4.18.3', released: '22 Sep 2026', rows: 101, change: 'No scoring change applies to the figures in this report.' },
  ],
  categories: [
    { name: 'Meta tags', avg: 12.7, max: 14, pct: 90.7, augPct: 90.0, julPct: 88.6, junPct: 88.6 },
    { name: 'Content quality', avg: 9.9, max: 12, pct: 82.5, augPct: 78.3, julPct: 80.0, junPct: 80.0 },
    { name: 'Robots & crawler access', avg: 13.8, max: 18, pct: 76.7, augPct: 77.8, julPct: 76.1, junPct: 75.6 },
    { name: 'Technical signals', avg: 3.7, max: 6, pct: 61.7, augPct: 61.7, julPct: 61.7, junPct: 61.7 },
    { name: 'Schema markup', avg: 7.2, max: 16, pct: 45.0, augPct: 45.0, julPct: 42.5, junPct: 38.1 },
    { name: 'Brand & entity', avg: 4.1, max: 10, pct: 41.0, augPct: 41.0, julPct: 38.0, junPct: 38.0 },
    { name: 'LLMs.txt', avg: 7.1, max: 18, pct: 39.4, augPct: 43.3, julPct: 36.1, junPct: 38.9 },
    { name: 'AI discovery', avg: 0.5, max: 6, pct: 8.3, augPct: 10.0, julPct: 10.0, junPct: 8.3 },
  ],
  // TLDs with at least 8 domains in the September cohort
  tlds: [
    { tld: '.com', n: 375, avg: 56.6, pctLlms: 58.9, pctSchema: 80.0 },
    { tld: '.ai', n: 29, avg: 61.0, pctLlms: 75.9, pctSchema: 72.4 },
    { tld: '.fr', n: 25, avg: 57.0, pctLlms: 40.0, pctSchema: 92.0 },
    { tld: '.de', n: 24, avg: 60.3, pctLlms: 54.2, pctSchema: 83.3 },
    { tld: '.ca', n: 15, avg: 54.6, pctLlms: 66.7, pctSchema: 60.0 },
    { tld: '.io', n: 15, avg: 56.5, pctLlms: 66.7, pctSchema: 80.0 },
    { tld: '.org', n: 13, avg: 41.8, pctLlms: 23.1, pctSchema: 53.8 },
    { tld: '.app', n: 12, avg: 56.3, pctLlms: 66.7, pctSchema: 83.3 },
    { tld: '.net', n: 12, avg: 55.9, pctLlms: 50.0, pctSchema: 75.0 },
    { tld: '.it', n: 10, avg: 49.8, pctLlms: 40.0, pctSchema: 40.0 },
    { tld: '.cn', n: 10, avg: 40.5, pctLlms: 60.0, pctSchema: 30.0 },
    { tld: '.in', n: 9, avg: 50.3, pctLlms: 33.3, pctSchema: 55.6 },
    { tld: '.cz', n: 8, avg: 46.5, pctLlms: 62.5, pctSchema: 37.5 },
    { tld: '.dev', n: 8, avg: 56.5, pctLlms: 62.5, pctSchema: 75.0 },
    { tld: '.nl', n: 8, avg: 69.8, pctLlms: 87.5, pctSchema: 100.0 },
  ],
};

const faqs = [
  {
    question: 'What is the average GEO score in September 2026?',
    answer: `The average GEO score across 704 unique domains audited by GeoReady in September 2026 is 56.2 out of 100, essentially flat versus August's 56.4 (−0.2) and the first month since the benchmark began in which the average did not rise. The median is 58. 28.8% of audited sites reach the "Good" band (68–85) or above, versus 29.1% in August; 71.2% sit below Good. The sample grew from 282 to 704 domains, so the cohort is a different population from August's.`,
  },
  {
    question: 'Why are September 2026 month-over-month changes only indicative?',
    answer: `September's rows were scored by four engine versions — 4.17.1 (289 domains), 4.18.1 (55), 4.18.2 (259) and 4.18.3 (101) — whereas August's cohort was scored predominantly on 4.16.2. Releases during the month changed detection in ways that can affect the score: LocalBusiness and its subtypes now count as Organization schema, several Brand & entity checks were corrected, and CJK word counts are no longer under-counted (4.18.0 and 4.18.1; 415 of the 704 domains were scored on 4.18.1 or later). A month-over-month delta therefore mixes behaviour change, a different population and engine changes.`,
  },
  {
    question: 'Did llms.txt adoption fall in September 2026?',
    answer: `The measured rate fell from 62.8% in August to 57.4% in September, and full, structured files from 30.1% to 26.0%. Read it with two caveats. The cohort is 2.5 times larger and largely new. And an llms.txt that a CDN or WAF serves to the auditor with a 403 or 406 is counted as absent — in this edition as in every earlier one — so 57.4%, like the prior months' figures, is a floor rather than an exact level. Because the same limitation applied to August, it does not explain the drop. Of the 404 sites with a file, 54.7% publish a thin stub.`,
  },
  {
    question: 'What is the biggest AI search readiness gap in September 2026?',
    answer: `AI Discovery, for the fourth month running. Only 15.2% of audited sites expose any AI discovery endpoint (such as /.well-known/ai.txt), and the average AI Discovery score is 0.5 out of 6 points — 8.3% efficiency, the lowest of the eight categories. Across four editions efficiency reads 8.3% → 10.0% → 10.0% → 8.3%, and adoption 16.0% → 17.5% → 16.7% → 15.2%.`,
  },
  {
    question: 'Are more sites blocking AI crawlers in September 2026?',
    answer: `No — fewer. 8.8% of audited sites block at least one major AI crawler in robots.txt, down from 14.2% in August and below July's 9.7%; 5.1% block three or more (10.6% in August). The August edition reported the first rise in blocking; September did not continue it. The series is not monotonic, and with a population that changes every month, one month's move in either direction is not a trend. The average site still explicitly allows 23.8 AI bots.`,
  },
  {
    question: 'Which TLD leads AI search readiness in September 2026?',
    answer: `Among TLDs with at least eight domains, .nl has the highest average at 69.8 (87.5% llms.txt, 100% schema), but on only 8 domains. Among larger groups, .ai averages 61.0 across 29 domains with 75.9% llms.txt adoption, and .de 60.3 across 24. .com, with 375 of the 704 domains, sits at 56.6, close to the overall average. .cn (40.5) and .org (41.8) are lowest. Most TLD groups are small, so single-TLD figures swing a lot from month to month.`,
  },
  {
    question: 'How does this benchmark compare to the whole web?',
    answer: `This is a benchmark of sites that chose to audit with GeoReady, not a random sample of the web. Only 43 of September's 704 domains were also in August's cohort, so each monthly edition is largely an independent sample shaped by who visited GeoReady that month. The cohort skews toward teams already interested in AI visibility, so these figures almost certainly overestimate readiness across all websites. Read month-over-month deltas as directional — and, this month, as partly an engine-version effect.`,
  },
];

// Recurring mono annotation: sample and window as declared in the Methodology
// section (704 domains, 1–30 September 2026). No invented figures.
const SAMPLE_NOTE = 'n = 704 · 1–30 Sep 2026';
---

<Shell title={title} description={description} canonical={canonical}>
  <article itemscope itemtype="https://schema.org/Article" class="bg-paper font-text text-ink">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">

      {/* ── Header ─────────────────────────────────────────────────────────── */}
      <header class="mb-12 max-w-3xl">
        <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-ink-mute">
          <a href="/" class="transition-colors hover:text-ink">GeoReady</a>
          <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true" />
          <a href="/state-of-geo/" class="transition-colors hover:text-ink">State of GEO</a>
          <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true" />
          <span>September 2026</span>
        </nav>

        <h1 itemprop="headline" class="font-head text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] text-ink md:text-5xl">
          State of GEO: September 2026
        </h1>
        <p class="mt-2 font-head text-xl font-bold tracking-[-0.02em] text-ink-soft md:text-2xl">
          AI Search Readiness Across 704 Domains
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <span class="rounded-[2px] border border-rail px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-mute">
            September 2026 Report
          </span>
          <span class="font-mono text-[11px] text-ink-mute">704 domains · Published <time datetime="2026-10-01">1 October 2026</time></span>
        </div>

        <p class="mt-5 text-base leading-relaxed text-ink-soft md:text-lg" itemprop="description">
          In September 2026 (1–30 September), the <strong class="text-ink">704 unique domains</strong> audited by GeoReady averaged a GEO score of <strong class="text-ink">56.2 out of 100</strong> — flat versus August's 56.4, while the sample grew from 282 domains. 28.8% reached the "Good" band or better, 57.4% had a detectable llms.txt, and 8.8% blocked at least one AI crawler. This fourth edition is the first in which the average did not rise. It also comes with a caveat the earlier ones did not need: September's rows were scored by <a href="#engine-versions" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">four engine versions</a>, with Organization-schema, Brand &amp; entity and CJK detection changes landing mid-month. Month-over-month deltas are indicative, not purely behavioural.
        </p>

        <meta itemprop="datePublished" content={datePublished} />
        <meta itemprop="dateModified" content={dateModified} />
        <meta itemprop="author" content="Juan Camilo Auriti" />
      </header>

      <ArticleVisual
        src="/images/article-visuals/L1HeroBenchmarkDistribution.png"
        alt="Benchmark distribution diagram showing audited sites grouped by AI search readiness band, with most still below the Good threshold."
        caption="September 2026: 704 domains scored on the GEO Optimizer 100-point rubric. 71.2% still sit below the Good threshold."
        height={452}
      />

      {/* ── Executive summary — the page's single dark well: frames the month's
          main measured result (first-party data). Stat ids are dated anchors. ── */}
      <section class="mb-12 overflow-hidden rounded-[4px] bg-well text-well-ink" aria-label="Executive summary — September 2026">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-well-ink/15 px-6 py-3">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-well-mute">Executive summary — September 2026</p>
          <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-well-mute">{SAMPLE_NOTE}</span>
        </div>
        <div class="px-6 py-6 md:px-8">
          <div class="grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
            <div id="avg-score-september-2026">
              <p class="font-head text-3xl font-extrabold tabular-nums tracking-[-0.02em] text-white">{stats.avgScore}</p>
              <p class="mt-1 text-xs leading-relaxed text-well-mute">avg GEO score / 100 <span>(−0.2 vs August)</span></p>
            </div>
            <div id="domains-september-2026">
              <p class="font-head text-3xl font-extrabold tabular-nums tracking-[-0.02em] text-white">{stats.domains}</p>
              <p class="mt-1 text-xs leading-relaxed text-well-mute">unique domains <span>(+422 vs August)</span></p>
            </div>
            <div id="llms-txt-september-2026">
              <p class="font-head text-3xl font-extrabold tabular-nums tracking-[-0.02em] text-white">{stats.pctLlmsTxt}%</p>
              <p class="mt-1 text-xs leading-relaxed text-well-mute">have llms.txt <span>(−5.4pp vs August; a lower bound in both months)</span></p>
            </div>
            <div id="good-or-better-september-2026">
              <p class="font-head text-3xl font-extrabold tabular-nums tracking-[-0.02em] text-white">{stats.pctGoodOrAbove}%</p>
              <p class="mt-1 text-xs leading-relaxed text-well-mute">Good or better <span>(−0.3pp vs August)</span></p>
            </div>
          </div>
          <ul class="mt-6 space-y-2 text-sm leading-relaxed text-well-ink">
            <li class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-well-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              <span>The sample grew from 282 to 704 domains and the average stayed flat (56.4 → 56.2). After 20.8% → 24.7% → 29.1%, the Good-or-better share paused at 28.8%.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-well-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              <span>Four engine versions scored this cohort. 289 domains (41.1%) were audited on 4.17.1, before the month's detection changes; the other 415 on 4.18.1 or later. August was scored predominantly on 4.16.2.</span>
            </li>
            <li id="ai-crawler-blocking-september-2026" class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-well-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              <span>AI-crawler blocking fell back to 8.8% after August's first-ever rise to 14.2%. The series (9.7% → 14.2% → 8.8%) is not monotonic.</span>
            </li>
            <li id="ai-discovery-september-2026" class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-well-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              <span>AI Discovery is the lowest category for the fourth month: 8.3% efficiency, 15.2% adoption.</span>
            </li>
          </ul>
        </div>
        <div class="border-t border-well-ink/15 px-6 py-3">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-well-mute">source: benchmark_audit_events · closed window 1–30 Sep 2026</p>
        </div>
      </section>

      <div class="space-y-14 leading-relaxed text-ink-soft [&_h2]:font-head [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:leading-tight [&_h2]:tracking-[-0.02em] [&_h2]:text-ink [&_h3]:font-head [&_h3]:text-lg [&_h3]:font-extrabold [&_h3]:tracking-[-0.01em] [&_h3]:text-ink [&_p]:text-ink-soft [&_p]:leading-relaxed [&_li]:text-ink-soft [&_li]:leading-relaxed">

        {/* ── 1. Engine-version mix — read before any month-over-month delta ── */}
        <section id="engine-versions">
          <h2>Read this first: four engine versions in one month</h2>
          <p class="mt-4">
            Every earlier edition was scored on a near-single engine version — August's cohort was scored predominantly on 4.16.2. September's was not. The audit engine shipped several releases during the month, and each domain's latest audit was scored by whichever version was live that day:
          </p>

          <div class="mt-6 overflow-hidden rounded-[4px] border border-rail bg-white">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
              <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">engine version mix</span>
              <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">{SAMPLE_NOTE}</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[640px] text-left text-sm">
                <caption class="sr-only">Engine versions that scored the September 2026 cohort</caption>
                <thead>
                  <tr class="border-b border-rail bg-paper">
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Version</th>
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Released</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Domains</th>
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Scoring-relevant change</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-rail">
                  {stats.engineVersions.map((row) => (
                    <tr>
                      <th scope="row" class="px-4 py-3 text-left font-mono font-semibold text-ink">{row.version}</th>
                      <td class="px-4 py-3 font-mono tabular-nums text-ink-mute">{row.released}</td>
                      <td class="px-4 py-3 text-right font-mono font-semibold tabular-nums text-ink">{row.rows}</td>
                      <td class="px-4 py-3 text-xs">{row.change}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <p class="mt-5">
            Three groups of changes matter for this report, all in 4.18.0 and 4.18.1 — so in this cohort they reach the 415 domains audited on 4.18.1 or later. <strong class="text-ink">Organization schema:</strong> before 4.18.1, only the literal <code class="text-sm font-mono">Organization</code> type counted, so a site marked up as <code class="text-sm font-mono">LocalBusiness</code> or a subtype such as <code class="text-sm font-mono">Restaurant</code> scored as having no Organization schema and lost Brand &amp; entity credit. <strong class="text-ink">Brand &amp; entity detection:</strong> 4.18.1 also cuts titles at an en-dash separator when comparing brand names, and recognises same-page About links such as <code class="text-sm font-mono">#about</code> on single-page sites. <strong class="text-ink">Content:</strong> before 4.18.0, Chinese, Japanese and Korean pages were measured roughly ten times too short, which affected the word-count and front-loading checks and the llms.txt depth points (31 of the 704 September domains, 4.4%, declare a CJK page language); 4.18.0 also made the negative-signal check read the same cleaned page text as the other checks, so a large <code class="text-sm font-mono">&lt;noscript&gt;</code> fallback menu is no longer mistaken for keyword-stuffed copy.
          </p>
          <p class="mt-4">
            These changes were made to correct missed credit and false penalties. Two consequences follow. First, 289 domains (41.1%) were scored on 4.17.1, before any of them, and August was scored predominantly on 4.16.2, which also lacked them. Second, <em>our interpretation</em> is that they are more likely to raise a September figure than to lower it — but their effect was not measured, and a change such as the brand-name separator can move an individual site's comparison either way. Every release is documented in the <a href="https://github.com/Auriti-Labs/geo-optimizer-skill/blob/main/CHANGELOG.md" target="_blank" rel="noopener noreferrer" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">public changelog</a>.
          </p>
        </section>

        {/* ── 2. Score distribution ──────────────────────────────────────────── */}
        <section id="score-distribution">
          <h2>Score distribution: a bigger sample, a flat average</h2>
          <p class="mt-4">
            The average GEO score across {stats.domains} unique domains is <strong class="text-ink">{stats.avgScore} out of 100</strong> — 0.2 points below August's 56.4, and still above July's 54.1 and June's 53.6. The median is {stats.median}, with the bottom quarter of sites scoring at or below {stats.p25} and the top quarter at or above {stats.p75}. The highest score is {stats.maxScore}; the lowest is {stats.minScore}. After two consecutive increases, this is the first month the average did not rise — in a cohort that is two and a half times larger than August's and, for the most part, made of different sites.
          </p>
          <p class="mt-4">
            The band breakdown moved only slightly:
          </p>

          <div class="mt-6 overflow-hidden rounded-[4px] border border-rail bg-white">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
              <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">score bands</span>
              <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">{SAMPLE_NOTE}</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[640px] text-left text-sm">
                <caption class="sr-only">Score bands, September 2026 versus August 2026</caption>
                <thead>
                  <tr class="border-b border-rail bg-paper">
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Band</th>
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Score range</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Domains</th>
