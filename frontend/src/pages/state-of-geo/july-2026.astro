---
import Shell from '../../components/Shell.astro';
import NewsletterSignup from '../../components/NewsletterSignup';
import ArticleVisual from '../../components/ArticleVisual.astro';

const title = 'State of GEO: July 2026 — AI Search Readiness Benchmark Report';
const description =
  'The July 2026 State of GEO report analyzes 360 unique domains for AI search readiness. Average GEO score: 54.1/100. Only 24.7% of sites reach "Good" or above. Schema adoption rose 5.5pp while llms.txt slipped 4.1pp month-over-month. Full category breakdown, TLD data, and actionable insights.';
const canonical = 'https://geoready.dev/state-of-geo/july-2026/';
const datePublished = '2026-08-03';
const dateModified = '2026-08-03';

const stats = {
  domains: 360,
  avgScore: 54.1,
  median: 55,
  p25: 43,
  p75: 67,
  minScore: 6,
  maxScore: 100,
  pctExcellent: 1.9,
  pctGood: 22.8,
  pctFoundation: 61.1,
  pctCritical: 14.2,
  pctBelowGood: 75.3,
  pctLlmsTxt: 54.2,
  pctLlmsFull: 26.9,
  pctSchema: 75.6,
  pctOrgSchema: 52.2,
  pctWebSchema: 58.9,
  pctFaqSchema: 18.1,
  pctCanonical: 82.8,
  pctH1: 80.6,
  pctLang: 95.0,
  pctAnswerFirst: 78.6,
  pctContentFaq: 18.1,
  pctAiDiscovery: 17.5,
  avgBotsAllowed: 23.2,
  avgWordCount: 1157,
  categories: [
    { name: 'Meta tags', avg: 12.4, max: 14, pct: 88.6 },
    { name: 'Content quality', avg: 9.6, max: 12, pct: 80.0 },
    { name: 'Robots & crawler access', avg: 13.7, max: 18, pct: 76.1 },
    { name: 'Technical signals', avg: 3.7, max: 6, pct: 61.7 },
    { name: 'LLMs.txt', avg: 6.5, max: 18, pct: 36.1 },
    { name: 'Schema markup', avg: 6.8, max: 16, pct: 42.5 },
    { name: 'Brand & entity', avg: 3.8, max: 10, pct: 38.0 },
    { name: 'AI discovery', avg: 0.6, max: 6, pct: 10.0 },
  ],
  tlds: [
    { tld: '.com', n: 199, avg: 53.3, pctLlms: 49.7, pctSchema: 74.9 },
    { tld: '.ai', n: 17, avg: 57.8, pctLlms: 82.4, pctSchema: 70.6 },
    { tld: '.org', n: 12, avg: 50.8, pctLlms: 41.7, pctSchema: 91.7 },
    { tld: '.de', n: 10, avg: 46.6, pctLlms: 30.0, pctSchema: 80.0 },
    { tld: '.it', n: 8, avg: 61.4, pctLlms: 50.0, pctSchema: 100.0 },
    { tld: '.co', n: 6, avg: 59.3, pctLlms: 100.0, pctSchema: 83.3 },
    { tld: '.fr', n: 6, avg: 64.2, pctLlms: 66.7, pctSchema: 100.0 },
    { tld: '.dev', n: 6, avg: 59.8, pctLlms: 66.7, pctSchema: 83.3 },
    { tld: '.net', n: 6, avg: 50.8, pctLlms: 50.0, pctSchema: 66.7 },
    { tld: '.cn', n: 5, avg: 35.6, pctLlms: 60.0, pctSchema: 40.0 },
    { tld: '.cz', n: 5, avg: 47.8, pctLlms: 20.0, pctSchema: 60.0 },
    { tld: '.hk', n: 4, avg: 63.3, pctLlms: 75.0, pctSchema: 100.0 },
  ],
  // Confronto June 2026 per la sezione month-over-month
  june: {
    domains: 288,
    avgScore: 53.6,
    median: 57,
    p25: 44,
    p75: 66,
    minScore: 7,
    maxScore: 90,
    pctExcellent: 1.4,
    pctGood: 19.4,
    pctFoundation: 64.6,
    pctCritical: 14.6,
    pctBelowGood: 79.2,
    pctLlmsTxt: 58.3,
    pctLlmsFull: 27.8,
    pctSchema: 70.1,
    pctOrgSchema: 51.0,
    pctWebSchema: 52.4,
    pctFaqSchema: 13.2,
    pctCanonical: 81.6,
    pctH1: 81.3,
    pctLang: 93.4,
    pctAnswerFirst: 77.1,
    pctContentFaq: 13.2,
    pctAiDiscovery: 16.0,
    avgBotsAllowed: 23.3,
    avgWordCount: 1224,
    categories: [
      { name: 'Meta tags', avg: 12.4, max: 14, pct: 88.6 },
      { name: 'Content quality', avg: 9.6, max: 12, pct: 80.0 },
      { name: 'Robots & crawler access', avg: 13.6, max: 18, pct: 75.6 },
      { name: 'Technical signals', avg: 3.7, max: 6, pct: 61.7 },
      { name: 'LLMs.txt', avg: 7.0, max: 18, pct: 38.9 },
      { name: 'Schema markup', avg: 6.1, max: 16, pct: 38.1 },
      { name: 'Brand & entity', avg: 3.8, max: 10, pct: 38.0 },
      { name: 'AI discovery', avg: 0.5, max: 6, pct: 8.3 },
    ],
  },
};

const faqs = [
  {
    question: 'What is the average GEO score in July 2026?',
    answer: `The average GEO score across 360 unique domains audited by GeoReady in July 2026 is 54.1 out of 100. The median is 55, meaning half of audited sites score below that threshold. Only 24.7% of sites reach the "Good" band (68–85) or above — up from 20.8% in June. The average improved by just 0.5 points month-over-month, but the distribution shifted meaningfully toward higher bands.`,
  },
  {
    question: 'How did the dataset change between June and July 2026?',
    answer: `The cohort grew from 288 to 360 domains — a 25% increase, with 72 new domains added. Despite the larger sample, the average score held steady at 54.1 (up 0.5 from 53.6 in June). The share of sites in the Good or Excellent band rose from 20.8% to 24.7%, a 3.9 percentage-point improvement. The first perfect 100-point score appeared in July, up from a maximum of 90 in June.`,
  },
  {
    question: 'Did llms.txt adoption increase or decrease in July 2026?',
    answer: `llms.txt adoption decreased from 58.3% in June to 54.2% in July — a 4.1 percentage-point regression. This is likely a dilution effect: many of the 72 new domains added to the cohort do not have an llms.txt file, pulling the overall rate down despite the absolute number of adopters growing. Full, structured llms.txt files remained flat at 26.9% (vs 27.8% in June).`,
  },
  {
    question: 'What is the biggest AI search readiness gap in July 2026?',
    answer: `AI Discovery remains the single largest gap: only 17.5% of audited sites expose any AI discovery endpoint (up from 16.0% in June), and the average AI Discovery score is just 0.6 out of 6 points — a 10.0% efficiency rate, up from 8.3% in June. While there is marginal improvement, AI Discovery is still the category where the most points are left on the table by a wide margin.`,
  },
  {
    question: 'Which schema type saw the biggest adoption gain in July 2026?',
    answer: `WebSite schema saw the largest gain, rising from 52.4% in June to 58.9% in July — a 6.5 percentage-point increase. FAQ schema also grew notably, from 13.2% to 18.1% (+4.9 pp). Overall schema markup adoption rose from 70.1% to 75.6% (+5.5 pp), the biggest adoption gain of any signal in the dataset. Schema category efficiency improved from 38.1% to 42.5%.`,
  },
  {
    question: 'Which TLD had the strongest debut in July 2026?',
    answer: `.fr domains entered the dataset with the highest average score of any TLD at 64.2, with 100% schema adoption and 66.7% llms.txt adoption. .hk domains also debuted strongly at 63.3 average with 100% schema adoption. Italian .it domains improved dramatically from June: average score rose from 54.3 to 61.4, schema adoption from 81% to 100%, and llms.txt from 33.3% to 50.0%.`,
  },
  {
    question: 'How does this benchmark compare to the whole web?',
    answer: `This is a benchmark of sites that chose to audit with GeoReady — not a random sample of the entire web. The cohort grew 25% from June to July, and the new entrants skew the averages. The cohort still skews toward teams already curious about AI visibility, which means these scores likely overestimate average readiness. Real-world averages across all websites are almost certainly lower.`,
  },
];
---

<Shell title={title} description={description} canonical={canonical}>
  <article itemscope itemtype="https://schema.org/Article">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">

      {/* ── Header ─────────────────────────────────────────────────────────── */}
      <header class="mb-12 max-w-3xl">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[10px] font-mono text-text-muted uppercase tracking-wider mb-4">
          <a href="/" class="hover:text-accent-teal">GeoReady</a>
          <span class="w-1 h-1 rounded-full bg-text-muted" />
          <a href="/state-of-geo/" class="hover:text-accent-teal">State of GEO</a>
          <span class="w-1 h-1 rounded-full bg-text-muted" />
          <span>July 2026</span>
        </nav>

        <div class="flex items-center gap-2 mb-4">
          <span class="text-[11px] font-mono font-semibold bg-accent-teal/10 text-accent-teal border border-accent-teal/20 px-2.5 py-1 rounded-full uppercase tracking-wider">
            July 2026 Report
          </span>
          <span class="text-[11px] font-mono text-text-muted">360 domains · Published 3 August 2026</span>
        </div>

        <h1 itemprop="headline" class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary leading-tight tracking-tight">
          State of GEO: July 2026
        </h1>
        <p class="mt-2 font-display text-xl md:text-2xl font-semibold text-text-secondary">
          AI Search Readiness Across 360 Domains
        </p>

        <p class="mt-5 text-base md:text-lg text-text-secondary leading-relaxed" itemprop="description">
          The second edition of the State of GEO benchmark covers <strong class="text-text-primary">360 unique domains</strong> — a 25% growth from June's 288 — scored across 8 categories, 100 points, and the same consistent rubric. The average score edged up 0.5 points to 54.1, but the distribution tells a more interesting story: the share of sites reaching "Good" or above climbed from 20.8% to 24.7%, schema adoption jumped 5.5 percentage points, and the first perfect 100-point score appeared. At the same time, llms.txt adoption slipped 4.1 points — a regression driven by the 72 new domains entering the cohort without AI-specific signals.
        </p>

        <meta itemprop="datePublished" content={datePublished} />
        <meta itemprop="dateModified" content={dateModified} />
        <meta itemprop="author" content="Juan Camilo Auriti" />
      </header>

      {/* ── Executive summary box ───────────────────────────────────────────── */}
      <section class="rounded-2xl border border-accent-teal/30 bg-accent-teal/5 p-6 mb-12 not-prose">
        <p class="text-xs font-mono text-accent-teal uppercase tracking-wider mb-4">Executive summary — July 2026</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
          <div>
            <p class="text-3xl font-bold text-text-primary">{stats.avgScore}</p>
            <p class="text-xs text-text-muted mt-0.5">avg GEO score / 100 <span class="text-accent-teal">(+0.5 vs June)</span></p>
          </div>
          <div>
            <p class="text-3xl font-bold text-text-primary">{stats.domains}</p>
            <p class="text-xs text-text-muted mt-0.5">unique domains <span class="text-accent-teal">(+72 vs June)</span></p>
          </div>
          <div>
            <p class="text-3xl font-bold text-text-primary">{stats.pctSchema}%</p>
            <p class="text-xs text-text-muted mt-0.5">have schema markup <span class="text-accent-teal">(+5.5pp vs June)</span></p>
          </div>
          <div>
            <p class="text-3xl font-bold text-text-primary">{stats.pctBelowGood}%</p>
            <p class="text-xs text-text-muted mt-0.5">Foundation or Critical <span class="text-accent-teal">(-3.9pp vs June)</span></p>
          </div>
        </div>
        <ul class="space-y-1.5 text-sm text-text-secondary">
          <li class="flex items-start gap-2"><span class="text-accent-teal mt-0.5">→</span> <span>The cohort grew 25% (288 → 360 domains) while the average score held steady at 54.1 — the new entrants did not drag the average down, suggesting broader awareness of AI readiness beyond early adopters.</span></li>
          <li class="flex items-start gap-2"><span class="text-accent-teal mt-0.5">→</span> <span>Schema adoption was the biggest mover: 70.1% → 75.6% (+5.5pp). WebSite schema alone jumped from 52.4% to 58.9% (+6.5pp), and FAQ schema grew from 13.2% to 18.1% (+4.9pp).</span></li>
          <li class="flex items-start gap-2"><span class="text-accent-teal mt-0.5">→</span> <span>llms.txt adoption regressed: 58.3% → 54.2% (-4.1pp). The 72 new domains are the likely cause — they have not yet adopted AI-specific signals even as they embrace traditional schema.</span></li>
          <li class="flex items-start gap-2"><span class="text-accent-teal mt-0.5">→</span> <span>The first perfect 100-point score appeared in July (max went from 90 to 100), and 7 domains reached the Excellent band (86+), up from 4 in June.</span></li>
        </ul>
      </section>

      <div class="space-y-14 text-text-secondary leading-relaxed [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-text-primary [&_h2]:leading-tight [&_h2]:tracking-tight [&_h3]:font-display [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-text-primary [&_p]:text-text-secondary [&_p]:leading-relaxed">

        {/* ── 1. Score distribution ──────────────────────────────────────────── */}
        <section>
          <h2>Score distribution: 75% still below the Good threshold</h2>
          <p class="mt-4">
            The average GEO score across {stats.domains} unique domains is <strong class="text-text-primary">{stats.avgScore} out of 100</strong> — up 0.5 points from June's 53.6. The median is {stats.median}, with the bottom quarter of sites scoring at or below {stats.p25} and the top quarter at or above {stats.p75}. The highest score in the dataset is {stats.maxScore} — the first perfect 100 in the benchmark's history, up from a maximum of 90 in June. The lowest is {stats.minScore}.
          </p>
          <p class="mt-4">
            The band breakdown shows a meaningful shift toward higher tiers compared to June:
          </p>

          <div class="mt-6 overflow-x-auto rounded-xl border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-bg-subtle text-text-muted text-[11px] font-mono uppercase tracking-wider">
                  <th class="px-4 py-3 text-left border-b border-border">Band</th>
                  <th class="px-4 py-3 text-left border-b border-border">Score range</th>
                  <th class="px-4 py-3 text-right border-b border-border">Domains</th>
                  <th class="px-4 py-3 text-right border-b border-border">Share</th>
                  <th class="px-4 py-3 text-right border-b border-border">June 2026</th>
                  <th class="px-4 py-3 text-left border-b border-border">What it means</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                <tr class="bg-bg-surface">
                  <td class="px-4 py-3 font-semibold text-accent-success">Excellent</td>
                  <td class="px-4 py-3 font-mono">86–100</td>
                  <td class="px-4 py-3 text-right font-mono">7</td>
                  <td class="px-4 py-3 text-right font-mono text-accent-success">1.9%</td>
                  <td class="px-4 py-3 text-right font-mono text-text-muted">1.4% (4)</td>
                  <td class="px-4 py-3 text-xs">All 8 categories well covered. Citable by AI with confidence.</td>
                </tr>
                <tr class="bg-bg-base">
                  <td class="px-4 py-3 font-semibold text-accent-teal">Good</td>
                  <td class="px-4 py-3 font-mono">68–85</td>
                  <td class="px-4 py-3 text-right font-mono">82</td>
                  <td class="px-4 py-3 text-right font-mono text-accent-teal">22.8%</td>
                  <td class="px-4 py-3 text-right font-mono text-text-muted">19.4% (56)</td>
                  <td class="px-4 py-3 text-xs">Strong fundamentals. Minor gaps in entity signals or AI discovery.</td>
                </tr>
                <tr class="bg-bg-surface">
                  <td class="px-4 py-3 font-semibold text-yellow-500">Foundation</td>
                  <td class="px-4 py-3 font-mono">36–67</td>
                  <td class="px-4 py-3 text-right font-mono">220</td>
                  <td class="px-4 py-3 text-right font-mono text-yellow-500">61.1%</td>
                  <td class="px-4 py-3 text-right font-mono text-text-muted">64.6% (186)</td>
                  <td class="px-4 py-3 text-xs">Reachable by AI but thin on structure, entity, and discovery signals.</td>
                </tr>
                <tr class="bg-bg-base">
                  <td class="px-4 py-3 font-semibold text-red-400">Critical</td>
                  <td class="px-4 py-3 font-mono">0–35</td>
                  <td class="px-4 py-3 text-right font-mono">51</td>
                  <td class="px-4 py-3 text-right font-mono text-red-400">14.2%</td>
                  <td class="px-4 py-3 text-right font-mono text-text-muted">14.6% (42)</td>
                  <td class="px-4 py-3 text-xs">Significant barriers — blocked crawlers, missing schema, no AI signals.</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="mt-5">
            The practical reading: <strong class="text-text-primary">three in four audited sites still cannot be described, cited, or recommended by an AI engine with confidence</strong>. But the direction of travel is positive. The Good band grew from 19.4% to 22.8% (+3.4 percentage points), Excellent nearly doubled from 4 to 7 domains, and the share of sites below Good dropped from 79.2% to 75.3% (-3.9 pp). The Foundation band shrank from 64.6% to 61.1%, suggesting some sites are climbing out of the middle tier into Good.
          </p>
        </section>

        {/* ── ArticleVisual ──────────────────────────────────────────────────── */}
        <ArticleVisual
          variant="score-distribution"
          title="GEO score distribution — July 2026"
          caption="360 domains scored on the GEO Optimizer 100-point rubric. 75.3% sit in Foundation or Critical."
        />

        {/* ── 2. Category breakdown ──────────────────────────────────────────── */}
        <section>
          <h2>Category breakdown: schema is gaining, llms.txt is slipping</h2>
          <p class="mt-4">
            The GEO rubric scores eight categories. Each has a different maximum. The table below shows the July 2026 average for each, what the maximum is, and the efficiency percentage — how much of the available points the average site is capturing.
          </p>

          <div class="mt-6 overflow-x-auto rounded-xl border border-border">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-bg-subtle text-text-muted text-[11px] font-mono uppercase tracking-wider">
                  <th class="px-4 py-3 text-left border-b border-border">Category</th>
                  <th class="px-4 py-3 text-right border-b border-border">Avg score</th>
                  <th class="px-4 py-3 text-right border-b border-border">Max</th>
                  <th class="px-4 py-3 text-right border-b border-border">Efficiency</th>
                  <th class="px-4 py-3 text-right border-b border-border">June eff.</th>
                  <th class="px-4 py-3 border-b border-border"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border">
                {stats.categories.map((cat, i) => (
                  <tr class={i % 2 === 0 ? 'bg-bg-surface' : 'bg-bg-base'}>
                    <td class="px-4 py-3 font-medium text-text-primary">{cat.name}</td>
                    <td class="px-4 py-3 text-right font-mono">{cat.avg}</td>
                    <td class="px-4 py-3 text-right font-mono text-text-muted">{cat.max}</td>
                    <td class="px-4 py-3 text-right font-mono font-semibold" style={`color: ${cat.pct >= 75 ? 'var(--color-accent-success, #22c55e)' : cat.pct >= 50 ? 'var(--color-accent-teal, #0d9488)' : '#f59e0b'}`}>
                      {cat.pct}%
                    </td>
                    <td class="px-4 py-3 text-right font-mono text-text-muted">{stats.june.categories[i].pct}%</td>
                    <td class="px-4 py-3 w-32">
                      <div class="h-1.5 rounded-full bg-bg-subtle overflow-hidden">
                        <div class="h-full rounded-full bg-accent-teal" style={`width:${cat.pct}%`} />
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="mt-6">
            Three categories form a strong foundation. <strong class="text-text-primary">Meta tags</strong> lead at 88.6% efficiency — unchanged from June, as title tags, descriptions, and canonical URLs are well understood and broadly implemented. <strong class="text-text-primary">Content quality</strong> follows at 80.0%, also flat, driven by the 78.6% of sites that lead pages with a direct, parseable answer (up from 77.1%). <strong class="text-text-primary">Robots and crawler access</strong> improved slightly to 76.1% (from 75.6%): most sites allow the major AI bots, with an average of 23.2 bots explicitly permitted.
          </p>

          <p class="mt-4">
            The middle tier saw the most notable month-over-month movement. <strong class="text-text-primary">Schema markup</strong> improved from 38.1% to 42.5% efficiency — a 4.4 percentage-point gain, the largest of any category. This aligns with the adoption data: overall schema adoption rose from 70.1% to 75.6%, WebSite schema from 52.4% to 58.9%, and FAQ schema from 13.2% to 18.1%. Conversely, <strong class="text-text-primary">LLMs.txt</strong> efficiency dropped from 38.9% to 36.1% — a 2.8 percentage-point decline, reflecting the adoption regression from 58.3% to 54.2%. <strong class="text-text-primary">Brand & entity</strong> remained flat at 38.0%.
          </p>

          <p class="mt-4">
            The outlier remains <strong class="text-text-primary">AI Discovery</strong> at just 10.0% — an average of 0.6 points out of 6. This is up from 8.3% in June, a modest improvement, but AI discovery files are still a concept that almost no one has acted on.
          </p>
        </section>

        {/* ── 3. Adoption rates ──────────────────────────────────────────────── */}
        <section>
          <h2>Adoption rates: the machine-readability stack</h2>
          <p class="mt-4">
            The GEO rubric checks specific technical signals beyond category scores. These adoption rates show where the default behavior of the web sits in July 2026 — and what changed from June.
          </p>

          <div class="mt-6 space-y-3">
            {[
              { label: 'HTML lang attribute set', pct: 95.0, note: 'Near-universal — up from 93.4% in June. Language is the most implemented signal.' },
              { label: 'Canonical URL present', pct: 82.8, note: 'Strong baseline, up from 81.6%. 17.2% of sites still risk duplicate-content confusion.' },
              { label: 'Answer-first content structure', pct: 78.6, note: 'Up from 77.1%. Most sites open key pages with a direct statement.' },
              { label: 'H1 tag present', pct: 80.6, note: 'Slightly down from 81.3% — the new domains pulled this marginally lower.' },
              { label: 'Any schema markup', pct: 75.6, note: 'Biggest mover: up 5.5pp from 70.1%. But average schema score is still only 42.5% of max.' },
              { label: 'llms.txt file (any)', pct: 54.2, note: 'Regression: down 4.1pp from 58.3%. New domains entering the cohort lack AI-specific signals.' },
              { label: 'WebSite schema', pct: 58.9, note: 'Up 6.5pp from 52.4% — the largest single schema-type gain.' },
              { label: 'Organization schema', pct: 52.2, note: 'Up from 51.0%. Brand entity clarity starts here.' },
              { label: 'llms.txt (full / structured)', pct: 26.9, note: 'Down from 27.8%. Only 26.9% have a complete file — 27.3% of llms.txt adopters publish a minimal stub.' },
              { label: 'AI discovery endpoints', pct: 17.5, note: 'Up from 16.0%. /.well-known/ai.txt and similar. Still the biggest untapped category.' },
              { label: 'FAQ schema', pct: 18.1, note: 'Up 4.9pp from 13.2% — notable growth. FAQ content on page also rose to 18.1%.' },
              { label: 'FAQ content on page', pct: 18.1, note: 'Up from 13.2%. FAQ structure is finally being adopted, closing the content-vs-schema gap.' },
            ].map(item => (
              <div>
                <div class="flex justify-between text-sm mb-1">
                  <span class="text-text-secondary">{item.label}</span>
                  <span class="font-mono font-semibold text-text-primary">{item.pct}%</span>
                </div>
                <div class="h-2 rounded-full bg-bg-subtle overflow-hidden">
                  <div class="h-full rounded-full bg-accent-teal" style={`width:${item.pct}%`} />
                </div>
                <p class="text-xs text-text-muted mt-1">{item.note}</p>
              </div>
            ))}
          </div>

