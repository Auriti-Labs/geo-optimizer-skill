---
import Shell from '../../components/Shell.astro';
import NewsletterSignup from '../../components/NewsletterSignup';

const title = 'State of GEO: July 2026 AI Search Benchmark';
const description =
  'State of GEO July 2026: 360 domains, avg score 54.1/100, only 24.7% at Good or above. Schema rose, llms.txt slipped. Compare your site free.';
const canonical = 'https://geoready.dev/state-of-geo/july-2026/';
const datePublished = '2026-08-03';
const dateModified = '2026-08-03';

const stats = {
  domains: 360,
  avgScore: 54.1,
  median: 55,
  p25: 43,
  p75: 67,
  minScore: 6,
  maxScore: 100,
  pctExcellent: 1.9,
  pctGood: 22.8,
  pctFoundation: 61.1,
  pctCritical: 14.2,
  pctBelowGood: 75.3,
  pctLlmsTxt: 54.2,
  pctLlmsFull: 26.9,
  pctSchema: 75.6,
  pctOrgSchema: 52.2,
  pctWebSchema: 58.9,
  pctFaqSchema: 18.1,
  pctCanonical: 82.8,
  pctH1: 80.6,
  pctLang: 95.0,
  pctAnswerFirst: 78.6,
  pctContentFaq: 18.1,
  pctAiDiscovery: 17.5,
  avgBotsAllowed: 23.2,
  avgWordCount: 1157,
  categories: [
    { name: 'Meta tags', avg: 12.4, max: 14, pct: 88.6 },
    { name: 'Content quality', avg: 9.6, max: 12, pct: 80.0 },
    { name: 'Robots & crawler access', avg: 13.7, max: 18, pct: 76.1 },
    { name: 'Technical signals', avg: 3.7, max: 6, pct: 61.7 },
    { name: 'LLMs.txt', avg: 6.5, max: 18, pct: 36.1 },
    { name: 'Schema markup', avg: 6.8, max: 16, pct: 42.5 },
    { name: 'Brand & entity', avg: 3.8, max: 10, pct: 38.0 },
    { name: 'AI discovery', avg: 0.6, max: 6, pct: 10.0 },
  ],
  tlds: [
    { tld: '.com', n: 199, avg: 53.3, pctLlms: 49.7, pctSchema: 74.9 },
    { tld: '.ai', n: 17, avg: 57.8, pctLlms: 82.4, pctSchema: 70.6 },
    { tld: '.org', n: 12, avg: 50.8, pctLlms: 41.7, pctSchema: 91.7 },
    { tld: '.de', n: 10, avg: 46.6, pctLlms: 30.0, pctSchema: 80.0 },
    { tld: '.it', n: 8, avg: 61.4, pctLlms: 50.0, pctSchema: 100.0 },
    { tld: '.co', n: 6, avg: 59.3, pctLlms: 100.0, pctSchema: 83.3 },
    { tld: '.fr', n: 6, avg: 64.2, pctLlms: 66.7, pctSchema: 100.0 },
    { tld: '.dev', n: 6, avg: 59.8, pctLlms: 66.7, pctSchema: 83.3 },
    { tld: '.net', n: 6, avg: 50.8, pctLlms: 50.0, pctSchema: 66.7 },
    { tld: '.cn', n: 5, avg: 35.6, pctLlms: 60.0, pctSchema: 40.0 },
    { tld: '.cz', n: 5, avg: 47.8, pctLlms: 20.0, pctSchema: 60.0 },
    { tld: '.hk', n: 4, avg: 63.3, pctLlms: 75.0, pctSchema: 100.0 },
  ],
  // Confronto June 2026 per la sezione month-over-month
  june: {
    domains: 288,
    avgScore: 53.6,
    median: 57,
    p25: 44,
    p75: 66,
    minScore: 7,
    maxScore: 90,
    pctExcellent: 1.4,
    pctGood: 19.4,
    pctFoundation: 64.6,
    pctCritical: 14.6,
    pctBelowGood: 79.2,
    pctLlmsTxt: 58.3,
    pctLlmsFull: 27.8,
    pctSchema: 70.1,
    pctOrgSchema: 51.0,
    pctWebSchema: 52.4,
    pctFaqSchema: 13.2,
    pctCanonical: 81.6,
    pctH1: 81.3,
    pctLang: 93.4,
    pctAnswerFirst: 77.1,
    pctContentFaq: 13.2,
    pctAiDiscovery: 16.0,
    avgBotsAllowed: 23.3,
    avgWordCount: 1224,
    categories: [
      { name: 'Meta tags', avg: 12.4, max: 14, pct: 88.6 },
      { name: 'Content quality', avg: 9.6, max: 12, pct: 80.0 },
      { name: 'Robots & crawler access', avg: 13.6, max: 18, pct: 75.6 },
      { name: 'Technical signals', avg: 3.7, max: 6, pct: 61.7 },
      { name: 'LLMs.txt', avg: 7.0, max: 18, pct: 38.9 },
      { name: 'Schema markup', avg: 6.1, max: 16, pct: 38.1 },
      { name: 'Brand & entity', avg: 3.8, max: 10, pct: 38.0 },
      { name: 'AI discovery', avg: 0.5, max: 6, pct: 8.3 },
    ],
  },
};

const faqs = [
  {
    question: 'What is the average GEO score in July 2026?',
    answer: `The average GEO score across 360 unique domains audited by GeoReady in July 2026 is 54.1 out of 100. The median is 55, meaning half of audited sites score below that threshold. Only 24.7% of sites reach the "Good" band (68–85) or above — up from 20.8% in June. The average improved by just 0.5 points month-over-month, but the distribution shifted meaningfully toward higher bands.`,
  },
  {
    question: 'How did the dataset change between June and July 2026?',
    answer: `The cohort grew from 288 to 360 domains — a 25% increase, with 72 new domains added. Despite the larger sample, the average score held steady at 54.1 (up 0.5 from 53.6 in June). The share of sites in the Good or Excellent band rose from 20.8% to 24.7%, a 3.9 percentage-point improvement. The first perfect 100-point score appeared in July, up from a maximum of 90 in June.`,
  },
  {
    question: 'Did llms.txt adoption increase or decrease in July 2026?',
    answer: `llms.txt adoption decreased from 58.3% in June to 54.2% in July — a 4.1 percentage-point regression. This is likely a dilution effect: many of the 72 new domains added to the cohort do not have an llms.txt file, pulling the overall rate down despite the absolute number of adopters growing. Full, structured llms.txt files remained flat at 26.9% (vs 27.8% in June).`,
  },
  {
    question: 'What is the biggest AI search readiness gap in July 2026?',
    answer: `AI Discovery remains the single largest gap: only 17.5% of audited sites expose any AI discovery endpoint (up from 16.0% in June), and the average AI Discovery score is just 0.6 out of 6 points — a 10.0% efficiency rate, up from 8.3% in June. While there is marginal improvement, AI Discovery is still the category where the most points are left on the table by a wide margin.`,
  },
  {
    question: 'Which schema type saw the biggest adoption gain in July 2026?',
    answer: `WebSite schema saw the largest gain, rising from 52.4% in June to 58.9% in July — a 6.5 percentage-point increase. FAQ schema also grew notably, from 13.2% to 18.1% (+4.9 pp). Overall schema markup adoption rose from 70.1% to 75.6% (+5.5 pp), the biggest adoption gain of any signal in the dataset. Schema category efficiency improved from 38.1% to 42.5%.`,
  },
  {
    question: 'Which TLD had the strongest debut in July 2026?',
    answer: `.fr domains entered the dataset with the highest average score of any TLD at 64.2, with 100% schema adoption and 66.7% llms.txt adoption. .hk domains also debuted strongly at 63.3 average with 100% schema adoption. Italian .it domains improved dramatically from June: average score rose from 54.3 to 61.4, schema adoption from 81% to 100%, and llms.txt from 33.3% to 50.0%.`,
  },
  {
    question: 'How does this benchmark compare to the whole web?',
    answer: `This is a benchmark of sites that chose to audit with GeoReady — not a random sample of the entire web. The cohort grew 25% from June to July, and the new entrants skew the averages. The cohort still skews toward teams already curious about AI visibility, which means these scores likely overestimate average readiness. Real-world averages across all websites are almost certainly lower.`,
  },
];

// Annotazione mono ricorrente: campione e periodo dichiarati dalla pagina stessa
// (Methodology: 360 domini, 1–31 luglio 2026). Nessun numero inventato.
const SAMPLE_NOTE = 'n = 360 · 1–31 Jul 2026';
---

<Shell title={title} description={description} canonical={canonical}>
  <article itemscope itemtype="https://schema.org/Article" class="bg-paper font-text text-ink">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 md:py-16">

      {/* ── Header ─────────────────────────────────────────────────────────── */}
      <header class="mb-12 max-w-3xl">
        <nav aria-label="Breadcrumb" class="mb-5 flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-ink-mute">
          <a href="/" class="transition-colors hover:text-ink">GeoReady</a>
          <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true" />
          <a href="/state-of-geo/" class="transition-colors hover:text-ink">State of GEO</a>
          <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true" />
          <span>July 2026</span>
        </nav>

        <h1 itemprop="headline" class="font-head text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] text-ink md:text-5xl">
          State of GEO: July 2026
        </h1>
        <p class="mt-2 font-head text-xl font-bold tracking-[-0.02em] text-ink-soft md:text-2xl">
          AI Search Readiness Across 360 Domains
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <span class="rounded-[2px] border border-rail px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-[0.1em] text-ink-mute">
            July 2026 Report
          </span>
          <span class="font-mono text-[11px] text-ink-mute">360 domains · Published 3 August 2026</span>
        </div>

        <p class="mt-5 text-base leading-relaxed text-ink-soft md:text-lg" itemprop="description">
          The second edition of the State of GEO benchmark covers <strong class="text-ink">360 unique domains</strong> — a 25% growth from June's 288 — scored across 8 categories, 100 points, and the same consistent rubric. The average score edged up 0.5 points to 54.1, but the distribution tells a more interesting story: the share of sites reaching "Good" or above climbed from 20.8% to 24.7%, schema adoption jumped 5.5 percentage points, and the first perfect 100-point score appeared. At the same time, llms.txt adoption slipped 4.1 points — a regression driven by the 72 new domains entering the cohort without AI-specific signals.
        </p>

        <meta itemprop="datePublished" content={datePublished} />
        <meta itemprop="dateModified" content={dateModified} />
        <meta itemprop="author" content="Juan Camilo Auriti" />
      </header>

      {/* ── Executive summary — l'unico log well della pagina: incornicia il
          risultato misurato principale del mese (dati first-party) ─────────── */}
      <section class="mb-12 overflow-hidden rounded-[4px] bg-well text-well-ink" aria-label="Executive summary — July 2026">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-well-ink/15 px-6 py-3">
          <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-well-mute">Executive summary — July 2026</p>
          <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-well-mute">{SAMPLE_NOTE}</span>
        </div>
        <div class="px-6 py-6 md:px-8">
          <div class="grid grid-cols-2 gap-x-4 gap-y-5 sm:grid-cols-4">
            <div>
              <p class="font-head text-3xl font-extrabold tabular-nums tracking-[-0.02em] text-white">{stats.avgScore}</p>
              <p class="mt-1 text-xs leading-relaxed text-well-mute">avg GEO score / 100 <span>(+0.5 vs June)</span></p>
            </div>
            <div>
              <p class="font-head text-3xl font-extrabold tabular-nums tracking-[-0.02em] text-white">{stats.domains}</p>
              <p class="mt-1 text-xs leading-relaxed text-well-mute">unique domains <span>(+72 vs June)</span></p>
            </div>
            <div>
              <p class="font-head text-3xl font-extrabold tabular-nums tracking-[-0.02em] text-white">{stats.pctSchema}%</p>
              <p class="mt-1 text-xs leading-relaxed text-well-mute">have schema markup <span>(+5.5pp vs June)</span></p>
            </div>
            <div>
              <p class="font-head text-3xl font-extrabold tabular-nums tracking-[-0.02em] text-white">{stats.pctBelowGood}%</p>
              <p class="mt-1 text-xs leading-relaxed text-well-mute">Foundation or Critical <span>(-3.9pp vs June)</span></p>
            </div>
          </div>
          <ul class="mt-6 space-y-2 text-sm leading-relaxed text-well-ink">
            <li class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-well-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              <span>The cohort grew 25% (288 → 360 domains) while the average score held steady at 54.1 — the new entrants did not drag the average down, suggesting broader awareness of AI readiness beyond early adopters.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-well-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              <span>Schema adoption was the biggest mover: 70.1% → 75.6% (+5.5pp). WebSite schema alone jumped from 52.4% to 58.9% (+6.5pp), and FAQ schema grew from 13.2% to 18.1% (+4.9pp).</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-well-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              <span>llms.txt adoption regressed: 58.3% → 54.2% (-4.1pp). The 72 new domains are the likely cause — they have not yet adopted AI-specific signals even as they embrace traditional schema.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <svg class="mt-1 h-3.5 w-3.5 shrink-0 text-well-mute" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
              <span>The first perfect 100-point score appeared in July (max went from 90 to 100), and 7 domains reached the Excellent band (86+), up from 4 in June.</span>
            </li>
          </ul>
        </div>
        <div class="border-t border-well-ink/15 px-6 py-3">
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-well-mute">source: benchmark_audit_events · GET /api/public/benchmark</p>
        </div>
      </section>

      <div class="space-y-14 leading-relaxed text-ink-soft [&_h2]:font-head [&_h2]:text-2xl [&_h2]:font-extrabold [&_h2]:leading-tight [&_h2]:tracking-[-0.02em] [&_h2]:text-ink [&_h3]:font-head [&_h3]:text-lg [&_h3]:font-extrabold [&_h3]:tracking-[-0.01em] [&_h3]:text-ink [&_p]:text-ink-soft [&_p]:leading-relaxed [&_li]:text-ink-soft [&_li]:leading-relaxed">

        {/* ── 1. Score distribution ──────────────────────────────────────────── */}
        <section>
          <h2>Score distribution: 75% still below the Good threshold</h2>
          <p class="mt-4">
            The average GEO score across {stats.domains} unique domains is <strong class="text-ink">{stats.avgScore} out of 100</strong> — up 0.5 points from June's 53.6. The median is {stats.median}, with the bottom quarter of sites scoring at or below {stats.p25} and the top quarter at or above {stats.p75}. The highest score in the dataset is {stats.maxScore} — the first perfect 100 in the benchmark's history, up from a maximum of 90 in June. The lowest is {stats.minScore}.
          </p>
          <p class="mt-4">
            The band breakdown shows a meaningful shift toward higher tiers compared to June:
          </p>

          <div class="mt-6 overflow-hidden rounded-[4px] border border-rail bg-white">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
              <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">score bands</span>
              <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">{SAMPLE_NOTE}</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[640px] text-left text-sm">
                <thead>
                  <tr class="border-b border-rail bg-paper">
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Band</th>
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Score range</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Domains</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Share</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">June 2026</th>
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">What it means</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-rail">
                  <tr>
                    <td class="px-4 py-3 font-semibold text-ink">Excellent</td>
                    <td class="px-4 py-3 font-mono tabular-nums">86–100</td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-ink">7</td>
                    <td class="px-4 py-3 text-right font-mono font-semibold tabular-nums text-ink">1.9%</td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-ink-mute">1.4% (4)</td>
                    <td class="px-4 py-3 text-xs">All 8 categories well covered. Citable by AI with confidence.</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-semibold text-ink">Good</td>
                    <td class="px-4 py-3 font-mono tabular-nums">68–85</td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-ink">82</td>
                    <td class="px-4 py-3 text-right font-mono font-semibold tabular-nums text-ink">22.8%</td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-ink-mute">19.4% (56)</td>
                    <td class="px-4 py-3 text-xs">Strong fundamentals. Minor gaps in entity signals or AI discovery.</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-semibold text-ink">Foundation</td>
                    <td class="px-4 py-3 font-mono tabular-nums">36–67</td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-ink">220</td>
                    <td class="px-4 py-3 text-right font-mono font-semibold tabular-nums text-ink">61.1%</td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-ink-mute">64.6% (186)</td>
                    <td class="px-4 py-3 text-xs">Reachable by AI but thin on structure, entity, and discovery signals.</td>
                  </tr>
                  <tr>
                    <td class="px-4 py-3 font-semibold text-ink">Critical</td>
                    <td class="px-4 py-3 font-mono tabular-nums">0–35</td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-ink">51</td>
                    <td class="px-4 py-3 text-right font-mono font-semibold tabular-nums text-ink">14.2%</td>
                    <td class="px-4 py-3 text-right font-mono tabular-nums text-ink-mute">14.6% (42)</td>
                    <td class="px-4 py-3 text-xs">Significant barriers — blocked crawlers, missing schema, no AI signals.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <p class="mt-5">
            The practical reading: <strong class="text-ink">three in four audited sites still cannot be described, cited, or recommended by an AI engine with confidence</strong>. But the direction of travel is positive. The Good band grew from 19.4% to 22.8% (+3.4 percentage points), Excellent nearly doubled from 4 to 7 domains, and the share of sites below Good dropped from 79.2% to 75.3% (-3.9 pp). The Foundation band shrank from 64.6% to 61.1%, suggesting some sites are climbing out of the middle tier into Good.
          </p>
        </section>

        {/* ── 2. Category breakdown ──────────────────────────────────────────── */}
        <section>
          <h2>Category breakdown: schema is gaining, llms.txt is slipping</h2>
          <p class="mt-4">
            The GEO rubric scores eight categories. Each has a different maximum. The table below shows the July 2026 average for each, what the maximum is, and the efficiency percentage — how much of the available points the average site is capturing.
          </p>

          <div class="mt-6 overflow-hidden rounded-[4px] border border-rail bg-white">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
              <span class="font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">category efficiency</span>
              <span class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">{SAMPLE_NOTE}</span>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full min-w-[640px] text-left text-sm">
                <thead>
                  <tr class="border-b border-rail bg-paper">
                    <th scope="col" class="px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Category</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Avg score</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Max</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Efficiency</th>
                    <th scope="col" class="px-4 py-3 text-right font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">June eff.</th>
                    <th scope="col" class="px-4 py-3"></th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-rail">
                  {stats.categories.map((cat, i) => (
                    <tr>
                      <td class="px-4 py-3 font-medium text-ink">{cat.name}</td>
                      <td class="px-4 py-3 text-right font-mono tabular-nums">{cat.avg}</td>
                      <td class="px-4 py-3 text-right font-mono tabular-nums text-ink-mute">{cat.max}</td>
                      <td class="px-4 py-3 text-right font-mono font-semibold tabular-nums text-ink">{cat.pct}%</td>
                      <td class="px-4 py-3 text-right font-mono tabular-nums text-ink-mute">{stats.june.categories[i].pct}%</td>
                      <td class="px-4 py-3 w-32">
                        <div class="h-2 rounded-[2px] border border-dashed border-ink-mute/60" aria-hidden="true">
                          <div class="h-full bg-ink-mute/25" style={`width:${cat.pct}%`} />
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <p class="mt-6">
            Three categories form a strong foundation. <strong class="text-ink">Meta tags</strong> lead at 88.6% efficiency — unchanged from June, as title tags, descriptions, and canonical URLs are well understood and broadly implemented. <strong class="text-ink">Content quality</strong> follows at 80.0%, also flat, driven by the 78.6% of sites that lead pages with a direct, parseable answer (up from 77.1%). <strong class="text-ink">Robots and crawler access</strong> improved slightly to 76.1% (from 75.6%): most sites allow the major AI bots, with an average of 23.2 bots explicitly permitted.
          </p>

          <p class="mt-4">
