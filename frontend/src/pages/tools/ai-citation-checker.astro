---
import Shell from '../../components/Shell.astro';
import AICitationChecker from '../../components/tools/AICitationChecker';
import CitationSurface from '../../components/product/CitationSurface.astro';
import ArticleVisual from '../../components/ArticleVisual.astro';

// Metadati SEO della pagina del tool.
// Il title bilancia query intent ("cited by ChatGPT & Perplexity" come domanda)
// e onestà: il check automatico usa Perplexity Sonar, dichiarato in description,
// badge hero e FAQ. ChatGPT resta solo come claim di correlazione (framing FAQ).
const title = 'Free AI Citation Checker: Is Your Site Cited?';
const description =
  'Free one-shot check: see which AI answer engines mention your brand and cite your domain, with verifiable sources. No sign-up needed.';
const canonical = 'https://geoready.dev/tools/ai-citation-checker/';

// FAQ visibili — riusate sia nel markup crawlable che nello schema FAQPage.
const faqs = [
  {
    question: 'What does an AI citation checker do?',
    answer:
      'An AI citation checker asks an AI answer engine the questions your customers ask and reports whether your brand is mentioned and whether your own domain is cited as a source. It tells you, for a given category, whether AI answers point people to you or to someone else.',
  },
  {
    question: 'How is this different from rank tracking?',
    answer:
      'Rank trackers measure your position in a list of ten blue links on Google. An AI citation checker measures something different: whether an AI answer cites your domain as one of the few sources behind a single generated answer. A page can rank well on Google and still never be cited by AI, so the two metrics do not move together.',
  },
  {
    question: 'Which AI engines does it check — ChatGPT or Perplexity?',
    answer:
      'The check queries Perplexity Sonar, an answer engine grounded in live web search that returns the exact source URLs it cited, which makes citations verifiable. ChatGPT and other parametric models do not expose their sources the same way. Citation patterns correlate across engines: content that is citable for Perplexity is building the signals other AI engines reward.',
  },
  {
    question: 'How does the AI citation checker work?',
    answer:
      'It sends customer-style questions about your product category to Perplexity Sonar, an AI answer engine grounded in live web search, and analyzes the answers: is your brand mentioned in the text, and does your domain appear among the cited sources? You also see which competitor domains were cited instead of you.',
  },
  {
    question: 'What does "mentioned but not cited" mean?',
    answer:
      'The AI knows your brand — usually from third-party pages like reviews or directories — but never cites your own domain as a source. That means other sites are the reference for your own product. The fix is making your own pages the citable source: structured data, llms.txt, statistics, and quotable content.',
  },
  {
    question: 'How often do AI citations change?',
    answer:
      'Continuously. AI answers are regenerated for every query and the underlying indexes refresh constantly, so a brand cited today can silently disappear next week. A one-shot check is a snapshot; ongoing monitoring is how you catch losses early.',
  },
  {
    question: 'Is this check really free?',
    answer:
      'Yes. Each check asks the AI engine two questions at our expense, so there is a fair-use limit per visitor and per day. Pro ($19/month) adds domain monitoring, score history, and regression alerts. Scheduled AI citation tracking — running these checks automatically and alerting you on wins or losses — is on Agency ($89/month founding, then $199/month).',
  },
];
---

<Shell title={title} description={description} canonical={canonical}>
  <article>
    {/* Hero — paper band, breadcrumb sulla riga di baseline dell'H1 */}
    <section class="bg-paper">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.88fr)_minmax(420px,0.82fr)] lg:items-center">
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
              <h1 class="max-w-3xl text-[2.3rem] font-semibold leading-[1.05] tracking-[-0.035em] text-ink sm:text-[3rem]">
                AI Citation Checker: is your brand cited by AI answer engines?
              </h1>
              <div class="eyebrow flex items-center gap-2">
                <a href="/" class="transition-colors hover:text-ink">Home</a>
                <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true"></span>
                <span>AI citation checker</span>
              </div>
            </div>

            {/* Badge onesto: dichiara l'engine effettivamente interrogato. */}
            <p class="mt-4 inline-flex items-center gap-2 rounded-[6px] border border-rail bg-white px-2.5 py-1 font-mono text-[11px] text-ink-soft">
              <span class="h-1.5 w-1.5 rounded-full bg-ink-mute" aria-hidden="true"></span>
              Powered by Perplexity Sonar — real, verifiable source citations
            </p>

            {/* Intro answer-first: cosa fa il tool. */}
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
              When your customers ask an AI engine "what's the best tool for…", does the
              answer mention <em>your</em> brand and cite <em>your</em> domain — or a
              competitor's? This tool asks a real AI answer engine and shows you the
              verdict, with the actual sources the AI cited. Citation patterns correlate
              across engines: content that Perplexity cites is building the signals other
              AI engines reward.
            </p>

            <div class="mt-8 grid gap-3 sm:grid-cols-3">
              {[
                ['Ask', 'Customer-style category prompts.'],
                ['Trace', 'Returned sources and cited domains.'],
                ['Act', 'Verdicts that point to the next fix.'],
              ].map(([label, text]) => (
                <div class="border-l border-rail pl-4">
                  <div class="eyebrow">{label}</div>
                  <p class="mt-1 text-sm leading-relaxed text-ink-soft">{text}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="flex items-center panel p-6 lg:p-8">
            <CitationSurface mode="sov" variant="light" class="w-full" />
          </div>
        </div>
      </div>
    </section>

    {/* ── Isola React: il checker vero e proprio ──────────────────────────── */}
    <section class="border-t border-rail bg-white" data-reveal>
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <ArticleVisual
          src="/images/article-visuals/B2RankingVsCitation.png"
          alt="Side-by-side diagram comparing traditional search ranking with AI answer citation."
          caption="AI citation checks measure source inclusion, not traditional ranking position."
          height={377}
          class="mx-auto"
        />

        <section class="mx-auto mt-10 max-w-5xl" aria-labelledby="citation-intent-links-heading">
          <h2 id="citation-intent-links-heading" class="max-w-3xl font-head text-2xl font-semibold tracking-[-0.02em] text-ink">
            Citation checks and visibility checks answer different questions.
          </h2>
          <div class="mt-5 overflow-hidden panel">
            <div class="border-b border-rail px-4 py-2.5">
              <div class="eyebrow">Choose the right check</div>
            </div>
            <div class="grid gap-px bg-rail md:grid-cols-3">
              <a href="/perplexity-citation-checker/" class="bg-paper p-4 transition-colors hover:bg-pass-wash/50">
                <span class="text-sm font-semibold text-ink">Perplexity citation checker</span>
                <span class="mt-2 block text-sm leading-relaxed text-ink-soft">Use this when you need source-backed answers with visible cited URLs.</span>
              </a>
              <a href="/chatgpt-visibility-checker/" class="bg-paper p-4 transition-colors hover:bg-pass-wash/50">
                <span class="text-sm font-semibold text-ink">ChatGPT visibility checker</span>
                <span class="mt-2 block text-sm leading-relaxed text-ink-soft">Use this when the question is whether the page is ready for ChatGPT-style retrieval.</span>
              </a>
              <a href="/ai-seo-audit/" class="bg-paper p-4 transition-colors hover:bg-pass-wash/50">
                <span class="text-sm font-semibold text-ink">AI SEO audit</span>
                <span class="mt-2 block text-sm leading-relaxed text-ink-soft">Use this when a poor citation result needs a technical and content diagnosis.</span>
              </a>
            </div>
          </div>
          <p class="mt-5 max-w-3xl text-sm leading-relaxed text-ink-soft">
            This check is a one-off, Perplexity-only snapshot —
            {' '}<a href="/chatgpt-citation-tracker/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">need recurring tracking instead?</a>
            {' '}If you are weighing paid trackers, the
            {' '}<a href="/rankscale-alternative/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">RankScale alternative</a>
            {' '}page compares one of them with GeoReady.
            {' '}And if a competitor keeps showing up in the sources instead of you, the
            {' '}<a href="/citation-gap-analysis/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">citation gap analysis</a>
            {' '}workflow covers the wider diagnosis.
          </p>
        </section>

        <section class="mx-auto mt-12 max-w-5xl md:mt-16" aria-labelledby="citation-tool-heading">
          <div class="mb-5 flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
            <h2 id="citation-tool-heading" class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink">Run a citation check</h2>
            <p class="max-w-md text-sm leading-relaxed text-ink-soft">
              Test a brand, domain, and category against source-backed AI answers.
            </p>
          </div>
          <div class="overflow-hidden rounded-[14px] border border-rail bg-paper">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rail px-5 py-2.5">
              <div class="eyebrow">Tool workspace</div>
              <div class="eyebrow">POST /api/citations</div>
            </div>
            <div class="p-5 sm:p-6">
              <AICitationChecker client:load />
            </div>
          </div>
        </section>
      </div>
    </section>

    {/* ── Contenuto SEO statico e crawlable ───────────────────────────────── */}
    <section class="border-t border-rail bg-paper" data-reveal>
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <section class="max-w-3xl">
          <h2 class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">Why AI citations matter more than rankings</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">
            AI answer engines don't show ten blue links — they give one answer and
            cite a handful of sources. If your domain is among those sources, you
            capture the click and the trust. If it isn't, the AI is actively
            sending your customers to whoever <em>is</em> cited. AI answers and
            classic Google rankings don't always overlap: a page can rank well on
            Google and never be cited by AI, so citation is a different game from
            classic SEO, with different winners.
          </p>
        </section>

        <ArticleVisual
          src="/images/article-visuals/A1HeroAIDiscovery.png"
          alt="End-to-end diagram showing a website becoming crawlable, understandable, quotable, and eligible for AI citation."
          caption="A brand has to be crawlable, understandable, and quotable before an answer engine can cite it."
          height={452}
        />

        <section class="mt-12 md:mt-16">
          <h2 class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">What the four verdicts mean</h2>
          <ul class="mt-5 max-w-3xl space-y-3" role="list">
            <li class="flex gap-3 panel p-4">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-pass-deep" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 21h8" />
                <path d="M12 17v4" />
                <path d="M7 4h10v4a5 5 0 0 1-10 0V4Z" />
                <path d="M7 6H4a3 3 0 0 0 3 3" />
                <path d="M17 6h3a3 3 0 0 1-3 3" />
              </svg>
              <p class="text-sm leading-relaxed text-ink-soft"><strong class="text-ink">Strong</strong> — your domain is cited as a source in most answers. Monitor it: positions degrade silently.</p>
            </li>
            <li class="flex gap-3 panel p-4">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-pass-deep" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              <p class="text-sm leading-relaxed text-ink-soft"><strong class="text-ink">Cited</strong> — you appear among sources, but not consistently. Strengthen citability to win more answers.</p>
            </li>
            <li class="flex gap-3 panel p-4">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-warn" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="8" />
                <path d="M12 8v4" />
                <path d="M12 16h.01" />
              </svg>
              <p class="text-sm leading-relaxed text-ink-soft"><strong class="text-ink">Mentioned only</strong> — the AI knows your brand from third parties but never cites your own pages. Make your domain the reference.</p>
            </li>
            <li class="flex gap-3 panel p-4">
              <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-fail" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="8" />
                <path d="m15 9-6 6" />
                <path d="m9 9 6 6" />
              </svg>
              <p class="text-sm leading-relaxed text-ink-soft"><strong class="text-ink">Invisible</strong> — neither mentioned nor cited. Start with a <a href="/ai-seo-audit/" data-cta="citation_checker_verdict_ai_seo_audit" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">free GEO audit</a> and fix the high-impact items first.</p>
            </li>
          </ul>
        </section>

        <section class="mt-12 max-w-3xl md:mt-16">
          <h2 class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">How to improve your AI citations</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">
            If the term is new, start with
            {' '}<a href="/guides/what-are-ai-citations/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">what are AI citations</a>.
            Citations are earned with technical and content signals that AI
            retrieval rewards: open access for AI crawlers, structured data,
            an <a href="/tools/llms-txt-generator/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">llms.txt</a>,
            quotable statistics, and multi-page topical coverage. The
            {' '}<a href="/guides/generative-engine-optimization/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">GEO guide</a>{' '}
            covers the full playbook, and the
            {' '}<a href="/ai-seo-audit/" data-cta="citation_checker_content_ai_seo_audit" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">free GEO audit</a>{' '}
            scores your site on 100 points across nine categories. For the background
            method behind this tool, see the step-by-step guide that answers
            {' '}<a href="/guides/ai-citations-check/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">how do I know if my content is cited in ChatGPT answers?</a>{' '}
            Run the audit, fix the priority items, then come back and re-check your
            citations.
          </p>
        </section>
      </div>
    </section>

    <section class="border-t border-rail bg-white" data-reveal>
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <section>
          <h2 class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">Which AI citation result should trigger action?</h2>
          <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
            A single AI citation check is useful only if it leads to the right next
            step. Use the result below to decide whether to monitor, improve the
            source page, or rebuild the visibility foundation.
          </p>
          <div class="mt-5 overflow-x-auto panel">
            <table class="min-w-full border-collapse text-left text-sm">
              <thead class="bg-paper">
                <tr>
                  <th scope="col" class="border-b border-rail px-4 py-3 eyebrow">Result</th>
                  <th scope="col" class="border-b border-rail px-4 py-3 eyebrow">Risk</th>
                  <th scope="col" class="border-b border-rail px-4 py-3 eyebrow">Next action</th>
                  <th scope="col" class="border-b border-rail px-4 py-3 eyebrow">GeoReady workflow</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row" class="border-b border-rail px-4 py-3 font-semibold text-ink">Strong</th>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">You can lose citations without noticing.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Track the same prompts weekly.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Agency citation snapshots and alerts.</td>
                </tr>
                <tr>
                  <th scope="row" class="border-b border-rail px-4 py-3 font-semibold text-ink">Cited</th>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Competitors still appear in adjacent prompts.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Find the prompts where your domain is missing.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Prompt tracking plus competitor comparison.</td>
                </tr>
                <tr>
                  <th scope="row" class="border-b border-rail px-4 py-3 font-semibold text-ink">Mentioned only</th>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Third-party pages define your brand for AI answers.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Make your own domain the better source.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Audit, source gaps, structured content fixes.</td>
                </tr>
                <tr>
                  <th scope="row" class="px-4 py-3 font-semibold text-ink">Invisible</th>
                  <td class="px-4 py-3 text-ink-soft">AI answers send buyers to other domains.</td>
                  <td class="px-4 py-3 text-ink-soft">Fix crawlability, schema, content, and authority first.</td>
                  <td class="px-4 py-3 text-ink-soft">Free GEO audit, then monitored fixes.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <ArticleVisual
          src="/images/article-visuals/D4MonitorLoop.png"
          alt="Loop diagram showing citation checks repeated over time through snapshots, fixes, rechecks, and monitoring."
          caption="A citation check is a snapshot; monitoring shows when answers change."
          height={424}
        />
      </div>
    </section>

    {/* FAQ visibili (stesse del FAQPage schema) */}
    <section class="border-t border-rail bg-paper" data-reveal>
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <h2 class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">Frequently asked questions</h2>
        <div class="panel mt-8 max-w-3xl divide-y divide-rail overflow-hidden">
          {faqs.map((faq) => (
            <div class="p-6">
              <h3 class="text-base font-semibold text-ink">{faq.question}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* CTA finale → SaaS — banda di verdetto della pagina */}
    <section class="band-dark" aria-labelledby="citation_checker-next-h" data-reveal>
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 md:py-20">
        <div class="eyebrow">Next step</div>
        <h2 id="citation_checker-next-h" class="mt-3 max-w-3xl text-3xl font-semibold tracking-[-0.03em] text-ink md:text-[2.5rem] md:leading-[1.08]">One check is a snapshot. Tracking is the moat.</h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">
          AI answers change every week. GeoReady turns this one-off check into
          ongoing AI citation tracking: it runs your citation checks on a
          schedule, alerts you when you lose or win a citation, and shows who
          replaced you — so you act before the traffic moves.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="https://app.geoready.dev/signup?plan=agency&intent=citations&utm_source=ai_citation_checker_page&utm_medium=content_cta&utm_campaign=tool_to_paid"
            data-plan-id="agency"
            data-plan-name="Agency"
            data-plan-period="monthly"
            data-plan-price="$89"
            data-plan-currency="USD"
            data-cta-location="citation_checker_final_tracking"
            class="inline-flex min-h-11 items-center justify-center rounded-[9px] bg-[#2DD4BF] px-6 py-3 text-[14px] font-semibold text-[#062420] transition-colors hover:bg-[#5EEAD4]"
          >
            Track citations weekly
          </a>
          <a
            href="/pricing/"
            data-cta="citation_checker_final_pricing"
            class="inline-flex min-h-11 items-center justify-center rounded-[9px] px-6 py-3 text-[14px] font-semibold text-ink shadow-[inset_0_0_0_1px_#2A3838] transition-shadow hover:shadow-[inset_0_0_0_1px_#2DD4BF]"
          >
            See pricing
          </a>
        </div>
      </div>
    </section>
  </article>

  {/* Schema JSON-LD: WebApplication (il tool) + FAQPage (le stesse FAQ visibili). */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "@id": "https://geoready.dev/tools/ai-citation-checker/#webapp",
        "isPartOf": { "@id": "https://geoready.dev/#webapp" },
        "name": "AI Citation Checker (Powered by Perplexity Sonar)",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Any",
        "url": canonical,
        "description": description,
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "publisher": { "@id": "https://geoready.dev/#organization" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "GeoReady",
            "item": "https://geoready.dev/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "AI Citation Checker",
            "item": canonical
          }
        ]
      }
    ]
  })} />
</Shell>
