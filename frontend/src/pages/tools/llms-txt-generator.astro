---
import Shell from '../../components/Shell.astro';
import LlmsTxtGenerator from '../../components/tools/LlmsTxtGenerator';
import LlmsPreview from '../../components/product/LlmsPreview.astro';
import ArticleVisual from '../../components/ArticleVisual.astro';

// Metadati SEO della pagina del tool.
const title = 'Free llms.txt Generator — Create an AI-Ready llms.txt';
const description =
  'Generate an llms.txt file from your sitemap. Help AI systems understand your most important pages with a clean, editable Markdown file.';
const canonical = 'https://geoready.dev/tools/llms-txt-generator/';

// FAQ visibili — riusate sia nel markup crawlable che nello schema FAQPage.
// Tenere allineate: ogni modifica al testo va replicata in entrambi i punti.
const faqs = [
  {
    question: 'What is llms.txt?',
    answer:
      'llms.txt is a plain-text Markdown file you publish at your domain root that lists your most important pages with short descriptions, so AI systems can orient themselves around what your site is about. It sits alongside robots.txt and sitemap.xml and acts as a clarity signal, not a ranking lever.',
  },
  {
    question: 'What does this llms.txt generator do?',
    answer:
      'It reads your sitemap, groups the URLs into H2 sections, and produces a ready-to-edit llms.txt with an H1 title and an optional summary. Instead of writing the file by hand, you get a structured starting point you can refine and publish.',
  },
  {
    question: 'What input does the generator need?',
    answer:
      'A sitemap. Paste your sitemap URL, or enter your homepage URL and the generator discovers the sitemap automatically. If no sitemap is found, it falls back to a minimal file built from your homepage.',
  },
  {
    question: 'Is llms.txt a ranking factor?',
    answer:
      'No. No major AI engine has confirmed that llms.txt changes how a site is ranked or cited, and it does not guarantee citations. It is an orientation file that helps AI systems understand your site faster — treat it as a clarity signal, not a lever that forces visibility.',
  },
  {
    question: 'Where should I upload llms.txt?',
    answer:
      'At the root of your domain, reachable at https://yourdomain.com/llms.txt and served as plain text. It belongs in the same location as robots.txt and sitemap.xml, not inside a subfolder.',
  },
  {
    question: 'Does this replace robots.txt?',
    answer:
      'No. robots.txt controls crawler access — what bots may fetch. llms.txt describes and indexes your content for AI systems. They are complementary: an llms.txt cannot override a block you set in robots.txt.',
  },
  {
    question: 'Can I edit the generated file?',
    answer:
      'Yes. The generated file is a starting point built from your sitemap. Edit the title, summary, and link descriptions, remove pages that do not matter, and reorder sections so your most important content comes first.',
  },
  {
    question: 'Why was no sitemap found?',
    answer:
      'A sitemap may be absent, served at a non-standard path, or blocked from automated fetching. When that happens the generator falls back to a minimal file from your homepage. You can paste a sitemap URL manually to get a complete result.',
  },
];
---

<Shell title={title} description={description} canonical={canonical}>
  <article>
    {/* Hero — paper band, breadcrumb sulla riga di baseline dell'H1 */}
    <section class="bg-paper">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,0.88fr)_minmax(420px,0.82fr)] lg:items-center">
          <div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
              <h1 class="max-w-3xl font-head text-4xl font-extrabold leading-[1.05] tracking-[-0.03em] text-ink md:text-5xl">
                Turn a sitemap into an AI-readable orientation file.
              </h1>
              <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.12em] text-ink-mute">
                <a href="/" class="transition-colors hover:text-ink">Home</a>
                <span class="h-1 w-1 rounded-full bg-ink-mute" aria-hidden="true"></span>
                <span>llms.txt generator</span>
              </div>
            </div>

            {/* Intro answer-first: cosa fa il tool e cosa NON garantisce. */}
            <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
              This free tool reads your sitemap and generates an
              <code class="text-sm font-mono"> llms.txt</code> file — a clean,
              editable Markdown index of your most important pages. An llms.txt is a
              guidance file that helps AI systems understand your site; it is not a
              confirmed ranking factor and does not guarantee citations. Generate it,
              edit it, and publish it at your domain root.
            </p>

            <div class="mt-8 grid gap-3 sm:grid-cols-3">
              {[
                ['Input', 'Homepage or sitemap URL.'],
                ['Transform', 'Grouped Markdown sections.'],
                ['Publish', '/llms.txt at the domain root.'],
              ].map(([label, text]) => (
                <div class="border-l border-rail pl-4">
                  <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">{label}</p>
                  <p class="mt-1 text-sm leading-relaxed text-ink-soft">{text}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="flex items-center rounded-[4px] border border-rail bg-white p-6">
            <LlmsPreview variant="dark" class="w-full" />
          </div>
        </div>
      </div>
    </section>

    {/* ── Isola React: il generatore vero e proprio ───────────────────────── */}
    <section class="border-t border-rail bg-white" aria-labelledby="llms-tool-heading">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <ArticleVisual
          src="/images/article-visuals/M1HeroLlmsGeneratorFlow.png"
          alt="Flow diagram showing a sitemap becoming grouped URLs, editable Markdown, and a published llms.txt file."
          caption="The generator turns a sitemap into editable llms.txt Markdown that can be published at the domain root."
          height={452}
          class="mx-auto"
        />

        <div class="mx-auto mt-10 max-w-5xl">
          <div class="mb-5 flex flex-col gap-2 md:flex-row md:items-baseline md:justify-between">
            <h2 id="llms-tool-heading" class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink">Generate your llms.txt</h2>
            <p class="max-w-md text-sm leading-relaxed text-ink-soft">
              Start from a URL, then edit the Markdown before publishing it.
            </p>
          </div>
          <div class="overflow-hidden rounded-[4px] border border-rail bg-paper">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rail px-5 py-2.5">
              <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.14em] text-ink-mute">Tool workspace</p>
              <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-ink-mute">POST /api/llms/generate</p>
            </div>
            <div class="p-5 sm:p-6">
              <LlmsTxtGenerator client:load />
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ── Contenuto SEO statico e crawlable ───────────────────────────────── */}
    <section class="border-t border-rail bg-paper">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        {/* 1. Cos'è un llms.txt generator */}
        <section class="max-w-3xl">
          <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">What is an llms.txt generator?</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">
            An llms.txt generator is a tool that builds an
            <code class="text-sm font-mono"> llms.txt</code> file for your site
            automatically. The file is a plain-text Markdown document that lists
            your most important pages with short descriptions, so AI systems and
            LLM-powered tools can orient themselves around what your site is about
            and which URLs matter.
          </p>
          <p class="mt-4 leading-relaxed text-ink-soft">
            Instead of writing the file by hand, this generator reads your sitemap,
            groups the URLs into sections, and produces a ready-to-edit Markdown
            file. It is an orientation file, not a ranking mechanism: no AI vendor
            has confirmed that publishing llms.txt forces citations or improves
            rankings. Think of it as a way to make your site easier to understand,
            not a guarantee of visibility. Read more in our guide to
            {' '}
            <a href="/guides/what-is-llms-txt/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">what llms.txt is</a>.
          </p>
        </section>

        <ArticleVisual
          src="/images/article-visuals/H1HeroLlmsTxtOrientation.png"
          alt="Diagram showing llms.txt as an orientation layer that points AI tools to canonical URLs and summaries."
          caption="llms.txt is an orientation layer: it prioritizes canonical URLs and short summaries for AI tools."
          height={452}
        />

        {/* 2. Come funziona */}
        <section class="mt-12 max-w-3xl md:mt-16">
          <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">How this generator works</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">
            The process is straightforward and runs in a few seconds:
          </p>
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-ink-soft">
            <li><strong>Reads your sitemap</strong> — it discovers your sitemap automatically from your domain, or uses the sitemap URL you provide.</li>
            <li><strong>Categorizes your URLs</strong> — pages are grouped into sections based on their structure, so the file is organized rather than a flat dump of links.</li>
            <li><strong>Generates clean Markdown</strong> — the output is a standard llms.txt with an H1 title, an optional summary, and H2 sections of links, ready to copy or download.</li>
          </ul>
          <p class="mt-4 leading-relaxed text-ink-soft">
            Every URL is validated before it is fetched, with anti-SSRF protection
            and size limits, so the tool only talks to safe, public endpoints. For
            speed, page titles are not fetched individually — the generator uses
            the URL structure from your sitemap. That keeps generation fast, and
            you can refine titles and descriptions yourself in the editable output.
          </p>
        </section>

        <ArticleVisual
          src="/images/article-visuals/C2LlmsTxtStructure.png"
          alt="Diagram of a useful llms.txt structure with a title, summary, section headings, and important page links."
          caption="A useful llms.txt is short, sectioned, and explicit about which pages matter most."
          height={565}
        />
      </div>
    </section>

    {/* 3. Cosa fare dopo */}
    <section class="border-t border-rail bg-white">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <section class="max-w-3xl">
          <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">What to do after generating llms.txt</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">
            The generated file is a starting point. To put it to work:
          </p>
          <ul class="mt-4 list-decimal space-y-3 pl-5 leading-relaxed text-ink-soft">
            <li>
              <strong>Save it as /llms.txt in your site root.</strong> Upload the
              file so it is reachable at <code class="text-sm font-mono">https://yourdomain.com/llms.txt</code>,
              served as plain text — the same place as your robots.txt and sitemap.
            </li>
            <li>
              <strong>Edit it for clarity.</strong> Rewrite the title and summary in
              your own words, sharpen link descriptions, remove pages that do not
              matter, and move your most important content to the top. In the
              <a href="/state-of-geo/september-2026/#llms-txt" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">September 2026 State of GEO</a>,
              54.7% of detected llms.txt files were thin stubs.
            </li>
            <li>
              <strong>Verify it loads.</strong> Open the URL in a browser to confirm
              the file is served correctly and is not blocked by your robots.txt or
              a redirect.
            </li>
          </ul>
          <p class="mt-4 leading-relaxed text-ink-soft">
            On WordPress, hosting a static <code class="text-sm font-mono">/llms.txt</code>
            {' '}takes a couple of extra steps — see the guide to
            {' '}
            <a href="/guides/llms-txt-wordpress/" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">adding llms.txt to WordPress</a>.
            For a direct WordPress workflow, use the
            {' '}
            <a href="/llms-txt-generator-wordpress/" data-cta="llms_generator_content_wordpress_workflow" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">llms.txt generator for WordPress</a>.
            When you want the full picture beyond llms.txt — crawlability, schema,
            content signals, and AI discovery — run a
            {' '}
            <a href="/ai-seo-audit/" data-cta="llms_generator_content_ai_seo_audit" class="text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep">free AI visibility audit</a>.
          </p>
        </section>

        <section class="mt-12 md:mt-16">
          <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">What llms.txt covers and what it does not cover</h2>
          <p class="mt-4 max-w-3xl leading-relaxed text-ink-soft">
            Publishing llms.txt improves orientation, but it does not replace a full
            GEO workflow. Use this table to decide the next check after the file is live.
          </p>
          <div class="mt-5 overflow-x-auto rounded-[4px] border border-rail bg-white">
            <table class="min-w-full border-collapse text-left text-sm">
              <thead class="bg-paper">
                <tr>
                  <th scope="col" class="border-b border-rail px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Need</th>
                  <th scope="col" class="border-b border-rail px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Covered by llms.txt?</th>
                  <th scope="col" class="border-b border-rail px-4 py-3 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-ink-mute">Next GeoReady step</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row" class="border-b border-rail px-4 py-3 font-semibold text-ink">List important URLs</th>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Yes. llms.txt can summarize canonical pages and sections.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Generate the file, edit descriptions, publish at /llms.txt.</td>
                </tr>
                <tr>
                  <th scope="row" class="border-b border-rail px-4 py-3 font-semibold text-ink">Allow AI crawler access</th>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">No. robots.txt and server rules still control access.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Run the free audit to check robots.txt, redirects, and blocked agents.</td>
                </tr>
                <tr>
                  <th scope="row" class="border-b border-rail px-4 py-3 font-semibold text-ink">Earn AI citations</th>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">No. Citations depend on source quality, structure, and off-page signals.</td>
                  <td class="border-b border-rail px-4 py-3 text-ink-soft">Track citation prompts and competitor sources over time.</td>
                </tr>
                <tr>
                  <th scope="row" class="px-4 py-3 font-semibold text-ink">Catch regressions</th>
                  <td class="px-4 py-3 text-ink-soft">No. A static file will not tell you when visibility drops.</td>
                  <td class="px-4 py-3 text-ink-soft">Monitor weekly changes with GeoReady Pro.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </section>

    {/* 4. FAQ */}
    <section class="border-t border-rail bg-paper">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <h2 class="font-head text-2xl font-extrabold tracking-[-0.02em] text-ink md:text-3xl">llms.txt generator FAQ</h2>
        <div class="mt-8 max-w-3xl">
          {faqs.map((faq) => (
            <div class="border-t border-rail py-5 first:border-t-0 first:pt-0">
              <h3 class="text-base font-semibold text-ink">{faq.question}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* CTA — banda di verdetto della pagina */}
    <section class="border-t border-rail bg-pass-deep">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <h2 class="max-w-3xl font-head text-2xl font-extrabold tracking-[-0.02em] text-white md:text-3xl">Go beyond llms.txt with a full AI SEO audit</h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-pass-wash">
          An llms.txt is one signal. The free audit checks your site across eight
          GEO categories — crawlability, llms.txt, schema, content signals, AI
          discovery, and more — so you know where to focus next. No account
          needed.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href="/ai-seo-audit/"
            data-cta="llms_generator_final_free_audit"
            class="inline-flex items-center justify-center rounded-[4px] bg-white px-6 py-3 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-pass-deep transition-colors hover:bg-pass-wash"
          >
            Run a free AI visibility audit
          </a>
          <a
            href="https://app.geoready.dev/signup?plan=pro&intent=llms&utm_source=llms_txt_generator_page&utm_medium=content_cta&utm_campaign=tool_to_paid"
            data-plan-id="pro"
            data-plan-name="Pro"
            data-plan-period="monthly"
            data-plan-price="$19"
            data-plan-currency="USD"
            data-cta-location="llms_generator_final_monitoring"
            class="inline-flex items-center justify-center rounded-[4px] border border-white/40 px-6 py-3 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:border-white hover:bg-white/10"
          >
            Monitor weekly changes
          </a>
          <a
            href="/ai-seo/"
            data-cta="llms_generator_final_ai_seo"
            class="inline-flex items-center justify-center rounded-[4px] border border-white/40 px-6 py-3 font-mono text-[12px] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:border-white hover:bg-white/10"
          >
            Learn about AI SEO
          </a>
        </div>
        <p class="mt-4 text-xs text-pass-wash/90">
          New to the standard? Start with
          {' '}
          <a href="/guides/what-is-llms-txt/" class="text-white underline underline-offset-2 hover:text-pass-wash">what is llms.txt</a>.
        </p>
      </div>
    </section>
  </article>

  {/* Schema JSON-LD: WebApplication (il tool) + FAQPage (le stesse FAQ visibili). */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "@id": "https://geoready.dev/tools/llms-txt-generator/#webapp",
        "isPartOf": { "@id": "https://geoready.dev/#webapp" },
        "name": "Free llms.txt Generator",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Any",
        "url": canonical,
        "description": description,
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "publisher": { "@id": "https://geoready.dev/#organization" }
      },
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map((faq) => ({
          "@type": "Question",
          "name": faq.question,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.answer
          }
        }))
      }
    ]
  })} />
</Shell>
