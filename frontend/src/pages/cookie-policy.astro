---
import Shell from '../components/Shell.astro';
import {
  cookieRegistry,
  getCategories,
  getCategoryLabel,
  getCategoryDescription,
  getCookiesByCategory,
  CONSENT_VERSION,
} from '../lib/cookieRegistry';

const lastUpdated = 'October 26, 2026';
const categories = getCategories();

// Generated from cookieRegistry — the same module the consent banner reads. The
// previous version of this page kept the inventory in hand-written HTML, which
// drifted away from the code and ended up telling visitors that Google Analytics
// was not in use while it was. A generated table cannot drift.
const typeLabels: Record<string, string> = {
  cookie: 'Cookie',
  localStorage: 'localStorage',
  sessionStorage: 'sessionStorage',
  'external-request': 'External request',
};

// Nel mondo console il colore riporta solo stato: "necessary" è attivo (pass),
// tutte le altre categorie sono spente finché l'utente non acconsente (neutro).
const categoryClasses: Record<string, string> = {
  necessary: 'text-pass-deep border-pass/40',
  preferences: 'text-ink-mute border-rail',
  analytics: 'text-ink-mute border-rail',
  marketing: 'text-ink-mute border-rail',
};
---

<Shell
  title="Cookie Policy — GeoReady"
  description="Every cookie and storage key used on geoready.dev: purpose, provider, legal basis, duration, and how to change or withdraw your consent."
  canonical="https://geoready.dev/cookie-policy/"
>
  <div class="bg-paper">
    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 md:py-16">
      <header class="mb-12 md:mb-16">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h1 class="text-[2.1rem] font-semibold leading-[1.08] tracking-[-0.035em] text-ink sm:text-[2.6rem]">Cookie Policy</h1>
          <div class="eyebrow">GeoReady · Cookie Policy</div>
        </div>
        <p class="mt-3 font-mono text-[12px] text-ink-mute">Last updated: {lastUpdated} · Consent version {CONSENT_VERSION}</p>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-ink-soft">
          This page covers <strong class="font-semibold text-ink">geoready.dev</strong>, the public
          website. The inventory below is generated from the same configuration the consent
          banner uses, so what you read here is what the site actually does. The signed-in
          application has its own policy at
          <a href="https://app.geoready.dev/cookie-policy" class="text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">app.geoready.dev/cookie-policy</a>.
        </p>
      </header>

      <div class="space-y-10 leading-relaxed text-ink-soft">
        <section>
          <h2 class="mb-3 font-head text-xl font-semibold tracking-[-0.02em] text-ink">Cookies, local storage, and why both matter</h2>
          <p class="mb-3 text-sm">
            A cookie is a small file a site stores on your device. Browsers also offer
            <strong class="font-semibold text-ink">localStorage</strong>, which does the same job
            without sending anything back with each request. The law treats them the same way:
            storing or reading information on your device requires your consent unless it is
            strictly necessary to provide what you asked for (ePrivacy Directive art. 5(3)).
            We list both below and ask for consent for both.
          </p>
          <p class="mb-3 text-sm">
            Nothing in the analytics or marketing categories is loaded before you accept it.
            Rejecting costs you nothing: every page, the audit, and the tools work identically
            either way.
          </p>
          <p class="text-sm">
            Your choice also travels as a signal. Through
            <strong class="font-semibold text-ink">Google Consent Mode v2</strong> this site declares
            all four Google consent types — analytics storage, ad storage, ad user data and ad
            personalisation — as <em>denied</em> before any Google tag can run, and updates them
            only when you decide. Because the Analytics property is linked to Google Ads for
            conversion measurement, that declaration is what keeps a refusal meaningful on
            Google's side rather than only on ours. No advertising cookie is set here in either
            case.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-head text-xl font-semibold tracking-[-0.02em] text-ink">Categories</h2>
          <div class="mt-4 space-y-3">
            {categories.map((cat, i) => (
              <div class="panel p-4">
                <div class="mb-1 flex items-center gap-2">
                  <h3 class="text-sm font-semibold text-ink">{i + 1}. {getCategoryLabel(cat)}</h3>
                  {cat === 'necessary' ? (
                    <span class="font-text font-medium text-[12px] text-pass-deep">always on</span>
                  ) : (
                    <span class="eyebrow">off unless you accept</span>
                  )}
                </div>
                <p class="text-sm">{getCategoryDescription(cat)}</p>
                <p class="mt-2 text-xs text-ink-mute">
                  {getCookiesByCategory(cat).length === 0
                    ? 'Nothing is stored in this category today.'
                    : `${getCookiesByCategory(cat).length} item(s) — see the inventory below.`}
                </p>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h2 class="mb-3 font-head text-xl font-semibold tracking-[-0.02em] text-ink">Full inventory</h2>
          <p class="mb-4 text-sm">
            Every cookie and storage key this site can create, with the legal basis for each.
            Names shown with <code class="font-mono text-xs text-ink">&lt;…&gt;</code> contain a
            container identifier that varies.
          </p>

          <div class="overflow-x-auto panel">
            <table class="w-full min-w-[560px] text-sm">
              <thead class="bg-paper">
                <tr>
                  <th class="border-b border-rail px-4 py-3 text-left eyebrow">Name</th>
                  <th class="border-b border-rail px-4 py-3 text-left eyebrow">Category</th>
                  <th class="border-b border-rail px-4 py-3 text-left eyebrow">Type</th>
                  <th class="border-b border-rail px-4 py-3 text-left eyebrow">Provider</th>
                  <th class="border-b border-rail px-4 py-3 text-left eyebrow">Duration</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-rail">
                {cookieRegistry.map((c) => (
                  <tr class="align-top">
                    <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-ink">{c.name}</td>
                    <td class="px-4 py-3">
                      <span class={`rounded-[6px] border px-1.5 py-0.5 font-text text-[12px] font-semibold ${categoryClasses[c.category]}`}>
                        {getCategoryLabel(c.category)}
                      </span>
                    </td>
                    <td class="px-4 py-3 text-xs">{typeLabels[c.type] ?? c.type}</td>
                    <td class="px-4 py-3 text-xs">{c.provider}</td>
                    <td class="px-4 py-3 text-xs">{c.duration}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="mt-6 space-y-4">
            {cookieRegistry.map((c) => (
              <div class="panel p-4">
                <div class="mb-2 flex flex-wrap items-center gap-2">
                  <code class="font-mono text-xs font-semibold text-ink">{c.name}</code>
                  <span class={`rounded-[6px] border px-1.5 py-0.5 font-text text-[12px] font-semibold ${categoryClasses[c.category]}`}>
                    {getCategoryLabel(c.category)}
                  </span>
                  <span class="font-mono text-[11px] text-ink-mute">
                    {typeLabels[c.type] ?? c.type} · {c.firstOrThirdParty === 'first' ? 'first-party' : 'third-party'} · {c.domain}
                  </span>
                </div>
                <p class="mb-2 text-sm">{c.purpose}</p>
                <dl class="grid gap-x-6 gap-y-1 text-xs sm:grid-cols-2">
                  <div>
                    <dt class="inline text-ink-mute">Service: </dt>
                    <dd class="inline">{c.service}</dd>
                  </div>
                  <div>
                    <dt class="inline text-ink-mute">Duration: </dt>
                    <dd class="inline">{c.duration}</dd>
                  </div>
                  <div class="sm:col-span-2">
                    <dt class="inline text-ink-mute">Legal basis: </dt>
                    <dd class="inline">{c.legalBasis}</dd>
                  </div>
                  {c.dataShared && (
                    <div class="sm:col-span-2">
                      <dt class="inline text-ink-mute">Data involved: </dt>
                      <dd class="inline">{c.dataShared}</dd>
                    </div>
                  )}
                </dl>
                {c.notes && <p class="mt-2 text-xs text-ink-mute">{c.notes}</p>}
                {c.privacyPolicyUrl && (
                  <p class="mt-2 text-xs">
                    <a href={c.privacyPolicyUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-pass-deep underline decoration-rail underline-offset-2 transition-colors hover:decoration-pass-deep">
                      Provider privacy policy
                      <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
                      </svg>
                    </a>
                  </p>
                )}
              </div>
            ))}
          </div>

          <div class="mt-6 space-y-2 text-xs text-ink-mute">
            <p>
              <strong class="font-semibold text-ink-soft">Fonts:</strong> self-hosted and served from
              this domain. No request to an external CDN, no cookie.
            </p>
            <p>
              <strong class="font-semibold text-ink-soft">Astro, React, Tailwind:</strong> the framework
              itself sets no cookie and stores nothing. There is no session cookie on this site.
            </p>
            <p>
              <strong class="font-semibold text-ink-soft">Launchpadly badge:</strong> the directory badge in
              the footer is an image loaded from launchpadly.co. Displaying it sends your IP address
              and browser type to that provider, as any remote image does. It sets no cookie, and
              it is the only third-party request a page makes without your action.
            </p>
            <p>
              <strong class="font-semibold text-ink-soft">Guides:</strong> written in the Sanity content
              platform but rendered into static pages at build time. Reading a guide makes no
              request to Sanity from your browser.
            </p>
            <p>
              <strong class="font-semibold text-ink-soft">Links out:</strong> GitHub, PyPI and similar
              links in the footer are plain links. Nothing is sent to those sites unless you
              click.
            </p>
          </div>
        </section>

        <section>
          <h2 class="mb-3 font-head text-xl font-semibold tracking-[-0.02em] text-ink">Consent Mode</h2>
          <p class="text-sm">
            Before any Google tag can initialise, the site declares
            <strong class="font-semibold text-ink">Google Consent Mode v2</strong> with all four
            storage types — <code class="font-mono text-xs text-ink">ad_storage</code>,
            <code class="font-mono text-xs text-ink">analytics_storage</code>,
            <code class="font-mono text-xs text-ink">ad_user_data</code>,
            <code class="font-mono text-xs text-ink">ad_personalization</code> — set to denied, and
            updates them only after you choose. This runs before the tag loads, which is the
            only point at which the declaration is effective.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-head text-xl font-semibold tracking-[-0.02em] text-ink">Changing or withdrawing your consent</h2>
          <p class="mb-3 text-sm">
            Click the <strong class="font-semibold text-ink">Cookies</strong> button at the bottom
            left of any page. Withdrawing analytics consent takes effect immediately: the
            matching cookies and storage keys are deleted from your device and the Google tag
            is told that consent is denied. Withdrawing is as easy as accepting was — same
            number of clicks, no account needed.
          </p>
          <p class="mb-3 text-sm">
            Your choice is stored per device and per domain. Setting it here does not change it
            on app.geoready.dev, and vice versa — each domain asks separately, as the rules
            require.
          </p>
          <p class="mb-3 text-sm">You can also manage cookies in your browser:</p>
          <ul class="list-disc space-y-1 pl-5 text-sm">
            <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener noreferrer" class="text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Google Chrome</a></li>
            <li><a href="https://support.mozilla.org/en-US/kb/cookies-information-websites-store-on-your-computer" target="_blank" rel="noopener noreferrer" class="text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Mozilla Firefox</a></li>
            <li><a href="https://support.apple.com/en-us/105082" target="_blank" rel="noopener noreferrer" class="text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Safari</a></li>
            <li><a href="https://support.microsoft.com/en-us/microsoft-edge" target="_blank" rel="noopener noreferrer" class="text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Microsoft Edge</a></li>
          </ul>
          <p class="mt-3 text-sm">
            Clearing browser storage removes the record of your choice too, so the banner will
            ask again.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-head text-xl font-semibold tracking-[-0.02em] text-ink">Data protection</h2>
          <p class="text-sm">
            Who processes your data, on what legal basis, where it goes and how long it is kept:
            see the <a href="/privacy/" class="text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">Privacy Policy</a>.
            Questions or requests:
            <a href="mailto:info@geoready.dev" class="text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">info@geoready.dev</a>.
          </p>
        </section>

        <section>
          <h2 class="mb-3 font-head text-xl font-semibold tracking-[-0.02em] text-ink">Updates</h2>
          <p class="text-sm">
            When we add or remove something that stores data on your device, this page and the
            consent version change together. A new consent version means the banner asks again
            rather than carrying over a choice you made about a different inventory — which is
            why version {CONSENT_VERSION} re-prompted everyone.
          </p>
        </section>
      </div>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Cookie Policy — GeoReady",
    "description": "Every cookie and storage key used on geoready.dev: purpose, provider, legal basis, duration, and how to change or withdraw your consent.",
    "url": "https://geoready.dev/cookie-policy/",
    "isPartOf": {
      "@type": "WebSite",
      "name": "GeoReady",
      "url": "https://geoready.dev"
    }
  })} />
</Shell>
