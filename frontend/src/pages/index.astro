---
import Shell from '../components/Shell.astro';
import AuditForm from '../components/AuditForm';
import StatsBar from '../components/StatsBar';
import HeroInstrument from '../components/home/HeroInstrument.astro';
import { getBenchmark } from '../utils/benchmark';
import { getPublicStats } from '../utils/publicStats';

// I nove pesi della rubrica v2 (default dalla 4.19.0), come in models/config.py
// (CATEGORY_MAX_V2). Sono qui perché la pagina rivendica "auditable scoring": affermarlo
// e non mostrarlo è la stessa opacità che il prodotto critica. Tenere allineato ai pesi reali.
// La quarta colonna è la chiave di categoria dello score_breakdown JSON: è l'ID
// che il rail dei gate mostra come annotazione, quindi deve restare quella vera.
const SCORING_WEIGHTS = [
  ['Google AI readiness', 20, 'Indexable page, snippet controls, canonical, dates, byline, crawlable links, viewport, sitemap.', 'google_ai'],
  ['Robots.txt', 14, 'Whether citation crawlers are allowed to fetch the site at all.', 'robots'],
  ['Schema JSON-LD', 14, 'Valid structured data: Organization, WebSite, Article, FAQ.', 'schema'],
  ['Content', 14, 'Heading hierarchy, word count, lists, front-loaded answers, image alt text.', 'content'],
  ['Brand & entity', 12, 'Naming coherence, Knowledge Graph readiness, topic authority.', 'brand_entity'],
  ['Meta tags', 11, 'Title, description, canonical, and Open Graph completeness.', 'meta'],
  ['llms.txt', 6, 'Presence and depth of the root-level orientation file, including llms-full.txt.', 'llms'],
  ['Signals', 6, 'Declared language, feed availability, freshness date.', 'signals'],
  ['AI discovery', 3, 'The .well-known/ai.txt and /ai/*.json endpoints.', 'ai_discovery'],
] as const;

// Aggregati della coorte, letti a build time da GET /api/public/benchmark: erano
// hardcoded perché la build Docker gira prima che l'app locale sia in piedi, ma
// l'endpoint è pubblico e la build lo raggiunge come già fa con Sanity. I valori scritti
// a mano restavano indietro senza che nessuno se ne accorgesse — «750+ siti, media 54.3»
// contro i 900+ e 54.6 reali. Se l'endpoint non risponde si usano i valori di fallback:
// vedi utils/benchmark.ts.
const BENCHMARK = await getBenchmark();

// Stessa ragione: i contatori di StatsBar arrivavano solo via JS, quindi l'HTML statico
// mostrava a un crawler il fallback fermo a luglio (587 stelle, 5.134 download).
const { stats: PUBLIC_STATS, isLive: STATS_ARE_LIVE } = await getPublicStats();

// Un esempio concreto di fallimento per ogni gate: è quello che il pannello mostra
// quando si seleziona la categoria. Descrive check che il motore esegue davvero
// (core/audit.py), non promesse.
const GATE_EXAMPLES: Record<string, { check: string; fail: string }> = {
  google_ai: { check: '<meta name="robots" content="nosnippet">', fail: 'Snippet controls stop Google from quoting the page in AI Overviews.' },
  robots: { check: 'User-agent: GPTBot\nDisallow: /', fail: 'The citation crawler is refused before it reads a single line.' },
  schema: { check: '"@type": "Organization", "name": "Acme Inc"', fail: 'Structured data names a brand the visible page never uses.' },
  content: { check: '<h3>Pricing</h3> before any <h2>', fail: 'A broken heading outline makes passages harder to lift as answers.' },
  brand_entity: { check: 'title: "ACME" · schema: "Acme Studio" · footer: "Acme srl"', fail: 'Three names for one entity weaken the knowledge-graph match.' },
  meta: { check: '<meta name="description"> missing', fail: 'Engines fall back to an arbitrary excerpt for the summary.' },
  llms: { check: 'GET /llms.txt → 404', fail: 'No orientation file for agents that look for one.' },
  signals: { check: '"dateModified": "2027-01-01"', fail: 'A future date fails the freshness check.' },
  ai_discovery: { check: 'GET /.well-known/ai.txt → 404', fail: 'No machine-readable statement of AI crawler permissions.' },
};

// Serie di esempio per il grafico del monitoring: 12 settimane di un dominio fittizio,
// con una regressione alla settimana 8 sopra la soglia di alert (5 punti).
const HISTORY = [58, 61, 63, 66, 68, 71, 73, 64, 73, 74, 75, 76];
const CH = { w: 640, h: 200, pad: 18 };
const x = (i: number) => CH.pad + (i * (CH.w - CH.pad * 2)) / (HISTORY.length - 1);
const y = (v: number) => CH.h - CH.pad - ((v - 50) * (CH.h - CH.pad * 2)) / 30;
const HISTORY_PATH = HISTORY.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
const DROP = 7; // indice della settimana con la regressione

const faqs = [
  {
    q: 'What is Generative Engine Optimization?',
    a: 'GEO is the practice of making websites discoverable, readable, and citable by AI search engines such as ChatGPT, Perplexity, Claude, and Gemini. It focuses on structured data, content hierarchy, and technical signals that AI crawlers prioritize.',
  },
  {
    q: 'What does GeoReady check?',
    a: 'GeoReady audits 9 categories: Google AI readiness, robots.txt, JSON-LD schema, content quality, brand entity signals, meta tags, llms.txt, technical signals, and AI discovery paths. It also detects prompt injection patterns and negative signals through the same open-source GEO Optimizer engine. The CLI additionally offers Agent Access Audit (bot vs browser access simulation via `geo access`) and AI Crawler Activity Analytics (server log parsing via `geo logs`).',
  },
  {
    q: 'How is GEO different from traditional SEO?',
    a: 'Traditional SEO optimizes for keyword rankings and backlinks in conventional search engines. GEO optimizes for AI citation signals: structured data, clear content architecture, AI crawler permissions, and self-contained answer blocks. The two complement rather than replace each other.',
  },
  {
    q: 'Does a high score guarantee that AI answers will cite my site?',
    a: 'No. The score measures whether answer engines can reach, read, and attribute your pages. Whether a page is cited also depends on the question asked, the engine, and the competing sources. A low score, on the other hand, usually means a blocker that no content work can get past.',
  },
  {
    q: 'Do I still need Semrush or Ahrefs?',
    a: 'Yes, if you track keyword rankings and backlinks. GeoReady measures a different layer: AI crawler access, structured data, passage structure, and AI answer checks. Most teams run both.',
  },
  {
    q: 'Which parts of monitoring are automated?',
    a: 'Site audits and score monitoring run automatically on our servers: weekly on Pro, daily on Agency. AI answer checks query Perplexity through its API. For ChatGPT and Google AI answers you paste the answer you see and GeoReady scores it the same way. GeoReady does not scrape those interfaces.',
  },
  {
    q: 'Is the Pro plan available now?',
    a: 'Yes. Pick a plan and your account activates immediately. No sales call, no waitlist.',
  },
  {
    q: 'Is GeoReady open source?',
    a: 'The core GEO Optimizer engine is MIT licensed. Source code, scoring weights, and methodology are publicly available on GitHub. The CLI and the free web audit remain free; GeoReady Pro adds monitoring, history, alerts, exports, and team workflows.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};

// WebPage della homepage, emesso come blocco JSON-LD SEPARATO e non dentro il @graph
// globale di Layout.astro, per due motivi verificati sul motore di audit:
//  1. il check di freschezza (`signals`) legge `dateModified` solo al primo livello di
//     ogni blocco JSON-LD, quindi una data annidata in @graph non verrebbe vista;
//  2. il @graph di Layout è emesso su ogni pagina, e una data di aggiornamento valida
//     per la sola homepage non deve finire su tutte le altre.
//
// `dateModified` è la data della lettura del benchmark mostrata in pagina (la stessa di
// <time datetime> più sotto): è l'ultimo dato che cambia davvero su questa pagina, e non
// la data della build, che cambierebbe a ogni deploy anche senza modifiche di contenuto.
// `datePublished` è omesso apposta: la data di lancio reale non è nel repository e non
// va inventata.
//
// `author` riporta il nome oltre all'@id: un riferimento nudo `{"@id": ...}` non ha
// `name`, e il check di byline accetta solo un autore dichiarato con il nome.
// Titolo unico della pagina: lo usano sia <title>/og:title (via Shell) sia il `name` del
// WebPage. Con due stringhe scritte a mano basta una modifica a una sola per farle divergere.
//
// Il brand sta PRIMA del separatore. Il check di coerenza del nome (brand_entity) taglia
// title e og:title al primo separatore e confronta ciò che sta a sinistra con H1 e schema. Con
// il brand in coda, a sinistra restava la descrizione ("AI Visibility Audit & Citation
// Monitoring"), che non coincide con nessun'altra fonte, e il nome risultava incoerente
// anche se GeoReady compariva ovunque.
const PAGE_TITLE = "GeoReady | AI Visibility Audit & Monitoring";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://geoready.dev/#webpage",
  "url": "https://geoready.dev/",
  "name": PAGE_TITLE,
  "inLanguage": "en",
  "isPartOf": { "@id": "https://geoready.dev/#website" },
  "about": { "@id": "https://geoready.dev/#webapp" },
  "publisher": { "@id": "https://geoready.dev/#organization" },
  "author": {
    "@type": "Person",
    "@id": "https://geoready.dev/#founder",
    "name": "Juan Camilo Auriti"
  },
  "dateModified": BENCHMARK.asOfIso
};

// Larghezza della barra del benchmark: dato reale della coorte.
const avgPct = Math.max(0, Math.min(100, Number(BENCHMARK.average) || 0));

---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
<Shell
  title={PAGE_TITLE}
  description="Free AI visibility audit: check if ChatGPT, Perplexity, Claude and Gemini can reach, read and cite your site, then monitor the score over time."
  canonical="https://geoready.dev/"
>
  {/* Hero: la promessa a sinistra, lo strumento a destra */}
  <section id="audit-form" data-hero-bleed class="hero-v2 relative overflow-hidden bg-paper text-ink">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 pt-14 pb-16 sm:px-6 md:pt-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,540px)] lg:items-center lg:gap-14 lg:pb-24">
      <div class="min-w-0">
        <p class="eyebrow">AI visibility audit · monitoring</p>
        <h1 class="mt-4 max-w-[15ch] text-[2.55rem] font-semibold leading-[1.03] tracking-[-0.035em] sm:text-[3.4rem] xl:text-[4rem]">
          Know if AI answers can <em>cite</em> your site.
        </h1>
        <p class="mt-6 max-w-[54ch] text-[17px] leading-relaxed text-ink-soft">
          GeoReady is a Generative Engine Optimization (GEO) platform. Enter one URL and in about a minute you see whether ChatGPT, Perplexity, Claude and Gemini can reach, read and attribute it: a 0-100 score across 9 published categories, the fixes ranked by points, and the rule behind every point.
        </p>

        <div class="mt-8 max-w-[600px]">
          <AuditForm client:load variant="console" />
        </div>
        <p class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] text-ink-mute">
          <span class="inline-flex items-center gap-1.5"><span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-pass"></span>Free · no account · 5 audits a day</span>
          <a href="/report/demo/" data-cta="home_hero_demo_report" class="font-medium text-ink underline decoration-current/50 underline-offset-4 hover:decoration-pass-deep">View a sample report</a>
          <a href="/geo-readiness-manual/" data-cta="home_hero_manual" class="font-medium text-ink underline decoration-current/50 underline-offset-4 hover:decoration-pass-deep">Read the GEO manual</a>
          <a href="/pricing/" data-cta="home_hero_pro_monitoring" class="font-medium text-ink underline decoration-current/50 underline-offset-4 hover:decoration-pass-deep">Monitoring plans</a>
        </p>
      </div>

      <div class="min-w-0">
        <HeroInstrument />
      </div>
    </div>
  </section>

  {/* Proof strip: fatti verificabili, contatori live */}
  <section class="border-y border-rail bg-white text-ink" aria-label="GeoReady in numbers">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-6 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
      <dl class="grid grid-cols-2 gap-x-8 gap-y-4 sm:grid-cols-4 lg:gap-x-10">
        <div><dt class="eyebrow">AI bots checked</dt><dd class="mt-1 font-mono text-xl font-medium tabular-nums">27</dd></div>
        <div><dt class="eyebrow">Categories · points</dt><dd class="mt-1 font-mono text-xl font-medium tabular-nums">9 · 100</dd></div>
        <div><dt class="eyebrow">Citability checks</dt><dd class="mt-1 font-mono text-xl font-medium tabular-nums">47</dd></div>
        <div><dt class="eyebrow">Engine licence</dt><dd class="mt-1 font-mono text-xl font-medium">MIT</dd></div>
      </dl>
      <div class="[&_dl]:mt-0">
        <StatsBar client:idle variant="console" initial={PUBLIC_STATS} initialIsLive={STATS_ARE_LIVE} />
      </div>
    </div>
  </section>

  {/* I nove gate: lista a sinistra, dettaglio a destra. Senza JS sono tutti visibili. */}
  <section class="bg-paper text-ink" aria-labelledby="gates-h">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 md:py-28">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-end" data-reveal>
        <div>
          <p class="eyebrow">01 · What the audit reads</p>
          <h2 id="gates-h" class="mt-3 max-w-[18ch] text-3xl font-semibold tracking-[-0.03em] md:text-[2.75rem] md:leading-[1.08]">
            Nine gates, <em>published</em> weights, one score.
          </h2>
        </div>
        <p class="max-w-[52ch] leading-relaxed text-ink-soft">
          AI SEO is not a checklist, it is a retrieval path: an answer engine has to reach the page, understand it, trust it and quote it. Each gate below covers one step. The weights are the ones in the open-source engine (<code class="font-mono text-[13px]">CATEGORY_MAX_V2</code>), so any score can be recomputed by hand. For the engine-by-engine view, see the <a href="/ai-seo-audit/" data-cta="home_ai_seo_audit_link" class="text-pass-deep underline decoration-current/50 underline-offset-4 hover:decoration-pass-deep">AI SEO audit</a>.
        </p>
      </div>

      <div class="gates panel mt-10 grid overflow-hidden md:grid-cols-[minmax(0,300px)_minmax(0,1fr)]" data-gates data-reveal>
        <div class="gate-list border-b border-rail md:border-r md:border-b-0" aria-label="Scoring categories" data-gate-list>
          {SCORING_WEIGHTS.map(([name, points, , key], i) => (
            <button type="button" id={`gate-tab-${key}`} aria-controls={`gate-${key}`} class="gate-tab" data-gate-tab>
              <span aria-hidden="true" class="font-mono text-[11.5px] tabular-nums text-ink-mute">{String(i + 1).padStart(2, '0')}</span>
              <span class="min-w-0 flex-1 truncate text-left text-[14px] font-medium">{name}</span>
              <span class="gate-bar" aria-hidden="true"><i style={`width:${(points / 20) * 100}%`}></i></span>
              <span class="w-6 text-right font-mono text-[12px] tabular-nums text-ink-soft">{points}<span class="sr-only"> points</span></span>
            </button>
          ))}
        </div>
        <div class="min-w-0">
          {SCORING_WEIGHTS.map(([name, points, what, key], i) => (
            <article id={`gate-${key}`} aria-labelledby={`gate-tab-${key}`} class="gate-panel p-6 md:p-8" data-gate-panel>
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h3 class="text-xl font-semibold tracking-[-0.02em]">{name}</h3>
                <p class="font-mono text-[13px] tabular-nums text-ink-mute"><span class="text-ink">{points}</span> / 100 pts · <span>{key}</span></p>
              </div>
              <p class="mt-3 max-w-[60ch] leading-relaxed text-ink-soft">{what}</p>
              <div class="mt-6 overflow-hidden rounded-[9px] bg-[#0B1010] text-[#E8F0EF]">
                <div class="flex items-center justify-between border-b border-[#1F2929] px-4 py-2">
                  <span class="font-mono text-[11.5px] text-[#7C8C8B]">a typical failing check</span>
                  <span class="rounded-[6px] bg-[#FF6B78]/15 px-2 py-0.5 font-mono text-[11px] text-[#FF6B78]">fail</span>
                </div>
                <pre class="overflow-x-auto px-4 py-4 font-mono text-[13px] leading-relaxed"><code>{GATE_EXAMPLES[key].check}</code></pre>
              </div>
              <p class="mt-3 text-[14px] leading-relaxed text-ink-soft">{GATE_EXAMPLES[key].fail}</p>
            </article>
          ))}
        </div>
      </div>

      <p class="mt-6 font-mono text-[12px] tabular-nums text-ink-mute">
        Bands: 86-100 excellent · 68-85 good · 36-67 foundation · 0-35 critical ·
        <a href="/methodology/" class="text-pass-deep underline underline-offset-4">full methodology</a> ·
        <a href="/guides/" class="text-pass-deep underline underline-offset-4">guides</a>
      </p>

      {/* Il percorso di recupero, con i link editoriali verso le guide */}
      <ol class="mt-14 grid gap-px overflow-hidden rounded-[14px] bg-rail md:grid-cols-3" data-reveal="stagger">
        {[
          ['Access', 'Crawler permissions, HTTP behavior and server-rendered content decide whether AI systems can reach the page.', '/guides/', 'AI visibility guides'],
          ['Meaning', 'Schema, headings, llms.txt and a consistent entity name tell the model what the page is about.', '/guides/what-are-ai-citations/', 'What counts as an AI citation'],
          ['Citation', 'Self-contained answers and factual density make a passage easy to quote inside a generated response.', '/citation-gap-analysis/', 'Citation gap analysis'],
        ].map(([title, text, href, label], i) => (
          <li class="bg-paper p-6">
            <p class="font-mono text-[12px] text-ink-mute">step {i + 1}</p>
            <h3 class="mt-2 text-lg font-semibold">{title}</h3>
            <p class="mt-2 text-[14px] leading-relaxed text-ink-soft">{text}</p>
            <a href={href} class="mt-4 inline-block text-[14px] font-medium text-pass-deep underline decoration-current/50 underline-offset-4 hover:decoration-pass-deep">{label}</a>
          </li>
        ))}
      </ol>
      <p class="mt-6 max-w-[62ch] text-[14px] leading-relaxed text-ink-soft">
        To test your own pages, read
        {' '}<a href="/guides/ai-citations-check/" class="text-pass-deep underline decoration-current/50 underline-offset-4 hover:decoration-pass-deep">how do I know if my content is cited in ChatGPT answers</a>.
      </p>
    </div>
  </section>

  {/* Monitoring: la banda scura, come la dashboard in dark mode */}
  <section class="band-dark" aria-labelledby="monitor-h">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 md:py-28">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center">
        <div data-reveal>
          <p class="eyebrow">02 · Monitoring</p>
          <h2 id="monitor-h" class="mt-3 max-w-[16ch] text-3xl font-semibold tracking-[-0.03em] md:text-[2.75rem] md:leading-[1.08]">
            An audit is a <em>baseline</em>. Monitoring tells you when it moves.
          </h2>
          <p class="mt-5 max-w-[50ch] leading-relaxed text-ink-soft">
            A plugin update rewrites robots.txt, a theme drops the JSON-LD, a migration loses the canonical. Monitoring re-runs the same scoring on a schedule, keeps the history, and emails you when the score drops by 5 points or more.
          </p>
          <dl class="mt-8 divide-y divide-rail border-y border-rail text-[14px]">
            <div class="flex justify-between gap-4 py-3"><dt class="text-ink-soft">Pro</dt><dd class="font-mono tabular-nums">10 domains · weekly</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-ink-soft">Agency</dt><dd class="font-mono tabular-nums">50 domains · daily</dd></div>
            <div class="flex justify-between gap-4 py-3"><dt class="text-ink-soft">Alert threshold</dt><dd class="font-mono tabular-nums">−5 pts</dd></div>
          </dl>
          <a href="/pricing/" data-cta="home_hero_monitoring_micro" class="mt-8 inline-flex items-center gap-2 rounded-[9px] bg-[#2DD4BF] px-5 py-3 text-[14px] font-semibold text-[#062420] transition-colors hover:bg-[#5EEAD4]">
            See monitoring plans
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
          </a>
        </div>

        <figure class="panel p-5 md:p-6" data-history data-reveal>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <p class="text-[14px] font-medium">Score history · sample domain</p>
            <p class="font-mono text-[12px] text-ink-mute">12 weekly runs</p>
          </div>
          <svg viewBox={`0 0 ${CH.w} ${CH.h}`} class="mt-4 h-auto w-full" role="img" aria-label={`Sample score history: from ${HISTORY[0]} to ${HISTORY[HISTORY.length - 1]}, with a drop from ${HISTORY[DROP - 1]} to ${HISTORY[DROP]} in week ${DROP + 1}`}>
            {[55, 65, 75].map((v) => (
              <g>
                <line x1={CH.pad} x2={CH.w - CH.pad} y1={y(v)} y2={y(v)} stroke="#1F2929" stroke-dasharray="3 5" />
                <text x={CH.w - CH.pad} y={y(v) - 6} text-anchor="end" fill="#7C8C8B" font-size="11" font-family="Geist Mono, monospace">{v}</text>
              </g>
            ))}
            <rect x={x(DROP) - 14} y={CH.pad} width="28" height={CH.h - CH.pad * 2} rx="6" fill="#FF6B78" opacity="0.08" />
            <path d={HISTORY_PATH} fill="none" stroke="#2DD4BF" stroke-width="2.25" stroke-linejoin="round" stroke-linecap="round" data-history-line />
            {HISTORY.map((v, i) => (
              <circle cx={x(i)} cy={y(v)} r={i === DROP ? 5 : 3} fill={i === DROP ? '#FF6B78' : '#111616'} stroke={i === DROP ? '#FF6B78' : '#2DD4BF'} stroke-width="2" data-history-dot />
            ))}
          </svg>
          <div class="mt-4 flex items-start gap-3 rounded-[9px] bg-[#172020] px-4 py-3" data-history-alert>
            <span class="mt-0.5 rounded-[6px] bg-[#FF6B78]/15 px-2 py-0.5 font-mono text-[11px] text-[#FF6B78]">alert</span>
            <p class="text-[13.5px] leading-relaxed text-ink-soft">
              <span class="font-medium text-ink">Week {DROP + 1}: {HISTORY[DROP - 1]} → {HISTORY[DROP]} (−{HISTORY[DROP - 1] - HISTORY[DROP]} pts).</span> robots.txt now disallows GPTBot. Email sent with the diff; fixed the next week.
            </p>
          </div>
          <figcaption class="mt-4 text-[12.5px] leading-relaxed text-ink-mute">
            What runs on its own: site audits and score monitoring on our servers, and AI answer checks on Perplexity through its API. ChatGPT and Google AI answers are pasted in by you and scored the same way; GeoReady does not scrape those interfaces.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* Per chi è: un pannello unico diviso in tre colonne */}
  <section class="bg-white text-ink" aria-labelledby="who-h">
    <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 md:py-28">
      <div data-reveal>
        <p class="eyebrow">03 · Who uses it</p>
        <h2 id="who-h" class="mt-3 max-w-[20ch] text-3xl font-semibold tracking-[-0.03em] md:text-[2.75rem] md:leading-[1.08]">
          One engine, <em>three</em> ways to run it.
        </h2>
      </div>
