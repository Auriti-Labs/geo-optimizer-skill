<style>
  /* Una sola texture: la griglia di punti del pannello, sfumata a destra dietro lo strumento. */
  .hero-v2::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#C9D3D3 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(100deg, transparent 38%, #000 75%);
    opacity: 0.55;
    pointer-events: none;
  }
  .hero-v2 > div { position: relative; }

  .gate-tab {
    display: flex; width: 100%; align-items: center; gap: 12px; padding: 12px 18px;
    border-left: 2px solid transparent; color: var(--color-ink-soft);
    transition: background-color .2s, color .2s, border-color .2s;
  }
  .gate-tab:hover { background: #F8FAFA; color: var(--color-ink); }
  .gate-tab[aria-selected='true'] { background: #F4F6F6; color: var(--color-ink); border-left-color: #0F766E; }
  .gate-tab:focus-visible, .faq summary:focus-visible { outline-offset: -2px; }
  .gate-bar { width: 44px; height: 4px; flex: none; border-radius: 99px; background: #E3E9E9; overflow: hidden; }
  .gate-bar i { display: block; height: 100%; background: #0A1514; border-radius: inherit; }
  .gate-tab[aria-selected='true'] .gate-bar i { background: #0F766E; }
  /* Senza JS i pannelli sono tutti visibili, impilati; lo script nasconde i non attivi. */
  [data-gates].is-tabs [data-gate-panel][hidden] { display: none; }
  [data-gates]:not(.is-tabs) [data-gate-panel] + [data-gate-panel] { border-top: 1px solid var(--color-rail); }

  .faq-plus { position: relative; width: 12px; height: 12px; flex: none; }
  .faq-plus::before, .faq-plus::after { content: ''; position: absolute; inset: 5.25px 0; height: 1.5px; background: var(--color-ink-mute); transition: transform .3s cubic-bezier(.16,1,.3,1); }
  .faq-plus::after { transform: rotate(90deg); }
  .faq[open] .faq-plus::after { transform: rotate(0deg); }
</style>

<script>
  // Tab dei gate: pattern ARIA tabs con frecce su/giù. Il contenuto è già nell'HTML.
  const gates = document.querySelector<HTMLElement>('[data-gates]');
  if (gates) {
    const tabs = Array.from(gates.querySelectorAll<HTMLButtonElement>('[data-gate-tab]'));
    const panels = Array.from(gates.querySelectorAll<HTMLElement>('[data-gate-panel]'));
    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(i === j));
        t.tabIndex = i === j ? 0 : -1;
      });
      panels.forEach((p, j) => { p.hidden = i !== j; });
      if (focus) tabs[i].focus();
    };
    gates.querySelector('[data-gate-list]')?.setAttribute('role', 'tablist');
    gates.querySelector('[data-gate-list]')?.setAttribute('aria-orientation', 'vertical');
    tabs.forEach((t) => t.setAttribute('role', 'tab'));
    panels.forEach((p) => { p.setAttribute('role', 'tabpanel'); p.tabIndex = 0; });
    gates.classList.add('is-tabs');
    select(0);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k !== 'ArrowDown' && k !== 'ArrowUp' && k !== 'Home' && k !== 'End') return;
        e.preventDefault();
        const n = k === 'Home' ? 0 : k === 'End' ? tabs.length - 1 : (i + (k === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
        select(n, true);
      });
    });
  }

  // Il grafico del monitoring si disegna quando entra in vista.
  const history = document.querySelector<SVGElement>('[data-history]');
  if (history && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([{ gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);
      const line = history.querySelector<SVGPathElement>('[data-history-line]')!;
      const len = line.getTotalLength();
      const tl = gsap.timeline({ scrollTrigger: { trigger: history, start: 'top 75%', once: true } });
      tl.fromTo(line, { strokeDasharray: len, strokeDashoffset: len }, { strokeDashoffset: 0, duration: 1.6, ease: 'power2.inOut' })
        .from(history.querySelectorAll('[data-history-dot]'), { scale: 0, transformOrigin: 'center', duration: 0.3, stagger: 0.1, ease: 'back.out(2)' }, 0.1)
        .from(history.querySelector('[data-history-alert]'), { opacity: 0, y: 8, duration: 0.5, ease: 'expo.out' }, '-=0.4');
    });
  }
</script>
