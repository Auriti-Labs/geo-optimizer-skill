---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/home-v3/SiteHeader.astro';
import SiteFooter from '../components/home-v3/SiteFooter.astro';
import CookieConsentManager from '../components/cookie/CookieConsentManager';
import { getPublicStats, STATS_FALLBACK_AS_OF } from '../utils/publicStats';
import '../styles/home-v3.css';

// Home v3: header, footer e sistema tipografico propri (Stack Sans), quindi niente Shell.
// Le altre pagine usano Shell, che monta gli stessi SiteHeader/SiteFooter senza il prop `home`.

// Contatori pubblici letti a build time, così l'HTML statico porta i numeri veri.
// Se /api/stats non risponde si usano i fallback datati di utils/publicStats.ts.
const { stats: PUBLIC_STATS, isLive: STATS_ARE_LIVE } = await getPublicStats();
const fmt = (n: number) => n.toLocaleString('en-US');
const STARS = fmt(PUBLIC_STATS.github_stars);
const STATS_AS_OF_ISO = STATS_ARE_LIVE ? new Date().toISOString().slice(0, 10) : STATS_FALLBACK_AS_OF;
const statsAsOf = new Date(STATS_AS_OF_ISO).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

// Titolo diviso per parola al build: l'ingresso è solo CSS, l'LCP coincide con l'FCP.
// L'indice --i prosegue tra le due righe per lo stagger.
const HERO_LINES = ['Know if AI answers', 'can cite your site.'];
let wordIndex = 0;
const heroWords = HERO_LINES.map((line) => line.split(' ').map((w) => ({ w, i: wordIndex++ })));

// Le FAQ visibili e lo schema FAQPage escono dallo stesso array (check G-SD-VISIBLE).
const faqs = [
  {
    q: 'Does a high score guarantee that AI answers will cite my site?',
    a: 'No. The score measures whether answer engines can reach, read and attribute your pages. Whether a page is cited also depends on the question, the engine and the competing sources. A low score usually means a blocker that no content work can get past.',
  },
  {
    q: 'Is the free audit really free?',
    a: 'Yes. No account, no card, five audits a day, and the full nine-category report. The CLI is MIT licensed and has no limits.',
  },
  {
    q: 'What does GeoReady check?',
    a: 'Nine categories: Google AI readiness, robots.txt, JSON-LD schema, content, brand and entity signals, meta tags, llms.txt, technical signals and AI discovery files. The same engine also flags prompt-injection patterns in page content.',
  },
  {
    q: 'Which parts of monitoring are automated?',
    a: 'Site audits and score monitoring run on our servers, weekly on Pro and daily on Agency. Perplexity answers are checked through its API. ChatGPT and Google answers are pasted by you and scored the same way; GeoReady does not scrape those interfaces.',
  },
  {
    q: 'The CLI has geo track and geo monitor. Why pay for Pro?',
    a: 'If you already run the CLI in CI, you may not need Pro. The CLI runs when you start it and stores history in a local SQLite file. Pro is for teams who would rather not operate the schedule, the storage and the alerts.',
  },
  {
    q: 'Do I still need Semrush or Ahrefs?',
    a: 'Yes, if you track keyword rankings and backlinks. GeoReady measures a different layer: AI crawler access, structured data, passage structure and AI answer checks. Most teams run both.',
  },
  {
    q: 'Can I cancel at any time?',
    a: 'Yes, from your account settings, with no lock-in and no penalty.',
  },
  {
    q: 'Is there a trial for paid plans?',
    a: 'There is no self-serve trial: the free audit is the permanent baseline. A 14-day Agency trial is available on request at info@geoready.dev.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};

// WebPage della homepage, emesso come blocco JSON-LD SEPARATO e non dentro il @graph
// globale di Layout.astro, per due motivi verificati sul motore di audit:
//  1. il check di freschezza (`signals`) legge `dateModified` solo al primo livello di
//     ogni blocco JSON-LD, quindi una data annidata in @graph non verrebbe vista;
//  2. il @graph di Layout è emesso su ogni pagina, e una data di aggiornamento valida
//     per la sola homepage non deve finire su tutte le altre.
//
// `dateModified` è la data "as of" dei contatori pubblici mostrata in pagina (la stessa di
// <time datetime> più sotto): è l'ultimo dato che cambia davvero su questa pagina. Con
// /api/stats raggiungibile coincide con il giorno della build, perché i numeri sono di quel giorno.
// `datePublished` è omesso apposta: la data di lancio reale non è nel repository e non
// va inventata.
//
// `author` riporta il nome oltre all'@id: un riferimento nudo `{"@id": ...}` non ha
// `name`, e il check di byline accetta solo un autore dichiarato con il nome.
// Titolo unico della pagina: lo usano sia <title>/og:title (via Shell) sia il `name` del
// WebPage. Con due stringhe scritte a mano basta una modifica a una sola per farle divergere.
//
// Il brand sta PRIMA del separatore. Il check di coerenza del nome (brand_entity) taglia
// title e og:title al primo separatore e confronta ciò che sta a sinistra con H1 e schema. Con
// il brand in coda, a sinistra restava la descrizione ("AI Visibility Audit & Citation
// Monitoring"), che non coincide con nessun'altra fonte, e il nome risultava incoerente
// anche se GeoReady compariva ovunque.
const PAGE_TITLE = "GeoReady | AI Visibility Audit & Monitoring";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://geoready.dev/#webpage",
  "url": "https://geoready.dev/",
  "name": PAGE_TITLE,
  "inLanguage": "en",
  "isPartOf": { "@id": "https://geoready.dev/#website" },
  "about": { "@id": "https://geoready.dev/#webapp" },
  "publisher": { "@id": "https://geoready.dev/#organization" },
  "author": {
    "@type": "Person",
    "@id": "https://geoready.dev/#founder",
    "name": "Juan Camilo Auriti"
  },
  "dateModified": STATS_AS_OF_ISO
};
// Tacche delle esecuzioni mensili per piano (Free: nessuna programmata).
const ticks = (n: number, on: number) => Array.from({ length: n }, (_, k) => k < on);

// Link di signup con gli stessi UTM delle card piano del resto del sito.
const signup = (plan: string) =>
  `https://app.geoready.dev/signup?plan=${plan}&utm_source=home&utm_medium=plan_card&utm_campaign=home_to_paid&utm_content=${plan}_card`;
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
<Layout
  title={PAGE_TITLE}
  description="Free AI visibility audit: check if ChatGPT, Perplexity, Claude and Gemini can reach, read and cite your site, then monitor the score over time."
  canonical="https://geoready.dev/"
>

  <SiteHeader home />

<main id="main-content">

{/* HERO: headline + rubric dal vivo */}
<section class="hero wrap" aria-labelledby="hero-title">
  <canvas class="hero-gl" id="hero-gl" aria-hidden="true"></canvas>
  <div class="hero-copy">
    <h1 id="hero-title" class="display mask">
      {heroWords.map((words, l) => (
        <span class="line"><span class={l === 1 ? 'grad' : undefined}>{words.map(({ w, i }, k) => <Fragment>{k > 0 && ' '}<span class="ch" style={`--i:${i}`}>{w}</span></Fragment>)}</span></span>
      ))}
    </h1>
    <p class="lead hero-lead">GeoReady is an AI visibility audit that checks whether ChatGPT, Perplexity, Claude and Gemini can reach, read and attribute your pages, scores them on a public 100-point rubric, and ranks the fixes by the points they win.</p>
    <form class="audit" id="audit" action="/report/audit/" method="get" data-audit-form>
      <label class="sr" for="audit-url">Website address</label>
      <input id="audit-url" name="url" type="text" inputmode="url" autocomplete="url" placeholder="your-site.com" required aria-describedby="audit-note">
      <button class="btn btn-go" type="submit">Run free audit</button>
    </form>
    <p class="note" id="audit-note" data-audit-note aria-live="polite">Free, no account, five audits a day. Or run the same engine yourself: <code>pip install geo-optimizer-skill</code></p>
    <p class="hero-proof"><a class="hero-demo" href="/report/demo/" data-cta="home_hero_demo_report">View a sample report<svg class="ic ic-s" aria-hidden="true"><use href="#i-arrow"/></svg></a><a href="https://github.com/Auriti-Labs/geo-optimizer-skill" data-cta="home_hero_github"><svg class="ic ic-s" aria-hidden="true"><use href="#i-star"/></svg><b>{STARS}</b> stars on GitHub</a><button class="motion-btn" type="button" aria-pressed="false"><svg class="ic ic-s" aria-hidden="true"><use href="#i-pause"/></svg>Pause motion</button></p>
  </div>

  <figure class="rubric" data-ui aria-label="Sample audit of example.com: switch on a fix to see the score change">
    <div class="rb-head">
      <div>
        <p class="rb-site">example.com</p>
        <p class="rb-meta">Sample audit · rubric v2</p>
        <p class="rb-band" id="band">Foundation</p>
      </div>
      <div class="rb-score">
        <svg class="score-ring" viewBox="0 0 100 100" aria-hidden="true"><defs><linearGradient id="ring-g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="rg-a"/><stop offset="1" class="rg-b"/></linearGradient></defs><circle class="ring-t" cx="50" cy="50" r="44"/><circle class="ring-v" id="ring" cx="50" cy="50" r="44" pathLength="100"/></svg>
        <p class="rb-val"><output class="rb-num" id="score" aria-live="off">56</output><span class="rb-max">/100</span></p>
        <p class="sr" id="score-sr" aria-live="polite"></p>
      </div>
    </div>
    <ul class="rb-cats" id="cats">
      <li data-cat="google_ai"><span>Google AI readiness</span><b>14</b><i>/20</i><s></s></li>
      <li data-cat="robots"><span>Robots.txt</span><b>3</b><i>/14</i><s></s></li>
      <li data-cat="schema"><span>Schema JSON-LD</span><b>7</b><i>/14</i><s></s></li>
      <li data-cat="content"><span>Content</span><b>11</b><i>/14</i><s></s></li>
      <li data-cat="brand"><span>Brand &amp; entity</span><b>6</b><i>/12</i><s></s></li>
      <li data-cat="meta"><span>Meta tags</span><b>9</b><i>/11</i><s></s></li>
      <li data-cat="llms"><span>llms.txt</span><b>0</b><i>/6</i><s></s></li>
      <li data-cat="signals"><span>Signals</span><b>4</b><i>/6</i><s></s></li>
      <li data-cat="ai_discovery"><span>AI discovery</span><b>2</b><i>/3</i><s></s></li>
    </ul>
    <fieldset class="rb-fixes">
      <legend>Fixes, ranked by points <span class="rb-hint">· flip one, watch the score</span></legend>
      <label class="fix"><input type="checkbox" role="switch" data-cat="robots" data-pts="11"><span class="fx-t">Allow OAI-SearchBot, PerplexityBot and Claude-SearchBot<small>robots.txt · line 4</small></span><b>+11</b><span class="sw" aria-hidden="true"></span></label>
      <label class="fix"><input type="checkbox" role="switch" data-cat="llms" data-pts="5"><span class="fx-t">Publish /llms.txt with sections and links<small>site root · file missing</small></span><b>+5</b><span class="sw" aria-hidden="true"></span></label>
      <label class="fix"><input type="checkbox" role="switch" data-cat="schema" data-pts="3"><span class="fx-t">Add Organization schema<small>&lt;head&gt; · JSON-LD</small></span><b>+3</b><span class="sw" aria-hidden="true"></span></label>
      <label class="fix"><input type="checkbox" role="switch" data-cat="signals" data-pts="2"><span class="fx-t">Show a visible publish date<small>article template · &lt;time&gt;</small></span><b>+2</b><span class="sw" aria-hidden="true"></span></label>
    </fieldset>
  </figure>
</section>

{/* PLATFORM: pannello illuminato, fila scura */}
<section class="platform" id="platform" aria-labelledby="platform-title">
  <div class="wrap pf-top">
    <h2 id="platform-title" class="head">Six views, one engine.</h2>
    <div class="pf-ctrl">
      <p class="pf-count" id="pf-count" aria-hidden="true">1 / 6</p>
      <button class="round" type="button" data-pf="-1" aria-label="Previous view"><svg class="ic flip" aria-hidden="true"><use href="#i-arrow"/></svg></button>
      <button class="round" type="button" data-pf="1" aria-label="Next view"><svg class="ic" aria-hidden="true"><use href="#i-arrow"/></svg></button>
    </div>
  </div>
  <div class="pf-stage">
    <div class="pf-row" id="pf-row" tabindex="0" role="region" aria-label="Product views, scroll sideways">

      <article class="pf-item" aria-label="Crawler access" data-name="Crawler access" data-plan="Free" data-desc="27 AI crawlers checked against your robots.txt, rule by rule. Search bots and training bots are told apart, so blocking training never costs you citations.">
        <div class="panel" data-ui>
          <p class="p-title">Crawler access <span>27 bots</span></p>
          <table class="p-table">
            <caption class="sr">Sample crawler access for example.com</caption>
            <thead><tr><th scope="col">Bot</th><th scope="col">Used for</th><th scope="col">Status</th></tr></thead>
            <tbody data-stagger>
              <tr><td>OAI-SearchBot</td><td>Search</td><td><span class="st bad">Blocked</span></td></tr>
              <tr><td>PerplexityBot</td><td>Search</td><td><span class="st bad">Blocked</span></td></tr>
              <tr><td>Claude-SearchBot</td><td>Search</td><td><span class="st bad">Blocked</span></td></tr>
              <tr><td>GPTBot</td><td>Training</td><td><span class="st">Blocked</span></td></tr>
              <tr><td>Google-Extended</td><td>Training</td><td><span class="st ok">Allowed</span></td></tr>
              <tr><td>CCBot</td><td>Training</td><td><span class="st">Blocked</span></td></tr>
            </tbody>
          </table>
        </div>
      </article>

      <article class="pf-item" aria-label="Ranked fixes" data-name="Ranked fixes" data-plan="Free" data-desc="Every fix names the file, the line and the points it is worth, so the first hour of work goes where the score moves most.">
        <div class="panel" data-ui>
          <p class="p-title">Fixes <span>4 open</span></p>
          <ol class="p-fixes" data-stagger>
            <li><span>robots.txt, line 4<small>Disallow: / blocks the three search bots</small></span><b>+11</b></li>
            <li><span>/llms.txt<small>File missing at the site root</small></span><b>+5</b></li>
            <li><span>&lt;head&gt; JSON-LD<small>No Organization entity</small></span><b>+3</b></li>
            <li><span>Article template<small>Publish date not visible</small></span><b>+2</b></li>
          </ol>
        </div>
      </article>

      <article class="pf-item" aria-label="Citability" data-name="Citability" data-plan="Free" data-desc="47 checks read the rendered page, not the source: whether a passage answers first, carries its numbers and holds its structure when quoted alone.">
        <div class="panel" data-ui>
          <p class="p-title">Citability <span>/guides/espresso-grind</span></p>
          <ul class="p-checks" data-stagger>
            <li class="ok">Answer in the first 60 words</li>
            <li class="ok">Heading hierarchy, H1 to H3</li>
            <li class="bad">Comparison written as prose, not a table</li>
            <li class="ok">Numbers stated in the text</li>
            <li class="bad">4 of 9 images without alt text</li>
          </ul>
        </div>
      </article>

      <article class="pf-item" aria-label="Score alerts" data-name="Score alerts" data-plan="Pro and Agency" data-desc="Monitoring re-runs the audit on a schedule and emails you when the score drops five points or more, with the change that caused it.">
        <div class="panel mail" data-ui>
          <p class="m-from">GeoReady alerts · Tue 27 Oct, 07:02</p>
          <p class="m-subj">example.com dropped from 67 to 56</p>
          <p class="m-body">robots.txt changed since last week. Line 4 now blocks OAI-SearchBot, PerplexityBot and Claude-SearchBot, so ChatGPT, Perplexity and Claude search can no longer cite you.</p>
          <p class="m-diff"><code>- Allow: /</code><code>+ Disallow: /</code></p>
          <span class="m-btn">Open the report</span>
        </div>
      </article>

      <article class="pf-item" aria-label="AI answer checks" data-name="AI answer checks" data-plan="One a week with a free account, more on paid plans" data-desc="Ask Perplexity a real question and see which domains its answer cites. ChatGPT and Google answers are pasted and scored the same way, never scraped.">
        <div class="panel" data-ui>
          <p class="p-title">Perplexity <span>answer check</span></p>
          <p class="q">“Which espresso grinder is quietest for a small kitchen?”</p>
          <ul class="p-cites" data-stagger>
            <li><span>coffeegeek.com</span><b>cited</b></li>
            <li><span>seriouseats.com</span><b>cited</b></li>
            <li><span>reddit.com</span><b>cited</b></li>
            <li class="you"><span>example.com</span><b>not cited</b></li>
          </ul>
        </div>
      </article>

      <article class="pf-item" aria-label="CLI and MCP" data-name="CLI and MCP" data-plan="Free, MIT licensed" data-desc="The engine behind the report is MIT licensed. Run it in CI, from a terminal, or as an MCP server inside your own agent.">
        <div class="panel code" data-ui>
<pre><code><span class="c-p">$</span> pip install geo-optimizer-skill
<span class="c-p">$</span> geo audit --url https://example.com

  GEO score   56/100  foundation
  robots.txt   3/14   citation bots blocked
  llms.txt     0/6    not found
  4 fixes ranked · +21 available</code></pre>
        </div>
      </article>
    </div>
    <ol class="wrap pf-rail" aria-label="Views">
      <li><button type="button" data-rail="0">Crawler access</button></li>
      <li><button type="button" data-rail="1">Ranked fixes</button></li>
      <li><button type="button" data-rail="2">Citability</button></li>
      <li><button type="button" data-rail="3">Score alerts</button></li>
      <li><button type="button" data-rail="4">AI answer checks</button></li>
      <li><button type="button" data-rail="5">CLI and MCP</button></li>
    </ol>
    <div class="wrap pf-caption">
      <p class="pf-name" id="pf-name">Crawler access</p>
      <p class="pf-plan" id="pf-plan">Free</p>
      <p class="pf-desc" id="pf-desc">27 AI crawlers checked against your robots.txt, rule by rule. Search bots and training bots are told apart, so blocking training never costs you citations.</p>
    </div>
    <p class="sr" id="pf-live" aria-live="polite"></p>
  </div>
</section>

{/* HOW: colonna run-in */}
<section class="how wrap" id="how" aria-labelledby="how-title">
  <div class="how-col">
    <h2 id="how-title" class="head">How an audit turns into citations</h2>

    <div class="stage reveal">
      <p><strong>To begin,</strong> paste a URL. GeoReady fetches the page the way AI crawlers do: robots.txt first, then the rendered HTML, the structured data and the discovery files. It takes about a minute and needs no account.</p>
      <div class="ev ev-fetch" data-ui>
        <span>example.com</span><span class="ev-bar"><s></s></span><span>Reading robots.txt · 27 bots</span>
      </div>
    </div>

    <div class="stage reveal">
      <p><strong>Within a minute,</strong> the report scores nine categories on rubric v2. The weights are public and versioned, so a score from June means the same thing as a score from today.</p>
      <div class="ev ev-weights" data-ui>
        <div class="ev-stack" aria-hidden="true" data-stagger><span style="--w:20">20</span><span style="--w:14">14</span><span style="--w:14">14</span><span style="--w:14">14</span><span style="--w:12">12</span><span style="--w:11">11</span><span style="--w:6">6</span><span style="--w:6">6</span><span style="--w:3">3</span></div>
        <p class="ev-key">Google AI 20 · Robots.txt 14 · Schema 14 · Content 14 · Brand 12 · Meta 11 · llms.txt 6 · Signals 6 · AI discovery 3</p>
      </div>
    </div>

    <div class="stage reveal">
      <p><strong>After that,</strong> you work down the fixes in order of points. Each one names the file and the line, and a re-run shows whether it landed.</p>
<pre class="ev ev-diff"><code data-stagger><span class="d-ctx">  User-agent: OAI-SearchBot</span>
<span class="d-ctx">  User-agent: PerplexityBot</span>
<span class="d-ctx">  User-agent: Claude-SearchBot</span>
<span class="d-del">- Disallow: /</span>
<span class="d-add">+ Allow: /</span></code></pre>
    </div>

    <div class="stage reveal">
      <p><strong>From then on,</strong> monitoring re-runs the audit for you, weekly on Pro and daily on Agency, keeps the history and emails you when the score drops five points or more. <a class="stage-link" href="#pricing" data-cta="home_how_plans">See plans</a></p>
      <figure class="ev ev-mon" data-ui id="mon">
        <div class="mc-head"><span class="mc-site">example.com</span><span class="mc-sched"><i aria-hidden="true"></i>Weekly run · Pro</span></div>
        <div class="mc-plot">
          <svg viewBox="0 0 560 330" role="img" aria-labelledby="mon-cap">
            <defs>
              <linearGradient id="mc-stroke" gradientUnits="userSpaceOnUse" x1="40" y1="0" x2="508" y2="0">
                <stop offset="0" class="mc-sa"/><stop offset="0.575" class="mc-sa"/><stop offset="0.6" class="mc-sx"/><stop offset="0.73" class="mc-sx"/><stop offset="0.755" class="mc-sa"/><stop offset="1" class="mc-sb"/>
              </linearGradient>
              <linearGradient id="mc-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="mc-fa"/><stop offset="1" class="mc-fb"/></linearGradient>
              <clipPath id="mc-clip"><rect class="mc-cliprect" x="30" y="0" width="518" height="300"/></clipPath>
            </defs>
            {/* corsie delle bande: asse ritagliato 50-80, etichette vere */}
            <rect class="mc-lane mc-lane-good" x="30" y="20" width="518" height="80"/>
            <rect class="mc-lane mc-lane-found" x="30" y="100" width="518" height="187"/>
            <line class="mc-edge" x1="30" y1="100" x2="548" y2="100"/>
            <line class="mc-edge-hot" x1="414" y1="100" x2="548" y2="100"/>
            <text class="mc-ax" x="24" y="24">80</text><text class="mc-ax" x="24" y="104">68</text><text class="mc-ax" x="24" y="291">40</text>
            <text class="mc-band" x="40" y="35">GOOD · 68–85</text>
            <text class="mc-band" x="40" y="277">FOUNDATION · 36–67</text>
            <line class="mc-base" x1="30" y1="296" x2="548" y2="296"/>
            <g clip-path="url(#mc-clip)"><path class="mc-area" d="M40 140 L92 133.3 L144 120 L196 113.3 L248 106.7 L300 106.7 L352 180 L404 106.7 L456 73.3 L508 53.3 L508 287 L40 287 Z"/></g>
            <path class="mc-glow" d="M40 140 L92 133.3 L144 120 L196 113.3 L248 106.7 L300 106.7 L352 180 L404 106.7 L456 73.3 L508 53.3"/>
            <path class="mc-line" d="M40 140 L92 133.3 L144 120 L196 113.3 L248 106.7 L300 106.7 L352 180 L404 106.7 L456 73.3 L508 53.3"/>
            {/* una corsa per settimana: scan, tacca, anello, punto */}
            <g class="mc-run" data-s="62"><line class="mc-scan" x1="40" y1="296" x2="40" y2="140"/><line class="mc-tick" x1="40" y1="292" x2="40" y2="300"/><circle class="mc-ring" cx="40" cy="140" r="5"/><circle class="mc-dot" cx="40" cy="140" r="4"/></g>
