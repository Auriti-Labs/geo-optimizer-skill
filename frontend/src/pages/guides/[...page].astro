---
import type { GetStaticPaths } from 'astro';
import Shell from '../../components/Shell.astro';
import NewsletterSignup from '../../components/NewsletterSignup';
import { guidePrimaryVisuals } from '../../lib/articleVisuals';
import { getArticlesByCategory, urlForImage } from '../../utils/sanity';

export const getStaticPaths = (async ({ paginate }) => {
  const articles = await getArticlesByCategory('guides');
  // Paginazione disattivata: ~55 guide vivono su un'unica /guides/ (niente
  // doorway paginate 2..10, già 301 → /guides/). pageSize ampio mantiene il
  // template (page.*) funzionante e `page.lastPage > 1` non renderizza il nav.
  // Rivedere quando le guide superano ~400.
  return paginate(articles, { pageSize: 500 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const articles = page.data;
const canonical = `https://geoready.dev/guides/${page.currentPage > 1 ? `${page.currentPage}/` : ''}`;
const title = page.currentPage > 1
  ? `Guides — Page ${page.currentPage} of ${page.lastPage} — GeoReady`
  : 'Guides — AI Search Visibility & GEO';
const guideActionLinks = [
  { href: '/ai-seo-audit/', label: 'AI SEO audit' },
  { href: '/chatgpt-visibility-checker/', label: 'ChatGPT visibility' },
  { href: '/perplexity-citation-checker/', label: 'Perplexity citations' },
  { href: '/research/', label: 'Research foundation' },
] as const;

const guideToolCards = [
  {
    href: '/ai-seo-audit/',
    title: 'Free AI SEO audit',
    copy:
      'Check crawler access, schema, llms.txt, content quality, AI discovery, and entity signals before prioritizing fixes.',
    meta: 'Audit',
    dataCta: 'guides_tools_ai_seo_audit',
  },
  {
    href: '/chatgpt-visibility-checker/',
    title: 'ChatGPT visibility checker',
    copy:
      'Use this path when the question is whether ChatGPT can understand, mention, or cite a website.',
    meta: 'Visibility',
    dataCta: 'guides_tools_chatgpt_visibility',
  },
  {
    href: '/perplexity-citation-checker/',
    title: 'Perplexity citation checker',
    copy:
      'Inspect source-backed answers and see whether Perplexity-style results cite your domain or competitors.',
    meta: 'Citations',
    dataCta: 'guides_tools_perplexity_citations',
  },
  {
    href: '/tools/llms-txt-generator/',
    title: 'Free llms.txt generator',
    copy:
      'Generate a starter llms.txt from a sitemap, then publish the editable Markdown at the domain root.',
    meta: 'Tool',
    dataCta: 'guides_tools_llms_generator',
  },
] as const;

const guideIntentCards = [
  {
    href: '/ai-seo-audit-for-saas/',
    title: 'AI SEO audit for SaaS',
    copy: 'Audit product, pricing, comparison, alternative, and docs pages before buyer-intent prompts send users elsewhere.',
    dataCta: 'guides_intent_saas_audit',
  },
  {
    href: '/chatgpt-visibility-audit/',
    title: 'ChatGPT visibility audit',
    copy: 'Find the access, entity, schema, or content blocker that keeps a page out of ChatGPT-style answers.',
    dataCta: 'guides_intent_chatgpt_audit',
  },
  {
    href: '/perplexity-citation-monitoring/',
    title: 'Perplexity citation monitoring',
    copy: 'Move from one citation snapshot to recurring checks for source losses and competitor replacements.',
    dataCta: 'guides_intent_perplexity_monitoring',
  },
  {
    href: '/llms-txt-generator-wordpress/',
    title: 'llms.txt generator for WordPress',
    copy: 'Generate the file, publish it at the WordPress domain root, then audit AI discovery and crawler access.',
    dataCta: 'guides_intent_wordpress_llms',
  },
] as const;

const guideFaqs = [
  {
    q: 'What topics do these guides cover?',
    a: 'Three areas: foundations (AI SEO, GEO, llms.txt, crawler access), citability (how answer engines choose and weigh sources), and execution (checklists and implementation paths for real sites).',
  },
  {
    q: 'Are these guides free to read?',
    a: 'Yes. Every guide is free with no account required, along with the free AI SEO check and other tools linked throughout.',
  },
  {
    q: 'How do these guides relate to the GEO Optimizer scoring engine?',
    a: "Each guide maps to specific signals in the open-source GEO Optimizer's nine-category score — the free tool measures whether a site actually implements what a given guide recommends.",
  },
  {
    q: 'How often are new guides published?',
    a: 'New guides are published on an ongoing basis, alongside monthly State of GEO benchmark reports that track what changes in AI search visibility.',
  },
] as const;

function getCardImage(article: (typeof articles)[number]) {
  if (article.ogImage?.asset) {
    return {
      src: urlForImage(article.ogImage).width(640).height(360).fit('crop').auto('format').url(),
      alt: article.ogImage.alt || '',
      fit: 'cover',
    };
  }

  const fallback = guidePrimaryVisuals[article.slug.current as keyof typeof guidePrimaryVisuals];
  return fallback
    ? {
        src: fallback.src,
        alt: fallback.alt,
        fit: 'contain',
      }
    : undefined;
}
---

<Shell
  title={title}
  description="Practical, no-hype guides on making your website visible and citable to AI answer engines like ChatGPT, Perplexity, Claude, and Gemini."
  canonical={canonical}
>
  {/* Header */}
  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-20">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h1 class="max-w-3xl font-head text-4xl font-semibold leading-[1.05] tracking-[-0.03em] text-ink md:text-5xl">
          AI visibility guides for people who need the system to make sense.
        </h1>
        <p class="font-text font-medium text-[12.5px] text-ink-mute">
          index: guides · {page.total} published
        </p>
      </div>

      <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft md:text-lg">
        Practical, research-grounded walkthroughs for making your site visible
        and citable to AI answer engines. No guaranteed-ranking promises — just
        the technical and content signals that help models find and quote you.
      </p>

      <div class="mt-10 grid gap-px overflow-hidden rounded-[10px] border border-rail bg-rail sm:grid-cols-3">
        {[
          ['01', 'Foundations', 'AI SEO, GEO, llms.txt, and crawler access.'],
          ['02', 'Citability', 'How answer engines choose sources and references.'],
          ['03', 'Execution', 'Checklists and implementation paths for real sites.'],
        ].map(([num, label, text]) => (
          <div class="bg-white p-5">
            <p class="font-text text-[12.5px] font-semibold text-pass-deep">{num}</p>
            <p class="mt-2 text-sm font-semibold text-ink">{label}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{text}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
        {guideActionLinks.map((link, index) => (
          <>
            <a href={link.href} class="text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep">
              {link.label}
            </a>
            {index < guideActionLinks.length - 1 && <span class="text-ink-mute">/</span>}
          </>
        ))}
      </div>
    </div>
  </section>

  {/* Guide list */}
  <section class="border-t border-rail bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <ul class="grid gap-4 md:grid-cols-2">
        {articles.map((a) => {
          const cardImage = getCardImage(a);
          return (
          <li>
            <a
              href={`/guides/${a.slug.current}/`}
              class="group block h-full overflow-hidden rounded-[10px] border border-rail bg-paper transition-colors hover:border-pass/50"
            >
              {cardImage ? (
                <div class="aspect-[16/9] w-full border-b border-rail bg-white">
                  <img
                    src={cardImage.src}
                    alt={cardImage.alt}
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                    class={`h-full w-full ${cardImage.fit === 'contain' ? 'object-contain p-4 md:p-5' : 'object-cover'}`}
                  />
                </div>
              ) : null}
              <div class="p-5 md:p-6">
                <h2 class="text-base font-semibold leading-snug text-ink transition-colors group-hover:text-pass-deep md:text-lg">
                  {a.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft md:text-base">
                  {a.description}
                </p>
                <p class="mt-4 font-text font-medium text-[12.5px] text-ink-mute">
                  published: {new Date(a.datePublished).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
              </div>
            </a>
          </li>
          );
        })}
      </ul>

      {/* Pagination */}
      {page.lastPage > 1 && (
        <nav class="mt-10 flex items-center justify-between gap-4" aria-label="Guides pagination">
          {page.url.prev ? (
            <a
              href={page.url.prev}
              class="rounded-[10px] border border-rail bg-white px-4 py-2 font-text text-[12.5px] font-semibold text-ink transition-colors hover:bg-pass-wash"
            >
              Newer
            </a>
          ) : <span />}

          <div class="flex items-center gap-1.5 font-mono text-xs text-ink-mute">
            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
              n === page.currentPage ? (
                <span class="flex h-8 w-8 items-center justify-center rounded-[6px] bg-pass-deep font-semibold text-white" aria-current="page">
                  {n}
                </span>
              ) : (
                <a
                  href={n === 1 ? '/guides/' : `/guides/${n}/`}
                  class="flex h-8 w-8 items-center justify-center rounded-[6px] border border-rail transition-colors hover:bg-pass-wash hover:text-ink"
                >
                  {n}
                </a>
              )
            ))}
          </div>

          {page.url.next ? (
            <a
              href={page.url.next}
              class="rounded-[10px] border border-rail bg-white px-4 py-2 font-text text-[12.5px] font-semibold text-ink transition-colors hover:bg-pass-wash"
            >
              Older
            </a>
          ) : <span />}
        </nav>
      )}
    </div>
  </section>

  {/* Tools — strumenti gratuiti collegati alle guide */}
  <section class="border-t border-rail bg-paper">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="grid gap-6 md:grid-cols-[minmax(0,0.55fr)_minmax(0,1fr)] md:items-start">
        <div>
          <h2 class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink">Free tools</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            Use the tools when a guide turns into an implementation task.
          </p>
          <p class="mt-3 font-text font-medium text-[12.5px] text-ink-mute">
            cost: $0 · no account
          </p>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-[10px] border border-rail bg-rail sm:grid-cols-2">
          {guideToolCards.map((tool) => (
            <li class="bg-white">
              <a
                href={tool.href}
                data-cta={tool.dataCta}
                class="block h-full p-5 transition-colors hover:bg-pass-wash/40 md:p-6"
              >
                <h3 class="text-base font-semibold leading-snug text-ink">
                  {tool.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                  {tool.copy}
                </p>
                <p class="mt-3 font-text font-medium text-[12px] text-ink-mute">{tool.meta}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-rail bg-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
      <div class="grid gap-6 md:grid-cols-[minmax(0,0.55fr)_minmax(0,1fr)] md:items-start">
        <div>
          <h2 class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink">Pages for commercial questions</h2>
          <p class="mt-3 text-sm leading-relaxed text-ink-soft">
            Use these when the guide topic maps to a buyer, SaaS, WordPress, or monitoring workflow.
          </p>
        </div>
        <ul class="grid gap-px overflow-hidden rounded-[10px] border border-rail bg-rail sm:grid-cols-2">
          {guideIntentCards.map((item) => (
            <li class="bg-paper">
              <a
                href={item.href}
                data-cta={item.dataCta}
                class="block h-full p-5 transition-colors hover:bg-pass-wash/40 md:p-6"
              >
                <h3 class="text-base font-semibold leading-snug text-ink">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                  {item.copy}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {page.currentPage === 1 && (
    <section class="border-t border-rail bg-paper" aria-labelledby="guides-faq-heading">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 md:py-16">
        <h2 id="guides-faq-heading" class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink">
          Frequently asked questions
        </h2>
        <div class="mt-6 space-y-6">
          {guideFaqs.map((faq) => (
            <div>
              <h3 class="text-base font-semibold text-ink">{faq.q}</h3>
              <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft md:text-base">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-rail bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <NewsletterSignup
        client:visible
        source="newsletter-guides"
        title="New guides + State of GEO data, monthly"
        detail="One substantive email a month: new GEO guides, fresh benchmark findings, and what changed in AI search. No spam."
      />
    </div>
  </section>

  {page.currentPage === 1 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: guideFaqs.map((faq) => ({
        '@type': 'Question',
        name: faq.q,
        acceptedAnswer: { '@type': 'Answer', text: faq.a },
      })),
    })} />
  )}
</Shell>
