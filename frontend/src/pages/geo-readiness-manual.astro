  {/* Shared handler for every .manual-download-form instance on the page */}
  <script>
    /**
     * Read a human-readable message out of an error response body.
     *
     * FastAPI shapes `detail` two different ways: a plain string for an explicit
     * HTTPException, but an array of {loc, msg, ...} objects for a 422 validation
     * failure. Rendering the latter directly put a literal "[object Object]" in
     * front of the user, so the array case is unwrapped to its first `msg` and
     * the pydantic "Value error, " prefix stripped.
     */
    function extractError(data: any): string {
      const fallback = 'Something went wrong. Try again.';
      const detail = data?.detail;
      if (typeof detail === 'string' && detail) return detail;
      if (Array.isArray(detail)) {
        const msg = detail.find((d) => typeof d?.msg === 'string')?.msg;
        if (msg) return String(msg).replace(/^Value error,\s*/, '');
      }
      return typeof data?.message === 'string' && data.message ? data.message : fallback;
    }

    function initManualForms() {
      document.querySelectorAll<HTMLElement>('.manual-download-form').forEach((container) => {
        if (container.dataset.wired === 'true') return;
        container.dataset.wired = 'true';

        const apiBase = container.dataset.apiBase || '/api';
        const form = container.querySelector<HTMLFormElement>('.manual-form');
        const successDiv = container.querySelector<HTMLElement>('.manual-success');
        const errorDiv = container.querySelector<HTMLElement>('.manual-error');
        const errorMsg = container.querySelector<HTMLElement>('.manual-error-msg');
        const successMsg = container.querySelector<HTMLElement>('.manual-success-msg');
        const submitBtn = container.querySelector<HTMLButtonElement>('.manual-submit');
        const emailInput = container.querySelector<HTMLInputElement>('.manual-email');
        const marketingConsentInput = container.querySelector<HTMLInputElement>('.manual-marketing-consent');
        const submitLabel = submitBtn?.innerHTML ?? 'Get the PDF';

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = emailInput?.value?.trim();
          if (!email) return;

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'Sending...';
          }
          errorDiv?.classList.add('hidden');
          successDiv?.classList.add('hidden');

          try {
            const res = await fetch(`${apiBase}/public/download-manual`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, marketing_consent: marketingConsentInput?.checked ?? false }),
            });

            if (res.ok) {
              const data = await res.json();
              successDiv?.classList.remove('hidden');
              if (successMsg && data.message) successMsg.textContent = data.message;
              form?.classList.add('hidden');
            } else {
              const data = await res.json().catch(() => ({}));
              errorDiv?.classList.remove('hidden');
              if (errorMsg) errorMsg.textContent = extractError(data);
            }
          } catch {
            errorDiv?.classList.remove('hidden');
            if (errorMsg) errorMsg.textContent = 'Network error. Please try again.';
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = submitLabel;
            }
          }
        });
      });
    }
    initManualForms();
  </script>

