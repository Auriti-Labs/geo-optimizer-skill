---
import Shell from '../components/Shell.astro';

const chapters = [
  { num: '0', title: 'The Selection Layer: Why AI Search Became a Filter' },
  { num: '1', title: 'Foreword: Why This Guide Exists' },
  { num: '2', title: 'How AI Answer Engines Work' },
  { num: '3', title: 'The AI Crawler Ecosystem' },
  { num: '4', title: 'Access: The Zero Layer' },
  { num: '5', title: 'Orientation: llms.txt and Beyond' },
  { num: '6', title: 'Understanding: Schema Markup Deep Dive' },
  { num: '7', title: 'Quotability: How to Write for Citation' },
  { num: '8', title: 'Entity Authority: Beyond the Page' },
  { num: '9', title: 'AI Citation Measurement' },
  { num: '10', title: 'GEO for Specific Verticals' },
  { num: '11', title: 'Security: Prompt Injection and AI Crawler Defense' },
  { num: '12', title: 'The GEO Tech Stack' },
  { num: '13', title: 'The Future of GEO' },
  { num: '14', title: 'Conclusion' },
];

const appendices = ['A: GEO Audit Checklist', 'B: AI Crawler Reference Card', 'C: JSON-LD Templates', 'D: GEO Glossary', 'E: References and Further Reading'];

const layers = [
  { num: '01', title: 'Access', desc: 'Crawl permissions, status codes, rendering, canonical control' },
  { num: '02', title: 'Orientation', desc: 'llms.txt, sitemap, feeds, priority URLs, discovery hints' },
  { num: '03', title: 'Understanding', desc: 'Schema, entity identity, metadata, page-type clarity' },
  { num: '04', title: 'Quotability', desc: 'Self-contained passages, factual density, source-worthy claims' },
  { num: '05', title: 'Entity Authority', desc: 'Independent mentions, consistent profiles, topical footprint' },
  { num: '06', title: 'Measurement', desc: 'Prompt sets, citations, competitors, logs, iteration backlog' },
];

const stats = [
  ['160', 'pages'],
  ['15', 'chapters'],
  ['5', 'appendices'],
  ['11', 'AI crawlers documented'],
];

const whoFor = [
  { icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', title: 'SEO practitioners', desc: 'Who need to add AI answer engines to their skill set, on top of their existing SEO knowledge.' },
  { icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3', title: 'SaaS and B2B teams', desc: 'Whose buyers ask ChatGPT "what\'s the best tool for X" before visiting any vendor website. If you\'re not in that answer, you\'re not in the consideration set.' },
  { icon: 'M14.7 6.3a1 1 0 0 0 0 1.4l1 1a1 1 0 0 0 1.4 0l3.7-3.7a1 1 0 0 0 0-1.4l-1-1a1 1 0 0 0-1.4 0z', title: 'Developers and tech leads', desc: 'Responsible for the infrastructure that makes content accessible to AI crawlers: robots.txt, rendering, schema, and server responses.' },
  { icon: 'M3 3v18h18', title: 'Marketing leaders', desc: 'Who need to decide where to invest between classic SEO and GEO in 2026, with evidence about what works and what doesn\'t.' },
];

const whatInside = [
  { title: 'The 4-layer GEO model', desc: 'Access, Orientation, Understanding, and Quotability, applied in order. Fix access before schema. Fix schema before content.' },
  { title: '11 AI crawlers documented', desc: 'GPTBot, OAI-SearchBot, PerplexityBot, ClaudeBot, Claude-SearchBot, Googlebot, Google-Extended, Applebot, CCBot, Bytespider, Diffbot. Each has user-agent tokens, robots.txt directives, and GEO implications.' },
  { title: '12 schema types with templates', desc: 'Article, FAQPage, HowTo, Organization, Person, Product, VideoObject, ImageObject, BreadcrumbList, WebSite, DefinedTerm, Dataset. Includes copy-paste JSON-LD templates and @graph examples.' },
  { title: 'Passage extraction mechanics', desc: 'How vector embeddings select passages, why BLUF (Bottom Line Up Front) beats narrative, and 5 anti-patterns that make your content invisible to retrieval.' },
  { title: 'Entity authority strategy', desc: 'Pillar-cluster architecture, sameAs cross-platform identity, entity resolution pipeline, independent mentions, and why 5 connected pages beat 1 perfect page.' },
  { title: 'Citation measurement workflow', desc: 'Manual prompt testing protocol, GA4 attribution, server log analysis, GEO metrics (citation presence, rate, share, accuracy, drift), on a weekly, monthly, and quarterly cadence.' },
  { title: 'Prompt injection defense', desc: '8 attack vectors against AI crawlers, CSP configuration, monitoring scripts, and a response plan for when your citations disappear.' },
  { title: 'Vertical-specific guidance', desc: 'SaaS/B2B, e-commerce, editorial, WordPress, and headless CMS, with platform-specific implementation patterns and pitfalls.' },
];

const faqs = [
  { q: 'Is this a marketing ebook?', a: 'No. It\'s a 160-page technical manual with code examples, JSON-LD templates, server log commands, robots.txt configurations, and audit checklists. It\'s written for practitioners.' },
  { q: 'Does it replace the free guides on geoready.dev?', a: 'No. The guides cover specific topics. The manual is the comprehensive reference that connects them, including material not on the site: the AI engine pipeline, passage extraction mechanics, prompt injection defense, and the GEO maturity model.' },
  { q: 'Is the content based on real data?', a: 'Yes. The manual draws from 1000+ site audits, the GeoReady benchmark dashboard, public State of GEO reports, official crawler documentation, and reasonable inference from how RAG systems work mechanically. Every claim is labeled by evidence level.' },
  { q: 'What format is the PDF?', a: 'A4 format, 160 pages, with a cover page, table of contents, diagrams, code blocks, tables, and appendices.' },
  { q: 'Why do you need my email?', a: 'We use your email to send a signed download link for the full PDF. The link is valid for 24 hours. GEO research updates are optional: check the consent box if you want them, leave it unchecked if you only want this one download email.' },
  { q: 'Can I share it with my team?', a: 'Yes. Once you download the PDF, share it internally. If you want to share it publicly (blog post, social media, newsletter), link back to this page so others can get their own copy.' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<Shell title="GEO Readiness Manual | Free PDF for AI Search" description="Free 160-page GEO manual PDF, built from 1000+ site audits. Practical steps to get cited by ChatGPT, Perplexity and AI Overviews. Free download, no account." canonical="https://geoready.dev/geo-readiness-manual/">

  {/* ============ HERO — paper ground, real cover in a white rail panel ============
      data-hero-bleed resta: ctaTracking.ts lo usa per attribuire il download
      del preview all'hero (manual_hero_preview) e la navbar è una barra paper opaca. */}
  <section data-hero-bleed class="bg-paper font-text text-ink">
    <div class="mx-auto max-w-7xl px-6 pt-16 pb-20 md:pt-24 md:pb-28">
      <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.62fr)]">

        {/* Copy column */}
        <div class="hero-in" style="animation-delay:0ms">
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
            <h1 class="font-head text-4xl font-semibold leading-[1.05] tracking-[-0.03em] text-ink md:text-6xl">
              The free GEO Readiness Manual for getting cited by AI search.
            </h1>
            <p class="font-text text-[12.5px] font-semibold text-ink-mute">
              Free 160-page technical manual
            </p>
          </div>

          <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft md:text-xl">
            ChatGPT, Perplexity, and Google AI Overviews choose 3-7 sources before a user ever sees a link. This manual is the technical reference for being one of them, built from audit data across 1000+ sites.
          </p>

          <div class="mt-9 grid max-w-lg grid-cols-2 gap-x-8 gap-y-5 sm:grid-cols-4">
            {stats.map(([num, label]) => (
              <div class="border-l border-rail pl-3.5">
                <p class="font-head text-2xl font-semibold tracking-[-0.02em] text-ink">{num}</p>
                <p class="mt-0.5 text-xs leading-tight text-ink-mute">{label}</p>
              </div>
            ))}
          </div>

          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-ink-mute">
            <span>By <span class="font-medium text-ink">Juan Camilo Auriti</span></span>
            <span class="h-1 w-1 rounded-full bg-ink-mute"></span>
            <span>Version 1.1, July 2026</span>
            <span class="h-1 w-1 rounded-full bg-ink-mute"></span>
            <span class="text-pass-deep">Free, no account required</span>
          </div>

          {/* Preview — no email gate */}
          <div class="mt-7 max-w-lg rounded-[10px] border border-rail bg-white p-4">
            <p class="text-sm leading-relaxed text-ink-soft">
              <span class="font-semibold text-ink">Not sure yet?</span>
              Read a free 3-chapter preview: Chapter 0 (The Selection Layer), Chapter 4 (Access), and Chapter 7 (Quotability). No email required.
            </p>
            <a href="/geo-readiness-manual-preview.pdf" class="mt-3 inline-flex items-center gap-2 rounded-[10px] border border-rail bg-white px-4 py-2.5 font-text text-[13px] font-semibold text-ink transition-colors hover:bg-pass-wash">
              Download free preview (PDF, 27 pages)
              <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>

          {/* Mobile-only inline form (desktop uses the sticky panel below the cover) */}
          <div class="mt-9 lg:hidden">
            <div id="manual-download-form-mobile" class="manual-download-form" data-api-base={import.meta.env.PUBLIC_API_BASE || '/api'}>
              <form class="manual-form flex flex-col sm:flex-row gap-3" novalidate>
                <label for="manual-email-mobile" class="sr-only">Email address</label>
                <input
                  type="email"
                  id="manual-email-mobile"
                  name="email"
                  required
                  placeholder="you@company.com"
                  class="manual-email flex-1 rounded-[10px] border border-ink/25 bg-white px-4 py-3.5 text-ink placeholder:text-ink-mute transition-shadow focus:border-pass-deep focus:outline-none focus:ring-2 focus:ring-pass/30"
                />
                <button
                  type="submit"
                  class="manual-submit inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[10px] bg-pass-deep px-6 py-3.5 font-text text-[13px] font-semibold text-white transition-colors hover:bg-pass"
                >
                  Get the PDF
                  <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                    <path d="M3 1.5 9.5 6 3 10.5V1.5Z" />
                  </svg>
                </button>
              </form>
              <label class="mt-3 flex cursor-pointer items-start gap-2.5 text-xs leading-relaxed text-ink-mute">
                <input type="checkbox" name="marketing_consent" class="manual-marketing-consent mt-0.5 h-3.5 w-3.5 cursor-pointer rounded-[4px] border-rail accent-pass-deep" />
                <span>Also send me occasional GEO research updates (new benchmarks, guides). Unchecked, you'll only get this one download email.</span>
              </label>
              <div class="manual-success hidden mt-4 rounded-[10px] border border-pass/30 bg-pass-wash p-4 text-sm">
                <p class="font-medium text-ink">Check your inbox.</p>
                <p class="manual-success-msg mt-0.5 text-ink-soft"></p>
              </div>
              <div class="manual-error hidden mt-3 rounded-[10px] border border-fail/30 bg-fail-wash px-4 py-3 text-sm text-fail">
                <span aria-hidden="true" class="mr-2 font-text text-[12.5px] font-semibold">err</span>
                <span class="manual-error-msg"></span>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-ink-mute">
                No spam. By downloading, you agree to our <a href="/privacy/" class="text-pass-deep underline decoration-rail underline-offset-2 hover:decoration-pass-deep">Privacy Policy</a>.
              </p>
            </div>
          </div>
        </div>

        {/* Cover column — the book sits in a white panel with a 1px rail border (No-Lift) */}
        <div class="hero-in flex justify-center lg:justify-end" style="animation-delay:120ms">
          <div class="w-[240px] rounded-[10px] border border-rail bg-white p-4 sm:w-[280px]">
            <img
              src="/assets/manual/cover-500.webp"
              srcset="/assets/manual/cover-500.webp 500w, /assets/manual/cover-1400.webp 1400w"
              sizes="(min-width: 640px) 280px, 240px"
              alt="Cover of The GEO Readiness Manual: a 160-page technical guide to AI search visibility, by Juan Camilo Auriti, GeoReady, 2026 Edition"
              width="1400"
              height="1981"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-auto w-full rounded-[6px]"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ============ DOWNLOAD PANEL — desktop-focused conversion block ============ */}
  <section class="border-y border-rail bg-white font-text text-ink">
    <div class="mx-auto max-w-7xl px-6">
      <div class="hidden items-center justify-between gap-10 py-8 lg:flex">
        <div class="max-w-md">
          <h2 class="font-head text-lg font-semibold tracking-[-0.02em] text-ink">Get the PDF in your inbox</h2>
          <p class="mt-1 text-sm leading-relaxed text-ink-soft">
            Enter your email. We'll send a download link valid for 24 hours. No account, no credit card.
          </p>
        </div>
        <div id="manual-download-form-desktop" class="manual-download-form max-w-lg flex-1" data-api-base={import.meta.env.PUBLIC_API_BASE || '/api'}>
          <form class="manual-form flex gap-3" novalidate>
            <label for="manual-email-desktop" class="sr-only">Email address</label>
            <input
              type="email"
              id="manual-email-desktop"
              name="email"
              required
              placeholder="you@company.com"
              class="manual-email flex-1 rounded-[10px] border border-ink/25 bg-white px-4 py-3 text-ink placeholder:text-ink-mute transition-shadow focus:border-pass-deep focus:outline-none focus:ring-2 focus:ring-pass/30"
            />
            <button
              type="submit"
              class="manual-submit inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-[10px] bg-pass-deep px-6 py-3 font-text text-[13px] font-semibold text-white transition-colors hover:bg-pass"
            >
              Get the PDF
              <svg class="h-3 w-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <path d="M3 1.5 9.5 6 3 10.5V1.5Z" />
              </svg>
            </button>
          </form>
          <label class="mt-2.5 flex cursor-pointer items-start gap-2.5 text-xs leading-relaxed text-ink-mute">
            <input type="checkbox" name="marketing_consent" class="manual-marketing-consent mt-0.5 h-3.5 w-3.5 cursor-pointer rounded-[4px] border-rail accent-pass-deep" />
            <span>Also send me occasional GEO research updates. Unchecked, you'll only get this one download email.</span>
          </label>
          <div class="manual-success hidden mt-3 rounded-[10px] border border-pass/30 bg-pass-wash p-3 text-sm">
            <p class="font-medium text-ink">Check your inbox.</p>
            <p class="manual-success-msg mt-0.5 text-ink-soft"></p>
          </div>
          <div class="manual-error hidden mt-3 rounded-[10px] border border-fail/30 bg-fail-wash px-4 py-3 text-sm text-fail">
            <span aria-hidden="true" class="mr-2 font-text text-[12.5px] font-semibold">err</span>
            <span class="manual-error-msg"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl bg-paper px-4 py-16 font-text text-ink sm:px-6 md:py-20">

    {/* Bottom strip stats — moved from old hero, now a standalone row */}
    <section class="mb-20 grid grid-cols-1 gap-px overflow-hidden rounded-[10px] border border-rail bg-rail md:grid-cols-4">
      {[
        ['Crawler access', '11 AI crawlers documented'],
        ['Schema deep dive', '12 types with JSON-LD templates'],
        ['Entity authority', 'Pillar-cluster architecture'],
        ['Measurement', 'Citation tracking workflow'],
      ].map(([label, text]) => (
        <div class="bg-white p-5">
          <p class="text-sm font-semibold text-ink">{label}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{text}</p>
        </div>
      ))}
    </section>

    {/* The problem */}
    <section class="mb-20 max-w-4xl">
      <h2 class="mb-6 font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">
        AI search selects its sources before the user sees anything.
      </h2>
      <div class="space-y-5 text-lg leading-relaxed text-ink-soft">
        <p>
          Traditional search returns ten links and asks the user to choose. AI answer engines choose first: they synthesize a single answer from 3-7 sources, then show the user the result. If your site isn't one of those sources, it is absent from the answer.
        </p>
        <p>
          The user reads one answer. They may never see the sources that weren't selected.
        </p>
        <p>
          The problem is selection, and its rules differ from the rules of ranking. Keywords, backlinks, and meta descriptions do not work the same way. The infrastructure that got you to page one on Google may be invisible to ChatGPT.
        </p>
      </div>
    </section>

    {/* The four-layer model */}
    <section class="mb-20">
      <h2 class="mb-4 font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">
        The four-layer model
      </h2>
      <p class="mb-8 max-w-3xl text-base leading-relaxed text-ink-soft">
        Everything in the manual reduces to four layers, applied in order, plus entity authority as a multiplier. Fix access before orientation. Fix orientation before schema. Fix schema before quotability. Build entity authority alongside all of them. Measure last.
      </p>

      <ol class="max-w-3xl divide-y divide-rail overflow-hidden rounded-[10px] border border-rail bg-white">
        {layers.map((layer) => (
          <li class="flex items-start gap-4 p-4 md:p-5">
            <span class="pt-0.5 font-mono text-[12px] font-medium tabular-nums text-ink-mute">{layer.num}</span>
            <div class="flex-1">
              <span class="text-base font-semibold text-ink">{layer.title}</span>
              <p class="mt-0.5 text-sm text-ink-soft">{layer.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    {/* Sample pages — proof it's a real document, not a placeholder */}
    <section class="mb-20">
      <h2 class="mb-3 font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">
        Inside the manual
      </h2>
      <p class="mb-8 max-w-2xl text-base leading-relaxed text-ink-soft">
        Two real spreads: server log commands for verifying AI crawler access, and the site-speed factors that shrink your crawl budget.
      </p>
      <div class="grid max-w-3xl gap-6 sm:grid-cols-2">
        <figure class="overflow-hidden rounded-[10px] border border-rail bg-white">
          <img
            src="/assets/manual/page-sample-1.webp"
            alt="Manual page 25: how to verify which AI crawlers access your site, with grep commands for Nginx and Apache access logs"
            width="900"
            height="1273"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
          <figcaption class="border-t border-rail px-4 py-3 font-mono text-[11px] text-ink-mute">Page 25: verifying AI crawler access via server logs</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-[10px] border border-rail bg-white">
          <img
            src="/assets/manual/page-sample-2.webp"
            alt="Manual page 45: site speed and crawl accessibility, covering TTFB targets, page weight limits, and internal linking depth"
            width="900"
            height="1273"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
          <figcaption class="border-t border-rail px-4 py-3 font-mono text-[11px] text-ink-mute">Page 45: TTFB targets and crawl budget</figcaption>
        </figure>
      </div>
    </section>

    {/* What's inside */}
    <section class="mb-20">
      <h2 class="mb-8 font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">
        What's inside
      </h2>
      <div class="grid max-w-6xl grid-cols-1 gap-px overflow-hidden rounded-[10px] border border-rail bg-rail sm:grid-cols-2 lg:grid-cols-3">
        {whatInside.map((item) => (
          <div class="bg-white p-5">
            <h3 class="mb-2 text-base font-semibold text-ink">{item.title}</h3>
            <p class="text-sm leading-relaxed text-ink-soft">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Who this is for */}
    <section class="mb-20">
      <h2 class="mb-8 font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">
        Who this is for
      </h2>
      <div class="grid max-w-4xl grid-cols-1 gap-px overflow-hidden rounded-[10px] border border-rail bg-rail sm:grid-cols-2">
        {whoFor.map((item) => (
          <div class="bg-white p-5">
            <div class="flex items-start gap-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0 text-ink-mute" aria-hidden="true">
                <path d={item.icon} />
              </svg>
              <div>
                <h3 class="mb-1 text-base font-semibold text-ink">{item.title}</h3>
                <p class="text-sm leading-relaxed text-ink-soft">{item.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    {/* Table of contents */}
    <section class="mb-20">
      <h2 class="mb-8 font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">
        Table of contents
      </h2>

      <div class="grid max-w-4xl grid-cols-1 gap-x-12 gap-y-2 md:grid-cols-2">
        {chapters.map((ch) => (
          <div class="flex items-baseline gap-3 border-b border-rail py-2">
            <span class="w-8 flex-shrink-0 font-mono text-xs tabular-nums text-ink-mute">Ch.{ch.num}</span>
            <span class="text-sm leading-snug text-ink-soft">{ch.title}</span>
          </div>
        ))}
      </div>

      <div class="mt-6 max-w-4xl">
        <p class="mb-3 font-text text-[12.5px] font-semibold text-ink-mute">Appendices</p>
        <div class="grid grid-cols-1 gap-x-12 gap-y-2 md:grid-cols-2">
          {appendices.map((ap) => (
            <div class="flex items-baseline gap-3 border-b border-rail py-2">
              <span class="w-8 flex-shrink-0 font-mono text-xs text-ink-mute">App.{ap.charAt(0)}</span>
              <span class="text-sm leading-snug text-ink-soft">{ap}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section class="mb-20 max-w-3xl">
      <h2 class="mb-8 font-head text-2xl font-semibold tracking-[-0.02em] text-ink md:text-3xl">
        FAQ
      </h2>
      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="border-b border-rail pb-5">
            <h3 class="mb-2 text-base font-semibold text-ink">{faq.q}</h3>
            <p class="text-sm leading-relaxed text-ink-soft">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>

    {/* Final CTA — repeats the download form so bottom-of-page readers convert without scrolling back */}
    <section class="border-t border-rail pt-10">
      <div class="mx-auto max-w-2xl rounded-[10px] border border-rail bg-white p-6 text-center md:p-10">
        <h2 class="mb-3 font-head text-2xl font-semibold tracking-[-0.02em] text-ink">
          Get the manual, free.
        </h2>
        <p class="mx-auto mb-6 max-w-xl text-base leading-relaxed text-ink-soft">
          160 pages, delivered to your inbox in under a minute. Then run a free audit to see exactly where your own site stands.
        </p>
        <div id="manual-download-form-footer" class="manual-download-form mx-auto max-w-md text-left" data-api-base={import.meta.env.PUBLIC_API_BASE || '/api'}>
          <form class="manual-form flex flex-col sm:flex-row gap-3" novalidate>
            <label for="manual-email-footer" class="sr-only">Email address</label>
