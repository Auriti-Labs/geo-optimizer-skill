---
import Shell from '../components/Shell.astro';
import CompareContainer from '../components/compare/CompareContainer';
import CompareSurface from '../components/product/CompareSurface.astro';

// Le 9 categorie di segnale del rubric v2 (default dal motore 4.19.0) e i rispettivi pesi (totale 100).
// Allineati a CATEGORY_MAX_V2 in src/geo_optimizer/models/config.py.
const SIGNAL_CATEGORIES = [
  ['Google AI readiness', 20, 'The technical conditions Google documents for its search and AI features: an indexable page, snippet controls, a single canonical, consistent dates, a byline, crawlable links, a viewport tag, and a declared sitemap.'],
  ['robots.txt', 14, 'Whether AI crawlers can reach the site and whether the file invites citation-oriented bots rather than blocking them by default.'],
  ['Schema JSON-LD', 14, 'Valid structured data — Organization, WebSite, Article, FAQ — that lets engines disambiguate entities and pull facts confidently.'],
  ['Content', 14, 'Heading hierarchy, front-loaded answers, lists, image alt text, and the numbers and links that make passages quotable.'],
  ['Brand & entity', 12, 'Naming coherence, knowledge-graph readiness, and about/contact clarity that tie pages to a recognizable entity.'],
  ['Meta tags', 11, 'Title, description, and Open Graph tags that keep the page identifiable.'],
  ['llms.txt', 6, 'Presence and quality of a root-level llms.txt: title, summary, sectioned links, and link depth that orient AI agents to the right pages. Google states that its AI features do not use this file.'],
  ['Signals', 6, 'Declared language, RSS, and freshness indicators that help engines judge currency.'],
  ['AI discovery', 3, 'Machine-readable endpoints such as /.well-known/ai.txt and JSON summaries that expose the site to AI tooling.'],
] as const;

// Le bande di punteggio, identiche a SCORE_BANDS in config.py.
const SCORE_BANDS = [
  ['86–100', 'Excellent', 'Most signals in place; the site is structurally ready to be cited.'],
  ['68–85', 'Good', 'Solid foundation with a few high-value gaps left to close.'],
  ['36–67', 'Foundation', 'Core pieces exist but several categories need work.'],
  ['0–35', 'Critical', 'Crawlability or structure blocks visibility before content matters.'],
] as const;

// FAQ visibili — riusate sia nel markup crawlable che nello schema FAQPage.
// Tenere allineate: ogni modifica al testo va replicata in entrambi i punti.
const faqs = [
  {
    question: 'What does a head-to-head GEO comparison actually measure?',
    answer:
      'It scores two sites across the same nine signal categories used in the standard GEO audit — Google AI readiness, robots.txt, schema, content, brand and entity signals, meta tags, llms.txt, freshness signals, and AI discovery — and shows the gap category by category. The output is a relative readiness picture, not a prediction that a specific model will cite either site.',
  },
  {
    question: 'Is the comparison free, and do I need an account?',
    answer:
      'The two-site comparison is free and runs without an account. It returns a side-by-side GEO score for each URL across all nine categories. Saving reports and tracking changes over time are account features, but the comparison itself is not gated.',
  },
  {
    question: 'When should I compare two sites instead of analyzing several competitors?',
    answer:
      'Use a two-site comparison when you have one clear benchmark — your domain against a single competitor, or a before-and-after on a redesign. When you need to see a market pattern across a set of domains, multi-competitor analysis is the better tool because it surfaces shared blockers and ranks several sites at once.',
  },
  {
    question: 'Does a higher GEO score guarantee more AI citations?',
    answer:
      'No. The score measures structural readiness — whether crawlers can reach the site, whether content is quotable, and whether entities are clear. Citation behavior in AI engines is probabilistic and changes as models are retrained. A stronger score removes friction; it does not force a citation.',
  },
  {
    question: 'Which AI engines does the comparison reflect?',
    answer:
      'The signals are engine-agnostic. They reflect the technical and content conditions that AI answer engines such as ChatGPT, Perplexity, and Claude rely on when they retrieve and cite sources — crawler access, structured data, quotable content, and entity clarity — rather than any single vendor’s ranking system.',
  },
  {
    question: 'How should I read a large gap between two sites?',
    answer:
      'Read it by category, not by the headline number. A 20-point gap concentrated in Google AI readiness or robots.txt is mostly a technical fix; the same gap spread across content and brand signals reflects slower editorial work. Start with the category where the difference is largest and the effort is lowest.',
  },
];
---

<Shell
  title="Compare AI Visibility: Two Websites Side by Side"
  description="Free head-to-head GEO audit. Enter two URLs and compare AI visibility, citability and technical signals for ChatGPT, Perplexity and Claude."
  canonical="https://geoready.dev/compare/"
>
  <div class="mx-auto max-w-7xl bg-paper px-5 pt-12 pb-16 text-ink sm:px-6 md:pt-16 md:pb-20">
    {/* Static hero — visible to crawlers */}
    <header class="mb-8 md:mb-10">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.86fr)_minmax(420px,0.82fr)] lg:items-center">
        <div>
          <div class="eyebrow">GeoReady · Compare</div>
          <h1 class="mt-4 max-w-[18ch] text-[2.3rem] leading-[1.05] tracking-[-0.03em] text-ink sm:text-[3rem] xl:text-[3.4rem]">
            Two websites, side by side: where AI engines make the choice.
          </h1>

          <p class="mt-6 max-w-[56ch] text-[17px] leading-relaxed text-ink-soft">
            Enter two URLs below and run a free head-to-head GEO audit. See which site is more
            visible to AI answer engines like ChatGPT, Perplexity, and Claude — scored across the
            same nine signal categories, side by side.
          </p>

          <div class="mt-8 grid gap-3 sm:grid-cols-3">
            {[
              ['Site A', 'Baseline score and blockers.'],
              ['Site B', 'Competing signal profile.'],
              ['Gap', 'Where one domain wins trust.'],
            ].map(([label, text]) => (
              <div class="border-t border-rail pt-3">
                <div class="eyebrow">{label}</div>
                <p class="mt-1 text-sm leading-relaxed text-ink-soft">{text}</p>
              </div>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2">
            <a href="#compare-form" data-cta="compare_hero_form" class="inline-flex min-h-11 items-center gap-2 rounded-[9px] bg-pass-deep px-6 py-3 text-[14px] font-semibold text-on-accent transition-colors hover:bg-pass">
              Compare two sites
            </a>
            <span class="eyebrow">POST /api/public/audits × 2</span>
          </div>
        </div>

        <div class="flex items-center">
          <CompareSurface mode="head" variant="dark" class="w-full" />
        </div>
      </div>
    </header>

    {/* Static info section — visible to crawlers */}
    <section class="panel mb-10 grid gap-4 p-5 md:grid-cols-[minmax(0,0.46fr)_repeat(3,minmax(0,1fr))] md:p-6">
      <div>
        <h2 class="font-head text-lg tracking-[-0.01em] text-ink">
          How comparison works
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          Each site is benchmarked against the same categories used in the standard GEO audit.
        </p>
      </div>
      {[
        ['Score', 'GEO Score across nine signal categories.'],
        ['Citability', 'Citation-oriented content and source signals.'],
        ['Readiness', 'Technical access, structure, and AI discovery.'],
      ].map(([label, text]) => (
        <div class="border-l border-rail pl-4">
          <div class="eyebrow">{label}</div>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{text}</p>
        </div>
      ))}
      <p class="text-sm text-ink-soft md:col-span-3 md:col-start-2">
        Need to evaluate more than two domains? <a href="/analyze-competitors/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">Use competitor analysis</a>.
      </p>
    </section>

    {/* Interactive tool — hydrated by React */}
    <div id="compare-form" class="scroll-mt-24">
      <CompareContainer client:only="react" />
    </div>

    {/* Static, crawler-visible content — answer-first */}
    <div class="mx-auto mt-16 max-w-7xl space-y-16 md:mt-20 md:space-y-20 [&>section>p]:max-w-[70ch] [&_h2]:text-[1.75rem] [&_h2]:font-semibold [&_h2]:text-ink [&_h2]:leading-[1.12] [&_h2]:tracking-[-0.03em] md:[&_h2]:text-[2.1rem] [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-ink [&_p]:text-ink-soft [&_p]:leading-relaxed [&_li]:text-ink-soft [&_li]:leading-relaxed">

      {/* When to run a comparison */}
      <section data-reveal>
        <h2>When to run a head-to-head GEO comparison</h2>
        <p class="mt-4">
          Run a two-site comparison when you have one clear benchmark in mind. The
          most common cases are your own domain against a single competitor, a
          before-and-after on a site you have just changed, or two candidate pages
          competing for the same query. The point is isolation: with exactly two
          sites, every difference in the score is attributable to one of them, not
          averaged across a crowd.
        </p>
        <p class="mt-4">
          It is the wrong tool when you want a market picture. If you are trying to
          understand how a whole category treats AI visibility, or to rank several
          domains at once, a single pair will mislead you. For that, use
          {' '}
          <a href="/analyze-competitors/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">multi-competitor analysis</a>.
          And if the comparison shows you're being cited less than a rival, see the
          {' '}
          <a href="/citation-gap-analysis/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">citation gap workflow</a>
          to find who AI cites instead. If you only need a baseline for one site, you do not need a comparison
          at all — <a href="/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">run a single audit</a> first,
          then compare once you have something to measure against.
        </p>
      </section>

      {/* What the 9 categories measure */}
      <section data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
          <h2>What the 9 signal categories measure</h2>
          <p class="font-text font-medium text-[12.5px] text-ink-mute">models/config.py · CATEGORY_MAX_V2 · Σ = 100 pts</p>
        </div>
        <p class="mt-4">
          Both sites are scored on the same nine categories used in the standard
          GEO audit (rubric v2, the default since engine 4.19.0), weighted to a total
          of 100 points. The weights reflect how much each category influences whether
          an AI answer engine can reach, understand, and quote a page. Google AI
          readiness carries the most weight, followed by robots.txt, schema, and
          content. Access comes first in practice: if a bot cannot fetch an indexable
          page, the quality of the content never gets a chance to matter. The
          <a href="/methodology/">methodology page</a> and the
          <a href="/docs/scoring-rubric/">scoring rubric</a> list every check.
        </p>
        <div class="panel mt-8 overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-rail">
                <th scope="col" class="eyebrow px-5 py-3.5 font-medium">Category</th>
                <th scope="col" class="eyebrow px-5 py-3.5 font-medium">Weight</th>
                <th scope="col" class="eyebrow px-5 py-3.5 font-medium">What it checks</th>
              </tr>
            </thead>
            <tbody>
              {SIGNAL_CATEGORIES.map(([name, weight, detail]) => (
                <tr class="border-b border-rail/60 align-top last:border-0">
                  <th scope="row" class="whitespace-nowrap px-4 py-3 font-semibold text-ink">{name}</th>
                  <td class="px-4 py-3 font-mono tabular-nums text-pass-deep">{weight}</td>
                  <td class="px-4 py-3 leading-relaxed text-ink-soft">{detail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4">
          The same weights apply to both sites, so the comparison is apples to apples.
          A site can score well on content yet lose the overall gap on a single
          blocked crawler — which is exactly the kind of imbalance a side-by-side view
          makes visible.
        </p>
      </section>

      {/* How to read the gap */}
      <section data-reveal>
        <h2>How to read the gap between two sites</h2>
        <p class="mt-4">
          Read the gap by category, not by the headline number. Two sites can sit ten
          points apart for very different reasons, and the reason determines the work.
          A gap concentrated in robots.txt or llms.txt is usually a technical fix you
          can ship in an afternoon. The same gap spread across content and brand
          signals reflects editorial and authority work that takes weeks.
        </p>
        <p class="mt-4">
          Map each category difference to the band it falls into:
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          {SCORE_BANDS.map(([range, label, meaning]) => (
            <div class="panel p-5">
              <div class="flex items-baseline gap-3">
                <span class="font-mono text-sm tabular-nums text-pass-deep">{range}</span>
                <span class="text-base font-semibold text-ink">{label}</span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft">{meaning}</p>
            </div>
          ))}
        </div>
        <div class="eyebrow mt-3">source: models/config.py · SCORE_BANDS</div>
        <p class="mt-4">
          Then prioritize where the difference is largest and the effort is lowest.
          A losing site in the foundation band with a strong competitor in good
          territory should fix crawlability and structure before touching copy. If
          you want the full reasoning behind why these categories matter for AI
          engines specifically, the <a href="/guides/geo-vs-seo/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">GEO vs SEO guide</a>
          {' '}explains what changes when the interface is an answer rather than a list of links.
        </p>
      </section>

      {/* Comparison vs multi-competitor analysis */}
      <section data-reveal>
        <h2>Comparison vs multi-competitor analysis</h2>
        <p class="mt-4">
          A two-site comparison and a multi-competitor analysis answer different
          questions. The comparison is built for depth on a single pair: it puts two
          domains side by side so the gap in each category is explicit and easy to
          act on. It is the right tool for a duel — you versus one rival, or one
          version of a page versus another.
        </p>
        <p class="mt-4">
          Multi-competitor analysis is built for breadth. It runs a batch audit across
          several domains and surfaces the pattern — shared blockers, the signals the
          leaders have in common, and where a whole set of sites is weak. Use it when
          you are setting strategy for a category rather than closing a gap with one
          competitor. When a pattern points you back to a single contender, return here
          and run the head-to-head. See
          {' '}
          <a href="/analyze-competitors/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">competitor AI visibility analysis</a>
          {' '}for the multi-site view.
        </p>
      </section>

      {/* FAQ */}
      <section data-reveal>
        <h2>Comparison FAQ</h2>
        <div class="panel mt-8 overflow-hidden">
          <div class="grid gap-px bg-rail md:grid-cols-2">
            {faqs.map((faq) => (
              <div class="bg-raised p-6">
                <h3>{faq.question}</h3>
                <p class="mt-2 text-sm">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>

  {/* Chiusura: la stessa banda scura della home */}
  <section class="band-dark" aria-labelledby="compare-next-h">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 sm:px-6 md:py-20 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <div class="eyebrow">Next step</div>
        <h2 id="compare-next-h" class="mt-3 text-3xl tracking-[-0.03em] md:text-[2.75rem] md:leading-[1.08]">Close the gap, then keep it closed.</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          Fix the category with the largest gap first. Monitoring re-runs the same audit on a schedule, so you see when your site moves.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="#compare-form" data-cta="compare_final_form" class="inline-flex min-h-11 items-center justify-center rounded-[9px] bg-accent px-6 py-3 text-[14px] font-semibold text-on-accent transition-colors hover:bg-pass">Compare two sites</a>
        <a href="/pricing/" data-cta="compare_final_pricing" class="inline-flex min-h-11 items-center justify-center rounded-[9px] px-6 py-3 text-[14px] font-semibold text-ink shadow-[inset_0_0_0_1px_#2A3838] transition-shadow hover:shadow-[inset_0_0_0_1px_#2DD4BF]">See monitoring plans</a>
      </div>
    </div>
  </section>

  {/* Page-specific schema */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Compare AI Search Visibility — Two Sites Side by Side",
    "description": "Run a free head-to-head GEO audit. Enter two URLs and compare AI search visibility, citability, and technical signals for ChatGPT, Perplexity, and Claude.",
    "url": "https://geoready.dev/compare/",
    "author": {
      "@id": "https://geoready.dev/#organization"
    },
    "publisher": {
      "@id": "https://geoready.dev/#organization"
    },
    "datePublished": "2026-05-12",
    "dateModified": "2026-10-14",
    "mainEntity": {
      "@type": "WebApplication",
      "@id": "https://geoready.dev/compare/#tool",
      "isPartOf": {
        "@id": "https://geoready.dev/#webapp"
      },
      "name": "GeoReady Comparison Tool",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Side-by-side GEO score comparison",
        "Citability benchmarking",
        "Technical signal analysis",
        "AI visibility scoring"
      ]
    }
  })} />

  {/* FAQPage — stesse FAQ visibili nel markup */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />

</Shell>
