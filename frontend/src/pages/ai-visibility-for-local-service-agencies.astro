---
import IntentLanding from '../components/IntentLanding.astro';
import AuditForm from '../components/AuditForm';

// Claims on this page were checked against the engine (src/geo_optimizer/core/audit_brand.py for
// the local-business signal, scoring and the nine categories) and the live pricing page. Plan limits
// are deliberately not quoted here: they change, and /pricing/ is the source.
const title = 'AI Visibility for Local Service Agencies | GeoReady';
const description =
  "Check whether AI answer engines can read your local clients' sites. The audit is free, needs no account, and reports a score with fixes per site.";
const canonical = 'https://geoready.dev/ai-visibility-for-local-service-agencies/';
const dateModified = '2026-10-20';

const stats = [
  {
    value: '9',
    label: 'Report categories',
    detail: 'Crawler access, structured data, content, brand and entity signals, meta tags and more. The full report is free.',
  },
  {
    value: '27',
    label: 'AI crawlers named',
    detail: 'The robots.txt check reports which of 27 named AI crawlers a site allows or blocks.',
  },
  {
    value: '$0',
    label: 'Free audit',
    detail: '5 audits per day, no account, no card. Paid plans add monitoring on a schedule.',
  },
];

const tableRows = [
  {
    signal: 'AI crawler access',
    freeCheck:
      'Reads robots.txt and reports which of 27 named AI crawlers are allowed or blocked, so you can check that every block is one the client chose.',
    paidLoop: 'On a paid plan the audit re-runs on a schedule and alerts you when the score drops by 5 points or more.',
  },
  {
    signal: 'Local business identity',
    freeCheck:
      'Checks the structured data (JSON-LD) for a LocalBusiness type, an areaServed, or an Organization with an address, and for sameAs links to profiles such as LinkedIn or Wikidata.',
    paidLoop: 'Scheduled re-audits show if a theme or plugin update removes that data.',
  },
  {
    signal: 'Contact and About signals',
    freeCheck: 'Checks for contact information and a link to an About page that tie the brand to a real business.',
    paidLoop: 'The same check runs on every scheduled audit.',
  },
  {
    signal: 'Answers a customer would ask',
    freeCheck:
      'Checks heading hierarchy, answer-first openings, lists and tables, and whether FAQ structured data is present on the page.',
    paidLoop: 'Score history shows whether rewritten service pages moved the content score.',
  },
  {
    signal: 'Dates',
    freeCheck: 'Checks for a valid publication or update date on the page.',
    paidLoop: 'Re-audits catch a date that disappears after a redesign.',
  },
  {
    signal: 'llms.txt',
    freeCheck:
      'Checks whether an llms.txt file exists and how it is structured. It is an emerging convention and optional: Google documents that no AI text files are needed for its own AI features.',
    paidLoop: 'The file is re-checked on every scheduled audit.',
  },
] as const;

const faqs = [
  {
    q: 'What does AI visibility mean for a local service business?',
    a: 'When a customer asks an answer engine something like "best roofing contractor in Denver" (an example query of ours, not one we saw an engine run), the engine may name businesses and cite pages. Whether a site can be read, understood and quoted is partly structural: can crawlers reach it, does the structured data say who and where the business is, does the page answer a question directly. GeoReady checks that structural part.',
  },
  {
    q: 'Can GeoReady get a client named by ChatGPT or Perplexity?',
    a: 'No, and no tool can promise it. Whether an answer engine names a business depends on the engine. GeoReady checks what you control on the site, and the score measures structural readiness, not whether a client is cited today. A site can score 90 and never be quoted.',
  },
  {
    q: 'What does the audit not look at?',
    a: 'It reads the pages as served. It does not read a Google Business Profile, directory listings or reviews, and it does not measure local search rankings. Those need other tools, and the audit complements them rather than replacing them.',
  },
  {
    q: 'Can I see how an answer engine responds about a client?',
    a: 'A free account includes one automated answer check a week, collected from Perplexity. Answers from other engines can be recorded by pasting them in by hand. An answer is a snapshot from one moment, not a stable ranking.',
  },
  {
    q: 'How would I use the free audit with a client?',
    a: 'Audit the client home page and the page for their main service, share the report, fix the items that matter most, then audit again to see the score move. The plans page lists what the paid plans add for monitoring more domains over time.',
  },
] as const;
---

<IntentLanding
  title={title}
  description={description}
  canonical={canonical}
  eyebrow="AI visibility for local service agencies"
  badge="For agencies that run sites for local service businesses"
  h1="Check whether AI engines can read your local clients' sites."
  lede="Roofers, plumbers, electricians, dentists and law firms are found through their web pages, and answer engines read those pages too. GeoReady audits whether a client site can be crawled, whether its structured data identifies the business, and whether a page answers a customer's question directly. The audit is free and needs no account. It measures structural readiness, not whether an engine names your client."
  dateModified={dateModified}
  primaryCta={{ href: '#audit-form', label: 'Audit a client site', dataCta: 'local_agencies_hero_form' }}
  secondaryCta={{ href: '/pricing/', label: 'See plans', dataCta: 'local_agencies_hero_pricing' }}
  stats={stats}
  tableHeading="What to check on a local service site"
  tableIntro="Start with what the audit can verify on the page. Each row is a check in the free report; the paid plans re-run the same checks on a schedule."
  tableRows={tableRows}
  faqs={faqs}
>
  <div slot="heroAside" class="w-full space-y-5">
    <section id="audit-form" class="overflow-hidden rounded-[10px] border border-rail bg-white" aria-label="Audit a local service site">
      <div class="flex items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
        <span class="font-text text-[12.5px] font-semibold text-ink-mute">Free audit</span>
        <span class="font-text font-medium text-[12.5px] text-ink-mute">POST /api/audit</span>
      </div>
      <div class="p-4">
        <AuditForm client:load variant="console" />
        <p class="mt-3 text-xs leading-relaxed text-ink-mute">Start with the client home page, then the page for their main service.</p>
      </div>
    </section>
  </div>

  <section>
    <h2>Why a local service site needs its own checklist</h2>
    <p class="mt-4">
      A local service site is usually small and built from a theme and a handful of plugins. A page can look right in a browser and still be hard for an
      answer engine to use: a security plugin may block a crawler, the business may not be marked up as a business with an address, or the service page may bury the
      answer a customer asks for under a long introduction.
    </p>
    <p class="mt-4">
      Our reading, not a vendor's: for this kind of site the fixes worth doing first are usually the unglamorous ones. Make sure the crawlers you
      want are allowed, say who the business is and where it works in structured data, and put the direct answer at the top of each service page. None of these
      guarantees a citation.
    </p>
  </section>

  <section>
    <h2>What to fix first</h2>
    <p class="mt-4">
      Fix access first: robots.txt, status codes and redirects. Fix identity second: the LocalBusiness or Organization data, the address and the sameAs links.
      Then rewrite the service pages so each block answers one question a customer would ask, with the price range, the area served and how to book stated in text,
      not only in images.
    </p>
    <p class="mt-4">
      After the foundation is fixed, audit again. The score and the category breakdown show what moved, and the
      <a href="/pricing/" class="text-pass-deep underline underline-offset-4 decoration-rail hover:decoration-pass-deep">plans page</a>
      lists how the paid plans re-run the audit on a schedule.
    </p>
  </section>
</IntentLanding>
