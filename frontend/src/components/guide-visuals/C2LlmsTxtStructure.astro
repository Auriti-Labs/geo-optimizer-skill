---
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 240" width="100%" height="auto" role="img" aria-labelledby="c2-struct-title">
  <title id="c2-struct-title">Recommended llms.txt structure with annotated sections</title>

  <!-- Background -->
  <rect width="680" height="240" fill="#F4F6F6"/>

  <!-- Title -->
  <text x="24" y="28" font-family="Geist, system-ui, sans-serif" font-size="14" font-weight="600" fill="#0A1514">Recommended llms.txt structure</text>

  <!-- Code block background -->
  <rect x="24" y="44" width="400" height="180" rx="3" fill="#172020"/>

  <!-- Line highlight rows (alternating subtle) -->
  <rect x="24" y="56" width="400" height="20" fill="#172020"/>
  <rect x="24" y="96" width="400" height="20" fill="#172020"/>
  <rect x="24" y="136" width="400" height="20" fill="#172020"/>
  <rect x="24" y="176" width="400" height="20" fill="#172020"/>

  <!-- Line numbers column -->
  <rect x="24" y="44" width="32" height="180" rx="3" fill="#161B15"/>
  <rect x="44" y="44" width="12" height="180" fill="#161B15"/>

  <!-- Line numbers -->
  <text x="36" y="70" font-family="Geist Mono, ui-monospace, monospace" font-size="11" fill="#48575A" text-anchor="middle">1</text>
  <text x="36" y="90" font-family="Geist Mono, ui-monospace, monospace" font-size="11" fill="#48575A" text-anchor="middle">2</text>
  <text x="36" y="110" font-family="Geist Mono, ui-monospace, monospace" font-size="11" fill="#48575A" text-anchor="middle">3</text>
  <text x="36" y="130" font-family="Geist Mono, ui-monospace, monospace" font-size="11" fill="#48575A" text-anchor="middle">4</text>
  <text x="36" y="150" font-family="Geist Mono, ui-monospace, monospace" font-size="11" fill="#48575A" text-anchor="middle">5</text>
  <text x="36" y="170" font-family="Geist Mono, ui-monospace, monospace" font-size="11" fill="#48575A" text-anchor="middle">6</text>
  <text x="36" y="190" font-family="Geist Mono, ui-monospace, monospace" font-size="11" fill="#48575A" text-anchor="middle">7</text>
  <text x="36" y="210" font-family="Geist Mono, ui-monospace, monospace" font-size="11" fill="#48575A" text-anchor="middle">8</text>

  <!-- Code content -->
  <!-- Row 1: # Site Name -->
  <text x="68" y="70" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#6B746D"># </text>
  <text x="83" y="70" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#EEF2F2">Site Name</text>

  <!-- Row 2: > description -->
  <text x="68" y="90" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#5F6C6E">&gt; </text>
  <text x="83" y="90" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#C9D4D2">Site description and purpose</text>

  <!-- Row 3: blank -->
  <text x="68" y="110" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#48575A"> </text>

  <!-- Row 4: ## Core Pages -->
  <text x="68" y="130" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#6B746D">## </text>
  <text x="92" y="130" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#EEF2F2">Core Pages</text>

  <!-- Row 5: - [Home](/) -->
  <text x="68" y="150" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#5F6C6E">- </text>
  <text x="82" y="150" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#CBD5D5">[Home](/)</text>
  <text x="136" y="150" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#5F6C6E">: Homepage overview</text>

  <!-- Row 6: - [About](/about/) -->
  <text x="68" y="170" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#5F6C6E">- </text>
  <text x="82" y="170" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#CBD5D5">[About](/about/)</text>
  <text x="170" y="170" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#5F6C6E">: About us</text>

  <!-- Row 7: ## Guides -->
  <text x="68" y="190" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#6B746D">## </text>
  <text x="92" y="190" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#EEF2F2">Guides</text>

  <!-- Row 8: - [Guide name] -->
  <text x="68" y="210" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#5F6C6E">- </text>
  <text x="82" y="210" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#CBD5D5">[Guide name](/guides/...)</text>
  <text x="244" y="210" font-family="Geist Mono, ui-monospace, monospace" font-size="12" fill="#5F6C6E">: ...</text>

  <!-- Annotation connector lines -->
  <!-- H1 annotation: row 1, y=70 -->
  <line x1="424" y1="70" x2="464" y2="70" stroke="#5F6C6E" stroke-width="1" stroke-dasharray="3,2"/>
  <circle cx="424" cy="70" r="2" fill="#5F6C6E"/>

  <!-- Blockquote annotation: row 2, y=90 -->
  <line x1="424" y1="90" x2="464" y2="90" stroke="#5F6C6E" stroke-width="1" stroke-dasharray="3,2"/>
  <circle cx="424" cy="90" r="2" fill="#5F6C6E"/>

  <!-- H2 annotation: row 4, y=130 -->
  <line x1="424" y1="130" x2="464" y2="130" stroke="#5F6C6E" stroke-width="1" stroke-dasharray="3,2"/>
  <circle cx="424" cy="130" r="2" fill="#5F6C6E"/>

  <!-- Link annotation: row 5, y=150 -->
  <line x1="424" y1="150" x2="464" y2="158" stroke="#5F6C6E" stroke-width="1" stroke-dasharray="3,2"/>
  <circle cx="424" cy="150" r="2" fill="#5F6C6E"/>

  <!-- Annotation labels -->
  <!-- H1 label -->
  <rect x="466" y="58" width="148" height="22" rx="4" fill="#FFFFFF" stroke="#DFE5E5" stroke-width="1"/>
  <text x="540" y="73" font-family="Geist, system-ui, sans-serif" font-size="11" fill="#5F6C6E" text-anchor="middle">H1: site name (required)</text>

  <!-- Blockquote label -->
  <rect x="466" y="78" width="148" height="22" rx="4" fill="#FFFFFF" stroke="#DFE5E5" stroke-width="1"/>
  <text x="540" y="93" font-family="Geist, system-ui, sans-serif" font-size="11" fill="#5F6C6E" text-anchor="middle">Blockquote: summary</text>

  <!-- H2 label -->
  <rect x="466" y="118" width="148" height="22" rx="4" fill="#FFFFFF" stroke="#DFE5E5" stroke-width="1"/>
  <text x="540" y="133" font-family="Geist, system-ui, sans-serif" font-size="11" fill="#5F6C6E" text-anchor="middle">H2: section grouping</text>

  <!-- Link + description label -->
  <rect x="466" y="146" width="148" height="22" rx="4" fill="#FFFFFF" stroke="#DFE5E5" stroke-width="1"/>
  <text x="540" y="161" font-family="Geist, system-ui, sans-serif" font-size="11" fill="#5F6C6E" text-anchor="middle">Link + description</text>

  <!-- Bottom note -->
  <text x="24" y="234" font-family="Geist, system-ui, sans-serif" font-size="11" fill="#5F6C6E">Sections repeat for each content category. Descriptions are optional but recommended.</text>
</svg>
