<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 220" width="100%" height="auto" role="img" aria-labelledby="q1-schema-validation-title">
  <title id="q1-schema-validation-title">Schema validation workflow from template detection to JSON-LD checks and post-deploy re-audits</title>

  <text x="390" y="22" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#0F172A">Schema works when it stays aligned with the page</text>
  <text x="390" y="40" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" fill="#475569">Identify the template, add JSON-LD, validate it, audit live pages, and re-check after changes</text>

  <circle cx="116" cy="118" r="54" fill="#F7F5F0" stroke="#E2E0DA" stroke-width="1.5"/>
  <text x="116" y="94" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" fill="#0F172A">1. Template</text>
  <rect x="84" y="112" width="64" height="8" rx="3" fill="#0D9488"/>
  <rect x="84" y="129" width="48" height="7" rx="2" fill="#CBD5E1"/>
  <text x="116" y="153" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" fill="#475569">content type</text>

  <line x1="172" y1="118" x2="218" y2="118" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="212,112 219,118 212,124" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <circle cx="274" cy="118" r="54" fill="#FFFFFF" stroke="#E2E0DA" stroke-width="1.5"/>
  <text x="274" y="94" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" fill="#0F172A">2. JSON-LD</text>
  <text x="244" y="118" font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" fill="#0D9488">"@type"</text>
  <text x="244" y="135" font-family="ui-monospace, SFMono-Regular, monospace" font-size="9" fill="#6366F1">"author"</text>
  <text x="274" y="153" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" fill="#475569">explicit fields</text>

  <line x1="330" y1="118" x2="376" y2="118" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="370,112 377,118 370,124" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <circle cx="432" cy="118" r="54" fill="#F7F5F0" stroke="#E2E0DA" stroke-width="1.5"/>
  <text x="432" y="94" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" fill="#0F172A">3. Validate</text>
  <rect x="402" y="112" width="60" height="18" rx="4" fill="#CCFBF1"/>
  <text x="432" y="125" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="700" fill="#0F766E">PASS</text>
  <text x="432" y="153" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" fill="#475569">syntax + fields</text>

  <line x1="488" y1="118" x2="534" y2="118" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="528,112 535,118 528,124" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <circle cx="590" cy="118" r="54" fill="#0F172A" stroke="#0F172A" stroke-width="1.5"/>
  <text x="590" y="94" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" fill="#FFFFFF">4. Audit</text>
  <rect x="560" y="113" width="60" height="8" rx="4" fill="#334155"/>
  <rect x="560" y="130" width="42" height="8" rx="4" fill="#334155"/>
  <text x="590" y="153" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" fill="#CBD5E1">live page</text>

  <path d="M614 68 C674 50, 716 76, 710 116 C705 154, 664 170, 624 156" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="627,149 622,157 632,159" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <rect x="658" y="92" width="96" height="52" rx="8" fill="#059669"/>
  <text x="706" y="115" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" fill="#FFFFFF">Re-check</text>
  <text x="706" y="132" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" fill="#D1FAE5">after deploys</text>

  <text x="390" y="202" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="10" fill="#94A3B8">Broken schema is usually invisible to users, so validation has to be part of the publishing loop.</text>
</svg>
