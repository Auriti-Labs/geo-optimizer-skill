<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 220" width="100%" height="auto" role="img" aria-labelledby="f1-entity-title">
  <title id="f1-entity-title">Entity authority built from a linked topic cluster instead of a single page</title>

  <text x="390" y="22" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#0F172A">Entity authority is built by a linked topic cluster</text>
  <text x="390" y="40" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" fill="#475569">One strong page is a page. Five connected pages become an entity signal.</text>

  <rect x="24" y="58" width="172" height="122" rx="8" fill="#F7F5F0" stroke="#E2E0DA" stroke-width="1.5"/>
  <text x="110" y="82" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" fill="#0F172A">Single page</text>
  <rect x="52" y="100" width="116" height="56" rx="6" fill="#FFFFFF" stroke="#E2E0DA" stroke-width="1"/>
  <rect x="68" y="116" width="78" height="7" rx="2" fill="#0D9488"/>
  <rect x="68" y="132" width="58" height="6" rx="2" fill="#E2E0DA"/>
  <rect x="68" y="145" width="72" height="6" rx="2" fill="#E2E0DA"/>
  <text x="110" y="170" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="10" fill="#94A3B8">isolated signal</text>

  <line x1="198" y1="119" x2="238" y2="119" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="232,113 239,119 232,125" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <rect x="242" y="58" width="296" height="122" rx="8" fill="#FFFFFF" stroke="#E2E0DA" stroke-width="1.5"/>
  <text x="390" y="80" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" fill="#0F172A">Topic cluster</text>

  <line x1="390" y1="115" x2="310" y2="100" stroke="#CBD5E1" stroke-width="1.2"/>
  <line x1="390" y1="115" x2="470" y2="100" stroke="#CBD5E1" stroke-width="1.2"/>
  <line x1="390" y1="115" x2="308" y2="145" stroke="#CBD5E1" stroke-width="1.2"/>
  <line x1="390" y1="115" x2="472" y2="145" stroke="#CBD5E1" stroke-width="1.2"/>
  <line x1="310" y1="100" x2="308" y2="145" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="3 2"/>
  <line x1="470" y1="100" x2="472" y2="145" stroke="#CBD5E1" stroke-width="1" stroke-dasharray="3 2"/>

  <rect x="346" y="92" width="88" height="46" rx="7" fill="#0D9488"/>
  <text x="390" y="112" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="700" fill="#FFFFFF">Pillar</text>
  <text x="390" y="127" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" fill="#CCFBF1">core topic</text>

  <rect x="268" y="86" width="64" height="28" rx="6" fill="#F7F5F0" stroke="#E2E0DA" stroke-width="1"/>
  <text x="300" y="104" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="600" fill="#475569">FAQ</text>
  <rect x="448" y="86" width="64" height="28" rx="6" fill="#F7F5F0" stroke="#E2E0DA" stroke-width="1"/>
  <text x="480" y="104" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="600" fill="#475569">Guide</text>
