  <text x="300" y="150" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="600" fill="#475569">Compare</text>
  <rect x="448" y="132" width="64" height="28" rx="6" fill="#F7F5F0" stroke="#E2E0DA" stroke-width="1"/>
  <text x="480" y="150" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="600" fill="#475569">How-to</text>

  <line x1="540" y1="119" x2="580" y2="119" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="574,113 581,119 574,125" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <rect x="584" y="58" width="172" height="122" rx="8" fill="#0F172A" stroke="#0F172A" stroke-width="1.5"/>
  <text x="670" y="82" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" fill="#FFFFFF">Authority score</text>
  <text x="670" y="111" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="800" fill="#5EEAD4">77</text>
  <text x="695" y="112" font-family="system-ui, -apple-system, sans-serif" font-size="11" fill="#94A3B8">/100</text>
  <rect x="612" y="128" width="116" height="8" rx="4" fill="#1E293B"/>
  <rect x="612" y="128" width="90" height="8" rx="4" fill="#0D9488"/>
  <text x="670" y="154" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="10" fill="#CBD5E1">coverage + interlinks</text>
  <text x="670" y="168" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="10" fill="#CBD5E1">+ pillar presence</text>

  <text x="390" y="202" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="10" fill="#94A3B8">Crawlers reconstruct authority from connected pages, not from one URL in isolation.</text>
</svg>
