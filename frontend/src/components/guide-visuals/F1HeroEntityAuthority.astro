<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 220" width="100%" height="auto" role="img" aria-labelledby="f1-entity-title">
  <title id="f1-entity-title">Entity authority built from a linked topic cluster instead of a single page</title>

  <text x="390" y="22" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="13" font-weight="600" fill="#0A1514">Entity authority is built by a linked topic cluster</text>
  <text x="390" y="40" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="11" fill="#48575A">One strong page is a page. Five connected pages become an entity signal.</text>

  <rect x="24" y="58" width="172" height="122" rx="3" fill="#F4F6F6" stroke="#DFE5E5" stroke-width="1.5"/>
  <text x="110" y="82" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0A1514">Single page</text>
  <rect x="52" y="100" width="116" height="56" rx="3" fill="#FFFFFF" stroke="#DFE5E5" stroke-width="1"/>
  <rect x="68" y="116" width="78" height="7" rx="2" fill="#0B8076"/>
  <rect x="68" y="132" width="58" height="6" rx="2" fill="#DFE5E5"/>
  <rect x="68" y="145" width="72" height="6" rx="2" fill="#DFE5E5"/>
  <text x="110" y="170" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="10" fill="#5F6C6E">isolated signal</text>

  <line x1="198" y1="119" x2="238" y2="119" stroke="#5F6C6E" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="232,113 239,119 232,125" fill="none" stroke="#5F6C6E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <rect x="242" y="58" width="296" height="122" rx="3" fill="#FFFFFF" stroke="#DFE5E5" stroke-width="1.5"/>
  <text x="390" y="80" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0A1514">Topic cluster</text>

  <line x1="390" y1="115" x2="310" y2="100" stroke="#C9D4D2" stroke-width="1.2"/>
  <line x1="390" y1="115" x2="470" y2="100" stroke="#C9D4D2" stroke-width="1.2"/>
  <line x1="390" y1="115" x2="308" y2="145" stroke="#C9D4D2" stroke-width="1.2"/>
  <line x1="390" y1="115" x2="472" y2="145" stroke="#C9D4D2" stroke-width="1.2"/>
  <line x1="310" y1="100" x2="308" y2="145" stroke="#C9D4D2" stroke-width="1" stroke-dasharray="3 2"/>
  <line x1="470" y1="100" x2="472" y2="145" stroke="#C9D4D2" stroke-width="1" stroke-dasharray="3 2"/>

  <rect x="346" y="92" width="88" height="46" rx="3" fill="#0B8076"/>
  <text x="390" y="112" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="11" font-weight="700" fill="#FFFFFF">Pillar</text>
  <text x="390" y="127" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="9" fill="#E4F3F0">core topic</text>

  <rect x="268" y="86" width="64" height="28" rx="3" fill="#F4F6F6" stroke="#DFE5E5" stroke-width="1"/>
  <text x="300" y="104" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="9" font-weight="600" fill="#48575A">FAQ</text>
  <rect x="448" y="86" width="64" height="28" rx="3" fill="#F4F6F6" stroke="#DFE5E5" stroke-width="1"/>
  <text x="480" y="104" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="9" font-weight="600" fill="#48575A">Guide</text>
  <rect x="268" y="132" width="64" height="28" rx="3" fill="#F4F6F6" stroke="#DFE5E5" stroke-width="1"/>
  <text x="300" y="150" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="9" font-weight="600" fill="#48575A">Compare</text>
  <rect x="448" y="132" width="64" height="28" rx="3" fill="#F4F6F6" stroke="#DFE5E5" stroke-width="1"/>
  <text x="480" y="150" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="9" font-weight="600" fill="#48575A">How-to</text>

  <line x1="540" y1="119" x2="580" y2="119" stroke="#5F6C6E" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="574,113 581,119 574,125" fill="none" stroke="#5F6C6E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <rect x="584" y="58" width="172" height="122" rx="3" fill="#0A1514" stroke="#0A1514" stroke-width="1.5"/>
  <text x="670" y="82" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="12" font-weight="700" fill="#FFFFFF">Authority score</text>
  <text x="670" y="111" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="28" font-weight="800" fill="#5EEAD4">77</text>
  <text x="695" y="112" font-family="Geist, system-ui, sans-serif" font-size="11" fill="#5F6C6E">/100</text>
  <rect x="612" y="128" width="116" height="8" rx="4" fill="#172020"/>
  <rect x="612" y="128" width="90" height="8" rx="4" fill="#0B8076"/>
  <text x="670" y="154" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="10" fill="#C9D4D2">coverage + interlinks</text>
  <text x="670" y="168" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="10" fill="#C9D4D2">+ pillar presence</text>

  <text x="390" y="202" text-anchor="middle" font-family="Geist, system-ui, sans-serif" font-size="10" fill="#5F6C6E">Crawlers reconstruct authority from connected pages, not from one URL in isolation.</text>
</svg>
