<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 220" width="100%" height="auto" role="img" aria-labelledby="m1-generator-title">
  <title id="m1-generator-title">llms.txt generator converts a sitemap into an editable orientation file hosted at the domain root</title>

  <text x="390" y="22" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="13" font-weight="600" fill="#0F172A">From sitemap to publishable llms.txt</text>
  <text x="390" y="40" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" fill="#475569">The generator validates a public sitemap, groups URLs, and outputs editable Markdown for the domain root</text>

  <rect x="24" y="66" width="128" height="96" rx="8" fill="#F7F5F0" stroke="#E2E0DA" stroke-width="1.5"/>
  <text x="88" y="90" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" fill="#0F172A">Sitemap</text>
  <text x="48" y="116" font-family="ui-monospace, SFMono-Regular, monospace" font-size="10" fill="#0D9488">/sitemap.xml</text>
  <rect x="48" y="130" width="76" height="7" rx="2" fill="#CBD5E1"/>
  <rect x="48" y="144" width="58" height="7" rx="2" fill="#E2E0DA"/>

  <line x1="154" y1="114" x2="194" y2="114" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="188,108 195,114 188,120" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <rect x="198" y="58" width="164" height="112" rx="8" fill="#FFFFFF" stroke="#E2E0DA" stroke-width="1.5"/>
  <text x="280" y="82" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" fill="#0F172A">Generator</text>
  <rect x="224" y="102" width="112" height="16" rx="4" fill="#CCFBF1"/>
  <text x="280" y="114" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="700" fill="#0F766E">validate URL</text>
  <rect x="224" y="128" width="112" height="16" rx="4" fill="#E0E7FF"/>
  <text x="280" y="140" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="700" fill="#4338CA">group sections</text>
  <rect x="224" y="154" width="112" height="16" rx="4" fill="#D1FAE5"/>
  <text x="280" y="166" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="9" font-weight="700" fill="#047857">write markdown</text>

  <line x1="364" y1="114" x2="404" y2="114" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round"/>
  <polyline points="398,108 405,114 398,120" fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>

  <rect x="408" y="58" width="158" height="112" rx="8" fill="#0F172A" stroke="#0F172A" stroke-width="1.5"/>
  <text x="487" y="82" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="12" font-weight="700" fill="#FFFFFF">llms.txt</text>
