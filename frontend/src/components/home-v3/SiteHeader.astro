---
// Header v3: sprite delle icone, barra in vetro con mega menu Platform e sheet mobile.
// I link verso le sezioni puntano a "/#..." così il componente regge anche fuori dalla home;
// fuori dalla home Pricing apre la sua pagina e gli eventi CTA perdono il prefisso home_.
interface Props { home?: boolean }
const { home = false } = Astro.props;
const pricing = home ? '/#pricing' : '/pricing/';
const cta = (name: string) => (home ? 'home_' : 'site_') + name;
const views = [
  ['Crawler access', '27 AI bots, search told apart from training'],
  ['Ranked fixes', 'File, line and points for every fix'],
  ['Citability', '47 checks on the rendered page'],
  ['Score alerts', 'An email when the score drops 5+ points'],
  ['AI answer checks', 'Which domains Perplexity cites'],
  ['CLI and MCP', 'The MIT engine in CI or your agent'],
];
const sheetLinks = [
  ['/#platform', 'Platform'],
  ['/#how', 'How it works'],
  [pricing, 'Pricing'],
  ['/research/', 'Research'],
  ['/docs/', 'Docs'],
];
---
<!-- icone: un linguaggio "nodo + arco", come il grafo che leggono i crawler -->
<svg class="sprite" aria-hidden="true" focusable="false">
  <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M6.5 12H18M13.5 7.5 18 12l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="4" cy="12" r="1.9" fill="currentColor"/></symbol>
  <symbol id="i-ext" viewBox="0 0 24 24"><path d="M8.6 15.4 17 7M10 7h7v7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6.6" cy="17.4" r="1.9" fill="currentColor"/></symbol>
  <symbol id="i-chev" viewBox="0 0 24 24"><path d="M6.5 9.5 12 15l5.5-5.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="15" r="1.6" fill="currentColor"/></symbol>
  <symbol id="i-star" viewBox="0 0 24 24"><path d="m12 3.5 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8z" fill="currentColor"/></symbol>
  <symbol id="i-pause" viewBox="0 0 24 24"><path d="M9 7v10M15 7v10" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></symbol>
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 4.5v4.2M12 15.3v4.2M4.5 12h4.2M15.3 12h4.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="2.1" fill="currentColor"/></symbol>
  <symbol id="i-system" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6.6" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 5.4a6.6 6.6 0 0 0 0 13.2z" fill="currentColor"/><circle cx="19.2" cy="4.8" r="1.6" fill="currentColor"/></symbol>
  <symbol id="i-light" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.7"/><g fill="currentColor"><circle cx="12" cy="3.6" r="1.25"/><circle cx="12" cy="20.4" r="1.25"/><circle cx="3.6" cy="12" r="1.25"/><circle cx="20.4" cy="12" r="1.25"/><circle cx="6.1" cy="6.1" r="1.1"/><circle cx="17.9" cy="17.9" r="1.1"/><circle cx="6.1" cy="17.9" r="1.1"/><circle cx="17.9" cy="6.1" r="1.1"/></g></symbol>
  <symbol id="i-dark" viewBox="0 0 24 24"><path d="M19 14.6A7.4 7.4 0 0 1 9.4 5a7.4 7.4 0 1 0 9.6 9.6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="17.2" cy="5.4" r="1.3" fill="currentColor"/><circle cx="20.2" cy="9" r="0.9" fill="currentColor"/></symbol>
  <symbol id="i-github" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.5a9.5 9.5 0 0 0-3 18.5c.5.1.7-.2.7-.5v-1.7c-2.6.6-3.2-1.2-3.2-1.2-.4-1.1-1-1.4-1-1.4-.9-.6 0-.6 0-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.1-.2-4.3-1-4.3-4.7 0-1 .4-1.9 1-2.6-.1-.2-.4-1.2.1-2.5 0 0 .8-.3 2.6 1a9 9 0 0 1 4.8 0c1.8-1.3 2.6-1 2.6-1 .5 1.3.2 2.3.1 2.5.6.7 1 1.6 1 2.6 0 3.7-2.2 4.5-4.3 4.7.3.3.6.8.6 1.6v2.4c0 .3.2.6.7.5A9.5 9.5 0 0 0 12 2.5z"/></symbol>
</svg>

<header class="top"><div class="bar wrap">
  <a class="brand" href="/" aria-label="GeoReady home">
    <img class="logo logo-light" src="/brand/geoready-lockup-light.svg" width="146" height="36" alt="GeoReady">
    <img class="logo logo-dark" src="/brand/geoready-lockup-dark.svg" width="146" height="36" alt="GeoReady">
  </a>
  <nav class="nav" aria-label="Main">
    <button class="nav-mega" type="button" aria-expanded="false" aria-controls="mega">Platform<svg class="ic ic-s" aria-hidden="true"><use href="#i-chev"/></svg></button>
    <a href="/#how">How it works</a>
    <a href={pricing}>Pricing</a>
    <a href="/research/">Research</a>
    <a href="/docs/">Docs</a>
  </nav>
  <div class="bar-end">
    <button class="theme" type="button" data-theme-toggle aria-label="Theme: system">
      <svg class="ic t-system" aria-hidden="true"><use href="#i-system"/></svg>
      <svg class="ic t-light" aria-hidden="true"><use href="#i-light"/></svg>
      <svg class="ic t-dark" aria-hidden="true"><use href="#i-dark"/></svg>
    </button>
    <a class="btn btn-small btn-ghost" href="https://app.geoready.dev/login">Sign in</a>
    <a class="btn btn-small btn-go bar-cta" href="/#audit" data-cta={cta('header_free_audit')}>Free audit</a>
    <button class="burger" type="button" popovertarget="sheet" aria-expanded="false" aria-label="Open menu"><i></i><i></i></button>
  </div>
</div>
  <div class="mega" id="mega" hidden>
    <div class="wrap mega-in">
      <ul class="mega-views">
        {views.map(([name, desc], i) => (
          <li style={`--i:${i}`}><a href="/#platform" data-go={i}><b>{name}</b><span>{desc}</span></a></li>
        ))}
      </ul>
      <div class="mega-side">
        <p class="mega-k">Open source engine</p>
        <p><code>pip install geo-optimizer-skill</code></p>
        <a class="mega-link" href="https://github.com/Auriti-Labs/geo-optimizer-skill">Read the code on GitHub<svg class="ic ic-s" aria-hidden="true"><use href="#i-ext"/></svg></a>
        <a class="mega-link" href="/methodology/">How the 100 points are weighted<svg class="ic ic-s" aria-hidden="true"><use href="#i-arrow"/></svg></a>
      </div>
    </div>
  </div>
</header>

<div class="sheet" id="sheet" popover role="dialog" aria-modal="true" aria-label="Menu">
  <div class="sheet-bar wrap">
    <img class="logo logo-light" src="/brand/geoready-lockup-light.svg" width="146" height="36" alt="GeoReady">
    <img class="logo logo-dark" src="/brand/geoready-lockup-dark.svg" width="146" height="36" alt="" role="presentation">
    <button class="burger is-x" type="button" popovertarget="sheet" popovertargetaction="hide" aria-label="Close menu" autofocus><i></i><i></i></button>
  </div>
  <nav class="sheet-nav wrap" aria-label="Mobile">
    {sheetLinks.map(([href, label], i) => (
      <a href={href} style={`--i:${i}`}><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{label}</a>
    ))}
  </nav>
  <div class="sheet-end wrap">
    <a class="btn btn-go" href="/#audit" data-cta={cta('sheet_free_audit')}>Run free audit</a>
    <a class="btn btn-ghost" href="https://app.geoready.dev/login">Sign in</a>
  </div>
</div>
