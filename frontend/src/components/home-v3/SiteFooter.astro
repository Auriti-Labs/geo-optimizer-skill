---
// Footer v3: newsletter (stesso endpoint di NewsletterSignup), quattro colonne di link,
// parola grande, versione del motore letta da pyproject e selettore del tema a 3 stati.
const cols: [string, [string, string][]][] = [
  ['Product', [
    ['/#audit', 'Free audit'],
    ['/pricing/', 'Pricing'],
    ['/geo-monitoring-tool/', 'Monitoring'],
    ['/analyze-competitors/', 'Competitor analysis'],
    ['/tools/ai-citation-checker/', 'AI citation checker'],
    ['/tools/llms-txt-generator/', 'llms.txt generator'],
  ]],
  ['Learn', [
    ['/methodology/', 'Methodology'],
    ['/research/', 'Research'],
    ['/state-of-geo/', 'State of GEO'],
    ['/guides/', 'Guides'],
    ['/docs/', 'Docs'],
    ['/compare/', 'Compare tools'],
  ]],
  ['Open source', [
    ['https://github.com/Auriti-Labs/geo-optimizer-skill', 'GitHub'],
    ['https://pypi.org/project/geo-optimizer-skill/', 'PyPI'],
    ['https://github.com/Auriti-Labs/geo-optimizer-skill/pkgs/container/geo-optimizer-skill', 'GHCR'],
    ['/docs/', 'MCP server'],
  ]],
  ['Company', [
    ['/about/', 'About'],
    ['/manifesto/', 'Manifesto'],
    ['/roadmap/', 'Roadmap'],
    ['/transparent-geo-tool/', 'Transparency'],
    ['mailto:info@geoready.dev', 'info@geoready.dev'],
  ]],
];
interface Props { home?: boolean }
const { home = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap foot-top">
    <div class="foot-brand">
      <img class="logo logo-light" src="/brand/geoready-lockup-light.svg" width="146" height="36" alt="GeoReady" loading="lazy">
      <img class="logo logo-dark" src="/brand/geoready-lockup-dark.svg" width="146" height="36" alt="" role="presentation" loading="lazy">
      <p>GEO audit and monitoring on a public 100-point rubric. The engine is MIT licensed.</p>
      <form class="news" id="news" method="post" novalidate data-source={home ? 'newsletter-home-footer' : 'newsletter-site-footer'}>
        <label for="news-email">One email a month: State of GEO data and what changed in AI search.</label>
        <div class="news-row">
          <input id="news-email" name="email" type="email" autocomplete="email" placeholder="you@company.com" aria-describedby="news-msg news-consent" required>
          <button class="btn btn-small" type="submit">Subscribe</button>
        </div>
        <p class="news-msg" id="news-msg" role="status"></p>
        {/* Deve restare allineato a STATE_OF_GEO_CONSENT_PURPOSE lato server, come in NewsletterSignup.tsx */}
        <p class="note" id="news-consent">By subscribing you agree to receive the monthly GeoReady newsletter: benchmark data from the State of GEO dataset, practical GEO guidance, and product updates. Unsubscribe anytime. See the <a href="/privacy/">Privacy Policy</a>.</p>
      </form>
    </div>
    <nav class="foot-cols" aria-label="Footer">
      {cols.map(([title, links]) => (
        <div><p class="foot-k">{title}</p><ul>
          {links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
        </ul></div>
      ))}
    </nav>
  </div>
  <p class="foot-word" aria-hidden="true">GeoReady</p>
  <div class="wrap foot-end">
    <p>© {year} Auriti Labs</p>
    <p class="foot-legal"><a href="/privacy/">Privacy</a><a href="/cookie-policy/">Cookies</a><a href="/terms/">Terms</a></p>
    <p class="foot-ver"><span class="foot-live" aria-hidden="true"></span>Engine v{__ENGINE_VERSION__} · rubric v2</p>
    <fieldset class="seg" aria-label="Theme">
      <label><input type="radio" name="theme-seg" value="system"><svg class="ic ic-s" aria-hidden="true"><use href="#i-system"/></svg><span class="sr">System</span></label>
      <label><input type="radio" name="theme-seg" value="light"><svg class="ic ic-s" aria-hidden="true"><use href="#i-light"/></svg><span class="sr">Light</span></label>
      <label><input type="radio" name="theme-seg" value="dark"><svg class="ic ic-s" aria-hidden="true"><use href="#i-dark"/></svg><span class="sr">Dark</span></label>
    </fieldset>
  </div>
</footer>
