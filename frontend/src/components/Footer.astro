---
import { BOOK } from '../lib/bookData';

// Il footer è organizzato in sezioni semantiche per aiutare sia gli utenti che
// i crawler a capire la struttura del sito. I link esterni portano `cta` per far
// scattare geo_cta_clicked via ctaTracking (listener delegato in Shell.astro).
type FooterLink = { label: string; href: string; cta?: string };
type FooterColumn = { id: string; heading: string; links: FooterLink[] };

const productCol: FooterColumn = {
  id: "product",
  heading: "Product",
  links: [
    { label: "Audit", href: "/", cta: "footer_audit" },
    { label: "Compare", href: "/compare/", cta: "footer_compare" },
    { label: "Analyze competitors", href: "/analyze-competitors/", cta: "footer_analyze_competitors" },
    { label: "AI citation checker", href: "/tools/ai-citation-checker/", cta: "footer_citation_checker" },
    { label: "ChatGPT visibility", href: "/chatgpt-visibility-checker/", cta: "footer_chatgpt_visibility" },
    { label: "Perplexity citations", href: "/perplexity-citation-checker/", cta: "footer_perplexity_citation" },
    { label: "AI SEO audit", href: "/ai-seo-audit/", cta: "footer_ai_seo_audit" },
    { label: "llms.txt generator", href: "/tools/llms-txt-generator/", cta: "footer_llms_generator" },
    { label: "Pricing", href: "/pricing/", cta: "footer_pricing" },
    { label: "Founding access", href: "/early-access/", cta: "footer_early_access" },
    { label: "For local agencies", href: "/ai-visibility-for-local-service-agencies/", cta: "footer_local_agencies" },
  ],
};

const resourcesCol: FooterColumn = {
  id: "resources",
  heading: "Resources",
  links: [
    { label: "Best GEO tools", href: "/best-geo-tools/", cta: "footer_best_geo_tools" },
    { label: "Guides", href: "/guides/", cta: "footer_guides" },
    { label: "State of GEO", href: "/state-of-geo/", cta: "footer_state_of_geo" },
    { label: "GEO knowledge base", href: "/resources/geo-knowledge-base/", cta: "footer_knowledge_base" },
    { label: "Methodology", href: "/methodology/", cta: "footer_methodology" },
    { label: "Research", href: "/research/", cta: "footer_research" },
    { label: "GEO Readiness Manual", href: "/geo-readiness-manual/", cta: "footer_manual" },
    { label: "GitHub", href: "https://github.com/Auriti-Labs/geo-optimizer-skill", cta: "footer_github" },
    { label: "Docs", href: "/docs/", cta: "footer_docs" },
    { label: "PyPI", href: "https://pypi.org/project/geo-optimizer-skill/", cta: "footer_pypi" },
  ],
};

const companyCol: FooterColumn = {
  id: "company",
  heading: "Company",
  links: [
    { label: "About", href: "/about/", cta: "footer_about" },
    { label: "Transparency", href: "/transparent-geo-tool/", cta: "footer_transparency" },
    { label: "Roadmap", href: "/roadmap/", cta: "footer_roadmap" },
    { label: "Manifesto", href: "/manifesto/", cta: "footer_manifesto" },
    { label: "Instagram", href: "https://www.instagram.com/geoready.dev/", cta: "footer_instagram" },
    { label: "YouTube", href: "https://youtube.com/@georeadydev", cta: "footer_youtube" },
    { label: "Privacy", href: "/privacy/", cta: "footer_privacy" },
    { label: "Cookies", href: "/cookie-policy/", cta: "footer_cookies" },
    { label: "Terms", href: "/terms/", cta: "footer_terms" },
  ],
};

const columns: FooterColumn[] = [productCol, resourcesCol, companyCol];

// Restituisce gli attributi da applicare al link: apre in nuova scheda i link
// esterni e aggiunge il cta tracking sui contenuti (null se non serve).
const linkAttrs = (l: FooterLink) => {
  if (l.href.startsWith('http')) {
    return { target: '_blank', rel: 'noopener', 'data-cta': l.cta };
  }
  return { 'data-cta': l.cta };
};
---

<footer class="band-dark mt-auto">
  <div class="mx-auto max-w-7xl px-6">

    {/* Riga comando: la stessa voce del motore che l'hero mostra in "$ geo audit" */}
    <div class="flex flex-col gap-4 border-b border-rail py-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[13px] text-ink-soft">
        <span class="text-pass-deep">$</span> pip install geo-optimizer-skill
        <span class="mt-1 block text-ink-mute sm:ml-2 sm:mt-0 sm:inline">v{__ENGINE_VERSION__} · MIT licence</span>
      </p>
      <a href="/#audit-form" data-cta="footer_run_audit" class="inline-flex items-center gap-1.5 self-start rounded-[9px] bg-pass-deep px-4 py-2 font-text text-[12.5px] font-semibold text-[#090C0C] transition-colors hover:bg-[#5EEAD4] sm:self-auto">
        Run a free audit
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

    <div class="grid gap-10 py-12 md:grid-cols-[1.2fr_2fr_1fr]">
      <div class="flex flex-col gap-4">
        <img src="/brand/geoready-lockup-dark.svg" width="89" height="22" alt="GeoReady AI visibility audit" decoding="async">
        <p class="max-w-[240px] text-xs leading-relaxed text-ink-mute">
          Open-source AI search visibility audit and monitoring. Built in Italy by Juan Camilo Auriti.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {columns.map((col) => (
          <nav aria-label={`Footer – ${col.heading}`}>
            <p class="eyebrow mb-3">{col.heading}</p>
            <ul class="space-y-2.5">
              {col.links.map((l) => (
                <li><a href={l.href} class="text-[13px] leading-relaxed text-ink-soft transition-colors hover:text-ink" {...linkAttrs(l)}>{l.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
      </div>

      {/* Book card: asset a conversione, pannello dello stesso sistema dark */}
      <div class="panel flex flex-col justify-between p-5">
        <div>
          <p class="font-mono text-[12px] font-medium tracking-[0.02em] text-pass-deep">The Book</p>
          <p class="mt-2 font-head text-[17px] font-semibold leading-tight tracking-[-0.02em] text-ink">
            {BOOK.title}
          </p>
          <p class="mt-1.5 text-xs leading-relaxed text-ink-soft">
            Google is no longer the only way customers find you. A technical manual for getting your
            site cited by LLMs and AI agents, with protocols validated on AutoGEO (arXiv preprint 2510.11438) and KDD 2024.
            {BOOK.numberOfPages} pages, paperback and Kindle.
          </p>
        </div>
        <a
          href="/book/"
          data-cta="footer_book"
          class="mt-4 inline-flex items-center justify-center gap-1.5 rounded-[9px] px-4 py-2 font-text text-[12.5px] font-semibold text-ink shadow-[inset_0_0_0_1px_#2A3636] transition-shadow hover:shadow-[inset_0_0_0_1px_#2DD4BF]"
        >
          <span>Get the book</span>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="flex flex-col items-center gap-5 border-t border-rail py-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="max-w-2xl text-xs text-ink-mute">
        Built in Italy by Juan Camilo Auriti. Designed for the global AI search ecosystem. Powered by Princeton KDD 2024 + AutoGEO (arXiv:2510.11438, preprint) research.
      </p>
      <a href="https://launchpadly.co/startup/geoready" target="_blank" rel="noopener noreferrer" data-launchpadly-badge="geoready" data-launchpadly-badge-variant="dark">
        <img src="https://launchpadly.co/embed/badges/startup/geoready.svg?variant=dark" alt="Launchpadly Startup Directory" width="220" height="48" loading="lazy" style="display:block;border:0;" />
      </a>
    </div>
  </div>
</footer>
