---
import type { RoadmapPhase as RoadmapPhaseType, RoadmapStatus } from '../../lib/roadmapContent';

interface Props {
  phase: RoadmapPhaseType;
  /** Posizione della fase nella sequenza (0-based) — resa come indice mono "01". */
  index: number;
}

const { phase, index } = Astro.props;

// Chip di stato in grammatica console: pass per ciò che è shipped, neutro per
// il pianificato, queued per l'esplorativo. Le etichette restano quelle della pagina.
const statusConfig: Record<RoadmapStatus, { label: string; chip: string }> = {
  available: { label: 'Available', chip: 'bg-pass-wash text-pass-deep' },
  'in-progress': { label: 'In progress', chip: 'border border-rail text-ink-mute' },
  planned: { label: 'Planned', chip: 'border border-rail text-ink-mute' },
  exploring: { label: 'Exploring', chip: 'border border-rail text-queued' },
};

// Progress aggregato della fase: quanti item sono già disponibili.
const total = phase.items.length;
const shipped = phase.items.filter((i) => i.status === 'available').length;
const shippedPct = total > 0 ? Math.round((shipped / total) * 100) : 0;

const phaseIndex = String(index + 1).padStart(2, '0');

// Filler cells so the hairline grid never exposes the rail ground as full
// slabs in unfilled trailing slots: the rail must stay a 1px seam only.
const fillSm = (2 - (total % 2)) % 2;
const fillLg = (3 - (total % 3)) % 3;
---

<section>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h2 class="font-head text-2xl font-semibold tracking-[-0.02em] md:text-3xl">
      <span class="mr-3 align-middle font-mono text-[13px] font-medium tabular-nums text-ink-mute">{phaseIndex}</span>{phase.label}
    </h2>
    <span class="font-mono text-[12px] tabular-nums text-ink-mute">{shipped} / {total} shipped</span>
  </div>
  <p class="mt-1 text-sm text-ink-soft">{phase.subtitle}</p>
  {shipped > 0 && (
    <div class="mt-3 h-1.5 w-full max-w-xs overflow-hidden rounded-[6px] border border-rail bg-white" role="img" aria-label={`${shipped} of ${total} items available`}>
      <div class="h-full bg-pass" style={`width: ${shippedPct}%`}></div>
    </div>
  )}

  <ul class="mt-5 grid grid-cols-1 gap-px overflow-hidden rounded-[10px] border border-rail bg-rail sm:grid-cols-2 lg:grid-cols-3">
    {phase.items.map((item) => {
      const cfg = statusConfig[item.status];
      return (
        <li class="bg-white p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <h3 class="text-sm font-semibold text-ink">{item.title}</h3>
            <span class={`rounded-[6px] px-1.5 py-0.5 font-text text-[12px] font-semibold ${cfg.chip}`}>{cfg.label}</span>
          </div>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{item.description}</p>
        </li>
      );
    })}
    {fillSm > 0 && <li aria-hidden="true" class="hidden bg-white sm:block lg:hidden"></li>}
    {Array.from({ length: fillLg }).map(() => (
      <li aria-hidden="true" class="hidden bg-white lg:block"></li>
    ))}
  </ul>
</section>
