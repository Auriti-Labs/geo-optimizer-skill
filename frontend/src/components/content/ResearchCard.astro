---
import type { ResearchSource } from '../../lib/researchContent';

interface Props {
  source: ResearchSource;
}

const { source } = Astro.props;

const typeLabels: Record<string, string> = {
  paper: 'Research paper',
  benchmark: 'Benchmark',
  report: 'Industry report',
  analysis: 'Internal analysis',
};

// Metadati verificabili (venue · year) come annotazione mono nella striscia
// di testata — Total Annotation Rule del design system console.
const meta = [source.venue, source.year].filter(Boolean).join(' · ');
---

<article class="overflow-hidden rounded-[10px] border border-rail bg-paper">
  <header class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-rail px-5 py-2.5">
    <span class="font-text text-[12.5px] font-semibold text-ink-mute">
      {typeLabels[source.type] || source.type}
    </span>
    {meta && (
      <span class="font-text font-medium text-[12.5px] text-ink-mute">{meta}</span>
    )}
  </header>

  <div class="p-5 md:p-6">
    <h3 class="font-head text-lg font-semibold leading-snug tracking-[-0.01em] text-ink md:text-xl">
      {source.title}
    </h3>
    {source.authors && (
      <p class="mt-1 text-sm text-ink-mute">{source.authors}</p>
    )}

    <div class="mt-4 space-y-4">
      <div>
        <p class="mb-1 font-text text-[12.5px] font-semibold text-ink-mute">Finding</p>
        <p class="max-w-3xl text-sm leading-relaxed text-ink-soft">{source.finding}</p>
      </div>

      <div>
        <p class="mb-1 font-text text-[12.5px] font-semibold text-ink-mute">How GEO Optimizer uses it</p>
        <p class="max-w-3xl text-sm leading-relaxed text-ink-soft">{source.howWeUseIt}</p>
      </div>

      {source.metrics && (
        <div class="pt-2">
          <p class="mb-2 font-text text-[12.5px] font-semibold text-ink-mute">Key metrics</p>
          <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-[10px] border border-rail bg-rail sm:grid-cols-3">
            {source.metrics.map((m) => (
              <div class="bg-raised p-2.5">
                <dt class="font-text font-medium text-[12px] text-ink-mute">{m.label}</dt>
                <dd class="mt-0.5 font-mono text-sm font-semibold tabular-nums text-ink">{m.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      {source.link && (
        <div class="pt-1">
          <a
            href={source.link}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-pass-deep underline decoration-rail underline-offset-4 hover:decoration-pass-deep"
          >
            {source.linkLabel || 'Read source'}
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        </div>
      )}
    </div>
  </div>
</article>
