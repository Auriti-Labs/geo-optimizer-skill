---
const version = `v${__ENGINE_VERSION__}`;

// Il menu è diviso per intento: "Tools" sono le cose che l'utente può fare adesso,
// "Learn" quelle che spiegano. Prima erano 3 voci in barra contro 13 in un unico
// dropdown "More" che mescolava tool, guide, un PDF e le pagine di brand, quindi
// le voci in fondo non venivano mai viste — comprese /best-geo-tools/ e /research/,
// che sono le due pagine con più impression dopo la home.
type NavLink = { label: string; href: string; desc: string };
type NavGroup = { id: string; label: string; links: NavLink[] };

// Menu corti (5 voci): le landing per singolo motore, manuale, roadmap e manifesto
// restano linkate da tutte le pagine tramite il footer.
const navGroups: NavGroup[] = [
  {
    id: "tools",
    label: "Tools",
    links: [
      { label: "Audit", href: "/", desc: "Free GEO audit of any URL" },
      { label: "Compare", href: "/compare/", desc: "Score your site against another" },
      { label: "Analyze competitors", href: "/analyze-competitors/", desc: "Benchmark several domains at once" },
      { label: "AI citation checker", href: "/tools/ai-citation-checker/", desc: "Is your brand cited by AI? Free check" },
      { label: "llms.txt generator", href: "/tools/llms-txt-generator/", desc: "Free AI-ready llms.txt from your sitemap" },
    ],
  },
  {
    id: "learn",
    label: "Learn",
    links: [
      { label: "Guides", href: "/guides/", desc: "Practical AI visibility guides" },
      { label: "Docs", href: "/docs/", desc: "GEO Optimizer technical reference" },
      { label: "Research", href: "/research/", desc: "Princeton KDD + AutoGEO" },
      { label: "Methodology", href: "/methodology/", desc: "How GEO scores are calculated" },
      { label: "State of GEO", href: "/state-of-geo/", desc: "Live benchmark of audited sites" },
    ],
  },
  {
    id: "compare",
    label: "Compare",
    links: [
      { label: "RankScale", href: "/rankscale-alternative/", desc: "RankScale vs GeoReady: monitoring, engines, pricing" },
      { label: "Goodie AI", href: "/goodie-alternative/", desc: "Goodie vs GeoReady: revenue attribution & openness" },
      { label: "AEO Vision", href: "/aeovision-alternative/", desc: "AEO Vision vs GeoReady: engines, tiers, transparency" },
      { label: "Profound", href: "/profound-alternative/", desc: "Profound vs GeoReady: monitoring depth, scoring" },
      { label: "Otterly", href: "/otterly-alternative/", desc: "Otterly vs GeoReady: AI visibility dashboards" },
      { label: "Veesie", href: "/veesie-alternative/", desc: "Veesie vs GeoReady: GEO monitoring, engines, EUR/USD" },
      { label: "Semrush AI Toolkit", href: "/semrush-ai-visibility-toolkit-alternative/", desc: "Semrush vs GeoReady: suite vs open engine" },
      { label: "Open-source rivals", href: "/open-source-profound-otterly-alternative/", desc: "Open-source GEO optimizer: MIT, self-host, CLI, transparent" },
    ],
  },
];

// Promosso fuori dai dropdown
const featuredLink = { label: "Pricing", href: "/pricing/" };
---

<nav id="site-nav" class="fixed inset-x-0 top-0 z-50 border-b border-transparent bg-paper transition-[border-color,box-shadow] duration-300" aria-label="Main navigation">
  <div class="mx-auto flex h-[59px] max-w-7xl items-center justify-between gap-3 px-4 sm:px-6">

    <!-- Logo -->
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <img src="/brand/geoready-lockup-light.svg" width="113" height="28" alt="GeoReady home" decoding="async">
      <span class="hidden rounded-[6px] border border-rail px-1.5 py-0.5 font-mono text-[10px] text-ink-mute sm:inline">{version}</span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden items-center gap-0.5 md:flex">
      {navGroups.map((g) => (
        <div class="relative" data-nav-group>
          <button
            id={`${g.id}-menu-btn`}
            class="nav-item flex items-center gap-1 rounded-[6px] px-3 py-1.5 text-[13px] font-medium text-ink-soft transition-colors hover:bg-pass-wash hover:text-ink"
            aria-expanded="false"
            aria-controls={`${g.id}-menu`}
          >
            {g.label}
            <svg data-nav-chevron width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="transition-transform duration-200">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div
            id={`${g.id}-menu`}
            class="more-menu invisible absolute left-0 top-full mt-2 w-72 translate-y-1 rounded-[14px] bg-white p-1.5 opacity-0 shadow-[0_16px_40px_-16px_rgba(10,21,20,0.22),0_0_0_1px_var(--color-rail)] transition-all duration-200"
          >
            {g.links.map((l) => (
              <a
                href={l.href}
                data-nav-link
                class="flex flex-col gap-0.5 rounded-[6px] px-3 py-2.5 text-sm transition-colors hover:bg-pass-wash/60"
              >
                <span class="font-medium text-ink">{l.label}</span>
                <span class="text-xs text-ink-mute">{l.desc}</span>
              </a>
            ))}
          </div>
        </div>
      ))}

      <!-- Featured: Pricing -->
      <a
        href={featuredLink.href}
        data-nav-link
        class="nav-item ml-1 rounded-[6px] px-3 py-1.5 text-[13px] font-semibold text-ink-soft transition-colors hover:bg-pass-wash hover:text-ink"
      >
        {featuredLink.label}
      </a>

      <!-- Divider -->
      <span class="mx-2 h-5 w-px bg-rail" aria-hidden="true"></span>

      <!-- Right cluster -->
      <div class="flex items-center gap-2">
        <a
          href="https://github.com/Auriti-Labs/geo-optimizer-skill"
          target="_blank"
          rel="noopener"
          aria-label="GitHub repository"
          class="flex h-8 w-8 items-center justify-center rounded-[6px] text-ink-soft transition-colors hover:bg-pass-wash hover:text-ink"
        >
          <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
        </a>
        <a
          href="https://app.geoready.dev/login"
          class="hidden whitespace-nowrap rounded-[6px] px-3 lg:inline-block py-1.5 text-[13px] font-medium text-ink-soft transition-colors hover:bg-pass-wash hover:text-ink"
        >
          Log in
        </a>
        <a
          href="https://app.geoready.dev/signup"
          class="group flex items-center gap-1.5 whitespace-nowrap rounded-[10px] bg-pass-deep px-4 py-2 font-text text-[12.5px] font-semibold text-white transition-colors hover:bg-pass"
        >
          <span>Get started</span>
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Mobile burger — arc + wave morphing into X -->
    <button
      id="mobile-menu-btn"
      class="relative flex h-10 w-10 items-center justify-center rounded-[6px] text-ink transition-colors hover:bg-pass-wash md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Menu</span>
      <svg id="burger-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="transition-transform duration-300">
        <!-- Arc (top) — morphs to X stroke 1 -->
        <path id="burger-arc" d="M5 8 A 7 7 0 0 1 19 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" class="transition-all duration-300"/>
        <!-- Wave (middle) — fades out -->
        <path id="burger-wave" d="M4 13 C 7 10 9 16 12 13 C 15 10 17 16 20 13" stroke="#0D9488" stroke-width="2" stroke-linecap="round" fill="none" class="transition-all duration-300"/>
        <!-- Bottom line — morphs to X stroke 2 -->
        <line id="burger-base" x1="6" y1="18" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-all duration-300"/>
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile fullscreen overlay -->
<div
  id="mobile-menu"
  class="fixed inset-x-0 bottom-0 top-[60px] z-[60] hidden overflow-y-auto overscroll-contain bg-paper md:hidden"
  role="navigation"
  aria-label="Mobile navigation"
  aria-hidden="true"
>
    <div class="px-5 pb-10 pt-5">

      <!-- Pricing, promoted out of the groups -->
      <a
        href="/pricing/"
        data-mobile-link
        class="group mb-5 flex items-center justify-between gap-3 rounded-[10px] border border-rail bg-white px-4 py-3.5 transition-colors hover:border-pass/50"
      >
        <div class="min-w-0">
          <p class="text-[15px] font-semibold leading-tight text-ink">Pricing: plans from $0</p>
          <p class="mt-0.5 truncate text-[11px] text-ink-mute">Free audit · Pro · Agency</p>
        </div>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-pass-deep transition-transform group-hover:translate-x-0.5" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>

      {navGroups.map((g) => (
        <div>
          <p class="mb-1.5 mt-5 px-1 font-text font-medium text-[12px] text-ink-mute">{g.label}</p>
          <div class="mb-2 flex flex-col">
            {g.links.map((l) => (
              <a
                href={l.href}
                data-mobile-link
                class="flex flex-col gap-0.5 border-b border-rail px-1 py-3 transition-colors last:border-0 hover:bg-pass-wash/50"
              >
                <span class="text-[15px] font-medium text-ink">{l.label}</span>
                <span class="text-[11px] text-ink-mute">{l.desc}</span>
              </a>
            ))}
          </div>
        </div>
      ))}

      <!-- Bottom CTAs -->
      <div class="mt-7 flex flex-col gap-2.5 border-t border-rail pt-5">
        <a
          href="https://app.geoready.dev/signup"
          data-mobile-link
          class="w-full rounded-[10px] bg-pass-deep py-3 text-center font-text text-[13px] font-semibold text-white transition-colors hover:bg-pass"
        >
          Get started free
        </a>
        <a
          href="https://app.geoready.dev/login"
          data-mobile-link
          class="w-full rounded-[10px] border border-rail bg-white py-3 text-center font-text text-[13px] font-semibold text-ink transition-colors hover:bg-pass-wash"
        >
          Log in
        </a>
        <a
          href="https://github.com/Auriti-Labs/geo-optimizer-skill"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-2 py-2.5 text-xs text-ink-soft transition-colors hover:text-ink"
        >
          <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          View on GitHub
        </a>
      </div>
    </div>
</div>

<script>
  // ─── Bordo allo scroll: in cima la barra si fonde con la pagina ─────────────
  const siteNav = document.getElementById('site-nav');
  const onScroll = () => siteNav?.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // ─── Mobile fullscreen menu ─────────────────────────────────────────────────
  const burgerBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function setBurgerOpen(open: boolean) {
    const arc = document.getElementById('burger-arc') as SVGPathElement | null;
    const wave = document.getElementById('burger-wave') as SVGPathElement | null;
    const base = document.getElementById('burger-base') as SVGLineElement | null;
    if (!arc || !wave || !base) return;
    if (open) {
      // Morph arc → diagonal X line, wave fades, base → opposite diagonal
      arc.setAttribute('d', 'M6 6 L 18 18');
      wave.style.opacity = '0';
      base.setAttribute('x1', '18');
      base.setAttribute('y1', '6');
      base.setAttribute('x2', '6');
      base.setAttribute('y2', '18');
    } else {
      arc.setAttribute('d', 'M5 8 A 7 7 0 0 1 19 8');
      wave.style.opacity = '';
      base.setAttribute('x1', '6');
      base.setAttribute('y1', '18');
      base.setAttribute('x2', '18');
      base.setAttribute('y2', '18');
    }
  }

  function openMobile() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove('hidden');
    mobileMenu.setAttribute('aria-hidden', 'false');
    burgerBtn?.setAttribute('aria-expanded', 'true');
    setBurgerOpen(true);
    document.body.style.overflow = 'hidden';
    setPageInert(true);
  }

  // Con il menu mobile aperto la pagina sotto l'overlay non deve ricevere focus né lettura.
  function setPageInert(on: boolean) {
    document.querySelectorAll<HTMLElement>('main, footer').forEach((el) => { el.inert = on; });
  }

  function closeMobile() {
    if (!mobileMenu) return;
    mobileMenu.classList.add('hidden');
    mobileMenu.setAttribute('aria-hidden', 'true');
    burgerBtn?.setAttribute('aria-expanded', 'false');
    setBurgerOpen(false);
    document.body.style.overflow = '';
    setPageInert(false);
    // Solo se il burger è visibile: oltre md è nascosto e il focus finirebbe su body.
    if (mobileMenu.contains(document.activeElement) && burgerBtn?.offsetParent) burgerBtn.focus();
  }

  burgerBtn?.addEventListener('click', () => {
    const isOpen = burgerBtn.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMobile() : openMobile();
  });

  // Chiudi al tap su un link mobile
  document.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', closeMobile);
  });

  // Escape chiude
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && burgerBtn?.getAttribute('aria-expanded') === 'true') {
      closeMobile();
    }
  });

  // Chiudi se viewport cresce oltre md (768px)
  const mq = window.matchMedia('(min-width: 768px)');
  mq.addEventListener('change', (e) => {
    if (e.matches) closeMobile();
  });

  // ─── Desktop grouped dropdowns ───────────────────────────────────
  // The bar has two menus ("Tools", "Learn"), so opening one has to close the
  // other, and moving focus out of one has to close it too — otherwise it stays
  // open over the page while focus is already somewhere else.
  const navGroupEls = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-group]'));

  function setGroupOpen(group: HTMLElement, open: boolean) {
    const btn = group.querySelector<HTMLButtonElement>('button');
    const menu = group.querySelector<HTMLElement>('.more-menu');
    const chevron = group.querySelector<SVGElement>('[data-nav-chevron]');
    if (!btn || !menu) return;

    menu.classList.toggle('opacity-0', !open);
    menu.classList.toggle('invisible', !open);
    menu.classList.toggle('translate-y-1', !open);
    menu.classList.toggle('opacity-100', open);
    menu.classList.toggle('visible', open);
    menu.classList.toggle('translate-y-0', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    chevron?.style.setProperty('transform', open ? 'rotate(180deg)' : '');
  }

  function closeAllGroups(except?: HTMLElement) {
    navGroupEls.forEach((g) => {
      if (g !== except) setGroupOpen(g, false);
    });
  }

  navGroupEls.forEach((group) => {
    const btn = group.querySelector<HTMLButtonElement>('button');
    if (!btn) return;

    // Disclosure a click: il click arriva da mouse, Enter/Spazio, screen reader e comandi
    // vocali. L'apertura al passaggio del mouse è stata tolta: chiudeva il menu nel gap
    // sotto il bottone e non era attivabile dagli screen reader (WCAG 1.4.13, 4.1.2).
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      closeAllGroups(group);
      setGroupOpen(group, !isOpen);
    });

    group.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setGroupOpen(group, false);
        btn.focus();
      }
    });

    group.addEventListener('focusout', (e: FocusEvent) => {
      if (!group.contains(e.relatedTarget as Node)) setGroupOpen(group, false);
    });
  });

  // Escape chiude i menu anche quando il focus non è dentro il gruppo.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllGroups();
  });

  document.addEventListener('click', (e) => {
    const inside = navGroupEls.some((g) => g.contains(e.target as Node));
    if (!inside) closeAllGroups();
  });

  // ─── Active link highlight (current page) ───────────────────────────────────
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
  navLinks.forEach((link) => {
    const href = link.getAttribute('href')?.replace(/\/$/, '') || '/';
    if (href === currentPath) {
      link.classList.add('nav-link-active');
      link.setAttribute('aria-current', 'page');
    }
  });

  // The current page usually sits inside a dropdown, so mark its group button
  // too — otherwise nothing in the visible bar reflects where the user is.
  navGroupEls.forEach((group) => {
    if (group.querySelector('.nav-link-active')) {
      group.querySelector('button')?.classList.add('nav-link-active');
    }
  });
</script>

<style>
  /* Current page: ink text over a pass-wash chip — state, reported in green. */
  .nav-item.nav-link-active {
    color: var(--color-ink);
    background: var(--color-pass-wash);
  }
  #site-nav[data-scrolled] {
    border-bottom-color: var(--color-rail);
    box-shadow: 0 1px 2px rgba(10, 21, 20, 0.04);
  }
  .more-menu a.nav-link-active {
    background: var(--color-pass-wash);
  }
</style>
