---
import Layout from '../layouts/Layout.astro';
import SiteHeader from './home-v3/SiteHeader.astro';
import SiteFooter from './home-v3/SiteFooter.astro';
import CookieConsentManager from './cookie/CookieConsentManager';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  twitterImage?: string;
}

const { title, description, canonical, robots, ogImage, twitterImage } = Astro.props;
---

<Layout title={title} description={description} canonical={canonical} robots={robots} ogImage={ogImage} twitterImage={twitterImage}>
  <SiteHeader />
  <main id="main-content" class="site-main">
    <slot />
  </main>
  <SiteFooter />
  <CookieConsentManager client:only="react" />
</Layout>

<script>
  // Shell v3 condivisa con la home: barra sticky in flusso, tema, menu, newsletter, tracking CTA delegato.
  import '../scripts/site-v3/shell.js';

  if (document.querySelector('[data-reveal]')) {
    import('../lib/motion').then((m) => m.initReveals()).catch(() => {});
  }
</script>
