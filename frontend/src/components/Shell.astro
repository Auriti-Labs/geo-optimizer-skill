---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import CookieConsentManager from './cookie/CookieConsentManager';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  twitterImage?: string;
}

const { title, description, canonical, robots, ogImage, twitterImage } = Astro.props;
---

<Layout title={title} description={description} canonical={canonical} robots={robots} ogImage={ogImage} twitterImage={twitterImage}>
  <Navbar />
  <main id="main-content" class="flex-1 site-main">
    <slot />
  </main>
  <Footer />
  <CookieConsentManager client:only="react" />
</Layout>

<script>
  // Tracking CTA delegato — copre tutte le pagine statiche senza idratare React.
  // L'evento è silenzioso finché non c'è consenso analytics (gestito in track()).
  import { initCtaTracking } from '../lib/ctaTracking';
  initCtaTracking();

  if (document.querySelector('[data-reveal]')) {
    import('../lib/motion').then((m) => m.initReveals()).catch(() => {});
  }
</script>

<style is:global>
  /* Reserve space for the fixed navbar (59px bar + 1px rail border) */
  .site-main { padding-top: 60px; }
  /* Legacy opt-in from the glass-nav era: heroes that bled under the pill
     cancel the main padding and re-add it inside, so their band background
     still reaches the top edge behind the opaque bar. */
  .site-main > section:first-child[data-hero-bleed] {
    margin-top: -60px;
    padding-top: 60px;
  }
</style>
