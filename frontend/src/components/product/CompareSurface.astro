---
/**
 * CompareSurface — a stylized competitive readout in the console world: sites
 * ranked by GEO score as horizontal bars inside a flat white panel. The
 * visitor's row is drawn solid, competitor rows dashed (reference data). Two
 * modes:
 *   - 'leaderboard': several sites ranked, "you" highlighted
 *   - 'head': two sites head-to-head with larger bars
 */
interface Site { name: string; score: number; you?: boolean; }
interface Props {
  mode?: 'leaderboard' | 'head';
  sites?: Site[];
  variant?: 'dark' | 'light';
  class?: string;
}
// `variant` is kept for interface compatibility: the console world is
// daylight-only, so it no longer changes the rendering.
const {
  mode = 'leaderboard',
  variant: _variant = 'light',
  class: className = '',
  sites = mode === 'head'
    ? [ { name: 'yoursite.com', score: 64, you: true }, { name: 'competitor.com', score: 88 } ]
    : [
        { name: 'leader.com', score: 91 },
        { name: 'competitor.com', score: 83 },
        { name: 'yoursite.com', score: 64, you: true },
        { name: 'rival.io', score: 58 },
      ],
} = Astro.props;

const ranked = [...sites].sort((a, b) => b.score - a.score);
const isHead = mode === 'head';
---

<div class={`overflow-hidden rounded-[10px] border border-rail bg-white text-ink ${className}`}>
  <div class="flex items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
    <span class="font-text text-[12.5px] font-semibold text-ink-mute">{isHead ? 'Head to head · sample' : 'AI visibility leaderboard · sample'}</span>
    <span class="rounded-[6px] border border-rail px-1.5 py-0.5 font-text text-[12px] font-semibold text-ink-mute">GEO score</span>
  </div>

  <div class="px-4 py-4">
    <div class={isHead ? 'space-y-5' : 'space-y-3'}>
      {ranked.map((s, i) => (
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <span class="flex items-baseline gap-2">
              {!isHead && <span class="font-mono text-[12px] tabular-nums text-ink-mute">{i + 1}</span>}
              <span class={`text-sm ${s.you ? 'font-semibold text-ink' : 'text-ink-soft'}`}>{s.name}{s.you && ' · you'}</span>
            </span>
            <span class={`font-mono tabular-nums ${isHead ? 'text-lg font-semibold' : 'text-sm'} ${s.you ? 'text-ink' : 'text-ink-soft'}`}>{s.score}</span>
          </div>
          <div class={`mt-1.5 ${isHead ? 'h-3' : 'h-2.5'} rounded-[6px] ${s.you ? 'border border-ink/40 bg-paper' : 'border border-dashed border-ink-mute/60'}`} aria-hidden="true">
            <div class={`h-full ${s.you ? 'bg-ink/60' : 'bg-ink-mute/25'}`} style={`width:${s.score}%`}></div>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-4 text-xs leading-relaxed text-ink-mute">
      {isHead ? 'See exactly which signals the higher-scoring site has that you don’t.' : 'Same 100-point rubric for every domain — find the gap to close.'}
    </p>
  </div>
</div>
