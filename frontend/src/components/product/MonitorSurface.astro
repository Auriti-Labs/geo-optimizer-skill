---
/**
 * MonitorSurface — a stylized monitoring readout in the console world: a flat
 * white panel with a rail header strip, a score-trend sparkline drawn in ink
 * (measured data, not status), and alert rows where color reports state only.
 * No gradients, no glow, no dark atmosphere.
 */
interface Props {
  variant?: 'dark' | 'light';
  compact?: boolean;
  class?: string;
}
// `variant` is kept for interface compatibility: the console world is
// daylight-only, so it no longer changes the rendering.
const { variant: _variant = 'dark', compact = false, class: className = '' } = Astro.props;

// Sparkline points (weekly GEO score trending up, with one dip → alert)
const pts = [52, 55, 54, 61, 67, 64, 73, 79, 87];
const W = 260, H = 70;
const max = 100, min = 40;
const coords = pts.map((p, i) => {
  const x = (i / (pts.length - 1)) * W;
  const y = H - ((p - min) / (max - min)) * H;
  return [x, y];
});
const path = coords.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const [lx, ly] = coords[coords.length - 1];
---

<div class={`overflow-hidden rounded-[10px] border border-rail bg-raised text-ink ${className}`}>
  <div class="flex items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
    <span class="font-text text-[12.5px] font-semibold text-ink-mute">Score history · sample</span>
    <span class="rounded-[6px] border border-rail px-1.5 py-0.5 font-text text-[12px] font-semibold text-ink-mute">weekly</span>
  </div>

  <div class="px-4 py-4">
    <p class="flex items-baseline gap-2">
      <span class="font-mono text-3xl font-semibold tabular-nums text-ink">87</span>
      <span class="inline-flex items-center gap-1 font-mono text-[12px] tabular-nums text-pass-deep">
        <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 10V2" /><path d="M2.5 5.5 6 2l3.5 3.5" />
        </svg>
        +35 / 9 weeks
      </span>
    </p>

    {/* Sparkline — the visitor's measured trend, drawn solid in ink */}
    <svg viewBox={`0 0 ${W} ${H}`} class="mt-3 w-full" preserveAspectRatio="none" role="img" aria-label="GEO score trend rising over nine weeks">
      <path d={path} fill="none" class="stroke-ink" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx={lx} cy={ly} r="3" class="fill-ink" />
    </svg>

    {!compact && (
      <div class="mt-4 divide-y divide-rail border-t border-rail">
        <div class="flex items-center justify-between gap-3 py-2">
          <span class="flex items-center gap-2.5">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-warn" aria-hidden="true"></span>
            <span class="text-sm text-ink">Regression alert · schema removed</span>
          </span>
          <span class="font-mono text-[12px] tabular-nums text-ink-mute">wk 6</span>
        </div>
        <div class="flex items-center justify-between gap-3 py-2">
          <span class="flex items-center gap-2.5">
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-pass" aria-hidden="true"></span>
            <span class="text-sm text-ink">Recovered · llms.txt added</span>
          </span>
          <span class="font-mono text-[12px] tabular-nums text-ink-mute">wk 7</span>
        </div>
      </div>
    )}
  </div>
</div>
