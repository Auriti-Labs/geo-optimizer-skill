---
/**
 * ScoreSurface — a stylized GEO-score readout rendered in the console world:
 * a flat white panel with a rail header strip, the score as a mono figure over
 * a solid bar (the visitor's own data is drawn solid), and per-category rows
 * where color appears only as status. No shadows, no gradients, no ring chart.
 */
interface Row {
  label: string;
  delta: string;          // e.g. "+18", "-3"
  state: 'good' | 'up' | 'warn';
}

interface Props {
  score?: number;
  band?: string;
  rows?: Row[];
  variant?: 'dark' | 'light';
  glow?: boolean;
  class?: string;
}

const {
  score = 87,
  band = 'Excellent',
  rows = [
    { label: 'llms.txt', delta: '+6', state: 'good' },
    { label: 'Schema JSON-LD', delta: '+14', state: 'up' },
    { label: 'AI bot access', delta: '+11', state: 'good' },
    { label: 'Meta description', delta: '-3', state: 'warn' },
  ],
  // `variant` and `glow` are kept for interface compatibility: the console
  // world is daylight-only and flat, so they no longer change the rendering.
  variant: _variant = 'dark',
  glow: _glow = true,
  class: className = '',
} = Astro.props;

const pct = Math.max(0, Math.min(100, score));

const dot = {
  good: 'bg-pass',
  up: 'bg-pass',
  warn: 'bg-warn',
};
---

<div class={`overflow-hidden rounded-[10px] border border-rail bg-white text-ink ${className}`}>
  <div class="flex items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
    <span class="font-text text-[12.5px] font-semibold text-ink-mute">GEO score · sample</span>
    <span class="rounded-[6px] bg-pass-wash px-1.5 py-0.5 font-text text-[12px] font-semibold text-pass-deep">{band}</span>
  </div>

  <div class="px-4 py-4">
    <div class="flex items-baseline justify-between gap-3">
      <p class="flex items-baseline gap-1.5">
        <span class="font-mono text-4xl font-semibold tabular-nums text-ink">{score}</span>
        <span class="font-text font-medium text-[12.5px] text-ink-mute">/ 100</span>
      </p>
      <span class="font-text font-medium text-[12.5px] text-ink-mute">9 categories</span>
    </div>
    <div class="mt-2 h-2.5 rounded-[6px] border border-ink/40 bg-paper" aria-hidden="true">
      <div class="h-full bg-ink/60" style={`width:${pct}%`}></div>
    </div>

    <div class="mt-4 divide-y divide-rail border-t border-rail">
      {rows.map((row) => (
        <div class="flex items-center justify-between gap-3 py-2">
          <span class="flex items-center gap-2.5">
            <span class={`inline-block h-1.5 w-1.5 rounded-full ${dot[row.state]}`} aria-hidden="true"></span>
            <span class="text-sm text-ink">{row.label}</span>
          </span>
          <span class={`font-mono text-[12px] tabular-nums ${row.state === 'warn' ? 'text-warn' : 'text-pass-deep'}`}>{row.delta}</span>
        </div>
      ))}
    </div>
  </div>
</div>
