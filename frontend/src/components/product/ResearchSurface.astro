---
/**
 * ResearchSurface — a stylized chart of citation-uplift findings from the
 * research the scoring is grounded in (Princeton KDD 2024), rendered in the
 * console world: flat white panel, rail header strip, dashed bar tracks —
 * published reference data, not the visitor's own.
 */
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
// `variant` is kept for interface compatibility: the console world is
// daylight-only, so it no longer changes the rendering.
const { variant: _variant = 'light', class: className = '' } = Astro.props;

// Citation-visibility uplift by method (Princeton GEO, KDD 2024)
const methods = [
  { label: 'Cite Sources', uplift: 115 },
  { label: 'Quotations', uplift: 41 },
  { label: 'Statistics', uplift: 40 },
  { label: 'Fluency', uplift: 24 },
];
const max = 115;
---

<div class={`overflow-hidden rounded-[10px] border border-rail bg-raised text-ink ${className}`}>
  <div class="flex items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
    <span class="font-text text-[12.5px] font-semibold text-ink-mute">Citation uplift by method</span>
    <span class="rounded-[6px] border border-rail px-1.5 py-0.5 font-text text-[12px] font-semibold text-ink-mute">KDD 2024</span>
  </div>

  <div class="px-4 py-4">
    <div class="space-y-3">
      {methods.map((m) => (
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <span class="text-sm text-ink">{m.label}</span>
            <span class="font-mono text-[12px] tabular-nums text-pass-deep">+{m.uplift}%</span>
          </div>
          <div class="mt-1.5 h-2.5 rounded-[6px] border border-dashed border-ink-mute/60" aria-hidden="true">
            <div class="h-full bg-ink-mute/25" style={`width:${(m.uplift / max) * 100}%`}></div>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-4 text-xs leading-relaxed text-ink-mute">Measured visibility gain in AI-generated answers — the signals GEO Optimizer scores.</p>
    <p class="mt-2 font-text font-medium text-[12px] text-ink-mute">source: arXiv 2311.09735 · KDD 2024</p>
  </div>
</div>
