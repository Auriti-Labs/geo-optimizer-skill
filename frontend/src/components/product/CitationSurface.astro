---
/**
 * CitationSurface — a stylized AI-citation readout in the console world: flat
 * white panel, rail header strip, mono figures. Two modes:
 *   - 'verdict': brand mention + domain citation rates with a verdict chip
 *   - 'sov': share-of-voice — competitor rows drawn dashed (reference data),
 *     the visitor's row drawn solid, warn amber only where it reports state.
 */
interface Props {
  mode?: 'verdict' | 'sov';
  variant?: 'dark' | 'light';
  class?: string;
}
// `variant` is kept for interface compatibility: the console world is
// daylight-only, so it no longer changes the rendering.
const { mode = 'verdict', variant: _variant = 'light', class: className = '' } = Astro.props;

// Self-evident placeholder domains (same convention as CompareSurface): the
// figures are an illustrative sample readout, never claims about real brands.
const sov = [
  { name: 'competitor-a.com', cites: 4 },
  { name: 'competitor-b.com', cites: 3 },
  { name: 'yoursite.com', cites: 0, you: true },
];
const maxCites = 4;
---

<div class={`overflow-hidden rounded-[10px] border border-rail bg-raised text-ink ${className}`}>
  {mode === 'verdict' ? (
    <>
      <div class="flex items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
        <span class="font-text text-[12.5px] font-semibold text-ink-mute">AI citation check · sample</span>
        <span class="rounded-[6px] bg-warn-wash px-1.5 py-0.5 font-text text-[12px] font-semibold text-warn">Mentioned, not cited</span>
      </div>
      <div class="px-4 py-4">
        <div class="grid grid-cols-2 gap-4">
          <div class="border-l border-rail pl-3">
            <p class="font-text font-medium text-[12px] text-ink-mute">Brand mentioned</p>
            <p class="mt-1 font-mono text-2xl font-semibold tabular-nums text-ink">67%</p>
          </div>
          <div class="border-l border-rail pl-3">
            <p class="font-text font-medium text-[12px] text-ink-mute">Domain cited</p>
            <p class="mt-1 font-mono text-2xl font-semibold tabular-nums text-warn">0%</p>
          </div>
        </div>
        <div class="mt-4 border-t border-rail pt-3">
          <p class="text-xs text-ink-mute">Cited instead of you, for "GEO audit tools":</p>
          <p class="mt-1 font-mono text-xs text-ink-soft">competitor-a.com · competitor-b.com · competitor-c.com</p>
        </div>
      </div>
    </>
  ) : (
    <>
      <div class="flex items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
        <span class="font-text text-[12.5px] font-semibold text-ink-mute">Share of AI citations · sample</span>
        <span class="rounded-[6px] border border-rail px-1.5 py-0.5 font-text text-[12px] font-semibold text-ink-mute">Perplexity</span>
      </div>
      <div class="px-4 py-4">
        <div class="space-y-3">
          {sov.map((s) => (
            <div>
              <div class="flex items-baseline justify-between gap-3">
                <span class={`text-sm ${s.you ? 'font-semibold text-ink' : 'text-ink-soft'}`}>{s.name}{s.you && ' · you'}</span>
                <span class={`font-mono text-[12px] tabular-nums ${s.you ? 'text-warn' : 'text-ink-soft'}`}>{s.cites} citations</span>
              </div>
              <div class={`mt-1.5 h-2.5 rounded-[6px] ${s.you ? 'border border-ink/40 bg-paper' : 'border border-dashed border-ink-mute/60'}`} aria-hidden="true">
                {s.cites > 0 && (
                  <div class={`h-full ${s.you ? 'bg-ink/60' : 'bg-ink-mute/25'}`} style={`width:${(s.cites / maxCites) * 100}%`}></div>
                )}
              </div>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs leading-relaxed text-ink-mute">When customers ask AI about your category, these domains get cited — and you don’t.</p>
      </div>
    </>
  )}
</div>
