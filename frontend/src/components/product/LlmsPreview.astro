---
/**
 * LlmsPreview — a preview of a generated llms.txt file rendered as a console
 * artifact: flat white panel, rail header strip naming the file, mono body.
 * No dark ground — the well is reserved for first-party measured data.
 */
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
// `variant` is kept for interface compatibility: the console world is
// daylight-only, so it no longer changes the rendering.
const { variant: _variant = 'dark', class: className = '' } = Astro.props;

const lines = [
  { t: 'h1', s: '# Example Co' },
  { t: 'q', s: '> AI visibility tools and guides for modern teams.' },
  { t: 'gap', s: '' },
  { t: 'h2', s: '## Pages' },
  { t: 'li', s: '- [Home](https://example.com/)' },
  { t: 'li', s: '- [Pricing](https://example.com/pricing/)' },
  { t: 'gap', s: '' },
  { t: 'h2', s: '## Guides' },
  { t: 'li', s: '- [What is llms.txt](https://example.com/guides/llms-txt/)' },
  { t: 'li', s: '- [AI SEO basics](https://example.com/guides/ai-seo/)' },
];
---

<div class={`overflow-hidden rounded-[10px] border border-rail bg-raised text-ink ${className}`}>
  <div class="flex items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
    <span class="font-mono text-[11px] font-semibold text-ink">llms.txt</span>
    <span class="rounded-[6px] border border-rail px-1.5 py-0.5 font-text text-[12px] font-semibold text-ink-mute">generated</span>
  </div>
  <pre class="overflow-x-auto px-4 py-4 font-mono text-[13px] leading-relaxed text-ink-soft"><code>{lines.map((l) => (
      l.t === 'gap'
        ? <div>&nbsp;</div>
        : <div class={l.t === 'h1' || l.t === 'h2' ? 'font-semibold text-ink' : l.t === 'q' ? 'text-ink-mute' : ''}>{l.t === 'li' ? <><span class="text-ink-mute">- </span><span class="underline decoration-rail underline-offset-2">{l.s.replace(/^- /, '')}</span></> : l.s}</div>
    ))}</code></pre>
</div>
