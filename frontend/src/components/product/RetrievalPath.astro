---
/**
 * RetrievalPath — the Access → Meaning → Citation path as a console-world
 * diagram: flat white panel, mono stage indexes as near-square plates, signal
 * chips with 2px radii, and drawn SVG marks instead of glyphs. Pass green
 * appears only on verified-access checks (status).
 */
interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
// `variant` is kept for interface compatibility: the console world is
// daylight-only, so it no longer changes the rendering.
const { variant: _variant = 'light', class: className = '' } = Astro.props;

const stages = [
  { n: '01', title: 'Access', signals: [
    { label: 'GPTBot', ok: true },
    { label: 'ClaudeBot', ok: true },
    { label: 'SSR', ok: true },
  ] },
  { n: '02', title: 'Meaning', signals: [
    { label: 'llms.txt', ok: false },
    { label: 'JSON-LD', ok: false },
    { label: 'headings', ok: false },
  ] },
  { n: '03', title: 'Citation', signals: [
    { label: 'answer blocks', ok: false },
    { label: 'statistics', ok: false },
    { label: 'sources', ok: false },
  ] },
];
---

<div class={`rounded-[10px] border border-rail bg-raised p-4 text-ink ${className}`}>
  <div class="space-y-3">
    {stages.map((s, i) => (
      <>
        <div class="flex items-start gap-4">
          <span class="mt-0.5 inline-flex rounded-[6px] border border-rail px-1.5 py-0.5 font-mono text-[11px] font-medium tabular-nums text-ink-mute">{s.n}</span>
          <div class="flex-1">
            <h3 class="font-head text-base font-semibold tracking-[-0.01em] text-ink">{s.title}</h3>
            <div class="mt-2 flex flex-wrap gap-1.5">
              {s.signals.map((sig) => (
                <span class="inline-flex items-center gap-1 rounded-[6px] border border-rail px-2 py-0.5 font-mono text-[11px] text-ink-soft">
                  {sig.label}
                  {sig.ok && (
                    <svg class="h-2.5 w-2.5 text-pass-deep" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="verified">
                      <path d="M2.5 6.5 5 9l4.5-6" />
                    </svg>
                  )}
                </span>
              ))}
            </div>
          </div>
          <span class="mt-1 font-mono text-[12px] tabular-nums text-ink-mute">{['+34', '+40', '+26'][i]}</span>
        </div>
        {i < stages.length - 1 && (
          <div class="ml-[11px] flex items-center gap-2">
            <span class="h-6 w-px bg-rail" aria-hidden="true"></span>
            <span class="inline-flex items-center gap-1 font-text font-medium text-[12px] text-ink-mute">
              retrieves
              <svg class="h-2.5 w-2.5" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 2v8" /><path d="M2.5 6.5 6 10l3.5-3.5" />
              </svg>
            </span>
          </div>
        )}
      </>
    ))}
  </div>
</div>
