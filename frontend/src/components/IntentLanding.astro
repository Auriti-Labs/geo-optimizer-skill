---
import Shell from './Shell.astro';

type Cta = {
  href: string;
  label: string;
  dataCta: string;
  variant?: 'primary' | 'secondary';
};

type Stat = {
  value: string;
  label: string;
  detail: string;
};

type TableRow = {
  signal: string;
  freeCheck: string;
  paidLoop: string;
};

type Faq = {
  q: string;
  a: string;
};

type PaidStep = {
  heading: string;
  copy: string;
  proofPoints: string[];
  plan: {
    id: 'pro' | 'agency';
    name: 'Pro' | 'Agency';
    price: '$19' | '$89';
    period: 'monthly';
    href: string;
    cta: string;
    ctaLocation: string;
    intent: string;
  };
  secondary?: Cta;
};

interface Props {
  title: string;
  description: string;
  canonical: string;
  eyebrow: string;
  badge: string;
  h1: string;
  lede: string;
  dateModified: string;
  primaryCta: Cta;
  secondaryCta: Cta;
  stats: Stat[];
  tableHeading: string;
  tableIntro: string;
  tableRows: TableRow[];
  faqs: Faq[];
  paidStep?: PaidStep;
}

const {
  title,
  description,
  canonical,
  eyebrow,
  badge,
  h1,
  lede,
  dateModified,
  primaryCta,
  secondaryCta,
  stats,
  tableHeading,
  tableIntro,
  tableRows,
  faqs,
  paidStep,
} = Astro.props;

const offerCatalog = {
  '@type': 'OfferCatalog',
  name: 'GeoReady plans for AI visibility work',
  itemListElement: [
    {
      '@type': 'Offer',
      name: 'Free AI SEO audit',
      price: '0',
      priceCurrency: 'USD',
      url: canonical,
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: 'GeoReady Pro',
      price: '19',
      priceCurrency: 'USD',
      url: 'https://app.geoready.dev/signup?plan=pro',
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: 'GeoReady Agency',
      price: '89',
      priceCurrency: 'USD',
      url: 'https://app.geoready.dev/signup?plan=agency',
      availability: 'https://schema.org/InStock',
    },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    dateModified,
    mainEntity: { '@id': `${canonical}#service` },
    publisher: {
      '@type': 'Organization',
      name: 'GeoReady',
      url: 'https://geoready.dev/',
    },
    isPartOf: { '@id': 'https://geoready.dev/#website' },
  },
  {
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: h1,
    description,
    serviceType: eyebrow,
    areaServed: 'Worldwide',
    provider: {
      '@type': 'Organization',
      name: 'GeoReady',
      url: 'https://geoready.dev/',
    },
    hasOfferCatalog: offerCatalog,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'GeoReady', item: 'https://geoready.dev/' },
      { '@type': 'ListItem', position: 2, name: eyebrow, item: canonical },
    ],
  },
] };

// Prezzo dopo la fase founding, come in home e pricing.
const publicPrice = { '$19': '$29', '$89': '$199' } as const;

const primaryClass =
  'inline-flex min-h-11 items-center justify-center rounded-[9px] bg-pass-deep px-6 py-3 text-[14px] font-semibold text-on-accent transition-colors hover:bg-pass';
const secondaryClass =
  'inline-flex min-h-11 items-center justify-center rounded-[9px] bg-raised px-6 py-3 text-[14px] font-semibold text-ink shadow-[inset_0_0_0_1px_var(--color-rail)] transition-shadow hover:shadow-[inset_0_0_0_1px_var(--color-pass-deep)]';
// Varianti per la banda scura, come nella CTA finale della home.
const darkPrimaryClass =
  'inline-flex min-h-11 items-center justify-center rounded-[9px] bg-accent px-6 py-3 text-[14px] font-semibold text-on-accent transition-colors hover:bg-pass';
const darkSecondaryClass =
  'inline-flex min-h-11 items-center justify-center rounded-[9px] px-6 py-3 text-[14px] font-semibold text-ink shadow-[inset_0_0_0_1px_#2A3838] transition-shadow hover:shadow-[inset_0_0_0_1px_#2DD4BF]';
---

<Shell title={title} description={description} canonical={canonical}>
  <article class="bg-paper font-text text-ink">
    {/* Hero: stesso impianto della home v2, promessa a sinistra e strumento a destra */}
    <header class="border-b border-rail">
      <div class="mx-auto max-w-7xl px-5 pt-12 pb-16 sm:px-6 md:pt-16 lg:pb-20">
        <nav aria-label="Breadcrumb" class="eyebrow flex items-baseline gap-2">
          <a href="/" class="transition-colors hover:text-ink">GeoReady</a>
          <span aria-hidden="true">/</span>
          <span>{eyebrow}</span>
        </nav>
        <div class="mt-6 grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,500px)] lg:gap-14">
          <div class="min-w-0">
            <h1 class="max-w-[20ch] text-[2.3rem] leading-[1.05] tracking-[-0.03em] sm:text-[3rem] xl:text-[3.4rem]">
              {h1}
            </h1>

            <p class="mt-5 inline-flex items-center gap-1.5 text-[13px] text-ink-mute">
              <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-pass"></span>{badge}
            </p>

            <p class="mt-5 max-w-[60ch] text-[17px] leading-relaxed text-ink-soft">
              {lede}
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
              <a href={primaryCta.href} data-cta={primaryCta.dataCta} class={primaryClass}>
                {primaryCta.label}
              </a>
              <a href={secondaryCta.href} data-cta={secondaryCta.dataCta} class={secondaryClass}>
                {secondaryCta.label}
              </a>
            </div>

            <dl class="mt-10 grid gap-x-6 gap-y-5 border-t border-rail pt-6 sm:grid-cols-3">
              {stats.map((item) => (
                <div>
                  <dt class="eyebrow">{item.value}</dt>
                  <dd class="mt-1.5 text-[15px] font-semibold text-ink">{item.label}</dd>
                  <dd class="mt-1.5 text-[13px] leading-relaxed text-ink-soft">{item.detail}</dd>
                </div>
              ))}
            </dl>
          </div>

          <aside class="w-full min-w-0">
            <slot name="heroAside" />
          </aside>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-7xl space-y-16 px-5 py-16 sm:px-6 md:space-y-20 md:py-20 [&_h2]:text-[1.75rem] [&_h2]:font-semibold [&_h2]:leading-[1.12] [&_h2]:tracking-[-0.03em] [&_h2]:text-ink md:[&_h2]:text-[2.1rem] [&_h3]:text-base [&_h3]:font-semibold [&_h3]:text-ink [&_p]:leading-relaxed [&_p]:text-ink-soft [&_li]:leading-relaxed [&_li]:text-ink-soft [&>section]:max-w-none [&>section>p]:max-w-[70ch]">
      <slot />

      <section aria-labelledby="decision-table-heading" data-reveal>
        <div class="max-w-3xl">
          <div class="eyebrow">Free check · paid loop</div>
          <h2 id="decision-table-heading" class="mt-3">{tableHeading}</h2>
          <p class="mt-4">{tableIntro}</p>
        </div>

        <div class="panel mt-8 overflow-x-auto">
          <table class="min-w-full border-collapse text-left text-sm">
            <thead>
              <tr>
                <th scope="col" class="eyebrow border-b border-rail px-5 py-3.5 font-medium">Signal or question</th>
                <th scope="col" class="eyebrow border-b border-rail px-5 py-3.5 font-medium">What the free check gives you</th>
                <th scope="col" class="eyebrow border-b border-rail px-5 py-3.5 font-medium">When paid monitoring matters</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-rail">
              {tableRows.map((row) => (
                <tr>
                  <th scope="row" class="px-5 py-4 align-top text-sm font-semibold text-ink">{row.signal}</th>
                  <td class="px-5 py-4 align-top text-ink-soft">{row.freeCheck}</td>
                  <td class="px-5 py-4 align-top text-ink-soft">{row.paidLoop}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {paidStep && (
        <section aria-labelledby="paid-path-heading" class="panel overflow-hidden" data-reveal>
          <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(300px,0.42fr)]">
            <div class="p-6 md:p-10">
              <div class="eyebrow">From one audit to monitoring</div>
              <h2 id="paid-path-heading" class="mt-3">{paidStep.heading}</h2>
              <p class="mt-4">{paidStep.copy}</p>
              <ul class="mt-6 grid gap-3 md:grid-cols-3" role="list">
                {paidStep.proofPoints.map((point) => (
                  <li class="flex gap-2 text-sm">
                    <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-pass"></span>{point}
                  </li>
                ))}
              </ul>
            </div>
            <aside class="band-dark p-6 md:p-10">
              <div class="eyebrow">Recommended plan</div>
              <span class="mt-3 block text-2xl font-semibold tracking-[-0.02em] text-ink">{paidStep.plan.name}</span>
              <p class="mt-1 text-sm text-ink-soft">
                <span class="font-mono text-ink tabular-nums">{paidStep.plan.price}</span>/mo founding, then <span class="font-mono tabular-nums">{publicPrice[paidStep.plan.price]}</span>
              </p>
              <p class="mt-4 text-sm leading-relaxed text-ink-soft">
                The free check stays useful. The paid plan adds the recurring proof that a one-time result cannot give.
              </p>
              <div class="mt-6 flex flex-col gap-3">
                <a
                  href={paidStep.plan.href}
                  data-plan-id={paidStep.plan.id}
                  data-plan-name={paidStep.plan.name}
                  data-plan-price={paidStep.plan.price}
                  data-plan-period={paidStep.plan.period}
                  data-plan-currency="USD"
                  data-cta-location={paidStep.plan.ctaLocation}
                  class={darkPrimaryClass}
                >
                  {paidStep.plan.cta}
                </a>
                {paidStep.secondary && (
                  <a href={paidStep.secondary.href} data-cta={paidStep.secondary.dataCta} class={darkSecondaryClass}>
                    {paidStep.secondary.label}
                  </a>
                )}
              </div>
            </aside>
          </div>
        </section>
      )}

      <section aria-labelledby="intent-faq-heading" data-reveal>
        <div class="eyebrow">FAQ</div>
        <h2 id="intent-faq-heading" class="mt-3">Frequently asked questions</h2>
        <div class="panel mt-8 overflow-hidden">
          {/* gap-px su fondo rail = filetti tra le celle; l'ultima dispari occupa tutta la riga */}
          <div class="grid gap-px bg-rail md:grid-cols-2 md:[&>section:last-child:nth-child(odd)]:col-span-2">
            {faqs.map((item) => (
              <section class="bg-raised p-6">
                <h3>{item.q}</h3>
                <p class="mt-2 text-sm">{item.a}</p>
              </section>
            ))}
          </div>
        </div>
      </section>
    </div>

    {/* Chiusura: la stessa banda scura della home */}
    <section class="band-dark" aria-labelledby="intent-next-heading">
      <div class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-16 sm:px-6 md:py-20 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <div class="eyebrow">Next step</div>
          <h2 id="intent-next-heading" class="mt-3 text-3xl tracking-[-0.03em] md:text-[2.75rem] md:leading-[1.08]">Turn the search intent into a measurable audit.</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">
            Start with a free page-level check. If the score exposes a technical or citation gap, move the same domain into monitoring instead of repeating manual checks.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={primaryCta.href} data-cta={`${primaryCta.dataCta}_footer`} class={darkPrimaryClass}>{primaryCta.label}</a>
          <a href="/pricing/" data-cta="intent_landing_footer_pricing" class={darkSecondaryClass}>Compare plans</a>
        </div>
      </div>
    </section>
  </article>
</Shell>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
