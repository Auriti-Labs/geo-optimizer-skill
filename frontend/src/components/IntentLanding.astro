---
import Shell from './Shell.astro';

type Cta = {
  href: string;
  label: string;
  dataCta: string;
  variant?: 'primary' | 'secondary';
};

type Stat = {
  value: string;
  label: string;
  detail: string;
};

type TableRow = {
  signal: string;
  freeCheck: string;
  paidLoop: string;
};

type Faq = {
  q: string;
  a: string;
};

type PaidStep = {
  heading: string;
  copy: string;
  proofPoints: string[];
  plan: {
    id: 'pro' | 'studio' | 'agency';
    name: 'Pro' | 'Studio' | 'Agency';
    price: '$19' | '$49' | '$89';
    period: 'monthly';
    href: string;
    cta: string;
    ctaLocation: string;
    intent: string;
  };
  secondary?: Cta;
};

interface Props {
  title: string;
  description: string;
  canonical: string;
  eyebrow: string;
  badge: string;
  h1: string;
  lede: string;
  dateModified: string;
  primaryCta: Cta;
  secondaryCta: Cta;
  stats: Stat[];
  tableHeading: string;
  tableIntro: string;
  tableRows: TableRow[];
  faqs: Faq[];
  paidStep?: PaidStep;
}

const {
  title,
  description,
  canonical,
  eyebrow,
  badge,
  h1,
  lede,
  dateModified,
  primaryCta,
  secondaryCta,
  stats,
  tableHeading,
  tableIntro,
  tableRows,
  faqs,
  paidStep,
} = Astro.props;

const offerCatalog = {
  '@type': 'OfferCatalog',
  name: 'GeoReady plans for AI visibility work',
  itemListElement: [
    {
      '@type': 'Offer',
      name: 'Free AI SEO audit',
      price: '0',
      priceCurrency: 'USD',
      url: canonical,
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: 'GeoReady Pro',
      price: '19',
      priceCurrency: 'USD',
      url: 'https://app.geoready.dev/signup?plan=pro',
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: 'GeoReady Studio',
      price: '49',
      priceCurrency: 'USD',
      url: 'https://app.geoready.dev/signup?plan=studio',
      availability: 'https://schema.org/InStock',
    },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    dateModified,
    mainEntity: { '@id': `${canonical}#service` },
    publisher: {
      '@type': 'Organization',
      name: 'GeoReady',
      url: 'https://geoready.dev/',
    },
    isPartOf: { '@id': 'https://geoready.dev/#website' },
  },
  {
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: h1,
    description,
    serviceType: eyebrow,
    areaServed: 'Worldwide',
    provider: {
      '@type': 'Organization',
      name: 'GeoReady',
      url: 'https://geoready.dev/',
    },
    hasOfferCatalog: offerCatalog,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'GeoReady', item: 'https://geoready.dev/' },
      { '@type': 'ListItem', position: 2, name: eyebrow, item: canonical },
    ],
  },
] };

const primaryClass =
  'inline-flex min-h-11 items-center justify-center rounded-[--radius-md] bg-accent-teal px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-teal-dark';
const secondaryClass =
  'inline-flex min-h-11 items-center justify-center rounded-[--radius-md] border border-border bg-bg-surface px-5 py-3 text-sm font-semibold text-text-primary transition-colors hover:border-accent-teal';
---

<Shell title={title} description={description} canonical={canonical}>
  <article class="px-4 sm:px-6 py-10 md:py-16">
    <header class="mx-auto max-w-7xl overflow-hidden rounded-[--radius-xl] border border-border bg-bg-surface">
      <div class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(380px,0.72fr)]">
        <div class="p-6 md:p-10 lg:p-12">
          <div class="flex items-center gap-2 text-[10px] font-mono uppercase tracking-[0.16em] text-text-muted">
            <a href="/" class="hover:text-accent-teal">GeoReady</a>
            <span class="h-1 w-1 rounded-full bg-text-muted" aria-hidden="true"></span>
            <span>{eyebrow}</span>
          </div>

          <p class="mt-5 inline-flex items-center gap-2 rounded-full border border-accent-teal/30 bg-accent-teal/5 px-3 py-1 text-xs font-mono text-accent-teal">
            <span class="h-1.5 w-1.5 rounded-full bg-accent-teal" aria-hidden="true"></span>
            {badge}
          </p>

          <h1 class="mt-4 max-w-4xl font-display text-4xl font-bold leading-tight tracking-tight text-text-primary md:text-5xl">
            {h1}
          </h1>

          <p class="mt-5 max-w-3xl text-base leading-relaxed text-text-secondary md:text-lg">
            {lede}
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={primaryCta.href} data-cta={primaryCta.dataCta} class={primaryClass}>
              {primaryCta.label}
            </a>
            <a href={secondaryCta.href} data-cta={secondaryCta.dataCta} class={secondaryClass}>
              {secondaryCta.label}
            </a>
          </div>

          <dl class="mt-8 grid gap-3 sm:grid-cols-3">
            {stats.map((item) => (
              <div class="border-l border-accent-teal/30 pl-4">
                <dt class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent-teal">{item.value}</dt>
                <dd class="mt-1 text-sm font-semibold text-text-primary">{item.label}</dd>
                <dd class="mt-1 text-sm leading-relaxed text-text-secondary">{item.detail}</dd>
              </div>
            ))}
          </dl>
        </div>

        <aside class="flex items-center border-t border-border bg-bg-subtle p-6 lg:border-l lg:border-t-0">
          <slot name="heroAside" />
        </aside>
      </div>
    </header>

    <div class="mx-auto mt-14 max-w-7xl space-y-14 md:mt-16 md:space-y-16 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:leading-tight [&_h2]:tracking-tight [&_h2]:text-text-primary [&_h3]:font-display [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-text-primary [&_p]:leading-relaxed [&_p]:text-text-secondary [&_li]:leading-relaxed [&_li]:text-text-secondary">
      <slot />

      <section aria-labelledby="decision-table-heading">
        <div class="max-w-3xl">
          <h2 id="decision-table-heading">{tableHeading}</h2>
          <p class="mt-4">{tableIntro}</p>
        </div>

        <div class="mt-6 overflow-x-auto rounded-[--radius-lg] border border-border bg-bg-surface">
          <table class="min-w-full border-collapse text-left text-sm">
            <thead class="bg-bg-subtle text-text-primary">
              <tr>
                <th scope="col" class="border-b border-border px-4 py-3 font-semibold">Signal or question</th>
                <th scope="col" class="border-b border-border px-4 py-3 font-semibold">What the free check gives you</th>
                <th scope="col" class="border-b border-border px-4 py-3 font-semibold">When paid monitoring matters</th>
              </tr>
            </thead>
            <tbody>
              {tableRows.map((row) => (
                <tr>
                  <th scope="row" class="border-b border-border px-4 py-3 font-semibold text-text-primary">{row.signal}</th>
                  <td class="border-b border-border px-4 py-3 text-text-secondary">{row.freeCheck}</td>
                  <td class="border-b border-border px-4 py-3 text-text-secondary">{row.paidLoop}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {paidStep && (
        <section aria-labelledby="paid-path-heading" class="overflow-hidden rounded-[--radius-lg] border border-border bg-bg-surface">
          <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(300px,0.42fr)]">
            <div class="p-6 md:p-8">
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent-teal">Free check to paid loop</p>
              <h2 id="paid-path-heading" class="mt-2">{paidStep.heading}</h2>
              <p class="mt-4">{paidStep.copy}</p>
              <ul class="mt-5 grid gap-3 md:grid-cols-3" role="list">
                {paidStep.proofPoints.map((point) => (
                  <li class="border-l border-accent-teal/30 pl-3 text-sm">{point}</li>
                ))}
              </ul>
            </div>
            <aside class="border-t border-border bg-bg-subtle p-6 md:p-8 lg:border-l lg:border-t-0">
              <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-text-muted">Recommended plan</p>
              <p class="mt-2 font-display text-2xl font-bold text-text-primary">{paidStep.plan.name}</p>
              <p class="mt-1 text-sm text-text-secondary">
                <span class="font-mono text-text-primary">{paidStep.plan.price}</span> / month
              </p>
              <p class="mt-4 text-sm leading-relaxed text-text-secondary">
                The free check stays useful. The paid plan adds the recurring proof that a one-time result cannot give.
              </p>
              <div class="mt-5 flex flex-col gap-3">
                <a
                  href={paidStep.plan.href}
                  data-plan-id={paidStep.plan.id}
                  data-plan-name={paidStep.plan.name}
                  data-plan-price={paidStep.plan.price}
                  data-plan-period={paidStep.plan.period}
                  data-plan-currency="USD"
                  data-cta-location={paidStep.plan.ctaLocation}
                  class={primaryClass}
                >
                  {paidStep.plan.cta}
                </a>
                {paidStep.secondary && (
                  <a href={paidStep.secondary.href} data-cta={paidStep.secondary.dataCta} class={secondaryClass}>
                    {paidStep.secondary.label}
                  </a>
                )}
              </div>
            </aside>
          </div>
        </section>
      )}

      <section aria-labelledby="intent-faq-heading">
        <h2 id="intent-faq-heading">Frequently asked questions</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {faqs.map((item) => (
            <section class="rounded-[--radius-lg] border border-border bg-bg-surface p-5">
              <h3>{item.q}</h3>
              <p class="mt-2 text-sm">{item.a}</p>
            </section>
          ))}
        </div>
      </section>

      <section class="rounded-[--radius-lg] border border-accent-teal/25 bg-accent-teal/5 p-6 md:p-8" aria-label="Next step">
        <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
          <div class="max-w-2xl">
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-accent-teal">Next step</p>
            <h2 class="mt-2">Turn the search intent into a measurable audit.</h2>
            <p class="mt-3 text-sm">
              Start with a free page-level check. If the score exposes a technical or citation gap, move the same domain into monitoring instead of repeating manual checks.
            </p>
          </div>
          <div class="flex flex-col gap-3 sm:flex-row">
            <a href={primaryCta.href} data-cta={`${primaryCta.dataCta}_footer`} class={primaryClass}>{primaryCta.label}</a>
            <a href="/pricing/" data-cta="intent_landing_footer_pricing" class={secondaryClass}>Compare plans</a>
          </div>
        </div>
      </section>
    </div>
  </article>
</Shell>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
