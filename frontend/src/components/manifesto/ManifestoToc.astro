---
import type { ManifestoSection } from '../../lib/manifestoContent';

interface Props {
  sections: ManifestoSection[];
}

const { sections } = Astro.props;
---

<nav
  class="sticky top-24 hidden w-64 shrink-0 self-start lg:block"
  aria-label="Manifesto contents"
>
  <div class="border-l border-rail pl-5">
    <p class="mb-4 font-text text-[12.5px] font-semibold text-ink-mute">
      Contents
    </p>
    <ol class="space-y-2.5">
      {sections.map((s) => (
        <li>
          <a
            href={`#${s.id}`}
            class="group flex items-baseline gap-2.5 text-sm text-ink"
          >
            <span class="shrink-0 font-mono text-[11px] tabular-nums text-ink-mute">
              {s.number}
            </span>
            <span class="leading-snug underline decoration-rail underline-offset-4 transition-colors group-hover:decoration-pass-deep">
              {s.title}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>

<!-- Mobile TOC: visibile solo su schermi piccoli -->
<nav class="mb-10 border-y border-rail py-5 lg:hidden" aria-label="Manifesto contents">
  <p class="mb-4 font-text text-[12.5px] font-semibold text-ink-mute">
    Contents
  </p>
  <ol class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
    {sections.map((s) => (
      <li>
        <a
          href={`#${s.id}`}
          class="group flex items-baseline gap-2.5 text-sm text-ink"
        >
          <span class="shrink-0 font-mono text-[11px] tabular-nums text-ink-mute">
            {s.number}
          </span>
          <span class="leading-snug underline decoration-rail underline-offset-4 transition-colors group-hover:decoration-pass-deep">{s.title}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
