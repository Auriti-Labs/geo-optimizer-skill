---
import type { ManifestoSection } from '../../lib/manifestoContent';

interface Props {
  section: ManifestoSection;
}

const { section } = Astro.props;
const hasItems = section.items && section.items.length > 0;
const isGrid = hasItems && (section.items?.length || 0) >= 4;
---

<section id={section.id} class="scroll-mt-24">
  <header class="mb-6">
    <h2 class="font-head text-2xl font-semibold leading-tight tracking-[-0.02em] md:text-3xl">
      <span class="mr-3 align-middle font-mono text-[13px] font-medium tabular-nums text-ink-mute">{section.number}</span>{section.title}
    </h2>
    {section.intro && (
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-ink-soft">
        {section.intro}
      </p>
    )}
  </header>

  {section.paragraphs && (
    <div class="max-w-2xl space-y-4">
      {section.paragraphs.map((p) => (
        <p class="text-base leading-relaxed text-ink-soft">{p}</p>
      ))}
    </div>
  )}

  {section.quote && (
    <blockquote class="mt-6 max-w-2xl border-l-2 border-pass-deep pl-5" cite="https://geoready.dev/manifesto">
      <p class="text-base font-medium italic leading-relaxed text-ink">
        «{section.quote}»
      </p>
    </blockquote>
  )}

  {section.references && section.references.length > 0 && (
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      {section.references.map((ref) => (
        <a
          href={ref.href}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-medium text-pass-deep underline decoration-rail underline-offset-4 transition-colors hover:decoration-pass-deep"
        >
          <span>{ref.label}</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      ))}
    </div>
  )}

  {hasItems && (
    <div class={`mt-6 gap-px overflow-hidden rounded-[10px] border border-rail bg-rail ${isGrid ? 'grid grid-cols-1 sm:grid-cols-2' : 'grid grid-cols-1'}`}>
      {section.items?.map((item) => (
        <div class="bg-white p-4">
          <h3 class="text-sm font-semibold text-ink">
            {item.title}
          </h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">
            {item.description}
          </p>
          {item.points && (
            <ul class="mt-2 space-y-1">
              {item.points.map((pt) => (
                <li class="font-mono text-[11px] tabular-nums text-ink-mute">{pt}</li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  )}
</section>
