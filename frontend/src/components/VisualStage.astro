---
import MarketingVisual from './MarketingVisual.astro';

interface VisualAsset {
  webp: string;
  webpSrcSet?: string;
  png: string;
  pngSrcSet?: string;
  alt: string;
  caption?: string;
  width: number;
  height: number;
}

interface Metric {
  label: string;
  value: string;
}

interface Props {
  visual: VisualAsset;
  label: string;
  caption?: string;
  eyebrow?: string;
  metrics?: Metric[];
  chips?: string[];
  variant?: 'dark' | 'light' | 'paper';
  sizes?: string;
  imgClass?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  priority?: boolean;
}

// Mondo console: ogni variante rende lo stesso pannello bianco su rail —
// il materiale scuro (well) è riservato ai dati misurati, una volta per pagina.
// `variant` resta nell'interfaccia per compatibilità con i chiamanti esistenti.
const {
  visual,
  label,
  caption = visual.caption,
  eyebrow,
  metrics = [],
  chips = [],
  sizes = '100vw',
  imgClass = '',
  class: className = '',
  loading = 'lazy',
  priority = false,
} = Astro.props;
---

<figure class={`overflow-hidden rounded-[10px] border border-rail bg-white ${className}`}>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rail px-4 py-2.5">
    <span class="font-text text-[12.5px] font-semibold text-ink-mute">{label}</span>
    {eyebrow && (
      <span class="rounded-[6px] border border-rail px-1.5 py-0.5 font-text font-medium text-[12px] text-ink-mute">
        {eyebrow}
      </span>
    )}
  </div>

  <MarketingVisual
    webp={visual.webp}
    webpSrcSet={visual.webpSrcSet}
    png={visual.png}
    pngSrcSet={visual.pngSrcSet}
    alt={visual.alt}
    width={visual.width}
    height={visual.height}
    sizes={sizes}
    loading={loading}
    priority={priority}
    imgClass={imgClass}
  />

  {metrics.length > 0 && (
    <div class="grid gap-px border-t border-rail bg-rail sm:grid-cols-3">
      {metrics.map((metric) => (
        <div class="bg-paper px-4 py-2.5">
          <p class="font-text font-medium text-[12px] text-ink-mute">{metric.label}</p>
          <p class="mt-0.5 text-sm font-semibold text-ink">{metric.value}</p>
        </div>
      ))}
    </div>
  )}

  {(caption || chips.length > 0) && (
    <figcaption class="flex flex-col gap-3 border-t border-rail px-4 py-3 sm:flex-row sm:items-start sm:justify-between">
      {caption && (
        <p class="max-w-2xl text-xs leading-relaxed text-ink-mute">{caption}</p>
      )}
      {chips.length > 0 && (
        <div class="flex flex-wrap gap-2 sm:justify-end">
          {chips.map((chip) => (
            <span class="rounded-[6px] border border-rail px-1.5 py-0.5 font-text font-medium text-[12px] text-ink-mute">
              {chip}
            </span>
          ))}
        </div>
      )}
    </figcaption>
  )}
</figure>
