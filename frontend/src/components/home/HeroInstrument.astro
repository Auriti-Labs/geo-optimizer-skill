---
// Lo strumento dell'hero: un audit di esempio reso con la stessa mappa a 100 punti
// della dashboard (shell.css .map/.seg/.cells). L'HTML contiene già lo stato finale,
// quindi crawler, utenti senza JS e reduced-motion vedono il risultato completo; lo
// script lo riavvolge e lo riproduce una volta. Il dominio usa il TLD riservato
// .example (RFC 2606): un esempio dichiarato, non un cliente inventato.
// I massimi sono quelli della rubrica v2 (CATEGORY_MAX_V2), la somma fa 100.
const DOMAIN = 'acme-studio.example';
const SEGMENTS = [
  { key: 'google_ai', label: 'Google AI', max: 20, got: 15 },
  { key: 'robots', label: 'Robots', max: 14, got: 6 },
  { key: 'schema', label: 'Schema', max: 14, got: 9 },
  { key: 'content', label: 'Content', max: 14, got: 11 },
  { key: 'brand_entity', label: 'Brand', max: 12, got: 7 },
  { key: 'meta', label: 'Meta', max: 11, got: 9 },
  { key: 'llms', label: 'llms.txt', max: 6, got: 0 },
  { key: 'signals', label: 'Signals', max: 6, got: 4 },
  { key: 'ai_discovery', label: 'Discovery', max: 3, got: 0 },
];
const SCORE = SEGMENTS.reduce((s, x) => s + x.got, 0); // 61 → banda foundation (36-67)
const FINDINGS = [
  { tone: 'fail', label: 'fail', text: 'robots.txt disallows GPTBot and ClaudeBot', pts: '−8' },
  { tone: 'warn', label: 'warn', text: 'No llms.txt at the site root', pts: '−6' },
  { tone: 'pass', label: 'pass', text: 'Organization and WebSite JSON-LD are valid', pts: '+9' },
];
const STEPS = ['robots.txt', '27 AI bots', 'JSON-LD', 'llms.txt', 'score'];
---

<figure class="ins panel" data-instrument aria-label={`Sample audit of ${DOMAIN}: score ${SCORE} out of 100, foundation band`}>
  <div class="ins-bar">
    <span class="eyebrow">Sample audit</span>
    <button type="button" class="ins-replay" data-replay aria-label="Replay the sample audit" hidden>
      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9" /><path d="M2.5 2.5v2.6h2.6" /></svg>
      Replay
    </button>
  </div>

  <div class="ins-url">
    <span class="ins-cmd" aria-hidden="true">$ geo audit</span>
    <span class="ins-domain" data-domain>{DOMAIN}</span><span class="ins-caret" aria-hidden="true"></span>
  </div>

  <ol class="ins-steps" aria-label="Checks run">
    {STEPS.map((s) => <li data-step>{s}</li>)}
  </ol>

  <div class="ins-head">
    <div>
      <p class="ins-score"><span data-score>{SCORE}</span><small>/100</small></p>
    </div>
    <p class="ins-band" data-band><span class="pill pill-foundation">Foundation</span><span class="ins-band-r">36–67</span></p>
  </div>

  <div class="ins-map" aria-hidden="true">
    {SEGMENTS.map((s) => (
      <div class="seg" data-seg>
        <p class="seg-l">{s.label}</p>
        <div class="cells" style={`grid-template-columns:repeat(${s.max},1fr);width:${(s.max / 20) * 100}%`}>
          {Array.from({ length: s.max }, (_, i) => <i class={i < s.got ? 'got' : undefined} />)}
        </div>
        <span class="seg-n">{s.got}/{s.max}</span>
      </div>
    ))}
  </div>

  <ul class="ins-find">
    {FINDINGS.map((f) => (
      <li data-finding>
        <span class={`tag tag-${f.tone}`}>{f.label}</span>
        <span class="ins-find-t">{f.text}</span>
        <span class="ins-find-p">{f.pts}</span>
      </li>
    ))}
  </ul>

  <figcaption class="ins-foot" data-foot>
    Fix the first two findings: <b>+14 pts</b>, from {SCORE} to {SCORE + 14} (good band).
  </figcaption>
</figure>
<script is:inline>
  // Sincrono, prima del primo paint: nasconde le parti animate così lo stato finale non
  // lampeggia prima del replay. Se lo script del modulo non parte entro 1,5 s, si torna allo
  // stato finale statico.
  (function () {
    var r = document.currentScript.previousElementSibling;
    if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
    r.classList.add('is-pending');
    setTimeout(function () { if (!r.dataset.played) r.classList.remove('is-pending'); }, 1500);
  })();
</script>

<style>
  .ins {
    --empty: #1C2727;
    --earned: #E8F0EF;
    position: relative;
    padding: 18px 20px 16px;
    background: #111616;
    box-shadow: 0 0 0 1px #1F2929, 0 24px 60px -24px rgba(0, 0, 0, 0.55);
    color: #E8F0EF;
    font-size: 13px;
  }
  .ins-bar { display: flex; align-items: center; justify-content: space-between; min-height: 24px; }
  .ins .eyebrow { color: #7C8C8B; }
  .ins-replay {
    display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 9px;
    border-radius: 7px; color: #9DADAB; font-size: 12px; font-weight: 500;
    box-shadow: inset 0 0 0 1px #1F2929; transition: color .2s, box-shadow .2s;
  }
  .ins-replay:hover { color: #E8F0EF; box-shadow: inset 0 0 0 1px #2DD4BF66; }

  .ins-url {
    display: flex; align-items: center; gap: 10px; height: 40px; margin-top: 12px; padding: 0 12px;
    border-radius: 9px; background: #090C0C; box-shadow: inset 0 0 0 1px #1F2929;
    font-family: var(--font-mono); font-size: 13.5px;
  }
  .ins-cmd { color: #2DD4BF; }
  .ins-domain { color: #E8F0EF; white-space: nowrap; }
  .ins-caret { width: 7px; height: 16px; margin-left: -8px; background: #2DD4BF; opacity: 0; }

  .ins-steps { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .ins-steps li {
    padding: 2px 8px; border-radius: 6px; background: #172020; color: #9DADAB;
    font-family: var(--font-mono); font-size: 11.5px;
  }
  .ins-steps li::before { content: '✓ ' / ''; color: #2DD4BF; }

  .ins-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-top: 18px; }
  .ins-score { font: 500 80px/0.85 var(--font-mono); letter-spacing: -0.06em; font-variant-numeric: tabular-nums; }
  .ins-score small { margin-left: 4px; font-size: 18px; letter-spacing: -0.02em; color: #7C8C8B; }
  .ins-band { display: flex; align-items: center; gap: 8px; padding-bottom: 4px; }
  .ins-band-r { font-family: var(--font-mono); font-size: 12px; color: #7C8C8B; }
  .pill { display: inline-flex; align-items: center; height: 22px; padding: 0 9px; border-radius: 999px; font-size: 12px; font-weight: 600; }
  .pill-foundation { background: rgba(245, 181, 68, 0.14); color: #F5B544; }

  /* Vista impilata della dashboard: una riga per categoria, celle di larghezza fissa
     (la riga da 20 punti occupa tutta la colonna), quindi le barre sono confrontabili. */
  .ins-map { display: grid; gap: 6px; margin-top: 18px; }
  .seg { display: grid; grid-template-columns: 76px minmax(0, 1fr) 40px; align-items: center; gap: 10px; }
  .seg-l { font-size: 11.5px; color: #9DADAB; white-space: nowrap; }
  .seg-n { text-align: right; font-family: var(--font-mono); font-size: 11px; color: #7C8C8B; font-variant-numeric: tabular-nums; }
  .cells { display: grid; gap: 2px; }
  .cells i { height: 12px; border-radius: 2px; background: var(--empty); }
  .cells i.got { background: var(--earned); }

  .ins-find { margin-top: 16px; border-top: 1px solid #1F2929; }
  .ins-find li { display: flex; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid #1F2929; }
  .ins-find-t { flex: 1; min-width: 0; color: #E8F0EF; }
  .ins-find-p { font-family: var(--font-mono); font-size: 12.5px; color: #9DADAB; font-variant-numeric: tabular-nums; }
  .tag { width: 40px; flex: none; text-align: center; padding: 1px 0; border-radius: 6px; font-family: var(--font-mono); font-size: 11px; font-weight: 500; }
  .tag-fail { background: rgba(255, 107, 120, 0.13); color: #FF6B78; }
  .tag-warn { background: rgba(245, 181, 68, 0.13); color: #F5B544; }
  .tag-pass { background: rgba(45, 212, 191, 0.13); color: #2DD4BF; }

  .ins-foot { margin-top: 12px; color: #9DADAB; font-size: 12.5px; }
  .ins-foot b { color: #2DD4BF; font-weight: 600; }

  .is-pending :is([data-step], [data-finding], [data-band], [data-foot], [data-score], [data-domain], .seg-n) { opacity: 0; }
  .is-pending .cells i.got { background: var(--empty); }

  /* Sotto i 560px si stringono padding, punteggio e colonne della mappa. */
  @media (max-width: 560px) {
    .ins { padding: 16px 14px 14px; }
    .ins-score { font-size: 64px; }
    .seg { grid-template-columns: 68px minmax(0, 1fr) 36px; gap: 8px; }
    .cells i { height: 10px; }
  }
</style>

<script>
  import type { gsap as GSAP } from 'gsap';

  // Riavvolge lo stato finale già presente nell'HTML e lo riproduce: battitura del
  // dominio, check in sequenza, celle in ordine di rubrica e conteggio del punteggio
  // sincronizzati, poi banda e finding.
  let current: GSAP.core.Timeline | undefined;

  function play(gsap: typeof GSAP, root: HTMLElement) {
    const domainEl = root.querySelector<HTMLElement>('[data-domain]')!;
    const caret = root.querySelector<HTMLElement>('.ins-caret')!;
    const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
    const domain = (domainEl.dataset.full ??= domainEl.textContent ?? '');
    const finalScore = Number((scoreEl.dataset.final ??= scoreEl.textContent ?? '0'));
    const steps = root.querySelectorAll('[data-step]');
    const cells = root.querySelectorAll('.cells i.got');
    const findings = root.querySelectorAll('[data-finding]');
    const band = root.querySelector('[data-band]');
    const segN = root.querySelectorAll('.seg-n');
    const foot = root.querySelector('[data-foot]');
    const typed = { n: 0 };
    const counter = { v: 0 };
    const fill = 1.3;

    current?.progress(1).kill();
    current = gsap.timeline({ defaults: { ease: 'expo.out' } })
      .set(steps, { opacity: 0, x: -4 })
      .set(cells, { backgroundColor: '#1C2727' })
      .set([findings, band, foot], { opacity: 0, y: 6 })
      .set(segN, { opacity: 0 })
      .set(caret, { opacity: 1 })
      .call(() => {
        scoreEl.textContent = '0';
        domainEl.textContent = '';
        root.dataset.played = '1';
        root.classList.remove('is-pending');
      })
      .to(typed, {
        n: domain.length, duration: 0.9, ease: 'none',
        onUpdate: () => { domainEl.textContent = domain.slice(0, Math.round(typed.n)); },
      })
      .to(caret, { opacity: 0, duration: 0.2 })
      .to(steps, { opacity: 1, x: 0, duration: 0.4, stagger: 0.14 }, '-=0.05')
      .addLabel('fill', '-=0.3')
      .to(cells, { backgroundColor: '#E8F0EF', duration: 0.18, ease: 'none', stagger: fill / cells.length }, 'fill')
      .to(counter, {
        v: finalScore, duration: fill + 0.18, ease: 'none',
        onUpdate: () => { scoreEl.textContent = String(Math.round(counter.v)); },
      }, 'fill')
      .to(band, { opacity: 1, y: 0, duration: 0.5 })
      .to(segN, { opacity: 1, duration: 0.4, stagger: 0.03 }, '<')
      .to(findings, { opacity: 1, y: 0, duration: 0.5, stagger: 0.14 }, '-=0.2')
      .to(foot, { opacity: 1, y: 0, duration: 0.5 }, '-=0.1');
  }

  const root = document.querySelector<HTMLElement>('[data-instrument]');
  const replay = root?.querySelector<HTMLButtonElement>('[data-replay]');
  if (root && replay && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    // GSAP arriva solo qui: con reduced motion la home non lo scarica affatto.
    import('gsap').then(({ gsap }) => {
      replay.hidden = false;
      play(gsap, root);
      replay.addEventListener('click', () => play(gsap, root));
    });
  }
</script>
