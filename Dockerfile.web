# ─── GEO Optimizer Web — Docker image per Railway ──────────────────────────
# Avvia il server FastAPI per servire l'API di audit (il sito geoready.dev ha un repository e un'immagine propri: Auriti-Labs/geoready-site)
#
# Build:  docker build -f Dockerfile.web -t geo-optimizer-web .
# Run:    docker run -p 8000:8000 geo-optimizer-web

# ─── Stage 1: Python build ────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

COPY pyproject.toml README.md ./
COPY src/ src/

# Installa con le dipendenze web + pdf (FastAPI + uvicorn + weasyprint)
RUN pip install --no-cache-dir --prefix=/install ".[web,pdf]"

# ─── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.12-slim

LABEL org.opencontainers.image.title="GEO Optimizer Web" \
      org.opencontainers.image.description="FastAPI audit service" \
      org.opencontainers.image.source="https://github.com/auriti-labs/geo-optimizer-skill"

COPY --from=builder /install /usr/local

# Certificati SSL + dipendenze di sistema per weasyprint (libpango, libcairo)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Utente non-root
RUN useradd --create-home --shell /bin/bash geo
USER geo
WORKDIR /home/geo

# The app mounts GEO_STATIC_DIR at "/" and refuses to start if it is missing; this image
# serves the API only, so an empty directory is enough (the site image fills it).
RUN mkdir -p /home/geo/static

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

ENV PORT=8000 \
    GEO_STATIC_DIR=/home/geo/static
EXPOSE 8000
# Reports "unhealthy" in `docker ps` when /health stops answering. Informational only:
# Docker does not restart on it. Works whether uvicorn binds 0.0.0.0 or 127.0.0.1.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ.get('PORT', '8000'), timeout=4)"

# Avvia il server FastAPI — usa $PORT da variabile d'ambiente
# per compatibilità con Render, Railway e altri PaaS che iniettano la porta
# Shell form necessaria per espansione variabile $PORT
CMD ["sh", "-c", "uvicorn geo_optimizer.web.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
