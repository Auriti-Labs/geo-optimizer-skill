{
  "rule": "jsonld-valid",
  "description": "Is a JSON-LD block syntactically valid JSON. Syntax only: schema.org semantics stay with the Python engine. A case with input.block checks one block body; a case with input.html runs a whole page through each engine's real extraction path (Python: audit_schema -> json_parse_errors, JS: checkJsonLd -> jsonLdBlocks) and expects the number of invalid blocks.",
  "cases": [
    { "name": "object", "input": { "block": "{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Acme\"}" }, "expect": { "valid": true }, "engines": ["python", "js"] },
    { "name": "array of objects", "input": { "block": "[{\"@type\":\"Thing\"},{\"@type\":\"Person\"}]" }, "expect": { "valid": true }, "engines": ["python", "js"] },
    { "name": "graph with surrounding whitespace", "input": { "block": "\n  {\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebSite\"}]}\n" }, "expect": { "valid": true }, "engines": ["python", "js"] },
    { "name": "trailing comma", "input": { "block": "{\"@type\":\"Thing\",}" }, "expect": { "valid": false }, "engines": ["python", "js"] },
    { "name": "single quotes", "input": { "block": "{'@type':'Thing'}" }, "expect": { "valid": false }, "engines": ["python", "js"] },
    { "name": "unquoted key", "input": { "block": "{@type: \"Thing\"}" }, "expect": { "valid": false }, "engines": ["python", "js"] },
    { "name": "empty block", "input": { "block": "" }, "expect": { "valid": false }, "engines": ["python", "js"] },
    { "name": "whitespace only", "input": { "block": "   \n  " }, "expect": { "valid": false }, "engines": ["python", "js"] },
    { "name": "truncated", "input": { "block": "{\"@type\":\"Thing\"" }, "expect": { "valid": false }, "engines": ["python", "js"] },
    { "name": "duplicate keys are accepted (RFC 8259 says SHOULD be unique, not MUST)", "input": { "block": "{\"@type\":\"Thing\",\"@type\":\"Person\"}" }, "expect": { "valid": true }, "engines": ["python", "js"] },
    { "name": "NaN is not JSON", "input": { "block": "{\"@type\":\"Product\",\"price\":NaN}" }, "expect": { "valid": false }, "engines": ["js"], "divergence": "D1", "note": "Python's json.loads accepts NaN, so the Python engine would call this block valid.", "reason": "RFC 8259 section 6: NaN and Infinity are not permitted number values; JSON-LD 1.1 requires a valid JSON document." },
    { "name": "Infinity is not JSON", "input": { "block": "{\"@type\":\"Product\",\"price\":Infinity}" }, "expect": { "valid": false }, "engines": ["js"], "divergence": "D1", "note": "Python's json.loads accepts Infinity.", "reason": "RFC 8259 section 6." },
    { "name": "-Infinity is not JSON", "input": { "block": "{\"@type\":\"Product\",\"price\":-Infinity}" }, "expect": { "valid": false }, "engines": ["js"], "divergence": "D1", "note": "Python's json.loads accepts -Infinity.", "reason": "RFC 8259 section 6." },

    { "name": "page: one valid block in the head", "input": { "html": "<!doctype html><html><head><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"name\":\"Acme\"}</script></head><body><p>Acme</p></body></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: no JSON-LD at all", "input": { "html": "<!doctype html><html><head><title>Acme</title></head><body><p>Acme</p></body></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: a valid @graph block", "input": { "html": "<html><head><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebSite\"},{\"@type\":\"Organization\"}]}</script></head></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: a valid top-level array", "input": { "html": "<html><head><script type=\"application/ld+json\">[{\"@type\":\"Thing\"},{\"@type\":\"Person\"}]</script></head></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: one valid and one invalid block", "input": { "html": "<html><head><script type=\"application/ld+json\">{\"@type\":\"Thing\"}</script><script type=\"application/ld+json\">{\"@type\":\"Thing\",}</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["python", "js"] },
    { "name": "page: two invalid blocks in the body", "input": { "html": "<html><body><script type=\"application/ld+json\">{'@type':'Thing'}</script><p>text</p><script type=\"application/ld+json\">{\"@type\":</script></body></html>" }, "expect": { "invalid": 2 }, "engines": ["python", "js"] },
    { "name": "page: a script of another type is not JSON-LD", "input": { "html": "<html><head><script type=\"application/json\">{bad</script><script>{bad</script></head></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: a block inside an HTML comment is not read", "input": { "html": "<html><head><!-- <script type=\"application/ld+json\">{bad</script> --></head></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: single-quoted type attribute", "input": { "html": "<html><head><script type='application/ld+json'>{bad</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["python", "js"] },
    { "name": "page: upper-case attribute name", "input": { "html": "<html><head><script TYPE=\"application/ld+json\">{bad</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["python", "js"] },
    { "name": "page: other attributes around type", "input": { "html": "<html><head><script id=\"org\" type=\"application/ld+json\" nonce=\"abc\">{bad</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["python", "js"] },
    { "name": "page: markup inside a JSON string", "input": { "html": "<html><head><script type=\"application/ld+json\">{\"@type\":\"Thing\",\"description\":\"<b>bold</b> text\"}</script></head></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: a byte order mark before the JSON", "input": { "html": "<html><head><script type=\"application/ld+json\">\ufeff{\"@type\":\"Thing\"}</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["python", "js"] },

    { "name": "page: NaN inside a block", "input": { "html": "<html><head><script type=\"application/ld+json\">{\"@type\":\"Product\",\"price\":NaN}</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["js"], "divergence": "D1", "note": "Python reports 0: audit_schema parses the block with json.loads, which accepts NaN.", "reason": "RFC 8259 section 6." },
    { "name": "page: Infinity inside a block", "input": { "html": "<html><head><script type=\"application/ld+json\">{\"@type\":\"Product\",\"price\":Infinity}</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["js"], "divergence": "D1", "note": "Python reports 0 for the same reason.", "reason": "RFC 8259 section 6." },
    { "name": "page: an empty block is skipped", "input": { "html": "<html><head><script type=\"application/ld+json\"></script></head></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: a whitespace-only block is skipped", "input": { "html": "<html><head><script type=\"application/ld+json\">  \n  </script></head></html>" }, "expect": { "invalid": 0 }, "engines": ["python", "js"] },
    { "name": "page: the type value is matched case-insensitively", "input": { "html": "<html><head><script type=\"Application/LD+JSON\">{bad</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["js"], "divergence": "D3", "note": "Python reports 0: soup.find_all(type='application/ld+json') matches the value exactly, so the block is never read.", "reason": "MIME type and subtype names are case-insensitive (RFC 2045, RFC 6838)." },
    { "name": "page: a type value with parameters is still JSON-LD", "input": { "html": "<html><head><script type=\"application/ld+json; charset=utf-8\">{bad</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["js"], "divergence": "D3", "note": "Python reports 0: exact value match.", "reason": "A media type may carry parameters (RFC 6838); the JSON-LD 1.1 media type defines a profile parameter." },
    { "name": "page: an HTML comment inside a script is literal text", "input": { "html": "<html><head><script type=\"application/ld+json\"><!-- note -->{\"@type\":\"Thing\"}</script></head></html>" }, "expect": { "invalid": 1 }, "engines": ["python"], "divergence": "D4", "note": "JS reports 0: html.js removes every <!-- --> from the page before extracting, including inside script bodies, so it validates a body the browser never sees.", "reason": "Script content is raw text (HTML Living Standard, script element content restrictions); the body handed to a JSON-LD processor starts with '<!--', which is not JSON." }
  ]
}
