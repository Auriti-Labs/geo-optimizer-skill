{
  "rule": "robots-ai-bots",
  "description": "Is a bot blocked on a path by robots.txt (RFC 9309: group of the bot or *, longest match, Allow wins ties, * and $ in rules). Paths other than / on purpose: the Python engine reads / as a site-wide 'partial' status. The byte limit is 500 KiB (512000 bytes of UTF-8, RFC 9309 §2.5): a case may give `robots` as a list of `{text, repeat}` parts, joined by the runner, so the file does not carry 500 KiB of text.",
  "cases": [
    {
      "name": "empty file blocks nobody",
      "input": {
        "robots": "",
        "bot": "OAI-SearchBot",
        "path": "/blog"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "wildcard group with Disallow: /",
      "input": {
        "robots": "User-agent: *\nDisallow: /",
        "bot": "OAI-SearchBot",
        "path": "/blog"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "named group blocks only that bot",
      "input": {
        "robots": "User-agent: OAI-SearchBot\nDisallow: /\n\nUser-agent: *\nAllow: /",
        "bot": "OAI-SearchBot",
        "path": "/blog"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "named group leaves the other bots alone",
      "input": {
        "robots": "User-agent: OAI-SearchBot\nDisallow: /\n\nUser-agent: *\nAllow: /",
        "bot": "PerplexityBot",
        "path": "/blog"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "longest match: Allow beats shorter Disallow",
      "input": {
        "robots": "User-agent: *\nDisallow: /private\nAllow: /private/public",
        "bot": "PerplexityBot",
        "path": "/private/public/x"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "longest match: path outside the Allow stays blocked",
      "input": {
        "robots": "User-agent: *\nDisallow: /private\nAllow: /private/public",
        "bot": "PerplexityBot",
        "path": "/private/x"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "tie between Allow and Disallow: Allow wins",
      "input": {
        "robots": "User-agent: *\nDisallow: /a\nAllow: /a",
        "bot": "Claude-SearchBot",
        "path": "/a/b"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "wildcard with end anchor matches the file",
      "input": {
        "robots": "User-agent: *\nDisallow: /*.pdf$",
        "bot": "Claude-SearchBot",
        "path": "/doc/file.pdf"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "end anchor does not match a longer path",
      "input": {
        "robots": "User-agent: *\nDisallow: /*.pdf$",
        "bot": "Claude-SearchBot",
        "path": "/doc/file.pdf.html"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "agent names are case-insensitive",
      "input": {
        "robots": "User-agent: claude-searchbot\nDisallow: /x",
        "bot": "Claude-SearchBot",
        "path": "/x"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "stacked User-agent lines share the rules",
      "input": {
        "robots": "User-agent: GPTBot\nUser-agent: PerplexityBot\nDisallow: /",
        "bot": "PerplexityBot",
        "path": "/a"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "empty Disallow allows everything",
      "input": {
        "robots": "User-agent: *\nDisallow:",
        "bot": "OAI-SearchBot",
        "path": "/a"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "a specific group overrides the wildcard group",
      "input": {
        "robots": "User-agent: *\nDisallow: /\n\nUser-agent: PerplexityBot\nAllow: /",
        "bot": "PerplexityBot",
        "path": "/a"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "comments and CRLF line ends are ignored",
      "input": {
        "robots": "# note\r\nUser-agent: * # all\r\nDisallow: /x # no\r\n",
        "bot": "OAI-SearchBot",
        "path": "/x/y"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "percent-encoded rule matches the raw non-ASCII path",
      "input": {
        "robots": "User-agent: *\nDisallow: /caf%C3%A9",
        "bot": "OAI-SearchBot",
        "path": "/café"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "escape of an unreserved character matches the plain character",
      "input": {
        "robots": "User-agent: *\nDisallow: /%7Euser",
        "bot": "OAI-SearchBot",
        "path": "/~user"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "escaped slash is not a slash",
      "input": {
        "robots": "User-agent: *\nDisallow: /a%2Fb",
        "bot": "OAI-SearchBot",
        "path": "/a/b"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "rule with many wildcards that cannot match answers at once",
      "input": {
        "robots": "User-agent: *\nDisallow: /a*a*a*a*a*a*a*a*a*a*a*a*a*a*b",
        "bot": "OAI-SearchBot",
        "path": "/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "a Sitemap line between two User-agent lines does not split the group (OAI-SearchBot)",
      "input": {
        "robots": "User-agent: OAI-SearchBot\nSitemap: https://example.com/sitemap.xml\nUser-agent: PerplexityBot\nDisallow: /private\n",
        "bot": "OAI-SearchBot",
        "path": "/private"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "a Sitemap line between two User-agent lines does not split the group (PerplexityBot)",
      "input": {
        "robots": "User-agent: OAI-SearchBot\nSitemap: https://example.com/sitemap.xml\nUser-agent: PerplexityBot\nDisallow: /private\n",
        "bot": "PerplexityBot",
        "path": "/private"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "an unknown record between two User-agent lines does not split the group",
      "input": {
        "robots": "User-agent: OAI-SearchBot\nHost: example.com\nUser-agent: Claude-SearchBot\nDisallow: /private\n",
        "bot": "OAI-SearchBot",
        "path": "/private"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "a Sitemap line after the rules does not affect a later group",
      "input": {
        "robots": "User-agent: OAI-SearchBot\nDisallow: /private\nSitemap: https://example.com/sitemap.xml\nUser-agent: Claude-SearchBot\nAllow: /\n",
        "bot": "Claude-SearchBot",
        "path": "/private"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "limit is in UTF-8 bytes: a rule past 512000 bytes is ignored although the text has fewer characters",
      "input": {
        "robots": [
          {
            "text": "User-agent: *\n",
            "repeat": 1
          },
          {
            "text": "#ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé\n",
            "repeat": 3000
          },
          {
            "text": "Disallow: /late\n",
            "repeat": 1
          }
        ],
        "bot": "OAI-SearchBot",
        "path": "/late"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "a rule before the byte limit is still read when multibyte text follows",
      "input": {
        "robots": [
          {
            "text": "User-agent: *\nDisallow: /early\n",
            "repeat": 1
          },
          {
            "text": "#ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé\n",
            "repeat": 3000
          }
        ],
        "bot": "OAI-SearchBot",
        "path": "/early"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "a rule ending exactly at the byte limit is kept",
      "input": {
        "robots": [
          {
            "text": "User-agent: *\n",
            "repeat": 1
          },
          {
            "text": "#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n",
            "repeat": 5069
          },
          {
            "text": "#ab\n",
            "repeat": 1
          },
          {
            "text": "Disallow: /é",
            "repeat": 1
          }
        ],
        "bot": "OAI-SearchBot",
        "path": "/é"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "a character cut by the byte limit is replaced, not dropped",
      "input": {
        "robots": [
          {
            "text": "User-agent: *\n",
            "repeat": 1
          },
          {
            "text": "#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n",
            "repeat": 5069
          },
          {
            "text": "#a\n",
            "repeat": 1
          },
          {
            "text": "Disallow: /éé\n",
            "repeat": 1
          }
        ],
        "bot": "OAI-SearchBot",
        "path": "/éé"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "limit applies to ASCII text too",
      "input": {
        "robots": [
          {
            "text": "User-agent: *\n",
            "repeat": 1
          },
          {
            "text": "#aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n",
            "repeat": 5069
          },
          {
            "text": "#aaaaaaaaaaaaaaaaaaaa\n",
            "repeat": 1
          },
          {
            "text": "Disallow: /late\n",
            "repeat": 1
          }
        ],
        "bot": "OAI-SearchBot",
        "path": "/late"
      },
      "expect": {
        "blocked": false
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "a single leading BOM is ignored",
      "input": {
        "robots": "﻿User-agent: *\nDisallow: /x\n",
        "bot": "OAI-SearchBot",
        "path": "/x"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "every leading BOM is ignored, not just the first",
      "input": {
        "robots": "﻿﻿User-agent: *\nDisallow: /x\n",
        "bot": "OAI-SearchBot",
        "path": "/x"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    },
    {
      "name": "leading BOMs do not count towards the byte limit: a rule after 200000 of them is still read",
      "input": {
        "robots": [
          {
            "text": "﻿",
            "repeat": 200000
          },
          {
            "text": "User-agent: *\nDisallow: /x\n",
            "repeat": 1
          }
        ],
        "bot": "OAI-SearchBot",
        "path": "/x"
      },
      "expect": {
        "blocked": true
      },
      "engines": [
        "python",
        "js"
      ]
    }
  ]
}
