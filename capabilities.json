{
  "manifest_version": 1,
  "package": "geo-optimizer-skill",
  "min_version": "4.19.9",
  "python": ">=3.10",
  "executables": [
    "geo",
    "geo-mcp",
    "geo-web"
  ],
  "spawns_processes": false,
  "telemetry": false,
  "url_fetch_guard": "validate_public_url + DNS pinning, re-validated on every redirect (src/geo_optimizer/utils/http.py)",
  "fetched_content": "untrusted data; never executed; prompt-injection patterns are flagged, not removed",
  "commands": {
    "audit": {
      "network": "target",
      "api_keys": [],
      "writes": [
        "--output",
        "geo-report.pdf (--format pdf)",
        "~/.geo-cache (--cache)",
        "~/.geo-optimizer/tracking.db (--save-history, --regression)"
      ],
      "loads_plugins": "installed geo_optimizer.checks entry points unless --no-plugins"
    },
    "fix": {
      "network": "target",
      "api_keys": [],
      "writes": [
        "./geo-fixes/ or --output-dir, only with --apply"
      ]
    },
    "llms": {
      "network": "target",
      "api_keys": [],
      "writes": [
        "--output"
      ]
    },
    "schema": {
      "network": "none",
      "api_keys": [],
      "writes": [
        "--file with --inject, after <file>.bak unless --no-backup"
      ]
    },
    "diff": {
      "network": "target",
      "api_keys": [],
      "writes": [
        "--output",
        "~/.geo-cache (--cache)"
      ]
    },
    "history": {
      "network": "none",
      "api_keys": [],
      "writes": [
        "~/.geo-optimizer/tracking.db (prunes rows older than 90 days)",
        "--output"
      ]
    },
    "coherence": {
      "network": "target",
      "api_keys": [],
      "writes": []
    },
    "monitor": {
      "network": "target",
      "api_keys": [],
      "writes": [
        "~/.geo-optimizer/tracking.db",
        "--output",
        "~/.geo-cache (--cache)"
      ]
    },
    "track": {
      "network": "target",
      "api_keys": [],
      "writes": [
        "~/.geo-optimizer/tracking.db",
        "geo-track-report.html (--report)",
        "--output",
        "~/.geo-cache (--cache)"
      ]
    },
    "logs": {
      "network": "none",
      "api_keys": [],
      "writes": []
    },
    "snapshots": {
      "network": "none",
      "api_keys": [],
      "writes": [
        "~/.geo-optimizer/snapshots.db",
        "--output"
      ]
    },
    "access": {
      "network": "target",
      "api_keys": [],
      "writes": [
        "--output"
      ]
    },
    "authority": {
      "network": "target",
      "api_keys": [],
      "writes": []
    },
    "citations": {
      "network": "the configured provider only: OpenAI, Anthropic, Groq (official SDK endpoints), api.perplexity.ai, generativelanguage.googleapis.com, api.deepseek.com, api.minimax.io, api.serpbase.dev (--provider serpbase)",
      "api_keys": [
        "GEO_LLM_PROVIDER+GEO_LLM_API_KEY",
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY",
        "GROQ_API_KEY",
        "PERPLEXITY_API_KEY",
        "GEMINI_API_KEY",
        "DEEPSEEK_API_KEY",
        "MINIMAX_API_KEY",
        "SERPBASE_API_KEY"
      ],
      "api_keys_required": true,
      "sends": "questions, brand name and domain; never page content",
      "writes": [
        "--output"
      ]
    },
    "drift": {
      "network": "none",
      "api_keys": [],
      "writes": [
        "~/.geo-optimizer/tracking.db"
      ]
    },
    "perception": {
      "network": "target",
      "api_keys": [],
      "writes": [
        "--output",
        "~/.geo-cache (--cache)"
      ]
    }
  },
  "mcp_tools": {
    "writes_to_disk": false,
    "network": "target URL; geo_factual_accuracy also fetches up to 8 links found on the page, through the same guard",
    "tools": [
      "geo_audit",
      "geo_fix",
      "geo_llms_generate",
      "geo_citability",
      "geo_schema_validate",
      "geo_compare",
      "geo_gap_analysis",
      "geo_ai_discovery",
      "geo_check_bots",
      "geo_trust_score",
      "geo_negative_signals",
      "geo_factual_accuracy"
    ]
  }
}
